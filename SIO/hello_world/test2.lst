     1                                  ; ==========================================
     2                                  ; DVE-554 Analysis Test Code (NASM)
     3                                  ; ==========================================
     4                                  
     5                                  [BITS 16]
     6                                  [ORG 0x8100]
     7                                  
     8                                  START:
     9 00000000 FA                          cli                     ; 割り込み禁止
    10 00000001 FC                          cld                     ; 文字列処理を前方へ
    11 00000002 BCFF7F                      mov     sp, 0x7FFF      ; SP = 0x7FFF 初期化
    12 00000005 B80000                      mov     ax, 0x0000
    13 00000008 8ED8                        mov     ds, ax          ; DS = 0000h
    14 0000000A B800C0                      mov     ax, 0xC000
    15 0000000D 8EC0                        mov     es, ax          ; ES = C000h
    16                                  
    17                                      ; --- 2. V53 システムレジスタ初期化 (ROM 01:81E6ルーチンの再現) ---
    18 0000000F E81900                      call L0181E6
    19                                  
    20                                      ; --- 3. TCU (タイマーユニット) 初期化 (ROM 01:839Dルーチンの再現) ---
    21 00000012 E82C00                      call L01839D
    22                                  
    23                                      ; --- 4. 物理IOの初期化 (ROM 01:83FDルーチンの内容) ---
    24 00000015 E84B00                      call L0183FD
    25                                  
    26                                      ; --- 5. MPSC の初期化 ---
    27 00000018 E85700                      call L018238            ; 外部MPSC uPD72001のセットアップ
    28                                  
    29                                      ; --- 6. 文字 'A' の連続送信 ---
    30                                  .loop_send:
    31 0000001B BAA200                      mov dx, 0x00A2
    32                                  .wait_tx:
    33 0000001E EC                          in al, dx
    34 0000001F A804                        test al, 0x04   ; Tx Buffer Empty?
    35 00000021 74FB                        jz .wait_tx
    36 00000023 BAA000                      mov dx, 0x00A0
    37 00000026 B041                        mov al, 'A'
    38 00000028 EE                          out dx, al
    39 00000029 EBF0                        jmp .loop_send
    40                                  
    41                                  ; --------------------------------------------------
    42                                  ;  V53 システムレジスタ初期化 (ROM 01:81E6相当)
    43                                  ; --------------------------------------------------
    44                                  L0181E6:
    45 0000002B BE[BC00]                    mov si, TABLE_V53_REG
    46                                  .next:
    47 0000002E 2E8B14                      mov dx, [cs:si]      ; Port Number (16bit)
    48 00000031 83FAFF                      cmp dx, 0xFFFF       ; Terminator
    49 00000034 740A                        je .done
    50 00000036 2E8A4402                    mov al, [cs:si+2]    ; Value (8bit)
    51 0000003A EE                          out dx, al
    52 0000003B 83C603                      add si, 3
    53 0000003E EBEE                        jmp .next
    54                                  .done:
    55 00000040 C3                          ret
    56                                  
    57                                  ; --------------------------------------------------
    58                                  ; TCU (タイマーユニット) 初期化 (ROM 01:839D相当)
    59                                  ; --------------------------------------------------
    60                                  L01839D:
    61 00000041 BE[F800]                    mov si, TABLE_TCU_REG
    62                                  .next:
    63 00000044 2E8B14                      mov dx, [cs:si]      ; Port1 (16bit)
    64 00000047 83FAFF                      cmp dx, 0xFFFF       ; Terminator
    65 0000004A 7416                        je .done
    66 0000004C 2E8A4402                    mov al, [cs:si+2]    ; Val1 (8bit)
    67 00000050 EE                          out dx, al
    68 00000051 2E8B5403                    mov dx, [cs:si+3]    ; Port2 (16bit)
    69 00000055 2E8B4405                    mov ax, [cs:si+5]    ; Val2 (16bit)
    70 00000059 EE                          out dx, al           ; Port2 Low
    71 0000005A 88E0                        mov al, ah
    72 0000005C EE                          out dx, al           ; Port2 High
    73 0000005D 83C607                      add si, 7
    74 00000060 EBE2                        jmp .next
    75                                  .done:
    76 00000062 C3                          ret
    77                                  
    78                                  ; ---------------------------------------------------
    79                                  ; 物理IOの初期化 (ROM 01:83FDルーチンの内容) 
    80                                  ; ---------------------------------------------------
    81                                  L0183FD:
    82 00000063 B000                        mov al, 0x00
    83 00000065 BA8600                      mov dx, 0x0086
    84 00000068 EE                          out dx, al
    85 00000069 BA8200                      mov dx, 0x0082
    86 0000006C EE                          out dx, al
    87 0000006D BA8000                      mov dx, 0x0080
    88 00000070 EE                          out dx, al
    89 00000071 C3                          ret
    90                                  
    91                                  ; ---------------------------------------------------
    92                                  ; MPSC1 初期化シーケンス (ROM 01:823B～の内容を網羅) 
    93                                  ; ---------------------------------------------------
    94                                  L018238:
    95 00000072 BAA200                      mov dx, 0x00A2  ; MPSC1 Ch-A Control
    96                                  
    97                                      ; ポインタの強制リセット
    98 00000075 B000                        mov al, 0x00
    99 00000077 EE                          out dx, al
   100 00000078 EE                          out dx, al
   101                                  
   102                                      ; Channel Reset
   103 00000079 B018                        mov al, 0x18
   104 0000007B EE                          out dx, al
   105                                      
   106                                      ; リセット後の安定待ち
   107 0000007C B96400                      mov cx, 100
   108                                  .wait_res:
   109 0000007F 90                          nop
   110 00000080 90                          nop
   111 00000081 90                          nop
   112 00000082 E2FB                        loop .wait_res
   113                                  
   114                                      ; WR4: 64x Clock, 2 Stop, No Parity (ROM値: E0h)
   115 00000084 B004                        mov al, 0x04
   116 00000086 EE                          out dx, al
   117 00000087 B0E0                        mov al, 0xE0
   118 00000089 EE                          out dx, al
   119                                  
   120                                      ; WR10: NRZ Encoding (ROM値: 00h)
   121 0000008A B00A                        mov al, 0x0A
   122 0000008C EE                          out dx, al
   123 0000008D B000                        mov al, 0x00
   124 0000008F EE                          out dx, al
   125                                  
   126                                      ; WR3: 8bit Rx, Rx Enable (ROM値: 32h)
   127 00000090 B003                        mov al, 0x03
   128 00000092 EE                          out dx, al
   129 00000093 B032                        mov al, 0x32
   130 00000095 EE                          out dx, al
   131                                  
   132                                      ; WR5: 8bit Tx, Tx Enable, DTR/RTS ON (ROM値: 68h相当)
   133 00000096 B005                        mov al, 0x05
   134 00000098 EE                          out dx, al
   135 00000099 B068                        mov al, 0x68
   136 0000009B EE                          out dx, al
   137                                  
   138                                      ; --- ボーレートジェネレータ設定 (ROM 01:82D0～付近) ---
   139                                  
   140                                      ; WR11: Clock Source Selection (ROM値: F3h)
   141                                      ; 受信・送信クロック共にBRG出力を選択
   142 0000009C B00B                        mov al, 0x0B
   143 0000009E EE                          out dx, al
   144 0000009F B0F3                        mov al, 0xF3
   145 000000A1 EE                          out dx, al
   146                                  
   147                                      ; WR12: Baud Rate Generator Time Constant Lower (ROM推測値)
   148                                      ; ダンプの 01:82A0 付近の設定に基づく
   149 000000A2 B00C                        mov al, 0x0C
   150 000000A4 EE                          out dx, al
   151 000000A5 B032                        mov al, 0x32    ; ROM内の設定値 32h
   152 000000A7 EE                          out dx, al
   153                                  
   154                                      ; WR13: Baud Rate Generator Time Constant Upper
   155 000000A8 B00D                        mov al, 0x0D
   156 000000AA EE                          out dx, al
   157 000000AB B000                        mov al, 0x00
   158 000000AD EE                          out dx, al
   159                                  
   160                                      ; WR14: BRG Control - BRG Enable (ROM値: E6h)
   161                                      ; ここで物理的にカウントが開始されます
   162 000000AE B00E                        mov al, 0x0E
   163 000000B0 EE                          out dx, al
   164 000000B1 B0E6                        mov al, 0xE6
   165 000000B3 EE                          out dx, al
   166                                  
   167                                      ; --- 割り込みリセット (ROM 01:8321～) ---
   168 000000B4 B080                        mov al, 0x80    ; Reset Tx Int
   169 000000B6 EE                          out dx, al
   170 000000B7 B040                        mov al, 0x40    ; Reset Rx Int
   171 000000B9 EE                          out dx, al
   172                                  
   173 000000BA C3                          ret
   174                                  
   175                                  ; --------------------------------------------------
   176                                  ; V53システムレジスタ設定テーブル (ROM 01:81FCから完全抽出)
   177                                  ; --------------------------------------------------
   178 000000BB 90                      ALIGN 2
   179                                  TABLE_V53_REG:
   180 000000BC FEFF00                      db 0xFE, 0xFF, 0x00     ; FFFE (SCTL) = 00h
   181 000000BF FDFF06                      db 0xFD, 0xFF, 0x06     ; FFFD (OPSEL)= 06h
   182 000000C2 FCFF00                      db 0xFC, 0xFF, 0x00     ; FFFC (OPHA) = 00h
   183 000000C5 FBFFE0                      db 0xFB, 0xFF, 0xE0     ; FFFB (DULA) = E0h
   184 000000C8 FAFFC0                      db 0xFA, 0xFF, 0xC0     ; FFFA (IULA) = C0h
   185 000000CB F9FFD0                      db 0xF9, 0xFF, 0xD0     ; FFF9 (TULA) = D0h
   186 000000CE F8FFF0                      db 0xF8, 0xFF, 0xF0     ; FFF8 (SULA) = F0h
   187 000000D1 EAFF00                      db 0xEA, 0xFF, 0x00     ; FFEA (WMB0) = 00h
   188 000000D4 EBFF00                      db 0xEB, 0xFF, 0x00     ; FFEB (WCY1) = 00h
   189 000000D7 ECFF00                      db 0xEC, 0xFF, 0x00     ; FFEC (WCY0) = 00h
   190 000000DA F3FF73                      db 0xF3, 0xFF, 0x73     ; FFF3 (WMB1) = 73h
   191 000000DD EDFF00                      db 0xED, 0xFF, 0x00     ; FFED (WAC)  = 00h
   192 000000E0 F4FF10                      db 0xF4, 0xFF, 0x10     ; FFF4 (WCY2) = 10h
   193 000000E3 F5FF22                      db 0xF5, 0xFF, 0x22     ; FFF5 (WCY3) = 22h
   194 000000E6 F6FF10                      db 0xF6, 0xFF, 0x10     ; FFF6 (WCY4) = 10h
   195 000000E9 F2FF00                      db 0xF2, 0xFF, 0x00     ; FFF2 (RFC)  = 00h
   196 000000EC E9FF00                      db 0xE9, 0xFF, 0x00     ; FFE9 (BRC)  = 00h
   197 000000EF F0FF02                      db 0xF0, 0xFF, 0x02     ; FFF0 (TCKS) = 02h
   198 000000F2 F1FF00                      db 0xF1, 0xFF, 0x00     ; FFF1 (SBCR) = 00h
   199 000000F5 FFFFFF                      db 0xFF, 0xFF, 0xFF     ; 終端マーカー
   200                                  
   201                                  ; --------------------------------------------------
   202                                  ; TCU タイマー設定テーブル (ROM 01:83BFから完全抽出)
   203                                  ; --------------------------------------------------
   204                                  ALIGN 2
   205                                  TABLE_TCU_REG:
   206                                      ; Port1, Val1, Port2, Val2(16)
   207 000000F8 D60036D000204E              db 0xD6, 0x00, 0x36, 0xD0, 0x00, 0x20, 0x4E ; T0設定
   208 000000FF D60070D200050D              db 0xD6, 0x00, 0x70, 0xD2, 0x00, 0x05, 0x0D ; T0最大値A
   209 00000106 D600B0D400050D              db 0xD6, 0x00, 0xB0, 0xD4, 0x00, 0x05, 0x0D ; T0最大値B
   210 0000010D FFFF                        db 0xFF, 0xFF           ; 終端マーカー
