     1                                  ; ==========================================
     2                                  ; DVE-554 Analysis Test Code (NASM)
     3                                  ; ==========================================
     4                                  
     5                                  [BITS 16]
     6                                  [ORG 0x8100]
     7                                  
     8                                  %define MPSC1_CTRL 0x00A2
     9                                  %define MPSC2_CTRL 0x00AA
    10                                  
    11                                  START:
    12 00000000 FA                          cli                     ; 割り込み禁止
    13 00000001 FC                          cld                     ; 文字列処理を前方へ
    14 00000002 BCFF7F                      mov     sp, 0x7FFF      ; SP = 0x7FFF 初期化
    15 00000005 B80000                      mov     ax, 0x0000
    16 00000008 8ED8                        mov     ds, ax          ; DS = 0000h
    17 0000000A B800C0                      mov     ax, 0xC000
    18 0000000D 8EC0                        mov     es, ax          ; ES = C000h
    19                                  
    20                                      ; --- 2. V53 システムレジスタ初期化 (ROM 01:81E6ルーチンの再現) ---
    21 0000000F E81900                      call L0181E6
    22                                  
    23                                      ; --- 3. TCU (タイマーユニット) 初期化 (ROM 01:839Dルーチンの再現) ---
    24 00000012 E82C00                      call L01839D
    25                                  
    26                                      ; --- 4. 物理IOの初期化 (ROM 01:83FDルーチンの内容) ---
    27 00000015 E84B00                      call L0183FD
    28                                  
    29                                      ; --- 5. MPSC の初期化 ---
    30 00000018 E85700                      call L018238            ; 外部MPSC uPD72001のセットアップ
    31                                  
    32                                      ; --- 6. 文字 'A' の連続送信 ---
    33                                  .loop_send:
    34 0000001B BAA200                      mov dx, 0x00A2
    35                                  .wait_tx:
    36 0000001E EC                          in al, dx
    37 0000001F A804                        test al, 0x04   ; Tx Buffer Empty?
    38 00000021 74FB                        jz .wait_tx
    39 00000023 BAA000                      mov dx, 0x00A0
    40 00000026 B041                        mov al, 'A'
    41 00000028 EE                          out dx, al
    42 00000029 EBF0                        jmp .loop_send
    43                                  
    44                                  ; --------------------------------------------------
    45                                  ;  V53 システムレジスタ初期化 (ROM 01:81E6相当)
    46                                  ; --------------------------------------------------
    47                                  L0181E6:
    48 0000002B BE[0401]                    mov si, TABLE_V53_REG
    49                                  .next:
    50 0000002E 2E8B14                      mov dx, [cs:si]      ; Port Number (16bit)
    51 00000031 83FAFF                      cmp dx, 0xFFFF       ; Terminator
    52 00000034 740A                        je .done
    53 00000036 2E8A4402                    mov al, [cs:si+2]    ; Value (8bit)
    54 0000003A EE                          out dx, al
    55 0000003B 83C603                      add si, 3
    56 0000003E EBEE                        jmp .next
    57                                  .done:
    58 00000040 C3                          ret
    59                                  
    60                                  ; --------------------------------------------------
    61                                  ; TCU (タイマーユニット) 初期化 (ROM 01:839D相当)
    62                                  ; --------------------------------------------------
    63                                  L01839D:
    64 00000041 BE[4001]                    mov si, TABLE_TCU_REG
    65                                  .next:
    66 00000044 2E8B14                      mov dx, [cs:si]      ; Port1 (16bit)
    67 00000047 83FAFF                      cmp dx, 0xFFFF       ; Terminator
    68 0000004A 7416                        je .done
    69 0000004C 2E8A4402                    mov al, [cs:si+2]    ; Val1 (8bit)
    70 00000050 EE                          out dx, al
    71 00000051 2E8B5403                    mov dx, [cs:si+3]    ; Port2 (16bit)
    72 00000055 2E8B4405                    mov ax, [cs:si+5]    ; Val2 (16bit)
    73 00000059 EE                          out dx, al           ; Port2 Low
    74 0000005A 88E0                        mov al, ah
    75 0000005C EE                          out dx, al           ; Port2 High
    76 0000005D 83C607                      add si, 7
    77 00000060 EBE2                        jmp .next
    78                                  .done:
    79 00000062 C3                          ret
    80                                  
    81                                  ; ---------------------------------------------------
    82                                  ; 物理IOの初期化 (ROM 01:83FDルーチンの内容) 
    83                                  ; ---------------------------------------------------
    84                                  L0183FD:
    85 00000063 B000                        mov al, 0x00
    86 00000065 BA8600                      mov dx, 0x0086
    87 00000068 EE                          out dx, al
    88 00000069 BA8200                      mov dx, 0x0082
    89 0000006C EE                          out dx, al
    90 0000006D BA8000                      mov dx, 0x0080
    91 00000070 EE                          out dx, al
    92 00000071 C3                          ret
    93                                  
    94                                  ; ---------------------------------------------------
    95                                  ; MPSC1 初期化シーケンス (ROM 01:8238～の内容を網羅) 
    96                                  ; ---------------------------------------------------
    97                                  L018238:
    98                                  ; --- [Phase 1: Hardware Reset] ---
    99 00000072 BAA200                      mov dx, MPSC1_CTRL
   100 00000075 30C0                        xor al, al          ; AL = 0
   101 00000077 EE                          out dx, al          ; Pointer Reset 1 
   102 00000078 EE                          out dx, al          ; Pointer Reset 2 
   103                                  
   104 00000079 BAAA00                      mov dx, MPSC2_CTRL
   105 0000007C EE                          out dx, al          ; Pointer Reset 1 
   106 0000007D EE                          out dx, al          ; Pointer Reset 2 
   107                                  
   108                                      ; Channel Reset (WR0: 0x18)
   109 0000007E BAA200                      mov dx, MPSC1_CTRL
   110 00000081 B018                        mov al, 0x18        ; Channel Reset command 
   111 00000083 EE                          out dx, al          ; Direct Write to WR0
   112                                  
   113 00000084 BAAA00                      mov dx, MPSC2_CTRL
   114 00000087 B018                        mov al, 0x18
   115 00000089 EE                          out dx, al
   116                                      
   117                                      ; リセット後の安定待ち
   118 0000008A B96400                      mov cx, 100
   119                                  .wait_res:
   120 0000008D 90                          nop
   121 0000008E 90                          nop
   122 0000008F 90                          nop
   123 00000090 E2FB                        loop .wait_res
   124                                  
   125                                      ; WR1: Reset Ext/Status
   126 00000092 B001                        mov al, 0x01        ; Select WR1
   127 00000094 B310                        mov bl, 0x10        ; Value 
   128 00000096 E85700                      call mpsc_write_both
   129                                  
   130                                      ; WR2: 
   131 00000099 B002                        mov al, 0x02        ; Select WR2
   132 0000009B B3E0                        mov bl, 0xE0        ; Value 
   133 0000009D E85000                      call mpsc_write_both
   134                                  
   135                                      ; WR4:
   136 000000A0 B004                        mov al, 0x04        ; Select WR4
   137 000000A2 B310                        mov bl, 0x10        ; Value 
   138 000000A4 E84900                      call mpsc_write_both
   139                                  
   140                                      ; WR4: 2回目
   141 000000A7 B004                        mov al, 0x04        ; Select WR4
   142 000000A9 B310                        mov bl, 0x10        ; Value 
   143 000000AB E84200                      call mpsc_write_both
   144                                  
   145                                      ; WR6:
   146 000000AE B006                        mov al, 0x06        ; Select WR6
   147 000000B0 B332                        mov bl, 0x32        ; Value 
   148 000000B2 E83B00                      call mpsc_write_both
   149                                  
   150                                      ; WR7:
   151 000000B5 B007                        mov al, 0x07        ; Select WR7
   152 000000B7 B332                        mov bl, 0x32        ; Value 
   153 000000B9 E83400                      call mpsc_write_both
   154                                  
   155                                      ; WR12:
   156 000000BC B00C                        mov al, 0x0C
   157 000000BE B300                        mov bl, 0x00
   158 000000C0 E82D00                      call mpsc_write_both
   159                                      
   160                                      ; WR14:
   161 000000C3 B00E                        mov al, 0x0E        ; Select WR14
   162 000000C5 B300                        mov bl, 0x00        ; Value 
   163 000000C7 E82600                      call mpsc_write_both
   164                                  
   165                                      ; WR15:
   166 000000CA B00F                        mov al, 0x0F        ; Select WR15
   167 000000CC B305                        mov bl, 0x05        ; Value 
   168 000000CE E81F00                      call mpsc_write_both
   169                                  
   170                                      ; WR11:
   171 000000D1 B00B                        mov al, 0x0B        ; Select WR11
   172 000000D3 B300                        mov bl, 0x00        ; Value 
   173 000000D5 E81800                      call mpsc_write_both
   174                                  
   175                                      ; WR3:
   176 000000D8 B003                        mov al, 0x03        ; Select WR3
   177 000000DA B3F3                        mov bl, 0xF3        ; Value 
   178 000000DC E81100                      call mpsc_write_both
   179                                  
   180                                      ; WR5:
   181 000000DF B005                        mov al, 0x05        ; Select WR5
   182 000000E1 B3E6                        mov bl, 0xE6        ; Value
   183 000000E3 E80A00                      call mpsc_write_both
   184                                      
   185                                      ; Reset Tx/Rx Interrupt (WR0)
   186 000000E6 BAA200                      mov dx, MPSC1_CTRL
   187 000000E9 B080                        mov al, 0x80        ; Reset Tx Int 
   188 000000EB EE                          out dx, al
   189 000000EC B040                        mov al, 0x40        ; Reset Rx Int 
   190 000000EE EE                          out dx, al
   191                                  
   192 000000EF C3                          ret
   193                                  
   194                                  ; --- Helper: Write to both MPSC1 and MPSC2 ---
   195                                  ; Input: AL = Register Index, BL = Value
   196                                  mpsc_write_both:
   197                                      ; MPSC1
   198 000000F0 BAA200                      mov dx, MPSC1_CTRL
   199 000000F3 EE                          out dx, al          ; Write Index
   200 000000F4 86C3                        xchg al, bl
   201 000000F6 EE                          out dx, al          ; Write Data
   202 000000F7 86C3                        xchg al, bl
   203                                      
   204                                      ; MPSC2
   205 000000F9 BAAA00                      mov dx, MPSC2_CTRL
   206 000000FC EE                          out dx, al          ; Write Index
   207 000000FD 86C3                        xchg al, bl
   208 000000FF EE                          out dx, al          ; Write Data
   209 00000100 86C3                        xchg al, bl
   210 00000102 C3                          ret
   211                                  
   212                                  ; --------------------------------------------------
   213                                  ; V53システムレジスタ設定テーブル (ROM 01:81FCから完全抽出)
   214                                  ; --------------------------------------------------
   215 00000103 90                      ALIGN 2
   216                                  TABLE_V53_REG:
   217 00000104 FEFF00                      db 0xFE, 0xFF, 0x00     ; FFFE (SCTL) = 00h
   218 00000107 FDFF06                      db 0xFD, 0xFF, 0x06     ; FFFD (OPSEL)= 06h
   219 0000010A FCFF00                      db 0xFC, 0xFF, 0x00     ; FFFC (OPHA) = 00h
   220 0000010D FBFFE0                      db 0xFB, 0xFF, 0xE0     ; FFFB (DULA) = E0h
   221 00000110 FAFFC0                      db 0xFA, 0xFF, 0xC0     ; FFFA (IULA) = C0h
   222 00000113 F9FFD0                      db 0xF9, 0xFF, 0xD0     ; FFF9 (TULA) = D0h
   223 00000116 F8FFF0                      db 0xF8, 0xFF, 0xF0     ; FFF8 (SULA) = F0h
   224 00000119 EAFF00                      db 0xEA, 0xFF, 0x00     ; FFEA (WMB0) = 00h
   225 0000011C EBFF00                      db 0xEB, 0xFF, 0x00     ; FFEB (WCY1) = 00h
   226 0000011F ECFF00                      db 0xEC, 0xFF, 0x00     ; FFEC (WCY0) = 00h
   227 00000122 F3FF73                      db 0xF3, 0xFF, 0x73     ; FFF3 (WMB1) = 73h
   228 00000125 EDFF00                      db 0xED, 0xFF, 0x00     ; FFED (WAC)  = 00h
   229 00000128 F4FF10                      db 0xF4, 0xFF, 0x10     ; FFF4 (WCY2) = 10h
   230 0000012B F5FF22                      db 0xF5, 0xFF, 0x22     ; FFF5 (WCY3) = 22h
   231 0000012E F6FF10                      db 0xF6, 0xFF, 0x10     ; FFF6 (WCY4) = 10h
   232 00000131 F2FF00                      db 0xF2, 0xFF, 0x00     ; FFF2 (RFC)  = 00h
   233 00000134 E9FF00                      db 0xE9, 0xFF, 0x00     ; FFE9 (BRC)  = 00h
   234 00000137 F0FF02                      db 0xF0, 0xFF, 0x02     ; FFF0 (TCKS) = 02h
   235 0000013A F1FF00                      db 0xF1, 0xFF, 0x00     ; FFF1 (SBCR) = 00h
   236 0000013D FFFFFF                      db 0xFF, 0xFF, 0xFF     ; 終端マーカー
   237                                  
   238                                  ; --------------------------------------------------
   239                                  ; TCU タイマー設定テーブル (ROM 01:83BFから完全抽出)
   240                                  ; --------------------------------------------------
   241                                  ALIGN 2
   242                                  TABLE_TCU_REG:
   243                                      ; Port1, Val1, Port2, Val2(16)
   244 00000140 D60036D000204E              db 0xD6, 0x00, 0x36, 0xD0, 0x00, 0x20, 0x4E ; T0設定
   245 00000147 D60070D200050D              db 0xD6, 0x00, 0x70, 0xD2, 0x00, 0x05, 0x0D ; T0最大値A
   246 0000014E D600B0D400050D              db 0xD6, 0x00, 0xB0, 0xD4, 0x00, 0x05, 0x0D ; T0最大値B
   247 00000155 FFFF                        db 0xFF, 0xFF           ; 終端マーカー
