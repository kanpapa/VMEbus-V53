     1                                  ;----------------------------------------------------------------;
     2                                  ; MPSC Send loop Program
     3                                  ;----------------------------------------------------------------;
     4                                          ORG 0000h
     5                                  
     6                                  ; ポートのベースアドレス（MPSC1_A_DATA）
     7                                  %define MPSC1_A_DATA 0x00A0
     8                                  %define MPSC1_A_CTRL 0x00A2
     9                                  %define MPSC1_B_DATA 0x00A4
    10                                  %define MPSC1_B_CTRL 0x00A6
    11                                  %define MPSC2_A_DATA 0x00A8
    12                                  %define MPSC2_A_CTRL 0x00AA
    13                                  %define MPSC2_B_DATA 0x00AC
    14                                  %define MPSC2_B_CTRL 0x00AE
    15                                  
    16                                  start:
    17 00000000 E82100                          call mpsc_init
    18                                        
    19 00000003 BB0000                          mov bx, 0           ; ポートオフセット(0, 4, 8, 12...用)
    20                                  
    21                                  ch_loop:
    22 00000006 B96400                          mov cx, 100         ; 送信カウンタ
    23                                  
    24                                  .send_block:
    25                                          ;--- 送信可能待ち ---
    26 00000009 8D97A200                        lea dx, [bx + MPSC1_A_DATA + 2] ; status port (data + 2)
    27                                  .wait_tx:
    28 0000000D EC                              in  al, dx
    29 0000000E A804                            test al, 04h
    30 00000010 74FB                            jz  .wait_tx
    31                                  
    32                                          ;--- データ送信 ---
    33 00000012 83EA02                          sub dx, 2           ; data port (status - 2)
    34 00000015 B041                            mov al, 'A'         ; alを再ロード（inで破壊されるため）
    35 00000017 EE                              out dx, al
    36                                  
    37 00000018 E2EF                            loop .send_block
    38                                  
    39                                          ;--- 次のポートへ (a2, a6, aa, ae の差分は4) ---
    40 0000001A 83C304                          add bx, 4
    41 0000001D 83FB10                          cmp bx, 16          ; 4ポート分(4*4=16) 終わったか
    42 00000020 75E4                            jne ch_loop
    43                                  
    44 00000022 EBDC                            jmp start
    45                                  
    46                                  ; ---------------------------------------------------
    47                                  ; MPSC1/2 初期化シーケンス
    48                                  ; ---------------------------------------------------
    49                                  mpsc_init:
    50                                  ; --- [Phase 1: Hardware Reset] ---
    51 00000024 BAA200                      mov dx, MPSC1_A_CTRL
    52 00000027 B000                        mov al, 0
    53 00000029 EE                          out dx, al          ; Pointer Reset 1
    54 0000002A EE                          out dx, al          ; Pointer Reset 2 
    55                                  
    56 0000002B BAAA00                      mov dx, MPSC2_A_CTRL
    57 0000002E B000                        mov al, 0
    58 00000030 EE                          out dx, al          ; Pointer Reset 1 
    59 00000031 EE                          out dx, al          ; Pointer Reset 2 
    60                                  
    61 00000032 BAA600                      mov dx, MPSC1_B_CTRL
    62 00000035 B000                        mov al, 0
    63 00000037 EE                          out dx, al          ; Pointer Reset 1
    64 00000038 EE                          out dx, al          ; Pointer Reset 2 
    65                                  
    66 00000039 BAAE00                      mov dx, MPSC2_B_CTRL
    67 0000003C B000                        mov al, 0
    68 0000003E EE                          out dx, al          ; Pointer Reset 1 
    69 0000003F EE                          out dx, al          ; Pointer Reset 2 
    70                                  
    71                                      ; Channel Reset (WR0: 0x18)
    72 00000040 BAA200                      mov dx, MPSC1_A_CTRL
    73 00000043 B018                        mov al, 0x18        ; Channel Reset command 
    74 00000045 EE                          out dx, al          ; Direct Write to WR0
    75                                  
    76 00000046 BAAA00                      mov dx, MPSC2_A_CTRL
    77 00000049 B018                        mov al, 0x18
    78 0000004B EE                          out dx, al
    79                                  
    80 0000004C BAA600                      mov dx, MPSC1_B_CTRL
    81 0000004F B018                        mov al, 0x18        ; Channel Reset command 
    82 00000051 EE                          out dx, al          ; Direct Write to WR0
    83                                  
    84 00000052 BAAE00                      mov dx, MPSC2_B_CTRL
    85 00000055 B018                        mov al, 0x18
    86 00000057 EE                          out dx, al
    87                                  
    88                                      ; リセット後の安定待ち
    89 00000058 B96400                      mov cx, 100
    90                                  .wait_res:
    91 0000005B 90                          nop
    92 0000005C 90                          nop
    93 0000005D 90                          nop
    94 0000005E E2FB                        loop .wait_res
    95                                  
    96                                      ; CR2: 割り込み動作の基本設定
    97 00000060 B002                        mov al, 2
    98 00000062 B300                        mov bl, 0x00        ; 割り込みは使用しない。ポーリングモード。
    99 00000064 E8AA00                      call mpsc_write_both
   100                                  
   101                                      ; CR4: 通信プロトコルとデータフォーマットの設定
   102 00000067 B004                        mov al, 4
   103 00000069 B344                        mov bl, 0x44        ; x16, Async, ストップビット 1bit，パリティなし
   104 0000006B E8A300                      call mpsc_write_both
   105                                  
   106                                      ; CR1: 送受信割り込みおよびDMAの無効化
   107 0000006E B001                        mov al, 1
   108 00000070 B300                        mov bl, 0x00
   109 00000072 E89C00                      call mpsc_write_both
   110                                      
   111                                      ; CR12: ボーレートジェネレータ（BRG）の割り込みとレジスタ書き込み設定 
   112 00000075 BAA200                      mov dx, MPSC1_A_CTRL
   113 00000078 B00C                        mov al, 12          ; Select CR12
   114 0000007A EE                          out dx, al
   115 0000007B B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
   116 0000007D EE                          out dx, al
   117 0000007E B01E                        mov al, 0x1e        ; 下位バイトの値
   118 00000080 EE                          out dx, al
   119 00000081 B000                        mov al, 0x00        ; 上位バイトの値
   120 00000083 EE                          out dx, al
   121                                      
   122 00000084 BAA200                      mov dx, MPSC1_A_CTRL
   123 00000087 B00C                        mov al, 12          ; Select CR12
   124 00000089 EE                          out dx, al
   125 0000008A B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
   126 0000008C EE                          out dx, al
   127 0000008D B01E                        mov al, 0x1e        ; 下位バイトの値
   128 0000008F EE                          out dx, al
   129 00000090 B000                        mov al, 0x00        ; 上位バイトの値
   130 00000092 EE                          out dx, al
   131                                      
   132 00000093 BAAA00                      mov dx, MPSC2_A_CTRL
   133 00000096 B00C                        mov al, 12          ; Select CR12
   134 00000098 EE                          out dx, al
   135 00000099 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
   136 0000009B EE                          out dx, al
   137 0000009C B01E                        mov al, 0x1e        ; 下位バイトの値
   138 0000009E EE                          out dx, al
   139 0000009F B000                        mov al, 0x00        ; 上位バイトの値
   140 000000A1 EE                          out dx, al
   141                                      
   142 000000A2 BAAA00                      mov dx, MPSC2_A_CTRL
   143 000000A5 B00C                        mov al, 12          ; Select CR12
   144 000000A7 EE                          out dx, al
   145 000000A8 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
   146 000000AA EE                          out dx, al
   147 000000AB B01E                        mov al, 0x1e        ; 下位バイトの値
   148 000000AD EE                          out dx, al
   149 000000AE B000                        mov al, 0x00        ; 上位バイトの値
   150 000000B0 EE                          out dx, al
   151                                  
   152 000000B1 BAA600                      mov dx, MPSC1_B_CTRL
   153 000000B4 B00C                        mov al, 12          ; Select CR12
   154 000000B6 EE                          out dx, al
   155 000000B7 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
   156 000000B9 EE                          out dx, al
   157 000000BA B01E                        mov al, 0x1e        ; 下位バイトの値
   158 000000BC EE                          out dx, al
   159 000000BD B000                        mov al, 0x00        ; 上位バイトの値
   160 000000BF EE                          out dx, al
   161                                      
   162 000000C0 BAA600                      mov dx, MPSC1_B_CTRL
   163 000000C3 B00C                        mov al, 12          ; Select CR12
   164 000000C5 EE                          out dx, al
   165 000000C6 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
   166 000000C8 EE                          out dx, al
   167 000000C9 B01E                        mov al, 0x1e        ; 下位バイトの値
   168 000000CB EE                          out dx, al
   169 000000CC B000                        mov al, 0x00        ; 上位バイトの値
   170 000000CE EE                          out dx, al
   171                                      
   172 000000CF BAAE00                      mov dx, MPSC2_B_CTRL
   173 000000D2 B00C                        mov al, 12          ; Select CR12
   174 000000D4 EE                          out dx, al
   175 000000D5 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
   176 000000D7 EE                          out dx, al
   177 000000D8 B01E                        mov al, 0x1e        ; 下位バイトの値
   178 000000DA EE                          out dx, al
   179 000000DB B000                        mov al, 0x00        ; 上位バイトの値
   180 000000DD EE                          out dx, al
   181                                      
   182 000000DE BAAE00                      mov dx, MPSC2_B_CTRL
   183 000000E1 B00C                        mov al, 12          ; Select CR12
   184 000000E3 EE                          out dx, al
   185 000000E4 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
   186 000000E6 EE                          out dx, al
   187 000000E7 B01E                        mov al, 0x1e        ; 下位バイトの値
   188 000000E9 EE                          out dx, al
   189 000000EA B000                        mov al, 0x00        ; 上位バイトの値
   190 000000EC EE                          out dx, al
   191                                  
   192                                      ; CR15: クロックソースとピン機能の選択
   193 000000ED B00F                        mov al, 15
   194 000000EF B356                        mov bl, 0x56        ; ボーレートジェネレータ使用
   195 000000F1 E81D00                      call mpsc_write_both
   196                                  
   197                                      ; CR14: BRGの動作許可とソース設定
   198 000000F4 B00E                        mov al, 14
   199 000000F6 B307                        mov bl, 0x07        ; BRGを動作させるソースクロックとして、システムクロック（CLK）を選択,送受信BRGカウント有効
   200 000000F8 E81600                      call mpsc_write_both
   201                                  
   202                                      ; CR10: データエンコーディングなどの設定
   203 000000FB B00A                        mov al, 10
   204 000000FD B300                        mov bl, 0x00        ; データフォーマットとしてNRZ方式を選択
   205 000000FF E80F00                      call mpsc_write_both
   206                                  
   207                                      ; CR3: 受信動作の有効化
   208 00000102 B003                        mov al, 3
   209 00000104 B3C1                        mov bl, 0xC1        ; データ 8bit，受信イネーブル
   210 00000106 E80800                      call mpsc_write_both
   211                                      
   212                                      ; CR5: 送信動作の有効化とモデム制御ピンのアサート
   213 00000109 B005                        mov al, 5
   214 0000010B B3EA                        mov bl, 0xEA        ; データ 8bit，送信イネーブル
   215 0000010D E80100                      call mpsc_write_both
   216                                      
   217 00000110 C3                          ret
   218                                  
   219                                  ; --- Helper: Write to both MPSC1 and MPSC2 ---
   220                                  ; Input: AL = Register Index, BL = Value
   221                                  mpsc_write_both:
   222                                      ; MPSC1
   223 00000111 BAA200                      mov dx, MPSC1_A_CTRL
   224 00000114 EE                          out dx, al          ; Write Index
   225 00000115 86C3                        xchg al, bl
   226 00000117 EE                          out dx, al          ; Write Data
   227 00000118 86C3                        xchg al, bl
   228                                  
   229 0000011A BAAA00                      mov dx, MPSC2_A_CTRL
   230 0000011D EE                          out dx, al          ; Write Index
   231 0000011E 86C3                        xchg al, bl
   232 00000120 EE                          out dx, al          ; Write Data
   233 00000121 86C3                        xchg al, bl
   234                                  
   235                                      ; MPSC2
   236 00000123 BAA600                      mov dx, MPSC1_B_CTRL
   237 00000126 EE                          out dx, al          ; Write Index
   238 00000127 86C3                        xchg al, bl
   239 00000129 EE                          out dx, al          ; Write Data
   240 0000012A 86C3                        xchg al, bl
   241                                  
   242 0000012C BAAE00                      mov dx, MPSC2_B_CTRL
   243 0000012F EE                          out dx, al          ; Write Index
   244 00000130 86C3                        xchg al, bl
   245 00000132 EE                          out dx, al          ; Write Data
   246 00000133 86C3                        xchg al, bl
   247                                  
   248 00000135 C3                          ret
   249                                      
