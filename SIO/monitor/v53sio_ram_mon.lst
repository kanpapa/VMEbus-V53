  1210                                  ; --------------------------------------------------
  1211                                  ;  V53 CPUシステムレジスタ初期化
  1212                                  ; --------------------------------------------------
  1213                                  v53_sysreg_init:
  1214 000005FB BE[1206]                    mov si, TABLE_V53_REG
  1215                                  .next:
  1216 000005FE 2E8B14                      mov dx, [cs:si]      ; Port Number (16bit)
  1217 00000601 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1218 00000604 740A                        je .done
  1219 00000606 2E8A4402                    mov al, [cs:si+2]    ; Value (8bit)
  1220 0000060A EE                          out dx, al
  1221 0000060B 83C603                      add si, 3
  1222 0000060E EBEE                        jmp .next
  1223                                  .done:
  1224 00000610 C3                          ret
  1225                                  
  1226                                  ; V53システムレジスタ設定テーブル
  1227 00000611 90                      ALIGN 2
  1228                                  TABLE_V53_REG:
  1229 00000612 FEFF00                      db 0xFE, 0xFF, 0x00     ; FFFE (SCTL) = 00h 16bit I/O boundary
  1230 00000615 FDFF06                      db 0xFD, 0xFF, 0x06     ; FFFD (OPSEL)= 06h Enable ICU,TCU  Disable DMAU,SCU
  1231 00000618 FCFF00                      db 0xFC, 0xFF, 0x00     ; FFFC (OPHA) = 00h
  1232 0000061B FBFFE0                      db 0xFB, 0xFF, 0xE0     ; FFFB (DULA) = E0h DCU:00E0h
  1233 0000061E FAFFC0                      db 0xFA, 0xFF, 0xC0     ; FFFA (IULA) = C0h ICU:00C0h
  1234 00000621 F9FFD0                      db 0xF9, 0xFF, 0xD0     ; FFF9 (TULA) = D0h TCU:00D0h
  1235 00000624 F8FFF0                      db 0xF8, 0xFF, 0xF0     ; FFF8 (SULA) = F0h SCU:00F0h
  1236 00000627 EAFF00                      db 0xEA, 0xFF, 0x00     ; FFEA (WMB0) = 00h
  1237 0000062A EBFF00                      db 0xEB, 0xFF, 0x00     ; FFEB (WCY1) = 00h
  1238 0000062D ECFF00                      db 0xEC, 0xFF, 0x00     ; FFEC (WCY0) = 00h
  1239 00000630 F3FF73                      db 0xF3, 0xFF, 0x73     ; FFF3 (WMB1) = 73h
  1240 00000633 EDFF00                      db 0xED, 0xFF, 0x00     ; FFED (WAC)  = 00h
  1241 00000636 F4FF10                      db 0xF4, 0xFF, 0x10     ; FFF4 (WCY2) = 10h
  1242 00000639 F5FF22                      db 0xF5, 0xFF, 0x22     ; FFF5 (WCY3) = 22h
  1243 0000063C F6FF10                      db 0xF6, 0xFF, 0x10     ; FFF6 (WCY4) = 10h
  1244 0000063F F2FF00                      db 0xF2, 0xFF, 0x00     ; FFF2 (RFC)  = 00h
  1245 00000642 E9FF00                      db 0xE9, 0xFF, 0x00     ; FFE9 (BRC)  = 00h
  1246 00000645 F0FF02                      db 0xF0, 0xFF, 0x02     ; FFF0 (TCKS) = 02h
  1247 00000648 F1FF00                      db 0xF1, 0xFF, 0x00     ; FFF1 (SBCR) = 00h
  1248 0000064B FFFFFF                      db 0xFF, 0xFF, 0xFF     ; 終端マーカー
  1249                                  
  1250                                  ; --------------------------------------------------
  1251                                  ; TCU (タイマーユニット) 初期化
  1252                                  ; --------------------------------------------------
  1253                                  v53_tcu_init:
  1254 0000064E BE[7006]                    mov si, TABLE_TCU_REG
  1255                                  .next:
  1256 00000651 2E8B14                      mov dx, [cs:si]      ; Port1 (16bit)
  1257 00000654 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1258 00000657 7416                        je .done
  1259 00000659 2E8A4402                    mov al, [cs:si+2]    ; Val1 (8bit)
  1260 0000065D EE                          out dx, al
  1261 0000065E 2E8B5403                    mov dx, [cs:si+3]    ; Port2 (16bit)
  1262 00000662 2E8B4405                    mov ax, [cs:si+5]    ; Val2 (16bit)
  1263 00000666 EE                          out dx, al           ; Port2 Low
  1264 00000667 88E0                        mov al, ah
  1265 00000669 EE                          out dx, al           ; Port2 High
  1266 0000066A 83C607                      add si, 7
  1267 0000066D EBE2                        jmp .next
  1268                                  .done:
  1269 0000066F C3                          ret
  1270                                  
  1271                                  ; TCU タイマー設定テーブル
  1272                                  ALIGN 2
  1273                                  TABLE_TCU_REG:
  1274                                      ; Port1, Val1, Port2, Val2(16)
  1275 00000670 D60036D000204E              db 0xD6, 0x00, 0x36, 0xD0, 0x00, 0x20, 0x4E ; T0設定
  1276 00000677 D60070D200050D              db 0xD6, 0x00, 0x70, 0xD2, 0x00, 0x05, 0x0D ; T0最大値A
  1277 0000067E D600B0D400050D              db 0xD6, 0x00, 0xB0, 0xD4, 0x00, 0x05, 0x0D ; T0最大値B
  1278 00000685 FFFF                        db 0xFF, 0xFF           ; 終端マーカー
  1279                                  
  1280                                  ; ---------------------------------------------------
  1281                                  ; 物理IOの初期化
  1282                                  ; ---------------------------------------------------
  1283                                  dve554_io_init:
  1284 00000687 B000                        mov al, 0x00
  1285 00000689 BA8600                      mov dx, 0x0086
  1286 0000068C EE                          out dx, al
  1287 0000068D BA8200                      mov dx, 0x0082
  1288 00000690 EE                          out dx, al
  1289 00000691 BA8000                      mov dx, 0x0080
  1290 00000694 EE                          out dx, al
  1291 00000695 C3                          ret
  1292                                  
  1293                                  ; ---------------------------------------
  1294                                  ; V53 ICUの初期化
  1295                                  ; ---------------------------------------
  1296                                  v53_icu_init:
  1297 00000696 BE[AC06]                        MOV SI, TABLE_V53_ICU	;I/O設定テーブルの先頭を指定
  1298                                  .loop:
  1299 00000699 2E8B14                          MOV DX, CS:[SI]	        ;テーブルからポート番号(Word)をロード
  1300 0000069C 83FAFF                          CMP DX, 0FFFFh	        ;終端マーカー（FFFFh）かチェック
  1301 0000069F 740A                            JZ .done	            ;終端なら終了（RETへ）
  1302 000006A1 2E8A4402                        MOV AL, CS:[SI+02]	    ;設定値(Byte)をロード
  1303 000006A5 EE                              OUT DX, AL	            ;ポートへ出力
  1304 000006A6 83C603                          ADD SI, 3	            ;次のエントリ（3バイト後）へ
  1305 000006A9 EBEE                            JMP .loop	            ;ループ
  1306                                  .done:
  1307 000006AB C3                              RET
  1308                                  
  1309                                  ALIGN 2
  1310                                  TABLE_V53_ICU:
  1311 000006AC C000                        DW ICU_REG0
  1312 000006AE 11                          DB 0x11    ; IIW1: 00010001b (Edge Trigger, カスケード拡張モード, IIW4有効)
  1313 000006AF C200                        DW ICU_REG1  
  1314 000006B1 20                          DB 0x20    ; IIW2: 00100000b (Vector Offset = 20h (INT 32))
  1315 000006B2 C200                        DW ICU_REG1
  1316 000006B4 30                          DB 0x30    ; IIW3: 00110000b (INTP4, INTP5はスレーブ接続)
  1317 000006B5 C200                        DW ICU_REG1
  1318 000006B7 03                          DB 0x03    ; IIW4: 00000011b (通常ネストモード、セルフFIモード)
  1319 000006B8 C200                        DW ICU_REG1
  1320 000006BA CE                          DB 0xCE    ; IMKW: 11001110b (INTP4, INTP5, INTP0以外はマスクする)     
  1321 000006BB FFFF                        DW 0x0FFFF
  1322                                  
  1323                                  ; =============================================================
  1324                                  ; uPD72001 (MPSC) 初期化シーケンス
  1325                                  ; CPU: 8086
  1326                                  ; 対象: MPSC #1 / MPSC #2  各チャンネルA/B
  1327                                  ;
  1328                                  ; 設定内容:
  1329                                  ;   非同期モード, 9600bps (BRGカウント=0x001E, CLK=x16),
  1330                                  ;   8データビット, ストップビット1, パリティなし
  1331                                  ;   全受信文字割り込み有効 (WR9 MIE有効)
  1332                                  ;   割り込みベクタベース = 10h (チャンネルB WR2)
  1333                                  ; =============================================================
  1334                                   
  1335                                  ; =============================================================
  1336                                  ; mpsc_init  - MPSCメイン初期化ルーチン
  1337                                  ; 入力: なし / 破壊: AX, BX, CX, DX
  1338                                  ; =============================================================
  1339                                  mpsc_init:
  1340                                      ; =========================================================
  1341                                      ; Phase 1: ポインタリセット → チャンネルリセット
  1342                                      ; WR0 ポインタを確実に0にしてからChannel Resetを発行する
  1343                                      ; =========================================================
  1344                                   
  1345                                      ; --- MPSC#1 チャンネルA ---
  1346 000006BD BAA200                      mov     dx, MPSC1_A_CTRL
  1347 000006C0 B000                        mov     al, 00h
  1348 000006C2 EE                          out     dx, al              ; WR0選択（ポインタリセット）
  1349 000006C3 B018                        mov     al, 18h             ; Channel Reset コマンド
  1350 000006C5 EE                          out     dx, al
  1351                                   
  1352                                      ; --- MPSC#2 チャンネルA ---
  1353 000006C6 BAAA00                      mov     dx, MPSC2_A_CTRL
  1354 000006C9 B000                        mov     al, 00h
  1355 000006CB EE                          out     dx, al              ; WR0選択（ポインタリセット）
  1356 000006CC B018                        mov     al, 18h
  1357 000006CE EE                          out     dx, al
  1358                                   
  1359                                      ; --- MPSC#1 チャンネルB ---
  1360 000006CF BAA600                      mov     dx, MPSC1_B_CTRL
  1361 000006D2 B000                        mov     al, 00h
  1362 000006D4 EE                          out     dx, al
  1363 000006D5 B018                        mov     al, 18h
  1364 000006D7 EE                          out     dx, al
  1365                                   
  1366                                      ; --- MPSC#2 チャンネルB ---
  1367 000006D8 BAAE00                      mov     dx, MPSC2_B_CTRL
  1368 000006DB B000                        mov     al, 00h
  1369 000006DD EE                          out     dx, al
  1370 000006DE B018                        mov     al, 18h
  1371 000006E0 EE                          out     dx, al
  1372                                   
  1373                                      ; リセット後安定待ち（約100ループ）
  1374 000006E1 B96400                      mov     cx, 100
  1375                                  .wait_reset:
  1376 000006E4 90                          nop
  1377 000006E5 90                          nop
  1378 000006E6 90                          nop
  1379 000006E7 E2FB                        loop    .wait_reset
  1380                                   
  1381                                      ; =========================================================
  1382                                      ; Phase 2: WR4 - 送受信共通フォーマット設定
  1383                                      ; 非同期モード, x16クロック, ストップビット1, パリティなし
  1384                                      ; WR4 = 44h: D7-D6=00(パリティなし), D5-D4=01(1stop),
  1385                                      ;             D3-D2=00(Async), D1-D0=01(x16)
  1386                                      ; ※ WR4はWR3/WR5より先に設定すること
  1387                                      ; =========================================================
  1388 000006E9 B004                        mov     al, 4
  1389 000006EB B344                        mov     bl, 44h
  1390 000006ED E88500                      call    mpsc_write_both_ab  ; 全チャンネル(A/B両方)に書き込み
  1391                                   
  1392                                      ; =========================================================
  1393                                      ; Phase 3: WR1 - 割り込み/DMA設定
  1394                                      ; WR1 = 10h: D4-D3=10(全受信文字で割り込み),
  1395                                      ;            D1=0(送信割り込み禁止), D0=0(外部割り込み禁止)
  1396                                      ; =========================================================
  1397 000006F0 B001                        mov     al, 1
  1398 000006F2 B310                        mov     bl, 10h
  1399 000006F4 E87E00                      call    mpsc_write_both_ab
  1400                                   
  1401                                      ; =========================================================
  1402                                      ; Phase 4: WR2 - 割り込みベクタ設定（チャンネルBのみ有効）
  1403                                      ; ベクタベース = 10h
  1404                                      ; チャンネルAへの書き込みは無効だが、対称性のため実施
  1405                                      ; =========================================================
  1406                                   
  1407                                      ; MPSC#1 チャンネルB WR2
  1408 000006F7 BAA600                      mov     dx, MPSC1_B_CTRL
  1409 000006FA B002                        mov     al, 02h
  1410 000006FC EE                          out     dx, al              ; WR2選択
  1411 000006FD B010                        mov     al, 10h             ; ベクタベース
  1412 000006FF EE                          out     dx, al
  1413                                   
  1414                                      ; MPSC#2 チャンネルB WR2
  1415 00000700 BAAE00                      mov     dx, MPSC2_B_CTRL
  1416 00000703 B002                        mov     al, 02h
  1417 00000705 EE                          out     dx, al
  1418 00000706 B010                        mov     al, 10h
  1419 00000708 EE                          out     dx, al
  1420                                   
  1421                                      ; =========================================================
  1422                                      ; Phase 5: WR9 - マスターインタラプトコントロール
  1423                                      ; WR9はチャンネルA/B共通レジスタ。どちらから書いても同じ。
  1424                                      ; WR9 = 08h: MIE=1(マスタ割り込み有効), NV=0, DLC=0
  1425                                      ; =========================================================
  1426 00000709 BAA200                      mov     dx, MPSC1_A_CTRL
  1427 0000070C B009                        mov     al, 09h             ; WR9選択
  1428 0000070E EE                          out     dx, al
  1429 0000070F B008                        mov     al, 08h             ; MIE=1
  1430 00000711 EE                          out     dx, al
  1431                                   
  1432 00000712 BAAA00                      mov     dx, MPSC2_A_CTRL
  1433 00000715 B009                        mov     al, 09h
  1434 00000717 EE                          out     dx, al
  1435 00000718 B008                        mov     al, 08h
  1436 0000071A EE                          out     dx, al
  1437                                   
  1438                                      ; =========================================================
  1439                                      ; Phase 6: WR10 - データエンコーディング
  1440                                      ; WR10 = 00h: NRZ, CRC無効
  1441                                      ; =========================================================
  1442 0000071B B00A                        mov     al, 10
  1443 0000071D B300                        mov     bl, 00h
  1444 0000071F E85300                      call    mpsc_write_both_ab
  1445                                   
  1446                                      ; =========================================================
  1447                                      ; Phase 7: WR12/WR13 - BRGタイムコンスタント設定
  1448                                      ; ボーレート9600bps, CLKソース, x16分周の場合:
  1449                                      ;   カウント値 = 0x001E (30)
  1450                                      ; WR12: タイムコンスタント下位8ビット
  1451                                      ; WR13: タイムコンスタント上位8ビット
  1452                                      ; ※ WR12とWR13は別々にWR0でアドレス指定して書き込む
  1453                                      ; =========================================================
  1454                                   
  1455                                      ; --- MPSC#1 チャンネルA ---
  1456 00000722 BAA200                      mov     dx, MPSC1_A_CTRL
  1457 00000725 B00C                        mov     al, 12
  1458 00000727 EE                          out     dx, al          ; WR12選択
  1459 00000728 B001                        mov     al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1460 0000072A EE                          out     dx, al
  1461 0000072B B01E                        mov     al, 0x1e        ; 下位バイトの値
  1462 0000072D EE                          out     dx, al
  1463 0000072E B000                        mov     al, 0x00        ; 上位バイトの値
  1464 00000730 EE                          out     dx, al
  1465                                   
  1466 00000731 B00C                        mov     al, 12          ; Select CR12
  1467 00000733 EE                          out     dx, al
  1468 00000734 B002                        mov     al, 2           ; 送信BRGレジスタセットモード有効
  1469 00000736 EE                          out     dx, al
  1470 00000737 B01E                        mov     al, 0x1e        ; 下位バイトの値
  1471 00000739 EE                          out     dx, al
  1472 0000073A B000                        mov     al, 0x00        ; 上位バイトの値
  1473 0000073C EE                          out     dx, al
  1474                                  
  1475                                      ; --- MPSC#2 チャンネルA ---
  1476 0000073D BAAA00                      mov     dx, MPSC2_A_CTRL
  1477 00000740 B00C                        mov     al, 12
  1478 00000742 EE                          out     dx, al
  1479 00000743 B001                        mov     al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1480 00000745 EE                          out     dx, al
  1481 00000746 B01E                        mov     al, 0x1e        ; 下位バイトの値
  1482 00000748 EE                          out     dx, al
  1483 00000749 B000                        mov     al, 0x00        ; 上位バイトの値
  1484 0000074B EE                          out     dx, al
  1485                                  
  1486 0000074C B00C                        mov     al, 12          ; Select CR12
  1487 0000074E EE                          out     dx, al
  1488 0000074F B002                        mov     al, 2           ; 送信BRGレジスタセットモード有効
  1489 00000751 EE                          out     dx, al
  1490 00000752 B01E                        mov     al, 0x1e        ; 下位バイトの値
  1491 00000754 EE                          out     dx, al
  1492 00000755 B000                        mov     al, 0x00        ; 上位バイトの値
  1493 00000757 EE                          out     dx, al
  1494                                   
  1495                                      ; =========================================================
  1496                                      ; Phase 8: WR15 - クロックソースとピン機能選択
  1497                                      ; WR15 = 56h: DPLL入力はBRG, RTSCとTTLCはBRG出力
  1498                                      ; =========================================================
  1499 00000758 B00F                        mov     al, 15
  1500 0000075A B356                        mov     bl, 56h
  1501 0000075C E81600                      call    mpsc_write_both_ab
  1502                                   
  1503                                      ; =========================================================
  1504                                      ; Phase 9: WR14 - BRG動作許可
  1505                                      ; WR14 = 07h: BRGソース=システムCLK, 送受信BRGカウント有効
  1506                                      ; D2=1(BR CLK=SYS CLK), D1=1(送信BRG有効), D0=1(受信BRG有効)
  1507                                      ; =========================================================
  1508 0000075F B00E                        mov     al, 14
  1509 00000761 B307                        mov     bl, 07h
  1510 00000763 E80F00                      call    mpsc_write_both_ab
  1511                                   
  1512                                      ; =========================================================
  1513                                      ; Phase 10: WR3 - 受信設定・イネーブル
  1514                                      ; WR3 = C1h: D7-D6=11(8ビット受信), D0=1(受信イネーブル)
  1515                                      ; =========================================================
  1516 00000766 B003                        mov     al, 3
  1517 00000768 B3C1                        mov     bl, 0C1h
  1518 0000076A E80800                      call    mpsc_write_both_ab
  1519                                   
  1520                                      ; =========================================================
  1521                                      ; Phase 11: WR5 - 送信設定・イネーブル
  1522                                      ; WR5 = EAh: D7=1(DTRアサート), D6-D5=11(8ビット送信),
  1523                                      ;            D3=1(送信イネーブル), D1=1(RTSアサート)
  1524                                      ; DTR/RTSを初期からアサートしない場合は 68h を使用:
  1525                                      ;   WR5 = 68h: D6-D5=11(8ビット), D3=1(TX EN), DTR/RTS=0
  1526                                      ; =========================================================
  1527 0000076D B005                        mov     al, 5
  1528 0000076F B3EA                        mov     bl, 0EAh
  1529 00000771 E80100                      call    mpsc_write_both_ab
  1530                                   
  1531 00000774 C3                          ret
  1532                                   
  1533                                  ; =============================================================
  1534                                  ; mpsc_write_both_ab
  1535                                  ;   MPSC#1/#2 の チャンネルA/B 全4ポートに同じレジスタ値を書く
  1536                                  ;   入力: AL = レジスタ番号(WR番号)
  1537                                  ;         BL = 書き込み値
  1538                                  ;   破壊: AX, DX
  1539                                  ; =============================================================
  1540                                  mpsc_write_both_ab:
  1541                                      ; MPSC#1 チャンネルA
  1542 00000775 BAA200                      mov     dx, MPSC1_A_CTRL
  1543 00000778 EE                          out     dx, al              ; レジスタ選択
  1544 00000779 86C3                        xchg    al, bl
  1545 0000077B EE                          out     dx, al              ; データ書き込み
  1546 0000077C 86C3                        xchg    al, bl
  1547                                   
  1548                                      ; MPSC#1 チャンネルB
  1549 0000077E BAA600                      mov     dx, MPSC1_B_CTRL
  1550 00000781 EE                          out     dx, al
  1551 00000782 86C3                        xchg    al, bl
  1552 00000784 EE                          out     dx, al
  1553 00000785 86C3                        xchg    al, bl
  1554                                   
  1555                                      ; MPSC#2 チャンネルA
  1556 00000787 BAAA00                      mov     dx, MPSC2_A_CTRL
  1557 0000078A EE                          out     dx, al
  1558 0000078B 86C3                        xchg    al, bl
  1559 0000078D EE                          out     dx, al
  1560 0000078E 86C3                        xchg    al, bl
  1561                                   
  1562                                      ; MPSC#2 チャンネルB
  1563 00000790 BAAE00                      mov     dx, MPSC2_B_CTRL
  1564 00000793 EE                          out     dx, al
  1565 00000794 86C3                        xchg    al, bl
  1566 00000796 EE                          out     dx, al
  1567 00000797 86C3                        xchg    al, bl
  1568                                   
  1569 00000799 C3                          ret
  1570                                   
  1571                                  ; =============================================================
  1572                                  ; 旧 mpsc_write_both（チャンネルAのみ。互換性のため残す）
  1573                                  ;   入力: AL = レジスタ番号, BL = 書き込み値
  1574                                  ; =============================================================
  1575                                  mpsc_write_both:
  1576 0000079A BAA200                      mov     dx, MPSC1_A_CTRL
  1577 0000079D EE                          out     dx, al
  1578 0000079E 86C3                        xchg    al, bl
  1579 000007A0 EE                          out     dx, al
  1580 000007A1 86C3                        xchg    al, bl
  1581                                   
  1582 000007A3 BAAA00                      mov     dx, MPSC2_A_CTRL
  1583 000007A6 EE                          out     dx, al
  1584 000007A7 86C3                        xchg    al, bl
  1585 000007A9 EE                          out     dx, al
  1586 000007AA 86C3                        xchg    al, bl
  1587                                   
  1588 000007AC C3                          ret
  1589                                  
