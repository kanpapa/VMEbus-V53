  1346                                  ; --------------------------------------------------
  1347                                  ;  V53 システムレジスタ初期化
  1348                                  ; --------------------------------------------------
  1349                                  v53_sysreg_init:
  1350 00000683 BE[DE07]                    mov si, TABLE_V53_REG
  1351                                  .next:
  1352 00000686 2E8B14                      mov dx, [cs:si]      ; Port Number (16bit)
  1353 00000689 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1354 0000068C 740A                        je .done
  1355 0000068E 2E8A4402                    mov al, [cs:si+2]    ; Value (8bit)
  1356 00000692 EE                          out dx, al
  1357 00000693 83C603                      add si, 3
  1358 00000696 EBEE                        jmp .next
  1359                                  .done:
  1360 00000698 C3                          ret
  1361                                  
  1362                                  ; --------------------------------------------------
  1363                                  ; TCU (タイマーユニット) 初期化
  1364                                  ; --------------------------------------------------
  1365                                  v53_tcu_init:
  1366 00000699 BE[1A08]                    mov si, TABLE_TCU_REG
  1367                                  .next:
  1368 0000069C 2E8B14                      mov dx, [cs:si]      ; Port1 (16bit)
  1369 0000069F 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1370 000006A2 7416                        je .done
  1371 000006A4 2E8A4402                    mov al, [cs:si+2]    ; Val1 (8bit)
  1372 000006A8 EE                          out dx, al
  1373 000006A9 2E8B5403                    mov dx, [cs:si+3]    ; Port2 (16bit)
  1374 000006AD 2E8B4405                    mov ax, [cs:si+5]    ; Val2 (16bit)
  1375 000006B1 EE                          out dx, al           ; Port2 Low
  1376 000006B2 88E0                        mov al, ah
  1377 000006B4 EE                          out dx, al           ; Port2 High
  1378 000006B5 83C607                      add si, 7
  1379 000006B8 EBE2                        jmp .next
  1380                                  .done:
  1381 000006BA C3                          ret
  1382                                  
  1383                                  ; ---------------------------------------------------
  1384                                  ; 物理IOの初期化
  1385                                  ; ---------------------------------------------------
  1386                                  dve554_io_init:
  1387 000006BB B000                        mov al, 0x00
  1388 000006BD BA8600                      mov dx, 0x0086
  1389 000006C0 EE                          out dx, al
  1390 000006C1 BA8200                      mov dx, 0x0082
  1391 000006C4 EE                          out dx, al
  1392 000006C5 BA8000                      mov dx, 0x0080
  1393 000006C8 EE                          out dx, al
  1394 000006C9 C3                          ret
  1395                                  
  1396                                  ; ---------------------------------------------------
  1397                                  ; MPSC1/2 初期化シーケンス
  1398                                  ; ---------------------------------------------------
  1399                                  mpsc_init:
  1400                                  ; --- [Phase 1: Hardware Reset] ---
  1401                                  ;   MPSC #1のチャネルA/Bに対して、リセットシーケンスを実行
  1402 000006CA BAA200                      mov dx, MPSC1_A_CTRL
  1403 000006CD B000                        mov al, 0
  1404 000006CF EE                          out dx, al          ; Pointer Reset 1
  1405 000006D0 EE                          out dx, al          ; Pointer Reset 2 
  1406                                  
  1407 000006D1 BAA600                      mov dx, MPSC1_B_CTRL
  1408 000006D4 B000                        mov al, 0
  1409 000006D6 EE                          out dx, al          ; Pointer Reset 1 
  1410 000006D7 EE                          out dx, al          ; Pointer Reset 2 
  1411                                  
  1412                                      ; Channel Reset (CR0: 0x18)
  1413 000006D8 BAA200                      mov dx, MPSC1_A_CTRL
  1414 000006DB B018                        mov al, 0x18        ; Channel Reset command 
  1415 000006DD EE                          out dx, al          ; Direct Write to WR0
  1416                                  
  1417 000006DE BAA600                      mov dx, MPSC1_B_CTRL
  1418 000006E1 B018                        mov al, 0x18
  1419 000006E3 EE                          out dx, al
  1420                                      
  1421                                      ; MPSC #2のチャネルA/Bに対しても同様のリセットシーケンスを実行
  1422 000006E4 BAAA00                      mov dx, MPSC2_A_CTRL
  1423 000006E7 B000                        mov al, 0
  1424 000006E9 EE                          out dx, al          ; Pointer Reset 1
  1425 000006EA EE                          out dx, al          ; Pointer Reset 2 
  1426                                  
  1427 000006EB BAAE00                      mov dx, MPSC2_B_CTRL
  1428 000006EE B000                        mov al, 0
  1429 000006F0 EE                          out dx, al          ; Pointer Reset 1 
  1430 000006F1 EE                          out dx, al          ; Pointer Reset 2 
  1431                                  
  1432                                      ; Channel Reset (CR0: 0x18)
  1433 000006F2 BAAA00                      mov dx, MPSC2_A_CTRL
  1434 000006F5 B018                        mov al, 0x18        ; Channel Reset command 
  1435 000006F7 EE                          out dx, al          ; Direct Write to WR0
  1436                                  
  1437 000006F8 BAAE00                      mov dx, MPSC2_B_CTRL
  1438 000006FB B018                        mov al, 0x18
  1439 000006FD EE                          out dx, al
  1440                                  
  1441                                      ; リセット後の安定待ち
  1442 000006FE B96400                      mov cx, 100
  1443                                  .wait_res:
  1444 00000701 90                          nop
  1445 00000702 90                          nop
  1446 00000703 90                          nop
  1447 00000704 E2FB                        loop .wait_res
  1448                                  
  1449                                      ; CR4: 送受信共通の動作設定
  1450 00000706 B004                        mov al, 4
  1451 00000708 B344                        mov bl, 0x44        ; x16, Async, ストップビット 1bit，パリティなし
  1452 0000070A E8AC00                      call mpsc_write_both
  1453                                  
  1454                                      ; CR2: システム全体の構成（割り込み/DMAモードや優先順位）を設定
  1455                                      ; CR2B
  1456 0000070D BAA600                      mov dx, MPSC1_B_CTRL       ; MPSC #1 Ch.B Control Port
  1457 00000710 B002                        mov al, 02h                ; CR2Bを選択
  1458 00000712 EE                          out dx, al
  1459 00000713 B010                        mov al, 10h         ; ベクタベースを 10h に設定
  1460 00000715 EE                          out dx, al
  1461                                  
  1462                                      ; CR1: バスインターフェース、割り込みおよびDMAの設定
  1463 00000716 B001                        mov al, 1
  1464                                      ;mov bl, 0x00       ; すべての割り込みとDMAを無効化
  1465 00000718 B312                        mov bl, 12h         ; D4-D3=10: 全受信文字で割り込み
  1466                                                          ; D1=1: 送信割り込み有効
  1467                                                          ; D0=0: 外部要因(E/S)割り込み無効
  1468 0000071A E89C00                      call mpsc_write_both
  1469                                      
  1470                                      ; CR12: ボーレートジェネレータ（BRG）の割り込みとレジスタ書き込み設定 
  1471                                      ; MPSC #1のチャネルA/Bに対して、BRGレジスタセットモードを有効化し、ボーレートの値を設定
  1472 0000071D BAA200                      mov dx, MPSC1_A_CTRL
  1473 00000720 B00C                        mov al, 12          ; Select CR12
  1474 00000722 EE                          out dx, al
  1475 00000723 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1476 00000725 EE                          out dx, al
  1477 00000726 B01E                        mov al, 0x1e        ; 下位バイトの値
  1478 00000728 EE                          out dx, al
  1479 00000729 B000                        mov al, 0x00        ; 上位バイトの値
  1480 0000072B EE                          out dx, al
  1481                                      
  1482 0000072C BAA600                      mov dx, MPSC1_B_CTRL
  1483 0000072F B00C                        mov al, 12          ; Select CR12
  1484 00000731 EE                          out dx, al
  1485 00000732 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1486 00000734 EE                          out dx, al
  1487 00000735 B01E                        mov al, 0x1e        ; 下位バイトの値
  1488 00000737 EE                          out dx, al
  1489 00000738 B000                        mov al, 0x00        ; 上位バイトの値
  1490 0000073A EE                          out dx, al
  1491                                      
  1492 0000073B BAA200                      mov dx, MPSC1_A_CTRL
  1493 0000073E B00C                        mov al, 12          ; Select CR12
  1494 00000740 EE                          out dx, al
  1495 00000741 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1496 00000743 EE                          out dx, al
  1497 00000744 B01E                        mov al, 0x1e        ; 下位バイトの値
  1498 00000746 EE                          out dx, al
  1499 00000747 B000                        mov al, 0x00        ; 上位バイトの値
  1500 00000749 EE                          out dx, al
  1501                                      
  1502 0000074A BAA600                      mov dx, MPSC1_B_CTRL
  1503 0000074D B00C                        mov al, 12          ; Select CR12
  1504 0000074F EE                          out dx, al
  1505 00000750 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1506 00000752 EE                          out dx, al
  1507 00000753 B01E                        mov al, 0x1e        ; 下位バイトの値
  1508 00000755 EE                          out dx, al
  1509 00000756 B000                        mov al, 0x00        ; 上位バイトの値
  1510 00000758 EE                          out dx, al
  1511                                  
  1512                                      ; MPSC #2のチャネルA/Bに対して、BRGレジスタセットモードを有効化し、ボーレートの値を設定
  1513 00000759 BAAA00                      mov dx, MPSC2_A_CTRL
  1514 0000075C B00C                        mov al, 12          ; Select CR12
  1515 0000075E EE                          out dx, al
  1516 0000075F B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1517 00000761 EE                          out dx, al
  1518 00000762 B01E                        mov al, 0x1e        ; 下位バイトの値
  1519 00000764 EE                          out dx, al
  1520 00000765 B000                        mov al, 0x00        ; 上位バイトの値
  1521 00000767 EE                          out dx, al
  1522                                      
  1523 00000768 BAAE00                      mov dx, MPSC2_B_CTRL
  1524 0000076B B00C                        mov al, 12          ; Select CR12
  1525 0000076D EE                          out dx, al
  1526 0000076E B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1527 00000770 EE                          out dx, al
  1528 00000771 B01E                        mov al, 0x1e        ; 下位バイトの値
  1529 00000773 EE                          out dx, al
  1530 00000774 B000                        mov al, 0x00        ; 上位バイトの値
  1531 00000776 EE                          out dx, al
  1532                                      
  1533 00000777 BAAA00                      mov dx, MPSC2_A_CTRL
  1534 0000077A B00C                        mov al, 12          ; Select CR12
  1535 0000077C EE                          out dx, al
  1536 0000077D B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1537 0000077F EE                          out dx, al
  1538 00000780 B01E                        mov al, 0x1e        ; 下位バイトの値
  1539 00000782 EE                          out dx, al
  1540 00000783 B000                        mov al, 0x00        ; 上位バイトの値
  1541 00000785 EE                          out dx, al
  1542                                      
  1543 00000786 BAAE00                      mov dx, MPSC2_B_CTRL
  1544 00000789 B00C                        mov al, 12          ; Select CR12
  1545 0000078B EE                          out dx, al
  1546 0000078C B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1547 0000078E EE                          out dx, al
  1548 0000078F B01E                        mov al, 0x1e        ; 下位バイトの値
  1549 00000791 EE                          out dx, al
  1550 00000792 B000                        mov al, 0x00        ; 上位バイトの値
  1551 00000794 EE                          out dx, al
  1552                                  
  1553                                      ; CR15: クロックソースとピン機能の選択
  1554 00000795 B00F                        mov al, 15
  1555 00000797 B356                        mov bl, 0x56        ; ボーレートジェネレータ使用
  1556 00000799 E81D00                      call mpsc_write_both
  1557                                  
  1558                                      ; CR14: BRGの動作許可とソース設定
  1559 0000079C B00E                        mov al, 14
  1560 0000079E B307                        mov bl, 0x07        ; BRGを動作させるソースクロックとして、システムクロック（CLK）を選択,送受信BRGカウント有効
  1561 000007A0 E81600                      call mpsc_write_both
  1562                                  
  1563                                      ; CR10: データエンコーディングなどの設定
  1564 000007A3 B00A                        mov al, 10
  1565 000007A5 B300                        mov bl, 0x00        ; データフォーマットとしてNRZ方式を選択
  1566 000007A7 E80F00                      call mpsc_write_both
  1567                                  
  1568                                      ; CR3: 受信動作の有効化
  1569 000007AA B003                        mov al, 3
  1570 000007AC B3C1                        mov bl, 0xC1        ; データ 8bit，受信イネーブル
  1571 000007AE E80800                      call mpsc_write_both
  1572                                      
  1573                                      ; CR5: 送信動作の有効化とモデム制御ピンのアサート
  1574 000007B1 B005                        mov al, 5
  1575 000007B3 B3EA                        mov bl, 0xEA        ; データ 8bit，送信イネーブル
  1576 000007B5 E80100                      call mpsc_write_both
  1577                                      
  1578 000007B8 C3                          ret
  1579                                  
  1580                                  ; --- Helper: Write to both MPSC #1, MPSC #2 ---
  1581                                  ; Input: AL = Register Index, BL = Value
  1582                                  mpsc_write_both:
  1583                                      ; MPSC #1 A-CHANNEL
  1584 000007B9 BAA200                      mov dx, MPSC1_A_CTRL
  1585 000007BC EE                          out dx, al          ; Write Index
  1586 000007BD 86C3                        xchg al, bl
  1587 000007BF EE                          out dx, al          ; Write Data
  1588 000007C0 86C3                        xchg al, bl
  1589                                      
  1590                                      ; MPSC #1 B-CHANNEL
  1591 000007C2 BAA600                      mov dx, MPSC1_B_CTRL
  1592 000007C5 EE                          out dx, al          ; Write Index
  1593 000007C6 86C3                        xchg al, bl
  1594 000007C8 EE                          out dx, al          ; Write Data
  1595 000007C9 86C3                        xchg al, bl
  1596                                  
  1597                                      ; MPSC #2 A-CHANNEL
  1598 000007CB BAAA00                      mov dx, MPSC2_A_CTRL
  1599 000007CE EE                          out dx, al          ; Write Index
  1600 000007CF 86C3                        xchg al, bl
  1601 000007D1 EE                          out dx, al          ; Write Data
  1602 000007D2 86C3                        xchg al, bl
  1603                                      
  1604                                      ; MPSC #2 B-CHANNEL
  1605 000007D4 BAAE00                      mov dx, MPSC2_B_CTRL
  1606 000007D7 EE                          out dx, al          ; Write Index
  1607 000007D8 86C3                        xchg al, bl
  1608 000007DA EE                          out dx, al          ; Write Data
  1609 000007DB 86C3                        xchg al, bl
  1610                                  
  1611 000007DD C3                          ret
