   972                                  ; ---------------------------------------------------------
   973                                  ; INT 0x20 (INTP0) Timer0 (100Hz) 割り込みハンドラ
   974                                  ; ---------------------------------------------------------
   975                                  _isr_int0x20:
   976 000004C5 FA                          cli	                        ;割り込み禁止
