   983                                      ; --- 32bit カウンタのインクリメント ---
   984 000004CD FF06[A809]                  inc word [tick_counter_lo]
   985 000004D1 7504                        jnz .skip_carry
   986 000004D3 FF06[AA09]                  inc word [tick_counter_hi]
   987                                  .skip_carry:
   988                                      ; --- EOI (End of Interrupt) 発行 ---
   989                                      ; これを送らないと次の割り込みが発生しません
   990 000004D7 B020                        mov al, 0x20         ; Non-Specific EOI
   991 000004D9 BAC000                      mov dx, ICU_REG0
   992 000004DC EE                          out dx, al
   993                                  
   994 000004DD 5A                          pop dx
   995 000004DE 5B                          pop bx
   996 000004DF 58                          pop ax
   997 000004E0 FB                          sti	                        ;割り込み許可
   998 000004E1 CF                          iret	                    ;割り込み復帰
