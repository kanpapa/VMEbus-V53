  1357 00000623 50                          push ax
  1358 00000624 53                          push bx
  1359 00000625 52                          push dx
  1360                                  
  1361 00000626 FF06[D809]                  inc word [int0x35_flag]     ;割り込み発生フラグセット
  1362                                      
  1363 0000062A BAAA00                      mov dx, MPSC2_A_CTRL	    ;MPSC #2 コマンドポート 0x00AAを指定
  1364 0000062D B038                        mov al, 0x38
  1365 0000062F EE                          out dx, al	                ;ポートへ出力
  1366                                  
  1367 00000630 5A                          pop dx
  1368 00000631 5B                          pop bx
  1369 00000632 58                          pop ax
  1370 00000633 FB                          sti	                        ;割り込み許可
  1371 00000634 CF                          iret	                    ;割り込み復帰
  1372                                  
  1373                                  ; --------------------------------------
  1374                                  ; INT 0x36
  1375                                  ; --------------------------------------
  1376                                  _isr_int0x36:
  1377 00000635 FA                          cli	                        ;割り込み禁止
  1378 00000636 50                          push ax
  1379 00000637 53                          push bx
  1380 00000638 52                          push dx
  1381                                  
  1382 00000639 FF06[DA09]                  inc word [int0x36_flag]     ;割り込み発生フラグセット
  1383                                      
  1384 0000063D BAAA00                      mov dx, MPSC2_A_CTRL	    ;MPSC #2 コマンドポート 0x00AAを指定
  1385 00000640 B038                        mov al, 0x38
  1386 00000642 EE                          out dx, al	                ;ポートへ出力
  1387                                  
  1388 00000643 5A                          pop dx
  1389 00000644 5B                          pop bx
  1390 00000645 58                          pop ax
  1391 00000646 FB                          sti	                        ;割り込み許可
  1392 00000647 CF                          iret	                    ;割り込み復帰
  1393                                  
  1394                                  ; --------------------------------------
  1395                                  ; INT 0x37
  1396                                  ; --------------------------------------
  1397                                  _isr_int0x37:
  1398 00000648 FA                          cli	                        ;割り込み禁止
  1399 00000649 50                          push ax
  1400 0000064A 53                          push bx
  1401 0000064B 52                          push dx
  1402                                  
  1403 0000064C FF06[DC09]                  inc word [int0x37_flag]     ;割り込み発生フラグセット
  1404                                      
  1405 00000650 BAAA00                      mov dx, MPSC2_A_CTRL	    ;MPSC #2 コマンドポート 0x00AAを指定
  1406 00000653 B038                        mov al, 0x38
  1407 00000655 EE                          out dx, al	                ;ポートへ出力
  1408                                  
  1409 00000656 5A                          pop dx
  1410 00000657 5B                          pop bx
  1411 00000658 58                          pop ax
  1412 00000659 FB                          sti	                        ;割り込み許可
  1413 0000065A CF                          iret	                    ;割り込み復帰
  1414                                  
  1415                                  ; --------------------------------------------------
  1416                                  ;  V53 CPUシステムレジスタ初期化
  1417                                  ; --------------------------------------------------
  1418                                  v53_sysreg_init:
  1419 0000065B BE[7206]                    mov si, TABLE_V53_REG
  1420                                  .next:
  1421 0000065E 2E8B14                      mov dx, [cs:si]      ; Port Number (16bit)
  1422 00000661 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1423 00000664 740A                        je .done
  1424 00000666 2E8A4402                    mov al, [cs:si+2]    ; Value (8bit)
  1425 0000066A EE                          out dx, al
  1426 0000066B 83C603                      add si, 3
  1427 0000066E EBEE                        jmp .next
  1428                                  .done:
  1429 00000670 C3                          ret
  1430                                  
  1431                                  ; V53システムレジスタ設定テーブル
  1432 00000671 90                      ALIGN 2
  1433                                  TABLE_V53_REG:
  1434 00000672 FEFF00                      db 0xFE, 0xFF, 0x00     ; FFFE (SCTL) = 0x00 16bit I/O boundary
  1435 00000675 FDFF06                      db 0xFD, 0xFF, 0x06     ; FFFD (OPSEL)= 0x06 Enable ICU,TCU  Disable DMAU,SCU
  1436 00000678 FCFF00                      db 0xFC, 0xFF, 0x00     ; FFFC (OPHA) = 0x00
  1437 0000067B FBFFE0                      db 0xFB, 0xFF, 0xE0     ; FFFB (DULA) = 0xE0 DCU:0x00E0
  1438 0000067E FAFFC0                      db 0xFA, 0xFF, 0xC0     ; FFFA (IULA) = 0xC0 ICU:0x00C0
  1439 00000681 F9FFD0                      db 0xF9, 0xFF, 0xD0     ; FFF9 (TULA) = 0xD0 TCU:0x00D0
  1440 00000684 F8FFF0                      db 0xF8, 0xFF, 0xF0     ; FFF8 (SULA) = 0xF0 SCU:0x00F0
  1441 00000687 EAFF00                      db 0xEA, 0xFF, 0x00     ; FFEA (WMB0) = 0x00
  1442 0000068A EBFF00                      db 0xEB, 0xFF, 0x00     ; FFEB (WCY1) = 0x00
  1443 0000068D ECFF00                      db 0xEC, 0xFF, 0x00     ; FFEC (WCY0) = 0x00
  1444 00000690 F3FF73                      db 0xF3, 0xFF, 0x73     ; FFF3 (WMB1) = 0x73
  1445 00000693 EDFF00                      db 0xED, 0xFF, 0x00     ; FFED (WAC)  = 0x00
  1446 00000696 F4FF10                      db 0xF4, 0xFF, 0x10     ; FFF4 (WCY2) = 0x10
  1447 00000699 F5FF22                      db 0xF5, 0xFF, 0x22     ; FFF5 (WCY3) = 0x22
  1448 0000069C F6FF10                      db 0xF6, 0xFF, 0x10     ; FFF6 (WCY4) = 0x10
  1449 0000069F F2FF00                      db 0xF2, 0xFF, 0x00     ; FFF2 (RFC)  = 0x00
  1450 000006A2 E9FF00                      db 0xE9, 0xFF, 0x00     ; FFE9 (BRC)  = 0x00
  1451 000006A5 F0FF02                      db 0xF0, 0xFF, 0x02     ; FFF0 (TCKS) = 0x02
  1452 000006A8 F1FF00                      db 0xF1, 0xFF, 0x00     ; FFF1 (SBCR) = 0x00
  1453 000006AB FFFFFF                      db 0xFF, 0xFF, 0xFF     ; 終端マーカー
  1454                                  
  1455                                  ; --------------------------------------------------
  1456                                  ; TCU (タイマーユニット) 初期化
  1457                                  ; --------------------------------------------------
  1458                                  v53_tcu_init:
  1459 000006AE BE[D006]                    mov si, TABLE_TCU_REG
  1460                                  .next:
  1461 000006B1 2E8B14                      mov dx, [cs:si]      ; Port1 (16bit)
  1462 000006B4 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1463 000006B7 7416                        je .done
  1464 000006B9 2E8A4402                    mov al, [cs:si+2]    ; Val1 (8bit)
  1465 000006BD EE                          out dx, al
  1466 000006BE 2E8B5403                    mov dx, [cs:si+3]    ; Port2 (16bit)
  1467 000006C2 2E8B4405                    mov ax, [cs:si+5]    ; Val2 (16bit)
  1468 000006C6 EE                          out dx, al           ; Port2 Low
  1469 000006C7 88E0                        mov al, ah
  1470 000006C9 EE                          out dx, al           ; Port2 High
  1471 000006CA 83C607                      add si, 7
  1472 000006CD EBE2                        jmp .next
  1473                                  .done:
  1474 000006CF C3                          ret
  1475                                  
  1476                                  ; TCU タイマー設定テーブル
  1477                                  ALIGN 2
  1478                                  TABLE_TCU_REG:
  1479                                      ; Port1, Val1, Port2, Val2(16)
  1480 000006D0 D600                        dw TM_CTL  ; T0設定
  1481 000006D2 36                          db 0x36
  1482 000006D3 D000                        dw TM0_CNT
  1483 000006D5 204E                        dw 0x4E20
  1484                                  
  1485 000006D7 D600                        dw TM_CTL  ; T0最大値A
  1486 000006D9 70                          db 0x70
  1487 000006DA D200                        dw TM1_CNT
  1488 000006DC 050D                        dw 0x0D05
  1489                                  
  1490 000006DE D600                        dw TM_CTL  ; T0最大値B
  1491 000006E0 B0                          db 0xB0
  1492 000006E1 D400                        dw TM2_CNT
  1493 000006E3 050D                        dw 0x0D05
  1494                                          
  1495 000006E5 FFFF                        dw 0x0FFFF ; 終端マーカー
  1496                                  
  1497                                  ; ---------------------------------------------------
  1498                                  ; 物理IOの初期化
  1499                                  ; ---------------------------------------------------
  1500                                  dve554_io_init:
  1501 000006E7 B000                        mov al, 0x00
  1502 000006E9 BA8600                      mov dx, 0x0086
  1503 000006EC EE                          out dx, al
  1504 000006ED BA8200                      mov dx, 0x0082
  1505 000006F0 EE                          out dx, al
  1506 000006F1 BA8000                      mov dx, 0x0080
  1507 000006F4 EE                          out dx, al
  1508 000006F5 C3                          ret
  1509                                  
  1510                                  ; ---------------------------------------
  1511                                  ; V53 ICUの初期化
  1512                                  ; ---------------------------------------
  1513                                  v53_icu_init:
  1514 000006F6 BE[0C07]                    MOV SI, TABLE_V53_ICU	;I/O設定テーブルの先頭を指定
  1515                                  .loop:
  1516 000006F9 2E8B14                      MOV DX, CS:[SI]	        ;テーブルからポート番号(Word)をロード
  1517 000006FC 83FAFF                      CMP DX, 0x0FFFF	        ;終端マーカー（0xFFFF）かチェック
  1518 000006FF 740A                        JZ .done	            ;終端なら終了（RETへ）
  1519 00000701 2E8A4402                    mov al, cs:[si+02]	    ;設定値(byte)をロード
  1520 00000705 EE                          out dx, al	            ;ポートへ出力
  1521 00000706 83C603                      add si, 3	            ;次のエントリ（3バイト後）へ
  1522 00000709 EBEE                        jmp .loop	            ;ループ
  1523                                  .done:
  1524 0000070B C3                          ret
  1525                                  
  1526                                  ALIGN 2
  1527                                  TABLE_V53_ICU:
  1528 0000070C C000                        dw ICU_REG0
  1529 0000070E 11                          db 0x11    ; IIW1: 00010001b (Edge Trigger, カスケード拡張モード, IIW4有効)
  1530 0000070F C200                        dw ICU_REG1  
  1531 00000711 20                          db 0x20    ; IIW2: 00100000b (Vector Offset = 0x20 (INT 32))
  1532 00000712 C200                        dw ICU_REG1
  1533 00000714 30                          db 0x30    ; IIW3: 00110000b (INTP4, INTP5はスレーブ接続)
  1534 00000715 C200                        dw ICU_REG1
  1535 00000717 03                          db 0x03    ; IIW4: 00000011b (通常ネストモード、通常FIモード、8086モード)
  1536 00000718 C200                        dw ICU_REG1
  1537 0000071A CE                          db 0xCE    ; IMKW: 11001110b (INTP4, INTP5, INTP0以外はマスクする)     
  1538 0000071B FFFF                        dw 0x0FFFF
  1539                                  
  1540                                  ; =============================================================
  1541                                  ; uPD72001 (MPSC) 初期化シーケンス
  1542                                  ; CPU: 8086
  1543                                  ; 対象: MPSC #1 / MPSC #2  チャンネルAのみを使用
  1544                                  ;
  1545                                  ; 設定内容:
  1546                                  ;   非同期モード, 9600bps (BRGカウント=0x001E, CLK=x16),
  1547                                  ;   8データビット, ストップビット1, パリティなし
  1548                                  ;   全受信文字割り込み有効
  1549                                  ;   割り込みベクタベース = MPSC #1 0x28, MPSC #2 0x29
  1550                                  ; =============================================================
  1551                                   
  1552                                  ; =============================================================
  1553                                  ; mpsc_init  - MPSCメイン初期化ルーチン
  1554                                  ; 入力: なし / 破壊: AX, BX, CX, DX
  1555                                  ; =============================================================
  1556                                  mpsc_init:
  1557                                      ; =========================================================
  1558                                      ; Phase 1: ポインタリセット → チャンネルリセット
  1559                                      ; CR0 ポインタを確実に0にしてからChannel Resetを発行する
  1560                                      ; =========================================================
  1561                                   
  1562                                      ; --- MPSC#1 チャンネルA ---
  1563 0000071D BAA200                      mov dx, MPSC1_A_CTRL
  1564 00000720 B000                        mov al, 0x00
  1565 00000722 EE                          out dx, al              ; CR0選択（ポインタリセット）
  1566 00000723 EE                          out dx, al              ; CR0選択（ポインタリセット）
  1567 00000724 B018                        mov al, 0x18             ; Channel Reset コマンド
  1568 00000726 EE                          out dx, al
  1569                                   
  1570                                      ; --- MPSC#2 チャンネルA ---
  1571 00000727 BAAA00                      mov dx, MPSC2_A_CTRL
  1572 0000072A B000                        mov al, 0x00
  1573 0000072C EE                          out dx, al              ; CR0選択（ポインタリセット）
  1574 0000072D EE                          out dx, al              ; CR0選択（ポインタリセット）
  1575 0000072E B018                        mov al, 0x18
  1576 00000730 EE                          out dx, al
  1577                                    
  1578                                      ; リセット後安定待ち（約100ループ）
  1579 00000731 B96400                      mov cx, 100
  1580                                  .wait_reset:
  1581 00000734 90                          nop
  1582 00000735 90                          nop
  1583 00000736 90                          nop
  1584 00000737 E2FB                        loop .wait_reset
  1585                                  
  1586                                      ; =========================================================
  1587                                      ; Phase 2: CR1 - 割り込み/DMA設定
  1588                                      ; CR1 = 0x10: D4-D3=10(全受信文字で割り込み),
  1589                                      ;            D1=0(送信割り込み禁止), D0=0(外部割り込み禁止)
  1590                                      ; =========================================================
  1591 00000739 BAA200                      mov dx, MPSC1_A_CTRL
  1592 0000073C B001                        mov al, 1
  1593 0000073E EE                          out dx, al              ; CR1
  1594 0000073F B010                        mov al, 0x10             ; 受信割り込み可能
  1595 00000741 EE                          out dx, al
  1596 00000742 BAAA00                      mov dx, MPSC2_A_CTRL
  1597 00000745 B001                        mov al, 1
  1598 00000747 EE                          out dx, al              ; CR1
  1599 00000748 B010                        mov al, 0x10             ; 受信割り込み可能
  1600 0000074A EE                          out dx, al
  1601                                  
  1602                                      ; =========================================================
  1603                                      ; Phase 3: CR2A - 割り込み/DMA設定
  1604                                      ; CR2 = 0x30 
  1605                                      ;  D5=1: ベクタモード
  1606                                      ;  D4-D3=10: 86応答モード
  1607                                      ;  D1-D0=00: 両チャンネルとも割り込み
  1608                                      ;  D2=0: A/BチャネルのPriority Select
  1609                                      ; =========================================================
  1610 0000074B B002                        mov al, 2
  1611 0000074D B3E0                        mov bl, 0x0e0    ; 0000 0000b
  1612 0000074F E8BF00                      call mpsc_write_both
  1613                                  
  1614                                      ; =========================================================
  1615                                      ; Phase 4: CR4 - 送受信共通フォーマット設定
  1616                                      ; 非同期モード, x16クロック, ストップビット1, パリティなし
  1617                                      ; CR4 = 0x44: D7-D6=00(パリティなし), D5-D4=01(1stop),
  1618                                      ;             D3-D2=00(Async), D1-D0=01(x16)
  1619                                      ; ※ CR4はCR3/CR5より先に設定すること
  1620                                      ; =========================================================
  1621 00000752 B004                        mov al, 4
  1622 00000754 B344                        mov bl, 0x44
  1623 00000756 E8B800                      call mpsc_write_both  ; Aチャンネル両方に書き込み
  1624                                   
  1625                                      ; =========================================================
  1626                                      ; Phase 5: CR12/CR13 - BRGタイムコンスタント設定
  1627                                      ; ボーレート9600bps, CLKソース, x16分周の場合:
  1628                                      ;   カウント値 = 0x001E (30)
  1629                                      ; CR12: タイムコンスタント下位8ビットと上位8ビットを送受信別に書き込む
  1630                                      ; =========================================================
  1631                                   
  1632                                      ; --- MPSC#1 チャンネルA ---
  1633 00000759 BAA200                      mov dx, MPSC1_A_CTRL
  1634 0000075C B00C                        mov al, 12          ; CR12選択
  1635 0000075E EE                          out dx, al
  1636 0000075F B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1637 00000761 EE                          out dx, al
  1638 00000762 B01E                        mov al, 0x1e        ; 下位バイトの値
  1639 00000764 EE                          out dx, al
  1640 00000765 B000                        mov al, 0x00        ; 上位バイトの値
  1641 00000767 EE                          out dx, al
  1642                                   
  1643 00000768 B00C                        mov al, 12          ; Select CR12
  1644 0000076A EE                          out dx, al
  1645 0000076B B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1646 0000076D EE                          out dx, al
  1647 0000076E B01E                        mov al, 0x1e        ; 下位バイトの値
  1648 00000770 EE                          out dx, al
  1649 00000771 B000                        mov al, 0x00        ; 上位バイトの値
  1650 00000773 EE                          out dx, al
  1651                                  
  1652                                      ; --- MPSC#2 チャンネルA ---
  1653 00000774 BAAA00                      mov dx, MPSC2_A_CTRL
  1654 00000777 B00C                        mov al, 12          ; CR12選択
  1655 00000779 EE                          out dx, al
  1656 0000077A B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1657 0000077C EE                          out dx, al
  1658 0000077D B01E                        mov al, 0x1e        ; 下位バイトの値
  1659 0000077F EE                          out dx, al
  1660 00000780 B000                        mov al, 0x00        ; 上位バイトの値
  1661 00000782 EE                          out dx, al
  1662                                  
  1663 00000783 B00C                        mov al, 12          ; Select CR12
  1664 00000785 EE                          out dx, al
  1665 00000786 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1666 00000788 EE                          out dx, al
  1667 00000789 B01E                        mov al, 0x1e        ; 下位バイトの値
  1668 0000078B EE                          out dx, al
  1669 0000078C B000                        mov al, 0x00        ; 上位バイトの値
  1670 0000078E EE                          out dx, al
  1671                                   
  1672                                      ; =========================================================
  1673                                      ; Phase 6: CR15 - クロックソースとピン機能選択
  1674                                      ; CR15 = 0x56: DPLL入力はBRG, RTSCとTTLCはBRG出力
  1675                                      ; =========================================================
  1676 0000078F B00F                        mov al, 15
  1677 00000791 B356                        mov bl, 0x56
  1678 00000793 E87B00                      call mpsc_write_both
  1679                                   
  1680                                      ; =========================================================
  1681                                      ; Phase 7: CR14 - BRG動作許可
  1682                                      ; CR14 = 0x07: BRGソース=システムCLK, 送受信BRGカウント有効
  1683                                      ; D2=1(BR CLK=SYS CLK), D1=1(送信BRG有効), D0=1(受信BRG有効)
  1684                                      ; =========================================================
  1685 00000796 B00E                        mov al, 14
  1686 00000798 B307                        mov bl, 0x07
  1687 0000079A E87400                      call mpsc_write_both
  1688                                  
  1689                                      ; =========================================================
  1690                                      ; Phase 8: CR11 - 外部ステータス割り込み要因設定
  1691                                      ; CR11 = 0h : すべての拡張E/S割り込み要因を完全に禁止する
  1692                                      ; =========================================================
  1693 0000079D B00B                        mov al, 11
  1694 0000079F B300                        mov bl, 0x00
  1695 000007A1 E86D00                      call mpsc_write_both
  1696                                  
  1697                                      ; =========================================================
  1698                                      ; Phase 9: CR3 - 受信設定・イネーブル
  1699                                      ; CR3 = 0xC1: D7-D6=11(8ビット受信), D0=1(受信イネーブル)
  1700                                      ; =========================================================
  1701 000007A4 B003                        mov al, 3
  1702 000007A6 B3C1                        mov bl, 0xC1
  1703 000007A8 E86600                      call mpsc_write_both
  1704                                   
  1705                                      ; =========================================================
  1706                                      ; Phase 10: CR5 - 送信設定・イネーブル
  1707                                      ; CR5 = 0xEA: D7=1(DTRアサート), D6-D5=11(8ビット送信),
  1708                                      ;            D3=1(送信イネーブル), D1=1(RTSアサート)
  1709                                      ; DTR/RTSを初期からアサートしない場合は 0x68 を使用:
  1710                                      ;   CR5 = 0x68: D6-D5=11(8ビット), D3=1(TX EN), DTR/RTS=0
  1711                                      ; =========================================================
  1712 000007AB B005                        mov al, 5
  1713 000007AD B3EA                        mov bl, 0xEA
  1714 000007AF E85F00                      call mpsc_write_both
  1715                                  
  1716                                      ; =========================================================
  1717                                      ; Phase 11: CR0  - 内部のCRC計算回路を初期化するコマンドを発行（ASYNCでは不要）
  1718                                      ; =========================================================
  1719                                      ;mov dx, MPSC1_A_CTRL
  1720                                      ;mov al, 0x80       ;送信CRC計算回路の初期化 (Initialize Tx CRC Calculator)
  1721                                      ;out dx, al    
  1722                                      ;mov al, 0x40       ;受信CRC計算回路の初期化 (Initialize Rx CRC Calculator)
  1723                                      ;out dx, al
  1724                                   
  1725                                      ;mov dx, MPSC2_A_CTRL
  1726                                      ;mov al, 0x80
  1727                                      ;out dx, al
  1728                                      ;mov al, 0x40
  1729                                      ;out dx, al
  1730                                  
  1731                                      ; =========================================================
  1732                                      ; Phase 12: チャンネルＢの設定
  1733                                      ; =========================================================
  1734 000007B2 BAA600                      mov dx, MPSC1_B_CTRL
  1735 000007B5 B000                        mov al, 0x00            ; ポインタリセット
  1736 000007B7 EE                          out dx, al
  1737 000007B8 EE                          out dx, al
  1738                                  
  1739 000007B9 BAAE00                      mov dx, MPSC2_B_CTRL
  1740 000007BC B000                        mov al, 0x00            ; ポインタリセット
  1741 000007BE EE                          out dx, al
  1742 000007BF EE                          out dx, al
  1743                                          
  1744 000007C0 B018                        mov al, 0x18            ; Channel Reset コマンド
  1745 000007C2 BAA600                      mov dx, MPSC1_B_CTRL
  1746 000007C5 EE                          out dx, al
  1747 000007C6 BAAE00                      mov dx, MPSC2_B_CTRL
  1748 000007C9 EE                          out dx, al
  1749                                  
  1750 000007CA B96400                      mov cx, 100
  1751                                  .wait_loop:
  1752 000007CD 90                          nop
  1753 000007CE 90                          nop
  1754 000007CF 90                          nop
  1755 000007D0 E2FB                        loop .wait_loop
  1756                                  
  1757                                      ; =========================================================
  1758                                      ; Phase 13: CR2B - 割り込みベクタ設定（チャンネルBで設定必要）
  1759                                      ; ベクタベース = MPSC #1 0x28, MPSC #2 0x30
  1760                                      ; =========================================================
  1761 000007D2 B002                        mov al, 2             ; CR2Bの設定
  1762 000007D4 BAA600                      mov dx, MPSC1_B_CTRL
  1763 000007D7 EE                          out dx, al
  1764 000007D8 BAAE00                      mov dx, MPSC2_B_CTRL
  1765 000007DB EE                          out dx, al
  1766                                          
  1767 000007DC B028                        mov al, 0x28             ; MPSC#1のベクタ設定
  1768 000007DE BAA600                      mov dx, MPSC1_B_CTRL
  1769 000007E1 EE                          out dx, al
  1770                                          
  1771 000007E2 B030                        mov al, 0x30             ; MPSC#2のベクタ設定
  1772 000007E4 BAAE00                      mov dx, MPSC2_B_CTRL
  1773 000007E7 EE                          out dx, al
  1774                                  
  1775                                      ; =========================================================
  1776                                      ; Phase 14: CR1B - 割り込み/DMA設定
  1777                                      ; CR1B = 0x00: D4-D3=0(受信割り込み完全禁止)
  1778                                      ;             D2=0(固定ベクタ)
  1779                                      ;             D1=0(送信割り込み禁止), D0=0(外部割り込み禁止)
  1780                                      ; =========================================================
  1781 000007E8 B001                        mov al, 1             ; CR1Bの設定
  1782 000007EA BAA600                      mov dx, MPSC1_B_CTRL
  1783 000007ED EE                          out dx, al
  1784 000007EE BAAE00                      mov dx, MPSC2_B_CTRL
  1785 000007F1 EE                          out dx, al
  1786                                     
  1787 000007F2 B000                        mov al, 0x00             ; ベクタ修飾無効、Bチャネル全割り込み禁止
  1788 000007F4 BAA600                      mov dx, MPSC1_B_CTRL
  1789 000007F7 EE                          out dx, al
  1790 000007F8 BAAE00                      mov dx, MPSC2_B_CTRL
  1791 000007FB EE                          out dx, al
  1792                                   
  1793                                      ; =========================================================
  1794                                      ; Phase 15: CR11B - 外部ステータス割り込み要因設定
  1795                                      ; CR11 = 0h : すべての拡張E/S割り込み要因を完全に禁止する
  1796                                      ; =========================================================
  1797 000007FC B00B                        mov al, 11              ; CR11Bの設定
  1798 000007FE BAA600                      mov dx, MPSC1_B_CTRL
  1799 00000801 EE                          out dx, al
  1800 00000802 BAAE00                      mov dx, MPSC2_B_CTRL
  1801 00000805 EE                          out dx, al
  1802                                  
  1803 00000806 B000                        mov al, 0x00             ; Bチャネルの外部ステータス割り込み禁止
  1804 00000808 BAA600                      mov dx, MPSC1_B_CTRL
  1805 0000080B EE                          out dx, al
  1806 0000080C BAAE00                      mov dx, MPSC2_B_CTRL
  1807 0000080F EE                          out dx, al
  1808                                      
  1809 00000810 C3                          ret
  1810                                   
  1811                                  ; =============================================================
  1812                                  ; mpsc_write_both（MPSC#1と#2のチャンネルAのみ設定）
  1813                                  ;   入力: AL = レジスタ番号, BL = 書き込み値
  1814                                  ; =============================================================
  1815                                  mpsc_write_both:
  1816 00000811 BAA200                      mov dx, MPSC1_A_CTRL
  1817 00000814 EE                          out dx, al
  1818 00000815 86C3                        xchg al, bl
  1819 00000817 EE                          out dx, al
  1820 00000818 86C3                        xchg al, bl
  1821                                   
  1822 0000081A BAAA00                      mov dx, MPSC2_A_CTRL
  1823 0000081D EE                          out dx, al
  1824 0000081E 86C3                        xchg al, bl
  1825 00000820 EE                          out dx, al
  1826 00000821 86C3                        xchg al, bl
  1827                                   
  1828 00000823 C3                          ret
  1829                                  
