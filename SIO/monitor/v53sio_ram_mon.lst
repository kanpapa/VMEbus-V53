     1                                  ; =================================================================
     2                                  ; V53 RAM Monitor for DVE-554 v0.1 2026-04-18
     3                                  ; Target: DVE-554 SIO VME Board
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; Real:   nasm -f bin v53sio_ram_mon.asm -o v53sio_ram_mon.bin -l v53sio_ram_mon.lst
     8                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53sio_ram_mon.bin v53sio_ram_mon.hex
     9                                  ; -----------------
    10                                  
    11                                      org 0
    12                                      cpu 186
    13                                  
    14                                      ; V53 ICU (00C0Hに配置)
    15                                      %define ICU_REG0    0x000C0
    16                                      %define ICU_REG1    0x000C2
    17                                  
    18                                      ; V53 TCU (00D0Hに配置)
    19                                      %define TM0_CNT     0x000D0 ; Timer 0 Counter
    20                                      %define TM1_CNT     0x000D2 ; Timer 1 Counter
    21                                      %define TM2_CNT     0x000D4 ; Timer 2 Counter
    22                                      %define TM_CTL      0x000D6 ; Timer Control
    23                                  
    24                                      ; V53 DMAU (00E0Hに配置)
    25                                      ; DMAUはモニタでは使用しないため、レジスタ定義は省略します。
    26                                  
    27                                      ; V53 SCU (00F0Hに配置）
    28                                      ; SCUはモニタでは使用しないため、レジスタ定義は省略します。
    29                                  
    30                                      ; uPD72001 MPSC #1 (00A0Hに配置)
    31                                      %define MPSC1_A_DATA 0x00A0 ; MPSC#1 Channel A Data Register
    32                                      %define MPSC1_A_CTRL 0x00A2 ; MPSC#1 Channel A Control Register
    33                                      %define MPSC1_B_DATA 0x00A8 ; MPSC#2 Channel B Data Register
    34                                      %define MPSC1_B_CTRL 0x00AA ; MPSC#2 Channel B Control Register
    35                                  
    36                                      ; uPD72001 MPSC #2 (00B0Hに配置)
    37                                      %define MPSC2_A_DATA 0x00B0 ; MPSC#2 Channel A Data Register
    38                                      %define MPSC2_A_CTRL 0x00B2 ; MPSC#2 Channel A Control Register
    39                                      %define MPSC2_B_DATA 0x00B8 ; MPSC#2 Channel B Data Register
    40                                      %define MPSC2_B_CTRL 0x00BA ; MPSC#2 Channel B Control Register
    41                                  
    42                                      %define TX_READY   0x04
    43                                      %define RX_READY   0x01
    44                                  
    45                                  section .text
    46                                  
    47                                  start:
    48 00000000 FA                          cli             ; 初期化中は割り込み禁止
    49                                  
    50                                      ; ---------------------------------------------
    51                                      ; 1. セグメントレジスタ初期化
    52                                      ; ---------------------------------------------
    53 00000001 0E                          push cs     ; CS -> DS
    54 00000002 1F                          pop ds
    55 00000003 0E                          push cs     ; CS -> ES
    56 00000004 07                          pop es
    57 00000005 8CC8                        mov ax, cs  ; CS -> SS
    58 00000007 8ED0                        mov ss, ax
    59 00000009 BCFF7F                      mov sp, 0x7FFF
    60                                      ; ------------------------------
    61                                  
    62                                      ; --- 2. V53 システムレジスタ初期化 ---
    63 0000000C E87806                      call v53_sysreg_init
    64                                  
    65                                      ; --- 3. TCU初期化  ---
    66 0000000F E88B06                      call v53_tcu_init
    67                                  
    68                                      ; --- 4. 物理IOの初期化（詳細不明） ---
    69 00000012 E8AA06                      call dve554_io_init
    70                                  
    71                                      ; --- 5. MPSC の初期化 ---
    72 00000015 E8B606                      call mpsc_init
    73                                      
    74                                      ; --- 6. 割り込みベクタの初期化 ---
    75 00000018 31C0                        xor ax, ax
    76 0000001A 8EC0                        mov es, ax              ; ES = 0000h (Vector Table Segment)
    77                                  
    78                                      ; Vector 10h 登録
    79 0000001C 26C7064000[9805]            mov word [es:0x40], _isr_int10h      ; オフセットを書き込み　0x20 * 4 = 0x80
    80 00000023 268C0E4200                  mov word [es:0x42], cs              ; 現在のコードセグメントを書き込み
    81                                  
    82                                      ; Vector 11h 登録
    83 00000028 26C7064400[B605]            mov word [es:0x44], _isr_int11h
    84 0000002F 268C0E4600                  mov word [es:0x46], cs
    85                                  
    86                                      ; Vector 12h 登録
    87 00000034 26C7064800[D405]            mov word [es:0x48], _isr_int12h
    88 0000003B 268C0E4A00                  mov word [es:0x4A], cs
    89                                  
    90                                      ; Vector 13h 登録
    91 00000040 26C7064C00[F205]            mov word [es:0x4C], _isr_int13h
    92 00000047 268C0E4E00                  mov word [es:0x4E], cs
    93                                      
    94                                      ; Vector 14h 登録
    95 0000004C 26C7065000[1006]            mov word [es:0x50], _isr_int14h
    96 00000053 268C0E5200                  mov word [es:0x52], cs
    97                                  
    98                                      ; Vector 15h 登録
    99 00000058 26C7065400[2E06]            mov word [es:0x54], _isr_int15h
   100 0000005F 268C0E5600                  mov word [es:0x56], cs
   101                                  
   102                                      ; Vector 16h 登録
   103 00000064 26C7065800[4C06]            mov word [es:0x58], _isr_int16h
   104 0000006B 268C0E5A00                  mov word [es:0x5A], cs
   105                                  
   106                                      ; Vector 17h 登録
   107 00000070 26C7065C00[6A06]            mov word [es:0x5C], _isr_int17h
   108 00000077 268C0E5E00                  mov word [es:0x5E], cs 
   109                                  
   110                                  
   111                                      ; Vector 20h (INTP0) 登録
   112 0000007C 26C7068000[B004]            mov word [es:0x80], _isr_intp0      ; オフセットを書き込み　0x20 * 4 = 0x80
   113 00000083 268C0E8200                  mov word [es:0x82], cs              ; 現在のコードセグメントを書き込み
   114                                  
   115                                      ; Vector 21h (INTP1) 登録
   116 00000088 26C7068400[CC04]            mov word [es:0x84], _isr_intp1
   117 0000008F 268C0E8600                  mov word [es:0x86], cs
   118                                  
   119                                      ; Vector 22h (INTP2) 登録
   120 00000094 26C7068800[EA04]            mov word [es:0x88], _isr_intp2
   121 0000009B 268C0E8A00                  mov word [es:0x8A], cs
   122                                  
   123                                      ; Vector 22h (INTP3) 登録
   124 000000A0 26C7068C00[0805]            mov word [es:0x8C], _isr_intp3
   125 000000A7 268C0E8E00                  mov word [es:0x8E], cs
   126                                  
   127                                      ; Vector 23h (INTP4) 登録
   128 000000AC 26C7069000[2605]            mov word [es:0x90], _isr_intp4 
   129 000000B3 268C0E9200                  mov word [es:0x92], cs
   130                                  
   131                                      ; Vector 24h (INTP5) 登録
   132 000000B8 26C7069400[4405]            mov word [es:0x94], _isr_intp5
   133 000000BF 268C0E9600                  mov word [es:0x96], cs
   134                                  
   135                                      ; Vector 25h (INTP6) 登録
   136 000000C4 26C7069800[6205]            mov word [es:0x98], _isr_intp6
   137 000000CB 268C0E9A00                  mov word [es:0x9A], cs
   138                                  
   139                                      ; Vector 26h (INTP7) 登録
   140 000000D0 26C7069C00[8005]            mov word [es:0x9C], _isr_intp7
   141 000000D7 268C0E9E00                  mov word [es:0x9E], cs
   142                                  
   143                                      ; --- 7. ICU初期化 ---
   144 000000DC BAC000                      mov dx, ICU_REG0
   145 000000DF B012                        mov al, 12h     ; IIW1: 00010010b (Edge Trigger, Single)
   146 000000E1 EE                          out dx, al
   147                                  
   148 000000E2 BAC200                      mov dx, ICU_REG1
   149 000000E5 B020                        mov al, 20h     ; IIW2: 00100000b (Vector Offset = 20h (INT 32))
   150 000000E7 EE                          out dx, al
   151                                  
   152 000000E8 B0FF                        mov al, 0ffh    ; IMKW: 11111111b (一旦割り込みをマスクする）
   153 000000EA EE                          out dx, al
   154                                  
   155                                      ; --- 8. 割り込み許可 ---
   156 000000EB FB                          sti
   157                                  
   158 000000EC B000                        mov al, 00h    ; IMKW: 11111000b (INTP0-INTP2を許可）
   159 000000EE EE                          out dx, al
   160                                  
   161                                      ; 変数初期化 (RAMエリアをクリア)
   162 000000EF C706[360A]0000              mov word [dump_seg], 0x0000
   163 000000F5 C706[380A]0000              mov word [dump_off], 0x0000
   164 000000FB C706[3A0A]0020              mov word [load_seg], 0x2000
   165                                  
   166                                      ; スタートメッセージの表示
   167 00000101 BE[3508]                    mov si, msg_boot
   168 00000104 E8F002                      call puts
   169                                  
   170                                  ; =================================================================
   171                                  ; Main Loop
   172                                  ; =================================================================
   173                                  monitor_loop:
   174 00000107 B03E                        mov al, '>'
   175 00000109 E8F902                      call putc
   176 0000010C B020                        mov al, ' '
   177 0000010E E8F402                      call putc
   178                                  
   179 00000111 E81103                      call getc_echo  ; コマンド受信（エコーあり）
   180 00000114 88C3                        mov bl, al
   181                                      
   182 00000116 80FB64                      cmp bl, 'd'     ; dump command
   183 00000119 747A                        je do_dump
   184 0000011B 80FB44                      cmp bl, 'D'
   185 0000011E 7475                        je do_dump
   186                                      
   187 00000120 80FB6C                      cmp bl, 'l'     ; load command
   188 00000123 7503E9D000                  je do_load
   189 00000128 80FB4C                      cmp bl, 'L'
   190 0000012B 7503E9C800                  je do_load
   191                                      
   192 00000130 80FB67                      cmp bl, 'g'     ; go command
   193 00000133 7503E94401                  je do_go
   194 00000138 80FB47                      cmp bl, 'G'
   195 0000013B 7503E93C01                  je do_go
   196                                  
   197 00000140 80FB77                      cmp bl, 'w'     ; Write command
   198 00000143 7503E96001                  je do_write
   199 00000148 80FB57                      cmp bl, 'W'
   200 0000014B 7503E95801                  je do_write
   201                                  
   202 00000150 3C69                        cmp al, 'i'     ; Input Port command
   203 00000152 7503E99401                  je do_in
   204 00000157 3C49                        cmp al, 'I'
   205 00000159 7503E98D01                  je do_in
   206                                  
   207 0000015E 3C6F                        cmp al, 'o'     ; Output Port command
   208 00000160 7503E9AA01                  je do_out
   209 00000165 3C4F                        cmp al, 'O'
   210 00000167 7503E9A301                  je do_out
   211                                  
   212 0000016C 3C73                        cmp al, 's'     ; Scan I/O command
   213 0000016E 7503E9C301                  je do_scan
   214 00000173 3C53                        cmp al, 'S'
   215 00000175 7503E9BC01                  je do_scan
   216                                  
   217 0000017A 3C74                        cmp al, 't'     ; Scan Timer wait command
   218 0000017C 7503E92702                  je do_timer
   219 00000181 3C54                        cmp al, 'T'
   220 00000183 7503E92002                  je do_timer
   221                                  
   222 00000188 3C3F                        cmp al, '?'     ; Help
   223 0000018A 7503E95C02                  je cmd_help
   224                                  
   225                                      ; 知らないコマンドなら改行して戻る
   226 0000018F E89C02                      call putc_crlf
   227 00000192 E972FF                      jmp monitor_loop
   228                                  
   229                                  ; =================================================================
   230                                  ; Command: Dump Memory
   231                                  ; Usage:
   232                                  ;   D               -> Dump next 64 bytes
   233                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   234                                  ; =================================================================
   235                                  do_dump:
   236 00000195 E88D02                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   237 00000198 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   238 0000019A 7418                        je .dump_run
   239 0000019C 3C20                        cmp al, ' '         ; Spaceなら引数解析
   240 0000019E 7405                        je .parse_args
   241                                      
   242                                      ; それ以外なら無視して実行へ（またはエラー処理）
   243 000001A0 E88B02                      call putc_crlf
   244 000001A3 EB12                        jmp .dump_run_start
   245                                  
   246                                  .parse_args:
   247 000001A5 E8B402                      call get_hex_word
   248 000001A8 A3[360A]                    mov [dump_seg], ax
   249 000001AB E8F402                      call skip_space
   250 000001AE E8AB02                      call get_hex_word
   251 000001B1 A3[380A]                    mov [dump_off], ax
   252                                      ; ここでEnter待ちをするか、そのまま実行するか
   253                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   254                                      
   255                                  .dump_run:
   256 000001B4 E87702                      call putc_crlf              ; 実行直前に改行
   257                                  
   258                                  .dump_run_start:
   259 000001B7 B90400                      mov cx, 4                   ; 4行表示する
   260                                      
   261                                  .line_loop:
   262 000001BA 51                          push cx
   263                                      
   264 000001BB A1[360A]                    mov ax, [dump_seg]          ; セグメントの表示
   265 000001BE E87602                      call print_hex_word
   266 000001C1 B03A                        mov al, ':'                 ; 区切り文字の:を表示
   267 000001C3 E83F02                      call putc
   268 000001C6 A1[380A]                    mov ax, [dump_off]          ; オフセットの表示
   269 000001C9 E86B02                      call print_hex_word
   270 000001CC B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   271 000001CE E83402                      call putc
   272                                  
   273 000001D1 8B36[380A]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   274                                  
   275 000001D5 1E                          push ds                     ; モニタのDSを保存
   276 000001D6 8E1E[360A]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   277                                      
   278 000001DA B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   279                                  .hex_loop:
   280 000001DD 8A04                        mov al, [si]
   281 000001DF E85C02                      call print_hex_byte         ; メモリ内容の表示
   282 000001E2 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   283 000001E4 E81E02                      call putc
   284 000001E7 46                          inc si                      ; 次のアドレスにする
   285 000001E8 E2F3                        loop .hex_loop              ; 16回繰り返し    
   286                                  
   287 000001EA 1F                          pop ds                      ; DSをモニタ用に戻す
   288                                  
   289 000001EB 8936[380A]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   290                                  
   291 000001EF E83C02                      call putc_crlf              ; 改行する
   292 000001F2 59                          pop cx
   293 000001F3 E2C5                        loop .line_loop             ; 4回繰り返す
   294                                      
   295 000001F5 E90FFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   296                                  
   297                                  ; =================================================================
   298                                  ; Command: Load Intel HEX
   299                                  ; Usage:
   300                                  ;   L           -> Load to default segment (load_seg)
   301                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   302                                  ; =================================================================
   303                                  do_load:
   304                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   305 000001F8 A1[3A0A]                    mov ax, [load_seg]
   306 000001FB 06                          push es             ; RAM用ESを保存
   307 000001FC 50                          push ax             ; デフォルトセグメントを保存
   308                                      
   309 000001FD E82502                      call getc_echo
   310 00000200 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   311 00000202 7402                        je .parse_seg
   312 00000204 EB05                        jmp .start_load
   313                                  
   314                                  .parse_seg:
   315 00000206 58                          pop ax              ; 不要になったデフォルトを捨てる
   316 00000207 E85202                      call get_hex_word   ; 新しいセグメント取得
   317 0000020A 50                          push ax             ; 保存
   318                                  
   319                                  .start_load:
   320 0000020B E82002                      call putc_crlf      ; メッセージ表示前に改行
   321 0000020E BE[6D08]                    mov si, msg_load    ; ロード開始メッセージを表示
   322 00000211 E8E301                      call puts
   323                                      
   324 00000214 58                          pop ax
   325 00000215 8EC0                        mov es, ax          ; ロード先をESに設定
   326                                      
   327                                      ; ターゲット表示
   328 00000217 E81D02                      call print_hex_word ; ESの値を表示
   329 0000021A B03A                        mov al, ':'         ; 区切り文字を表示
   330 0000021C E8E601                      call putc
   331 0000021F B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   332 00000221 E8E101                      call putc
   333 00000224 E80702                      call putc_crlf
   334                                  
   335                                  .wait_record:
   336 00000227 E8EC01                      call getc           ; 開始文字を待つ
   337 0000022A 3C3A                        cmp al, ':'
   338 0000022C 75F9                        jne .wait_record
   339                                  
   340 0000022E E85002                      call get_hex_byte   ; データ長を読み込み
   341 00000231 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   342 00000233 B500                        mov ch, 0
   343                                      
   344 00000235 E84902                      call get_hex_byte   ; 上位アドレスを読み込み
   345 00000238 88C7                        mov bh, al
   346 0000023A E84402                      call get_hex_byte   ; 下位アドレスを読み込み
   347 0000023D 88C3                        mov bl, al
   348                                      
   349 0000023F E83F02                      call get_hex_byte   ; レコードタイプを読み込み
   350 00000242 3C01                        cmp al, 01          ; End of File?
   351 00000244 7422                        je .handle_eof      ; EOFの処理へ
   352 00000246 3C00                        cmp al, 00          ; Data Record?
   353 00000248 7523                        jne .skip_line      ; その他はスキップ
   354                                      
   355 0000024A E312                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   356                                      
   357                                  .data_loop:
   358 0000024C E83202                      call get_hex_byte   ; 1バイト読み取り
   359 0000024F 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   360 00000252 43                          inc bx              ; 次のアドレスにする
   361                                      ; --- 追加: 64KBの境界チェック ---
   362 00000253 7507                        jnz .loop_next      ; bxが0にならなければそのまま
   363 00000255 8CC0                        mov ax, es          ; bxが0(一周)したら
   364 00000257 050010                      add ax, 0x1000      ; セグメントを64KB分(0x1000)進める
   365 0000025A 8EC0                        mov es, ax
   366                                      ; -----------------------------
   367                                  
   368                                  .loop_next:
   369 0000025C E2EE                        loop .data_loop     ; データ長分繰り返す
   370                                      
   371                                  .read_chk:
   372 0000025E E82002                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   373 00000261 B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   374 00000263 E89F01                      call putc
   375 00000266 EBBF                        jmp .wait_record    ; 次のレコード読み取りへ
   376                                  
   377                                  .handle_eof:            ; EOFの場合
   378 00000268 E81602                      call get_hex_byte   ; チェックサムを読み飛ばす
   379 0000026B EB02                        jmp .finish         ; 読み込み終了処理へ
   380                                  
   381                                  .skip_line:
   382 0000026D EBB8                        jmp .wait_record    ; 次のレコード読み込みへ
   383                                  
   384                                  .finish:
   385 0000026F 07                          pop es              ; RAM用ESを復帰
   386 00000270 E8BB01                      call putc_crlf
   387 00000273 BE[7908]                    mov si, msg_ok      ; "OK"を表示
   388 00000276 E87E01                      call puts
   389 00000279 E98BFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   390                                  
   391                                  ; =================================================================
   392                                  ; Command: Execute
   393                                  ; Usage:
   394                                  ;   G <Seg> <Off>
   395                                  ; Example: G 1000 0000
   396                                  ; =================================================================
   397                                  do_go:
   398                                      ; Gコマンドは入力後に改行
   399                                      
   400 0000027C E8A601                      call getc_echo      ; Space?
   401 0000027F 3C20                        cmp al, ' '
   402 00000281 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   403                                      
   404                                      ; 1. セグメント (SSSS) を取得
   405 00000283 E8D601                      call get_hex_word   ; AX = Segment
   406 00000286 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   407 00000287 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   408                                      
   409                                      ; スペース読み飛ばし (もしあれば)
   410 00000289 E81602                      call skip_space
   411                                      
   412                                      ; 2. オフセット (OOOO) を取得
   413 0000028C E8CD01                      call get_hex_word   ; AX = Offset
   414 0000028F 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   415                                      
   416 00000290 E89B01                      call putc_crlf      ; 実行前に改行
   417 00000293 BE[7C08]                    mov si, msg_go
   418 00000296 E85E01                      call puts
   419 00000299 E89201                      call putc_crlf
   420                                      
   421                                      ; 3. 実行環境のセットアップ
   422                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   423 0000029C 8EDB                        mov ds, bx
   424 0000029E 8EC3                        mov es, bx
   425                                  
   426                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   427 000002A0 FA                          cli
   428                                  
   429                                      ; 4. ジャンプ！ (Far Return)
   430                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   431 000002A1 CB                          retf                ; Jump!
   432                                  
   433                                  .go_default:
   434 000002A2 E88901                      call putc_crlf      ; 改行して
   435 000002A5 E95FFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   436                                  
   437                                  ; ==============================================================
   438                                  ; Command: Write Memory
   439                                  ; Usage:
   440                                  ;   W <Seg> <Off> <Val>
   441                                  ; ==============================================================
   442                                  do_write:    
   443 000002A8 E87A01                      call getc_echo      ; Space?
   444 000002AB 3C20                        cmp al, ' '
   445 000002AD 7403E9F401                  jne error           ; 引数なしならリターン(またはエラー)
   446                                  
   447                                      ; 1. セグメント (SSSS) を取得
   448 000002B2 E8A701                      call get_hex_word   ; AX = Segment
   449 000002B5 50                          push ax             ; ターゲットセグメントを保存
   450                                      
   451 000002B6 E86C01                      call getc_echo      ; Space?
   452 000002B9 3C20                        cmp al, ' '
   453 000002BB 7403E9E601                  jne error           ; 引数なしならリターン(またはエラー)
   454                                      
   455                                      ; 2. オフセット (OOOO) を取得
   456 000002C0 E89901                      call get_hex_word   ; AX = Offset
   457 000002C3 50                          push ax             ; ターゲットオフセットを保存
   458                                  
   459 000002C4 E85E01                      call getc_echo      ; Space?
   460 000002C7 3C20                        cmp al, ' '
   461 000002C9 7403E9D801                  jne error           ; 引数なしならリターン(またはエラー)
   462                                  
   463                                      ; 3. 設定データ (VV) を取得
   464 000002CE E89A01                      call get_hex_byte_echo   ; AL = Value
   465                                  
   466 000002D1 5B                          pop bx              ; bx = Offset
   467 000002D2 5A                          pop dx              ; dx = Target Segment
   468                                  
   469                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   470 000002D3 8916[360A]                  mov [dump_seg], dx
   471 000002D7 891E[380A]                  mov [dump_off], bx
   472                                      
   473 000002DB 8EDA                        mov ds, dx          ; DS再設定
   474 000002DD 3E8807                      mov [ds:bx], al     ; 書き込み！
   475                                      
   476 000002E0 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   477 000002E1 1F                          pop ds
   478                                  
   479 000002E2 BE[9F08]                    mov si, msg_done
   480 000002E5 E80F01                      call puts
   481 000002E8 E91CFE                      jmp monitor_loop
   482                                  
   483                                  ; ==============================================================
   484                                  ; Command: Input from Port
   485                                  ; Usage:
   486                                  ;   I <Port>
   487                                  ; ==============================================================
   488                                  do_in:
   489 000002EB E83701                      call getc_echo
   490 000002EE 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   491 000002F0 7403E9B101                  jne error           ; パラメタが無い場合はエラー処理へ
   492                                  
   493 000002F5 E86401                      call get_hex_word   ; ポートアドレスを取得
   494 000002F8 89C2                        mov dx, ax          ; 保存
   495 000002FA EC                          in al, dx           ; I/O Read
   496                                      
   497 000002FB 50                          push ax
   498 000002FC E82F01                      call putc_crlf      ; メッセージ表示前に改行
   499 000002FF BE[9908]                    mov si, msg_in_res
   500 00000302 E8F200                      call puts
   501 00000305 58                          pop ax
   502                                  
   503 00000306 E83501                      call print_hex_byte ; 値を表示
   504                                  
   505 00000309 E82201                      call putc_crlf      ; 改行して
   506 0000030C E9F8FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   507                                  
   508                                  ; ==============================================================
   509                                  ; Command: Output to Port
   510                                  ; Usage
   511                                  ;   O <Port> <Val>
   512                                  ; ==============================================================
   513                                  do_out:
   514 0000030F E81301                      call getc_echo
   515 00000312 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   516 00000314 7403E98D01                  jne error           ; パラメタが無い場合はエラー処理へ
   517                                  
   518 00000319 E84001                      call get_hex_word   ; ポートアドレスを取得
   519 0000031C 50                          push ax             ; スタックに積む
   520                                  
   521 0000031D E80501                      call getc_echo
   522 00000320 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   523 00000322 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   524                                      
   525 00000324 E84401                      call get_hex_byte_echo   ; 出力値を取得
   526 00000327 5A                          pop dx              ; スタックからDXにセット
   527                                      
   528 00000328 EE                          out dx, al          ; I/O Write
   529                                      
   530 00000329 BE[9F08]                    mov si, msg_done    ; DONEを表示。改行付き。
   531 0000032C E8C800                      call puts
   532 0000032F E9D5FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   533                                  
   534                                  error_pop:
   535 00000332 58                          pop ax              ; 使わなかったスタックを捨てる
   536 00000333 E97001                      jmp error
   537                                  
   538                                  ; ==============================================================
   539                                  ; Command: Scan I/O Ports
   540                                  ; Usage:
   541                                  ;   S <Start_port> <End_port>
   542                                  ; Description: Reads ports and prints if value is NOT 0xFF
   543                                  ; ==============================================================
   544                                  do_scan:
   545 00000336 E8EC00                      call getc_echo
   546 00000339 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   547 0000033B 7403E96601                  jne error           ; パラメタが無い場合はエラー処理へ
   548                                  
   549 00000340 E81901                      call get_hex_word   ; スタートポートアドレスを取得
   550 00000343 89C3                        mov bx, ax          ; BX = Start Address
   551                                      
   552 00000345 E8DD00                      call getc_echo
   553 00000348 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   554 0000034A 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   555                                  
   556 0000034C E80D01                      call get_hex_word   ; エンドポートアドレスを取得
   557 0000034F 89C1                        mov cx, ax          ; CX = End Address
   558                                  
   559 00000351 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   560 00000353 7603E94E01                  ja error
   561                                  
   562 00000358 E8D300                      call putc_crlf
   563 0000035B BE[2E09]                    mov si, msg_scan_start
   564 0000035E E89600                      call puts
   565                                  
   566                                  .scan_loop:
   567 00000361 89DA                        mov dx, bx          ; DXにポートアドレス設定
   568 00000363 EC                          in al, dx           ; I/O Read
   569                                  
   570 00000364 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   571 00000366 741D                        je .next_port
   572                                  
   573 00000368 50                          push ax             ; Readした値をスタックに保存
   574                                  
   575                                      ; --- 有効な値が見つかった場合の表示 ---
   576                                      ; [Port]: Value
   577 00000369 89D8                        mov ax, bx
   578 0000036B E8C900                      call print_hex_word ; ポートアドレスの表示
   579 0000036E B03A                        mov al, ':'
   580 00000370 E89200                      call putc
   581 00000373 B020                        mov al, ' '
   582 00000375 E88D00                      call putc
   583                                      
   584 00000378 58                          pop ax
   585 00000379 E8C200                      call print_hex_byte ; Readした値の表示
   586                                      
   587 0000037C BE[5909]                    mov si, msg_space   ; "  "
   588 0000037F E87500                      call puts
   589                                  
   590                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   591                                      ; ここでは単純にリスト形式で改行します
   592 00000382 E8A900                      call putc_crlf
   593                                  
   594                                  .next_port:
   595 00000385 43                          inc bx              ; 次のアドレスへ
   596                                      
   597                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   598 00000386 BAA200                      mov dx, MPSC1_A_CTRL
   599 00000389 EC                          in al, dx
   600 0000038A A801                        test al, RX_READY   ; RxRDY?
   601 0000038C 750D                        jnz .abort          ; 何かキーが押されたら中断
   602                                  
   603 0000038E 39CB                        cmp bx, cx
   604 00000390 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   605                                  
   606 00000392 BE[9F08]                    mov si, msg_done
   607 00000395 E85F00                      call puts
   608 00000398 E96CFD                      jmp monitor_loop
   609                                  
   610                                  .abort:
   611                                      ; 入力バッファを空読みしておく
   612 0000039B BAA000                      mov dx, MPSC1_A_DATA
   613 0000039E EC                          in al, dx
   614 0000039F BE[5C09]                    mov si, msg_abort
   615 000003A2 E85200                      call puts
   616 000003A5 E95FFD                      jmp monitor_loop
   617                                  
   618                                  ; ==============================================================
   619                                  ; Command: Timer
   620                                  ;   T          -> Show current tick counter (32-bit HEX)
   621                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   622                                  ; ==============================================================
   623                                  do_timer:
   624 000003A8 E87A00                      call getc_echo      ; コマンド('T')の次の文字を取得
   625 000003AB 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   626 000003AD 7421                        je .show_counter
   627 000003AF 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   628 000003B1 7403E9F000                  jne error           ; それ以外はエラー
   629                                  
   630                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   631 000003B6 E8A300                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   632                                  
   633                                      ; 開始時刻を保存 (Start Time)
   634 000003B9 8B1E[3C0A]                  mov bx, [tick_counter_lo]
   635                                  
   636                                  .wait_loop:
   637                                      ; 1. 現在時刻を取得
   638 000003BD 8B0E[3C0A]                  mov cx, [tick_counter_lo]
   639                                      
   640                                      ; 2. 経過時間を計算 (Current - Start)
   641                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   642 000003C1 29D9                        sub cx, bx          
   643                                      
   644                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   645 000003C3 39C1                        cmp cx, ax
   646 000003C5 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   647                                  
   648                                      ; 指定時間経過した
   649 000003C7 BE[9F08]                    mov si, msg_done
   650 000003CA E82A00                      call puts
   651 000003CD E937FD                      jmp monitor_loop
   652                                  
   653                                  .show_counter:
   654                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   655 000003D0 E85B00                      call putc_crlf
   656                                      
   657 000003D3 BE[6709]                    mov si, msg_tick    ; "Tick: "
   658 000003D6 E81E00                      call puts
   659                                  
   660                                      ; 32bitカウンタを [High][Low] の順で表示
   661 000003D9 A1[3E0A]                    mov ax, [tick_counter_hi]
   662 000003DC E85800                      call print_hex_word
   663 000003DF A1[3C0A]                    mov ax, [tick_counter_lo]
   664 000003E2 E85200                      call print_hex_word
   665                                      
   666 000003E5 E84600                      call putc_crlf
   667 000003E8 E91CFD                      jmp monitor_loop
   668                                  
   669                                  ; ==============================================================
   670                                  ; Command: Help
   671                                  ; ==============================================================
   672                                  cmd_help:
   673 000003EB E84000                      call putc_crlf
   674 000003EE BE[AB08]                    mov si, msg_help
   675 000003F1 E80300                      call puts
   676 000003F4 E910FD                      jmp monitor_loop
   677                                  
   678                                  ; =================================================================
   679                                  ; Utilities
   680                                  ; =================================================================
   681                                  
   682                                  ; 文字列出力
   683                                  puts:
   684 000003F7 2E8A04                      mov al, [cs:si]
   685 000003FA 08C0                        or al, al
   686 000003FC 7406                        jz .ret
   687 000003FE E80400                      call putc
   688 00000401 46                          inc si
   689 00000402 EBF3                        jmp puts
   690 00000404 C3                      .ret: ret
   691                                  
   692                                  ; 1文字出力
   693                                  putc:
   694 00000405 52                          push dx
   695 00000406 50                          push ax
   696 00000407 BAA200                      mov dx, MPSC1_A_CTRL
   697                                  .wait_tx:
   698 0000040A EC                          in al, dx
   699 0000040B A804                        test al, TX_READY   ; D2: Tx Buffer Empty?
   700 0000040D 74FB                        jz .wait_tx
   701 0000040F BAA000                      mov dx, MPSC1_A_DATA
   702 00000412 58                          pop ax
   703 00000413 EE                          out dx, al
   704 00000414 5A                          pop dx
   705 00000415 C3                          ret
   706                                  
   707                                  ; 1文字入力
   708                                  getc:
   709 00000416 52                          push dx
   710 00000417 BAA200                      mov dx, MPSC1_A_CTRL
   711                                  .wait_rx:
   712 0000041A EC                          in al, dx
   713 0000041B A801                        test al, RX_READY   ; D0: RX Ready?
   714 0000041D 74FB                        jz .wait_rx
   715 0000041F BAA000                      mov dx, MPSC1_A_DATA
   716 00000422 EC                          in al, dx
   717 00000423 5A                          pop dx
   718 00000424 C3                          ret
   719                                  
   720                                  ; 1文字入力　エコーバックあり
   721                                  getc_echo:
   722 00000425 E8EEFF                      call getc
   723 00000428 50                          push ax
   724 00000429 E8D9FF                      call putc
   725 0000042C 58                          pop ax
   726 0000042D C3                          ret
   727                                  
   728                                  ; 改行出力
   729                                  putc_crlf:
   730 0000042E B00D                        mov al, 0x0D
   731 00000430 E8D2FF                      call putc
   732 00000433 B00A                        mov al, 0x0A
   733 00000435 EBCE                        jmp putc
   734                                  
   735                                  ; -----------------------------------------------------------------
   736                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   737                                  ; Input: AX
   738                                  ; -----------------------------------------------------------------
   739                                  print_hex_word:
   740 00000437 50                          push ax
   741 00000438 88E0                        mov al, ah
   742 0000043A E80100                      call print_hex_byte
   743 0000043D 58                          pop ax
   744                                  
   745                                  ; -----------------------------------------------------------------
   746                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   747                                  ; Input: AL
   748                                  ; -----------------------------------------------------------------
   749                                  print_hex_byte:
   750 0000043E 50                          push ax
   751 0000043F 51                          push cx
   752                                  
   753                                      ; 上位バイトの表示
   754 00000440 50                          push ax
   755 00000441 C0E804                      shr al, 4
   756 00000444 E80900                      call .digit
   757                                  
   758                                      ; 下位バイトの表示
   759 00000447 58                          pop ax
   760 00000448 240F                        and al, 0x0F
   761 0000044A E80300                      call .digit
   762                                  
   763 0000044D 59                          pop cx
   764 0000044E 58                          pop ax
   765 0000044F C3                          ret
   766                                  
   767                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   768                                  .digit:
   769 00000450 0430                        add al, '0'
   770 00000452 3C39                        cmp al, '9'
   771 00000454 7602                        jbe .p
   772 00000456 0407                        add al, 7
   773 00000458 E8AAFF                  .p: call putc
   774 0000045B C3                          ret
   775                                  
   776                                  ; -----------------------------------------------------------------
   777                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   778                                  ; Input:  Serial (例: "1", "0", "0", "0")
   779                                  ; Output: AX = 0x1000
   780                                  ; -----------------------------------------------------------------
   781                                  get_hex_word:
   782 0000045C 53                          push bx
   783 0000045D E80B00                      call get_hex_byte_echo
   784 00000460 88C7                        mov bh, al
   785 00000462 E80600                      call get_hex_byte_echo
   786 00000465 88C3                        mov bl, al
   787 00000467 89D8                        mov ax, bx
   788 00000469 5B                          pop bx
   789 0000046A C3                          ret
   790                                  
   791                                  ; 16進数2桁入力　エコーバック有り
   792                                  get_hex_byte_echo:
   793 0000046B 53                          push bx
   794 0000046C E8B6FF                      call getc_echo
   795 0000046F E82500                      call hex_char_to_bin
   796 00000472 C0E004                      shl al, 4
   797 00000475 88C3                        mov bl, al
   798 00000477 E8ABFF                      call getc_echo
   799 0000047A E81A00                      call hex_char_to_bin
   800 0000047D 08D8                        or al, bl
   801 0000047F 5B                          pop bx
   802 00000480 C3                          ret
   803                                  
   804                                  ; -----------------------------------------------------------------
   805                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   806                                  ; Input:  Serial (例: "3", "F")
   807                                  ; Output: AL = 0x3F
   808                                  ; -----------------------------------------------------------------
   809                                  get_hex_byte:
   810 00000481 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   811                                  
   812                                      ; 上位4bit
   813 00000482 E891FF                      call getc
   814 00000485 E80F00                      call hex_char_to_bin
   815 00000488 C0E004                      shl al, 4
   816 0000048B 88C3                        mov bl, al          ; 一時保存
   817                                      
   818                                      ; 下位4bit
   819 0000048D E886FF                      call getc
   820 00000490 E80400                      call hex_char_to_bin
   821 00000493 08D8                        or al, bl           ; 上位を合成して結果はALへ
   822 00000495 5B                          pop bx
   823 00000496 C3                          ret
   824                                  
   825                                  ; -----------------------------------------------------------------
   826                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   827                                  ; Input: AL (ASCII)
   828                                  ; Output: AL (Binary)
   829                                  ; -----------------------------------------------------------------
   830                                  hex_char_to_bin:
   831 00000497 2C30                        sub al, '0'
   832 00000499 3C09                        cmp al, 9
   833 0000049B 7604                        jbe .done
   834 0000049D 2C07                        sub al, 7           ; 'A'-'F'対応
   835 0000049F 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   836                                  .done:
   837 000004A1 C3                          ret
   838                                  
   839                                  ; -----------------------------------------------------------------
   840                                  ; Helper: スペースなどを読み飛ばす
   841                                  ; -----------------------------------------------------------------
   842                                  skip_space:
   843 000004A2 E880FF                      call getc_echo
   844 000004A5 C3                          ret
   845                                  
   846                                  ; -----------------------------------------------------------------
   847                                  ; Helper: エラーメッセージ出力後モニタに戻る
   848                                  ; -----------------------------------------------------------------
   849                                  error:
   850 000004A6 BE[8308]                    mov si, msg_error
   851 000004A9 E84BFF                      call puts
   852 000004AC E958FC                      jmp monitor_loop
   853                                  
   854                                  ; ---------------------------------------------------------
   855                                  ; INTP0 (Vector 20h) ハンドラ　Timer0 (100Hz) 割り込み
   856                                  ; ---------------------------------------------------------
   857 000004AF 90                      align 2
   858                                  _isr_intp0:
   859 000004B0 60                          pusha               ; 全汎用レジスタ保存 (AX,CX,DX,BX,SP,BP,SI,DI)
   860 000004B1 1E                          push ds             ; セグメントレジスタ保存
   861 000004B2 06                          push es
   862                                  
   863                                      ; --- DSの設定 (重要: 変数にアクセスするため) ---
   864 000004B3 8CC8                        mov ax, cs
   865 000004B5 8ED8                        mov ds, ax
   866                                  
   867                                      ; --- 32bit カウンタのインクリメント ---
   868 000004B7 FF06[3C0A]                  inc word [tick_counter_lo]
   869 000004BB 7504                        jnz .skip_carry
   870 000004BD FF06[3E0A]                  inc word [tick_counter_hi]
   871                                  .skip_carry:
   872                                      ; --- EOI (End of Interrupt) 発行 ---
   873                                      ; これを送らないと次の割り込みが発生しません
   874 000004C1 B020                        mov al, 20h         ; Non-Specific EOI
   875 000004C3 BAC000                      mov dx, ICU_REG0
   876 000004C6 EE                          out dx, al
   877                                  
   878                                      ; --- 復帰処理 ---
   879 000004C7 07                          pop es
   880 000004C8 1F                          pop ds
   881 000004C9 61                          popa                ; 保存したレジスタをすべて復帰
   882                                  
   883 000004CA CF                          iret                ; 割り込みから復帰 (IP, CS, Flagsをpop)
   884                                  
   885                                  ; ---------------------------------------------------------
   886                                  ; INTP1 (Vector 21h) ハンドラ - 詳細不明
   887                                  ; ---------------------------------------------------------
   888 000004CB 90                      align 2
   889                                  _isr_intp1:
   890 000004CC 60                          pusha
   891 000004CD 1E                          push ds
   892 000004CE 06                          push es
   893                                  
   894                                      ; 1. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   895 000004CF 8CC8                        mov  ax, cs
   896 000004D1 8ED8                        mov  ds, ax
   897 000004D3 8EC0                        mov  es, ax
   898                                  
   899                                      ; 2. 発生フラグをセット
   900 000004D5 FF06[400A]                  inc  word [intp1_flag]
   901                                      
   902                                      ; --- 画面表示 ---
   903 000004D9 BE[7A09]                    mov  si, msg_intp1
   904 000004DC E818FF                      call puts
   905                                      
   906                                      ; EOI発行
   907 000004DF B020                        mov  al, 20h
   908 000004E1 BAC000                      mov  dx, ICU_REG0
   909 000004E4 EE                          out  dx, al
   910                                  
   911 000004E5 07                          pop  es
   912 000004E6 1F                          pop  ds
   913 000004E7 61                          popa
   914 000004E8 CF                          iret
   915                                  
   916                                  ; ---------------------------------------------------------
   917                                  ; INTP2 (Vector 22h) ハンドラ - 詳細不明
   918                                  ; ---------------------------------------------------------
   919 000004E9 90                      align 2
   920                                  _isr_intp2:
   921 000004EA 60                          pusha
   922 000004EB 1E                          push ds
   923 000004EC 06                          push es
   924                                  
   925                                      ; 1. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   926 000004ED 8CC8                        mov  ax, cs
   927 000004EF 8ED8                        mov  ds, ax
   928 000004F1 8EC0                        mov  es, ax
   929                                  
   930                                      ; 2. 発生フラグをセット
