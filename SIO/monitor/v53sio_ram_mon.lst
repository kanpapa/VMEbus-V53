     1                                  ; =================================================================
     2                                  ; V53 RAM Monitor for DVE-554 v0.2 2026-04-25
     3                                  ; Target: DVE-554 SIO VME Board
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; Real:   nasm -f bin v53sio_ram_mon.asm -o v53sio_ram_mon.bin -l v53sio_ram_mon.lst
     8                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53sio_ram_mon.bin v53sio_ram_mon.hex
     9                                  ; -----------------
    10                                  
    11                                      org 0
    12                                      cpu 186
    13                                  
    14                                      ; V53 ICU (00C0Hに配置)
    15                                      %define ICU_REG0    0x000C0
    16                                      %define ICU_REG1    0x000C2
    17                                  
    18                                      ; V53 TCU (00D0Hに配置)
    19                                      %define TM0_CNT     0x000D0 ; Timer 0 Counter
    20                                      %define TM1_CNT     0x000D2 ; Timer 1 Counter
    21                                      %define TM2_CNT     0x000D4 ; Timer 2 Counter
    22                                      %define TM_CTL      0x000D6 ; Timer Control
    23                                  
    24                                      ; V53 DMAU (00E0Hに配置)
    25                                      ; DMAUはモニタでは使用しないため、レジスタ定義は省略します。
    26                                  
    27                                      ; V53 SCU (00F0Hに配置）
    28                                      ; SCUはモニタでは使用しないため、レジスタ定義は省略します。
    29                                  
    30                                      ; uPD72001 MPSC #1
    31                                      %define MPSC1_A_DATA 0x00A0 ; MPSC #1 Channel A Data Register
    32                                      %define MPSC1_A_CTRL 0x00A2 ; MPSC #1 Channel A Control Register
    33                                      %define MPSC1_B_DATA 0x00A4 ; MPSC #1 Channel B Data Register
    34                                      %define MPSC1_B_CTRL 0x00A6 ; MPSC #1 Channel B Control Register
    35                                  
    36                                      ; uPD72001 MPSC #2
    37                                      %define MPSC2_A_DATA 0x00A8 ; MPSC #2 Channel A Data Register
    38                                      %define MPSC2_A_CTRL 0x00AA ; MPSC #2 Channel A Control Register
    39                                      %define MPSC2_B_DATA 0x00AC ; MPSC #2 Channel B Data Register
    40                                      %define MPSC2_B_CTRL 0x00AE ; MPSC #2 Channel B Control Register
    41                                  
    42                                      ;%define MPSC2_A_DATA 0x00A0 ; MPSC #1 Channel A Data Register
    43                                      ;%define MPSC2_A_CTRL 0x00A2 ; MPSC #1 Channel A Control Register
    44                                      ;%define MPSC2_B_DATA 0x00A4 ; MPSC #1 Channel B Data Register
    45                                      ;%define MPSC2_B_CTRL 0x00A6 ; MPSC #1 Channel B Control Register
    46                                  
    47                                      ; uPD72001 MPSC #2
    48                                      ;%define MPSC1_A_DATA 0x00A8 ; MPSC #2 Channel A Data Register
    49                                      ;%define MPSC1_A_CTRL 0x00AA ; MPSC #2 Channel A Control Register
    50                                      ;%define MPSC1_B_DATA 0x00AC ; MPSC #2 Channel B Data Register
    51                                      ;%define MPSC1_B_CTRL 0x00AE ; MPSC #2 Channel B Control Register
    52                                  
    53                                      %define TX_READY   0x04
    54                                      %define RX_READY   0x01
    55                                  
    56                                  section .text
    57                                  
    58                                  start:
    59 00000000 FA                          cli             ; 初期化中は割り込み禁止
    60 00000001 FC                          cld             ; 文字列操作で方向フラグをクリアしておく
    61                                  
    62                                      ; ---------------------------------------------
    63                                      ; 1. セグメントレジスタ初期化
    64                                      ; ---------------------------------------------
    65 00000002 0E                          push cs     ; CS -> DS
    66 00000003 1F                          pop ds
    67 00000004 0E                          push cs     ; CS -> ES
    68 00000005 07                          pop es
    69 00000006 8CC8                        mov ax, cs  ; CS -> SS
    70 00000008 8ED0                        mov ss, ax
    71 0000000A BCFF7F                      mov sp, 0x7FFF
    72                                      ; ------------------------------
    73                                  
    74 0000000D E8EB05                      call v53_sysreg_init    ; 2. V53 システムレジスタ初期化
    75 00000010 E83B06                      call v53_tcu_init       ; 3. TCU初期化
    76 00000013 E88006                      call v53_icu_init       ; 4. ICU初期化
    77 00000016 E86E06                      call dve554_io_init     ; 5. 物理IOの初期化（詳細不明）
    78                                  
    79                                      ; --- 6. 割り込みベクタの初期化 ---
    80 00000019 31C0                        xor ax, ax
    81 0000001B 8EC0                        mov es, ax              ; ES = 0000h (Vector Table Segment)
    82                                  
    83                                      ; Vector 10h 登録
    84 0000001D 26C7064000[A404]            mov word [es:0x40], _isr_int10h     ; オフセットを書き込み　0x10 * 4 = 0x40
    85 00000024 268C0E4200                  mov word [es:0x42], cs              ; 現在のコードセグメントを書き込み
    86                                  
    87                                      ; Vector 11h 登録
    88 00000029 26C7064400[BB04]            mov word [es:0x44], _isr_int11h
    89 00000030 268C0E4600                  mov word [es:0x46], cs
    90                                  
    91                                      ; Vector 12h 登録
    92 00000035 26C7064800[CB04]            mov word [es:0x48], _isr_int12h
    93 0000003C 268C0E4A00                  mov word [es:0x4A], cs
    94                                  
    95                                      ; Vector 13h 登録
    96 00000041 26C7064C00[DB04]            mov word [es:0x4C], _isr_int13h 
    97 00000048 268C0E4E00                  mov word [es:0x4E], cs
    98                                  
    99                                      ; Vector 14h 登録
   100 0000004D 26C7065000[EB04]            mov word [es:0x50], _isr_int14h
   101 00000054 268C0E5200                  mov word [es:0x52], cs
   102                                  
   103                                      ; Vector 15h 登録
   104 00000059 26C7065400[FB04]            mov word [es:0x54], _isr_int15h
   105 00000060 268C0E5600                  mov word [es:0x56], cs
   106                                  
   107                                      ; Vector 16h 登録
   108 00000065 26C7065800[0B05]            mov word [es:0x58], _isr_int16h
   109 0000006C 268C0E5A00                  mov word [es:0x5A], cs
   110                                  
   111                                      ; Vector 17h 登録
   112 00000071 26C7065C00[1B05]            mov word [es:0x5C], _isr_int17h
   113 00000078 268C0E5E00                  mov word [es:0x5E], cs
   114                                  
   115                                      ; Vector 20h (INTP0) 登録
   116 0000007D 26C7068000[2C05]            mov word [es:0x80], _isr_intp0      ; オフセットを書き込み　0x20 * 4 = 0x80
   117 00000084 268C0E8200                  mov word [es:0x82], cs              ; 現在のコードセグメントを書き込み
   118                                  
   119                                      ; Vector 21h (INTP1) 登録
   120 00000089 26C7068400[4E05]            mov word [es:0x84], _isr_intp1
   121 00000090 268C0E8600                  mov word [es:0x86], cs
   122                                  
   123                                      ; Vector 22h (INTP2) 登録
   124 00000095 26C7068800[6C05]            mov word [es:0x88], _isr_intp2
   125 0000009C 268C0E8A00                  mov word [es:0x8A], cs
   126                                  
   127                                      ; Vector 22h (INTP3) 登録
   128 000000A1 26C7068C00[8A05]            mov word [es:0x8C], _isr_intp3
   129 000000A8 268C0E8E00                  mov word [es:0x8E], cs
   130                                  
   131                                      ; Vector 23h (INTP4) 登録
   132 000000AD 26C7069000[A805]            mov word [es:0x90], _isr_intp4 
   133 000000B4 268C0E9200                  mov word [es:0x92], cs
   134                                  
   135                                      ; Vector 24h (INTP5) 登録
   136 000000B9 26C7069400[BA05]            mov word [es:0x94], _isr_intp5
   137 000000C0 268C0E9600                  mov word [es:0x96], cs
   138                                  
   139                                      ; Vector 25h (INTP6) 登録
   140 000000C5 26C7069800[CC05]            mov word [es:0x98], _isr_intp6
   141 000000CC 268C0E9A00                  mov word [es:0x9A], cs
   142                                  
   143                                      ; Vector 26h (INTP7) 登録
   144 000000D1 26C7069C00[EA05]            mov word [es:0x9C], _isr_intp7
   145 000000D8 268C0E9E00                  mov word [es:0x9E], cs
   146                                  
   147                                      ; ---------------------------------------------
   148                                      ; 7. MPSC初期化
   149                                      ; ---------------------------------------------
   150 000000DD E8DD05                      call mpsc_init
   151                                  
   152                                      ; --- 8. 割り込み許可 ---
   153 000000E0 FB                          sti
   154                                  
   155                                      ; 変数初期化 (RAMエリアをクリア)
   156 000000E1 C706[4609]0000              mov word [dump_seg], 0x0000
   157 000000E7 C706[4809]0000              mov word [dump_off], 0x0000
   158 000000ED C706[4A09]0020              mov word [load_seg], 0x2000
   159                                  
   160                                      ; スタートメッセージの表示
   161 000000F3 BE[AD07]                    mov si, msg_boot
   162 000000F6 E8F302                      call puts
   163                                  
   164                                  ; =================================================================
   165                                  ; Main Loop
   166                                  ; =================================================================
   167                                  monitor_loop:
   168 000000F9 B03E                        mov al, '>'
   169 000000FB E8FC02                      call putc
   170 000000FE B020                        mov al, ' '
   171 00000100 E8F702                      call putc
   172                                  
   173 00000103 E81403                      call getc_echo  ; コマンド受信（エコーあり）
   174 00000106 88C3                        mov bl, al
   175                                      
   176 00000108 80FB64                      cmp bl, 'd'     ; dump command
   177 0000010B 747A                        je do_dump
   178 0000010D 80FB44                      cmp bl, 'D'
   179 00000110 7475                        je do_dump
   180                                      
   181 00000112 80FB6C                      cmp bl, 'l'     ; load command
   182 00000115 7503E9D000                  je do_load
   183 0000011A 80FB4C                      cmp bl, 'L'
   184 0000011D 7503E9C800                  je do_load
   185                                      
   186 00000122 80FB67                      cmp bl, 'g'     ; go command
   187 00000125 7503E94401                  je do_go
   188 0000012A 80FB47                      cmp bl, 'G'
   189 0000012D 7503E93C01                  je do_go
   190                                  
   191 00000132 80FB77                      cmp bl, 'w'     ; Write command
   192 00000135 7503E96001                  je do_write
   193 0000013A 80FB57                      cmp bl, 'W'
   194 0000013D 7503E95801                  je do_write
   195                                  
   196 00000142 3C69                        cmp al, 'i'     ; Input Port command
   197 00000144 7503E99401                  je do_in
   198 00000149 3C49                        cmp al, 'I'
   199 0000014B 7503E98D01                  je do_in
   200                                  
   201 00000150 3C6F                        cmp al, 'o'     ; Output Port command
   202 00000152 7503E9AA01                  je do_out
   203 00000157 3C4F                        cmp al, 'O'
   204 00000159 7503E9A301                  je do_out
   205                                  
   206 0000015E 3C73                        cmp al, 's'     ; Scan I/O command
   207 00000160 7503E9C601                  je do_scan
   208 00000165 3C53                        cmp al, 'S'
   209 00000167 7503E9BF01                  je do_scan
   210                                  
   211 0000016C 3C74                        cmp al, 't'     ; Scan Timer wait command
   212 0000016E 7503E92A02                  je do_timer
   213 00000173 3C54                        cmp al, 'T'
   214 00000175 7503E92302                  je do_timer
   215                                  
   216 0000017A 3C3F                        cmp al, '?'     ; Help
   217 0000017C 7503E95F02                  je cmd_help
   218                                  
   219                                      ; 知らないコマンドなら改行して戻る
   220 00000181 E89F02                      call putc_crlf
   221 00000184 E972FF                      jmp monitor_loop
   222                                  
   223                                  ; =================================================================
   224                                  ; Command: Dump Memory
   225                                  ; Usage:
   226                                  ;   D               -> Dump next 64 bytes
   227                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   228                                  ; =================================================================
   229                                  do_dump:
   230 00000187 E89002                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   231 0000018A 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   232 0000018C 7418                        je .dump_run
   233 0000018E 3C20                        cmp al, ' '         ; Spaceなら引数解析
   234 00000190 7405                        je .parse_args
   235                                      
   236                                      ; それ以外なら無視して実行へ（またはエラー処理）
   237 00000192 E88E02                      call putc_crlf
   238 00000195 EB12                        jmp .dump_run_start
   239                                  
   240                                  .parse_args:
   241 00000197 E8B702                      call get_hex_word
   242 0000019A A3[4609]                    mov [dump_seg], ax
   243 0000019D E8F702                      call skip_space
   244 000001A0 E8AE02                      call get_hex_word
   245 000001A3 A3[4809]                    mov [dump_off], ax
   246                                      ; ここでEnter待ちをするか、そのまま実行するか
   247                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   248                                      
   249                                  .dump_run:
   250 000001A6 E87A02                      call putc_crlf              ; 実行直前に改行
   251                                  
   252                                  .dump_run_start:
   253 000001A9 B90400                      mov cx, 4                   ; 4行表示する
   254                                      
   255                                  .line_loop:
   256 000001AC 51                          push cx
   257                                      
   258 000001AD A1[4609]                    mov ax, [dump_seg]          ; セグメントの表示
   259 000001B0 E87902                      call print_hex_word
   260 000001B3 B03A                        mov al, ':'                 ; 区切り文字の:を表示
   261 000001B5 E84202                      call putc
   262 000001B8 A1[4809]                    mov ax, [dump_off]          ; オフセットの表示
   263 000001BB E86E02                      call print_hex_word
   264 000001BE B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   265 000001C0 E83702                      call putc
   266                                  
   267 000001C3 8B36[4809]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   268                                  
   269 000001C7 1E                          push ds                     ; モニタのDSを保存
   270 000001C8 8E1E[4609]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   271                                      
   272 000001CC B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   273                                  .hex_loop:
   274 000001CF 8A04                        mov al, [si]
   275 000001D1 E85F02                      call print_hex_byte         ; メモリ内容の表示
   276 000001D4 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   277 000001D6 E82102                      call putc
   278 000001D9 46                          inc si                      ; 次のアドレスにする
   279 000001DA E2F3                        loop .hex_loop              ; 16回繰り返し    
   280                                  
   281 000001DC 1F                          pop ds                      ; DSをモニタ用に戻す
   282                                  
   283 000001DD 8936[4809]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   284                                  
   285 000001E1 E83F02                      call putc_crlf              ; 改行する
   286 000001E4 59                          pop cx
   287 000001E5 E2C5                        loop .line_loop             ; 4回繰り返す
   288                                      
   289 000001E7 E90FFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   290                                  
   291                                  ; =================================================================
   292                                  ; Command: Load Intel HEX
   293                                  ; Usage:
   294                                  ;   L           -> Load to default segment (load_seg)
   295                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   296                                  ; =================================================================
   297                                  do_load:
   298                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   299 000001EA A1[4A09]                    mov ax, [load_seg]
   300 000001ED 06                          push es             ; RAM用ESを保存
   301 000001EE 50                          push ax             ; デフォルトセグメントを保存
   302                                      
   303 000001EF E82802                      call getc_echo
   304 000001F2 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   305 000001F4 7402                        je .parse_seg
   306 000001F6 EB05                        jmp .start_load
   307                                  
   308                                  .parse_seg:
   309 000001F8 58                          pop ax              ; 不要になったデフォルトを捨てる
   310 000001F9 E85502                      call get_hex_word   ; 新しいセグメント取得
   311 000001FC 50                          push ax             ; 保存
   312                                  
   313                                  .start_load:
   314 000001FD E82302                      call putc_crlf      ; メッセージ表示前に改行
   315 00000200 BE[E507]                    mov si, msg_load    ; ロード開始メッセージを表示
   316 00000203 E8E601                      call puts
   317                                      
   318 00000206 58                          pop ax
   319 00000207 8EC0                        mov es, ax          ; ロード先をESに設定
   320                                      
   321                                      ; ターゲット表示
   322 00000209 E82002                      call print_hex_word ; ESの値を表示
   323 0000020C B03A                        mov al, ':'         ; 区切り文字を表示
   324 0000020E E8E901                      call putc
   325 00000211 B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   326 00000213 E8E401                      call putc
   327 00000216 E80A02                      call putc_crlf
   328                                  
   329                                  .wait_record:
   330 00000219 E8EF01                      call getc           ; 開始文字を待つ
   331 0000021C 3C3A                        cmp al, ':'
   332 0000021E 75F9                        jne .wait_record
   333                                  
   334 00000220 E85302                      call get_hex_byte   ; データ長を読み込み
   335 00000223 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   336 00000225 B500                        mov ch, 0
   337                                      
   338 00000227 E84C02                      call get_hex_byte   ; 上位アドレスを読み込み
   339 0000022A 88C7                        mov bh, al
   340 0000022C E84702                      call get_hex_byte   ; 下位アドレスを読み込み
   341 0000022F 88C3                        mov bl, al
   342                                      
   343 00000231 E84202                      call get_hex_byte   ; レコードタイプを読み込み
   344 00000234 3C01                        cmp al, 01          ; End of File?
   345 00000236 7422                        je .handle_eof      ; EOFの処理へ
   346 00000238 3C00                        cmp al, 00          ; Data Record?
   347 0000023A 7523                        jne .skip_line      ; その他はスキップ
   348                                      
   349 0000023C E312                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   350                                      
   351                                  .data_loop:
   352 0000023E E83502                      call get_hex_byte   ; 1バイト読み取り
   353 00000241 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   354 00000244 43                          inc bx              ; 次のアドレスにする
   355                                      ; --- 追加: 64KBの境界チェック ---
   356 00000245 7507                        jnz .loop_next      ; bxが0にならなければそのまま
   357 00000247 8CC0                        mov ax, es          ; bxが0(一周)したら
   358 00000249 050010                      add ax, 0x1000      ; セグメントを64KB分(0x1000)進める
   359 0000024C 8EC0                        mov es, ax
   360                                      ; -----------------------------
   361                                  
   362                                  .loop_next:
   363 0000024E E2EE                        loop .data_loop     ; データ長分繰り返す
   364                                      
   365                                  .read_chk:
   366 00000250 E82302                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   367 00000253 B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   368 00000255 E8A201                      call putc
   369 00000258 EBBF                        jmp .wait_record    ; 次のレコード読み取りへ
   370                                  
   371                                  .handle_eof:            ; EOFの場合
   372 0000025A E81902                      call get_hex_byte   ; チェックサムを読み飛ばす
   373 0000025D EB02                        jmp .finish         ; 読み込み終了処理へ
   374                                  
   375                                  .skip_line:
   376 0000025F EBB8                        jmp .wait_record    ; 次のレコード読み込みへ
   377                                  
   378                                  .finish:
   379 00000261 07                          pop es              ; RAM用ESを復帰
   380 00000262 E8BE01                      call putc_crlf
   381 00000265 BE[F107]                    mov si, msg_ok      ; "OK"を表示
   382 00000268 E88101                      call puts
   383 0000026B E98BFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   384                                  
   385                                  ; =================================================================
   386                                  ; Command: Execute
   387                                  ; Usage:
   388                                  ;   G <Seg> <Off>
   389                                  ; Example: G 1000 0000
   390                                  ; =================================================================
   391                                  do_go:
   392                                      ; Gコマンドは入力後に改行
   393                                      
   394 0000026E E8A901                      call getc_echo      ; Space?
   395 00000271 3C20                        cmp al, ' '
   396 00000273 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   397                                      
   398                                      ; 1. セグメント (SSSS) を取得
   399 00000275 E8D901                      call get_hex_word   ; AX = Segment
   400 00000278 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   401 00000279 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   402                                      
   403                                      ; スペース読み飛ばし (もしあれば)
   404 0000027B E81902                      call skip_space
   405                                      
   406                                      ; 2. オフセット (OOOO) を取得
   407 0000027E E8D001                      call get_hex_word   ; AX = Offset
   408 00000281 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   409                                      
   410 00000282 E89E01                      call putc_crlf      ; 実行前に改行
   411 00000285 BE[F407]                    mov si, msg_go
   412 00000288 E86101                      call puts
   413 0000028B E89501                      call putc_crlf
   414                                      
   415                                      ; 3. 実行環境のセットアップ
   416                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   417 0000028E 8EDB                        mov ds, bx
   418 00000290 8EC3                        mov es, bx
   419                                  
   420                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   421 00000292 FA                          cli
   422                                  
   423                                      ; 4. ジャンプ！ (Far Return)
   424                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   425 00000293 CB                          retf                ; Jump!
   426                                  
   427                                  .go_default:
   428 00000294 E88C01                      call putc_crlf      ; 改行して
   429 00000297 E95FFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   430                                  
   431                                  ; ==============================================================
   432                                  ; Command: Write Memory
   433                                  ; Usage:
   434                                  ;   W <Seg> <Off> <Val>
   435                                  ; ==============================================================
   436                                  do_write:    
   437 0000029A E87D01                      call getc_echo      ; Space?
   438 0000029D 3C20                        cmp al, ' '
   439 0000029F 7403E9F701                  jne error           ; 引数なしならリターン(またはエラー)
   440                                  
   441                                      ; 1. セグメント (SSSS) を取得
   442 000002A4 E8AA01                      call get_hex_word   ; AX = Segment
   443 000002A7 50                          push ax             ; ターゲットセグメントを保存
   444                                      
   445 000002A8 E86F01                      call getc_echo      ; Space?
   446 000002AB 3C20                        cmp al, ' '
   447 000002AD 7403E9E901                  jne error           ; 引数なしならリターン(またはエラー)
   448                                      
   449                                      ; 2. オフセット (OOOO) を取得
   450 000002B2 E89C01                      call get_hex_word   ; AX = Offset
   451 000002B5 50                          push ax             ; ターゲットオフセットを保存
   452                                  
   453 000002B6 E86101                      call getc_echo      ; Space?
   454 000002B9 3C20                        cmp al, ' '
   455 000002BB 7403E9DB01                  jne error           ; 引数なしならリターン(またはエラー)
   456                                  
   457                                      ; 3. 設定データ (VV) を取得
   458 000002C0 E89D01                      call get_hex_byte_echo   ; AL = Value
   459                                  
   460 000002C3 5B                          pop bx              ; bx = Offset
   461 000002C4 5A                          pop dx              ; dx = Target Segment
   462                                  
   463                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   464 000002C5 8916[4609]                  mov [dump_seg], dx
   465 000002C9 891E[4809]                  mov [dump_off], bx
   466                                      
   467 000002CD 8EDA                        mov ds, dx          ; DS再設定
   468 000002CF 3E8807                      mov [ds:bx], al     ; 書き込み！
   469                                      
   470 000002D2 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   471 000002D3 1F                          pop ds
   472                                  
   473 000002D4 BE[1708]                    mov si, msg_done
   474 000002D7 E81201                      call puts
   475 000002DA E91CFE                      jmp monitor_loop
   476                                  
   477                                  ; ==============================================================
   478                                  ; Command: Input from Port
   479                                  ; Usage:
   480                                  ;   I <Port>
   481                                  ; ==============================================================
   482                                  do_in:
   483 000002DD E83A01                      call getc_echo
   484 000002E0 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   485 000002E2 7403E9B401                  jne error           ; パラメタが無い場合はエラー処理へ
   486                                  
   487 000002E7 E86701                      call get_hex_word   ; ポートアドレスを取得
   488 000002EA 89C2                        mov dx, ax          ; 保存
   489 000002EC EC                          in al, dx           ; I/O Read
   490                                      
   491 000002ED 50                          push ax
   492 000002EE E83201                      call putc_crlf      ; メッセージ表示前に改行
   493 000002F1 BE[1108]                    mov si, msg_in_res
   494 000002F4 E8F500                      call puts
   495 000002F7 58                          pop ax
   496                                  
   497 000002F8 E83801                      call print_hex_byte ; 値を表示
   498                                  
   499 000002FB E82501                      call putc_crlf      ; 改行して
   500 000002FE E9F8FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   501                                  
   502                                  ; ==============================================================
   503                                  ; Command: Output to Port
   504                                  ; Usage
   505                                  ;   O <Port> <Val>
   506                                  ; ==============================================================
   507                                  do_out:
   508 00000301 E81601                      call getc_echo
   509 00000304 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   510 00000306 7403E99001                  jne error           ; パラメタが無い場合はエラー処理へ
   511                                  
   512 0000030B E84301                      call get_hex_word   ; ポートアドレスを取得
   513 0000030E 50                          push ax             ; スタックに積む
   514                                  
   515 0000030F E80801                      call getc_echo
   516 00000312 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   517 00000314 7511                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   518                                      
   519 00000316 E84701                      call get_hex_byte_echo   ; 出力値を取得
   520 00000319 5A                          pop dx              ; スタックからDXにセット
   521                                      
   522 0000031A EE                          out dx, al          ; I/O Write
   523                                      
   524 0000031B E80501                      call putc_crlf      ; 書き込み完了後、まず改行する
   525 0000031E BE[1708]                    mov si, msg_done    ; DONEを表示。改行付き。
   526 00000321 E8C800                      call puts
   527                                      
   528 00000324 E9D2FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   529                                  
   530                                  error_pop:
   531 00000327 58                          pop ax              ; 使わなかったスタックを捨てる
   532 00000328 E97001                      jmp error
   533                                  
   534                                  ; ==============================================================
   535                                  ; Command: Scan I/O Ports
   536                                  ; Usage:
   537                                  ;   S <Start_port> <End_port>
   538                                  ; Description: Reads ports and prints if value is NOT 0xFF
   539                                  ; ==============================================================
   540                                  do_scan:
   541 0000032B E8EC00                      call getc_echo
   542 0000032E 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   543 00000330 7403E96601                  jne error           ; パラメタが無い場合はエラー処理へ
   544                                  
   545 00000335 E81901                      call get_hex_word   ; スタートポートアドレスを取得
   546 00000338 89C3                        mov bx, ax          ; BX = Start Address
   547                                      
   548 0000033A E8DD00                      call getc_echo
   549 0000033D 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   550 0000033F 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   551                                  
   552 00000341 E80D01                      call get_hex_word   ; エンドポートアドレスを取得
   553 00000344 89C1                        mov cx, ax          ; CX = End Address
   554                                  
   555 00000346 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   556 00000348 7603E94E01                  ja error
   557                                  
   558 0000034D E8D300                      call putc_crlf
   559 00000350 BE[A608]                    mov si, msg_scan_start
   560 00000353 E89600                      call puts
   561                                  
   562                                  .scan_loop:
   563 00000356 89DA                        mov dx, bx          ; DXにポートアドレス設定
   564 00000358 EC                          in al, dx           ; I/O Read
   565                                  
   566 00000359 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   567 0000035B 741D                        je .next_port
   568                                  
   569 0000035D 50                          push ax             ; Readした値をスタックに保存
   570                                  
   571                                      ; --- 有効な値が見つかった場合の表示 ---
   572                                      ; [Port]: Value
   573 0000035E 89D8                        mov ax, bx
   574 00000360 E8C900                      call print_hex_word ; ポートアドレスの表示
   575 00000363 B03A                        mov al, ':'
   576 00000365 E89200                      call putc
   577 00000368 B020                        mov al, ' '
   578 0000036A E88D00                      call putc
   579                                      
   580 0000036D 58                          pop ax
   581 0000036E E8C200                      call print_hex_byte ; Readした値の表示
   582                                      
   583 00000371 BE[D108]                    mov si, msg_space   ; "  "
   584 00000374 E87500                      call puts
   585                                  
   586                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   587                                      ; ここでは単純にリスト形式で改行します
   588 00000377 E8A900                      call putc_crlf
   589                                  
   590                                  .next_port:
   591 0000037A 43                          inc bx              ; 次のアドレスへ
   592                                      
   593                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   594 0000037B BAA200                      mov dx, MPSC1_A_CTRL
   595 0000037E EC                          in al, dx
   596 0000037F A801                        test al, RX_READY   ; RxRDY?
   597 00000381 750D                        jnz .abort          ; 何かキーが押されたら中断
   598                                  
   599 00000383 39CB                        cmp bx, cx
   600 00000385 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   601                                  
   602 00000387 BE[1708]                    mov si, msg_done
   603 0000038A E85F00                      call puts
   604 0000038D E969FD                      jmp monitor_loop
   605                                  
   606                                  .abort:
   607                                      ; 入力バッファを空読みしておく
   608 00000390 BAA000                      mov dx, MPSC1_A_DATA
   609 00000393 EC                          in al, dx
   610 00000394 BE[D408]                    mov si, msg_abort
   611 00000397 E85200                      call puts
   612 0000039A E95CFD                      jmp monitor_loop
   613                                  
   614                                  ; ==============================================================
   615                                  ; Command: Timer
   616                                  ;   T          -> Show current tick counter (32-bit HEX)
   617                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   618                                  ; ==============================================================
   619                                  do_timer:
   620 0000039D E87A00                      call getc_echo      ; コマンド('T')の次の文字を取得
   621 000003A0 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   622 000003A2 7421                        je .show_counter
   623 000003A4 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   624 000003A6 7403E9F000                  jne error           ; それ以外はエラー
   625                                  
   626                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   627 000003AB E8A300                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   628                                  
   629                                      ; 開始時刻を保存 (Start Time)
   630 000003AE 8B1E[4C09]                  mov bx, [tick_counter_lo]
   631                                  
   632                                  .wait_loop:
   633                                      ; 1. 現在時刻を取得
   634 000003B2 8B0E[4C09]                  mov cx, [tick_counter_lo]
   635                                      
   636                                      ; 2. 経過時間を計算 (Current - Start)
   637                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   638 000003B6 29D9                        sub cx, bx          
   639                                      
   640                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   641 000003B8 39C1                        cmp cx, ax
   642 000003BA 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   643                                  
   644                                      ; 指定時間経過した
   645 000003BC BE[1708]                    mov si, msg_done
   646 000003BF E82A00                      call puts
   647 000003C2 E934FD                      jmp monitor_loop
   648                                  
   649                                  .show_counter:
   650                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   651 000003C5 E85B00                      call putc_crlf
   652                                      
   653 000003C8 BE[DF08]                    mov si, msg_tick    ; "Tick: "
   654 000003CB E81E00                      call puts
   655                                  
   656                                      ; 32bitカウンタを [High][Low] の順で表示
   657 000003CE A1[4E09]                    mov ax, [tick_counter_hi]
   658 000003D1 E85800                      call print_hex_word
   659 000003D4 A1[4C09]                    mov ax, [tick_counter_lo]
   660 000003D7 E85200                      call print_hex_word
   661                                      
   662 000003DA E84600                      call putc_crlf
   663 000003DD E919FD                      jmp monitor_loop
   664                                  
   665                                  ; ==============================================================
   666                                  ; Command: Help
   667                                  ; ==============================================================
   668                                  cmd_help:
   669 000003E0 E84000                      call putc_crlf
   670 000003E3 BE[2308]                    mov si, msg_help
   671 000003E6 E80300                      call puts
   672 000003E9 E90DFD                      jmp monitor_loop
   673                                  
   674                                  ; =================================================================
   675                                  ; Utilities
   676                                  ; =================================================================
   677                                  
   678                                  ; 文字列出力
   679                                  puts:
   680 000003EC 2E8A04                      mov al, [cs:si]
   681 000003EF 08C0                        or al, al
   682 000003F1 7406                        jz .ret
   683 000003F3 E80400                      call putc
   684 000003F6 46                          inc si
   685 000003F7 EBF3                        jmp puts
   686 000003F9 C3                      .ret: ret
   687                                  
   688                                  ; 1文字出力
   689                                  putc:
   690 000003FA 52                          push dx
   691 000003FB 50                          push ax
   692 000003FC BAA200                      mov dx, MPSC1_A_CTRL
   693                                  .wait_tx:
   694 000003FF EC                          in al, dx
   695 00000400 A804                        test al, TX_READY   ; D2: Tx Buffer Empty?
   696 00000402 74FB                        jz .wait_tx
   697 00000404 BAA000                      mov dx, MPSC1_A_DATA
   698 00000407 58                          pop ax
   699 00000408 EE                          out dx, al
   700 00000409 5A                          pop dx
   701 0000040A C3                          ret
   702                                  
   703                                  ; 1文字入力
   704                                  getc:
   705 0000040B 52                          push dx
   706 0000040C BAA200                      mov dx, MPSC1_A_CTRL
   707                                  .wait_rx:
   708 0000040F EC                          in al, dx
   709 00000410 A801                        test al, RX_READY   ; D0: RX Ready?
   710 00000412 74FB                        jz .wait_rx
   711 00000414 BAA000                      mov dx, MPSC1_A_DATA
   712 00000417 EC                          in al, dx
   713 00000418 5A                          pop dx
   714 00000419 C3                          ret
   715                                  
   716                                  ; 1文字入力　エコーバックあり
   717                                  getc_echo:
   718 0000041A E8EEFF                      call getc
   719 0000041D 50                          push ax
   720 0000041E E8D9FF                      call putc
   721 00000421 58                          pop ax
   722 00000422 C3                          ret
   723                                  
   724                                  ; 改行出力
   725                                  putc_crlf:
   726 00000423 B00D                        mov al, 0x0D
   727 00000425 E8D2FF                      call putc
   728 00000428 B00A                        mov al, 0x0A
   729 0000042A EBCE                        jmp putc
   730                                  
   731                                  ; -----------------------------------------------------------------
   732                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   733                                  ; Input: AX
   734                                  ; -----------------------------------------------------------------
   735                                  print_hex_word:
   736 0000042C 50                          push ax
   737 0000042D 88E0                        mov al, ah
   738 0000042F E80100                      call print_hex_byte
   739 00000432 58                          pop ax
   740                                  
   741                                  ; -----------------------------------------------------------------
   742                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   743                                  ; Input: AL
   744                                  ; -----------------------------------------------------------------
   745                                  print_hex_byte:
   746 00000433 50                          push ax
   747 00000434 51                          push cx
   748                                  
   749                                      ; 上位バイトの表示
   750 00000435 50                          push ax
   751 00000436 C0E804                      shr al, 4
   752 00000439 E80900                      call .digit
   753                                  
   754                                      ; 下位バイトの表示
   755 0000043C 58                          pop ax
   756 0000043D 240F                        and al, 0x0F
   757 0000043F E80300                      call .digit
   758                                  
   759 00000442 59                          pop cx
   760 00000443 58                          pop ax
   761 00000444 C3                          ret
   762                                  
   763                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   764                                  .digit:
   765 00000445 0430                        add al, '0'
   766 00000447 3C39                        cmp al, '9'
   767 00000449 7602                        jbe .p
   768 0000044B 0407                        add al, 7
   769 0000044D E8AAFF                  .p: call putc
   770 00000450 C3                          ret
   771                                  
   772                                  ; -----------------------------------------------------------------
   773                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   774                                  ; Input:  Serial (例: "1", "0", "0", "0")
   775                                  ; Output: AX = 0x1000
   776                                  ; -----------------------------------------------------------------
   777                                  get_hex_word:
   778 00000451 53                          push bx
   779 00000452 E80B00                      call get_hex_byte_echo
   780 00000455 88C7                        mov bh, al
   781 00000457 E80600                      call get_hex_byte_echo
   782 0000045A 88C3                        mov bl, al
   783 0000045C 89D8                        mov ax, bx
   784 0000045E 5B                          pop bx
   785 0000045F C3                          ret
   786                                  
   787                                  ; 16進数2桁入力　エコーバック有り
   788                                  get_hex_byte_echo:
   789 00000460 53                          push bx
   790 00000461 E8B6FF                      call getc_echo
   791 00000464 E82500                      call hex_char_to_bin
   792 00000467 C0E004                      shl al, 4
   793 0000046A 88C3                        mov bl, al
   794 0000046C E8ABFF                      call getc_echo
   795 0000046F E81A00                      call hex_char_to_bin
   796 00000472 08D8                        or al, bl
   797 00000474 5B                          pop bx
   798 00000475 C3                          ret
   799                                  
   800                                  ; -----------------------------------------------------------------
   801                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   802                                  ; Input:  Serial (例: "3", "F")
   803                                  ; Output: AL = 0x3F
   804                                  ; -----------------------------------------------------------------
   805                                  get_hex_byte:
   806 00000476 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   807                                  
   808                                      ; 上位4bit
   809 00000477 E891FF                      call getc
   810 0000047A E80F00                      call hex_char_to_bin
   811 0000047D C0E004                      shl al, 4
   812 00000480 88C3                        mov bl, al          ; 一時保存
   813                                      
   814                                      ; 下位4bit
   815 00000482 E886FF                      call getc
   816 00000485 E80400                      call hex_char_to_bin
   817 00000488 08D8                        or al, bl           ; 上位を合成して結果はALへ
   818 0000048A 5B                          pop bx
   819 0000048B C3                          ret
   820                                  
   821                                  ; -----------------------------------------------------------------
   822                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   823                                  ; Input: AL (ASCII)
   824                                  ; Output: AL (Binary)
   825                                  ; -----------------------------------------------------------------
   826                                  hex_char_to_bin:
   827 0000048C 2C30                        sub al, '0'
   828 0000048E 3C09                        cmp al, 9
   829 00000490 7604                        jbe .done
   830 00000492 2C07                        sub al, 7           ; 'A'-'F'対応
   831 00000494 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   832                                  .done:
   833 00000496 C3                          ret
   834                                  
   835                                  ; -----------------------------------------------------------------
   836                                  ; Helper: スペースなどを読み飛ばす
   837                                  ; -----------------------------------------------------------------
   838                                  skip_space:
   839 00000497 E880FF                      call getc_echo
   840 0000049A C3                          ret
   841                                  
   842                                  ; -----------------------------------------------------------------
   843                                  ; Helper: エラーメッセージ出力後モニタに戻る
   844                                  ; -----------------------------------------------------------------
   845                                  error:
   846 0000049B BE[FB07]                    mov si, msg_error
   847 0000049E E84BFF                      call puts
   848 000004A1 E955FC                      jmp monitor_loop
   849                                  
