   851                                  ; Vector 10h
   852                                  ; --------------------------------------
   853                                  _isr_int10h:
   854 000004A4 FA                          CLI	                        ;割り込み禁止
   855 000004A5 50                          PUSH AX                     ;レジスタ保存
   856 000004A6 53                          PUSH BX                     ;レジスタ保存
   857 000004A7 52                          PUSH DX                 	;レジスタ保存
   858 000004A8 FF06[5009]                  inc word [int10h_flag]      ;発生フラグセット
   859 000004AC E80500                      CALL send_38h	            ;EOI発行サブルーチン呼出
   860 000004AF 5A                          POP DX
   861 000004B0 5B                          POP BX
   862 000004B1 58                          POP AX	                    ;レジスタ復帰
   863 000004B2 FB                          STI	                        ;割り込み許可
   864 000004B3 CF                          IRET	                    ;割り込み復帰
   865                                  
   866                                  send_38h:
   867 000004B4 BAA200                  	MOV DX, MPSC1_A_CTRL	;MPSC #1 コマンドポート 00A2h を指定
   868 000004B7 B038                        MOV AL, 38h
   869 000004B9 EE                          OUT DX, AL	    ;ポートへ出力
   870 000004BA C3                          RET
