     1                                  ; =================================================================
     2                                  ; V53 RAM Monitor for DVE-554 v0.1 2026-04-18
     3                                  ; Target: DVE-554 SIO VME Board
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; Real:   nasm -f bin v53sio_ram_mon.asm -o v53sio_ram_mon.bin -l v53sio_ram_mon.lst
     8                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53sio_ram_mon.bin v53sio_ram_mon.hex
     9                                  ; -----------------
    10                                  
    11                                      org 0
    12                                      cpu 186
    13                                  
    14                                      ; V53 ICU (00C0Hに配置)
    15                                      %define ICU_REG0    0x000C0
    16                                      %define ICU_REG1    0x000C2
    17                                  
    18                                      ; V53 TCU (00D0Hに配置)
    19                                      %define TM0_CNT     0x000D0 ; Timer 0 Counter
    20                                      %define TM1_CNT     0x000D2 ; Timer 1 Counter
    21                                      %define TM2_CNT     0x000D4 ; Timer 2 Counter
    22                                      %define TM_CTL      0x000D6 ; Timer Control
    23                                  
    24                                      ; V53 DMAU (00E0Hに配置)
    25                                      ; DMAUはモニタでは使用しないため、レジスタ定義は省略します。
    26                                  
    27                                      ; V53 SCU (00F0Hに配置）
    28                                      ; SCUはモニタでは使用しないため、レジスタ定義は省略します。
    29                                  
    30                                      ; uPD72001 MPSC #1
    31                                      %define MPSC1_A_DATA 0x00A0 ; MPSC #1 Channel A Data Register
    32                                      %define MPSC1_A_CTRL 0x00A2 ; MPSC #1 Channel A Control Register
    33                                      %define MPSC1_B_DATA 0x00A4 ; MPSC #1 Channel B Data Register
    34                                      %define MPSC1_B_CTRL 0x00A6 ; MPSC #1 Channel B Control Register
    35                                  
    36                                      ; uPD72001 MPSC #2
    37                                      %define MPSC2_A_DATA 0x00A8 ; MPSC #2 Channel A Data Register
    38                                      %define MPSC2_A_CTRL 0x00AA ; MPSC #2 Channel A Control Register
    39                                      %define MPSC2_B_DATA 0x00AC ; MPSC #2 Channel B Data Register
    40                                      %define MPSC2_B_CTRL 0x00AE ; MPSC #2 Channel B Control Register
    41                                  
    42                                      %define TX_READY   0x04
    43                                      %define RX_READY   0x01
    44                                  
    45                                  section .text
    46                                  
    47                                  start:
    48 00000000 FA                          cli             ; 初期化中は割り込み禁止
    49                                  
    50                                      ; ---------------------------------------------
    51                                      ; 1. セグメントレジスタ初期化
    52                                      ; ---------------------------------------------
    53 00000001 0E                          push cs     ; CS -> DS
    54 00000002 1F                          pop ds
    55 00000003 0E                          push cs     ; CS -> ES
    56 00000004 07                          pop es
    57 00000005 8CC8                        mov ax, cs  ; CS -> SS
    58 00000007 8ED0                        mov ss, ax
    59 00000009 BCFF7F                      mov sp, 0x7FFF
    60                                      ; ------------------------------
    61                                  
    62                                      ; --- 2. V53 システムレジスタ初期化 ---
    63 0000000C E87406                      call v53_sysreg_init
    64                                  
    65                                      ; --- 3. TCU初期化  ---
    66 0000000F E88706                      call v53_tcu_init
    67                                  
    68                                      ; --- 4. 物理IOの初期化（詳細不明） ---
    69 00000012 E8A606                      call dve554_io_init
    70                                  
    71                                      ; --- 5. MPSC の初期化 ---
    72 00000015 E8B206                      call mpsc_init
    73                                      
    74                                      ; --- 6. 割り込みベクタの初期化 ---
    75 00000018 31C0                        xor ax, ax
    76 0000001A 8EC0                        mov es, ax              ; ES = 0000h (Vector Table Segment)
    77                                  
    78                                      ; Vector 10h 登録
    79 0000001C 26C7064000[9405]            mov word [es:0x40], _isr_int10h     ; オフセットを書き込み　0x10 * 4 = 0x40
    80 00000023 268C0E4200                  mov word [es:0x42], cs              ; 現在のコードセグメントを書き込み
    81                                  
    82                                      ; Vector 11h 登録
    83 00000028 26C7064400[B205]            mov word [es:0x44], _isr_int11h
    84 0000002F 268C0E4600                  mov word [es:0x46], cs
    85                                  
    86                                      ; Vector 12h 登録
    87 00000034 26C7064800[D005]            mov word [es:0x48], _isr_int12h
    88 0000003B 268C0E4A00                  mov word [es:0x4A], cs
    89                                  
    90                                      ; Vector 13h 登録
    91 00000040 26C7064C00[EE05]            mov word [es:0x4C], _isr_int13h
    92 00000047 268C0E4E00                  mov word [es:0x4E], cs
    93                                      
    94                                      ; Vector 14h 登録
    95 0000004C 26C7065000[0C06]            mov word [es:0x50], _isr_int14h
    96 00000053 268C0E5200                  mov word [es:0x52], cs
    97                                  
    98                                      ; Vector 15h 登録
    99 00000058 26C7065400[2A06]            mov word [es:0x54], _isr_int15h
   100 0000005F 268C0E5600                  mov word [es:0x56], cs
   101                                  
   102                                      ; Vector 16h 登録
   103 00000064 26C7065800[4806]            mov word [es:0x58], _isr_int16h
   104 0000006B 268C0E5A00                  mov word [es:0x5A], cs
   105                                  
   106                                      ; Vector 17h 登録
   107 00000070 26C7065C00[6606]            mov word [es:0x5C], _isr_int17h
   108 00000077 268C0E5E00                  mov word [es:0x5E], cs 
   109                                  
   110                                  
   111                                      ; Vector 20h (INTP0) 登録
   112 0000007C 26C7068000[B204]            mov word [es:0x80], _isr_intp0      ; オフセットを書き込み　0x20 * 4 = 0x80
   113 00000083 268C0E8200                  mov word [es:0x82], cs              ; 現在のコードセグメントを書き込み
   114                                  
   115                                      ; Vector 21h (INTP1) 登録
   116 00000088 26C7068400[CE04]            mov word [es:0x84], _isr_intp1
   117 0000008F 268C0E8600                  mov word [es:0x86], cs
   118                                  
   119                                      ; Vector 22h (INTP2) 登録
   120 00000094 26C7068800[EC04]            mov word [es:0x88], _isr_intp2
   121 0000009B 268C0E8A00                  mov word [es:0x8A], cs
   122                                  
   123                                      ; Vector 22h (INTP3) 登録
   124 000000A0 26C7068C00[0A05]            mov word [es:0x8C], _isr_intp3
   125 000000A7 268C0E8E00                  mov word [es:0x8E], cs
   126                                  
   127                                      ; Vector 23h (INTP4) 登録
   128 000000AC 26C7069000[2805]            mov word [es:0x90], _isr_intp4 
   129 000000B3 268C0E9200                  mov word [es:0x92], cs
   130                                  
   131                                      ; Vector 24h (INTP5) 登録
   132 000000B8 26C7069400[4005]            mov word [es:0x94], _isr_intp5
   133 000000BF 268C0E9600                  mov word [es:0x96], cs
   134                                  
   135                                      ; Vector 25h (INTP6) 登録
   136 000000C4 26C7069800[5E05]            mov word [es:0x98], _isr_intp6
   137 000000CB 268C0E9A00                  mov word [es:0x9A], cs
   138                                  
   139                                      ; Vector 26h (INTP7) 登録
   140 000000D0 26C7069C00[7C05]            mov word [es:0x9C], _isr_intp7
   141 000000D7 268C0E9E00                  mov word [es:0x9E], cs
   142                                  
   143                                      ; --- 7. ICU初期化 ---
   144 000000DC BAC000                      mov dx, ICU_REG0
   145 000000DF B012                        mov al, 12h     ; IIW1: 00010010b (Edge Trigger, Single)
   146 000000E1 EE                          out dx, al
   147                                  
   148 000000E2 BAC200                      mov dx, ICU_REG1
   149 000000E5 B020                        mov al, 20h     ; IIW2: 00100000b (Vector Offset = 20h (INT 32))
   150 000000E7 EE                          out dx, al
   151                                  
   152 000000E8 B0FF                        mov al, 0ffh    ; IMKW: 11111111b (一旦割り込みをマスクする）
   153 000000EA EE                          out dx, al
   154                                  
   155                                      ; --- 8. 割り込み許可 ---
   156 000000EB FB                          sti
   157                                  
   158 000000EC B000                        mov al, 00h    ; IMKW: 00000000b (全マスクを解除）
   159 000000EE EE                          out dx, al
   160                                  
   161                                      ; 変数初期化 (RAMエリアをクリア)
   162 000000EF C706[320A]0000              mov word [dump_seg], 0x0000
   163 000000F5 C706[340A]0000              mov word [dump_off], 0x0000
   164 000000FB C706[360A]0020              mov word [load_seg], 0x2000
   165                                  
   166                                      ; スタートメッセージの表示
   167 00000101 BE[3108]                    mov si, msg_boot
   168 00000104 E8F302                      call puts
   169                                  
   170                                  ; =================================================================
   171                                  ; Main Loop
   172                                  ; =================================================================
   173                                  monitor_loop:
   174 00000107 B03E                        mov al, '>'
   175 00000109 E8FC02                      call putc
   176 0000010C B020                        mov al, ' '
   177 0000010E E8F702                      call putc
   178                                  
   179 00000111 E81403                      call getc_echo  ; コマンド受信（エコーあり）
   180 00000114 88C3                        mov bl, al
   181                                      
   182 00000116 80FB64                      cmp bl, 'd'     ; dump command
   183 00000119 747A                        je do_dump
   184 0000011B 80FB44                      cmp bl, 'D'
   185 0000011E 7475                        je do_dump
   186                                      
   187 00000120 80FB6C                      cmp bl, 'l'     ; load command
   188 00000123 7503E9D000                  je do_load
   189 00000128 80FB4C                      cmp bl, 'L'
   190 0000012B 7503E9C800                  je do_load
   191                                      
   192 00000130 80FB67                      cmp bl, 'g'     ; go command
   193 00000133 7503E94401                  je do_go
   194 00000138 80FB47                      cmp bl, 'G'
   195 0000013B 7503E93C01                  je do_go
   196                                  
   197 00000140 80FB77                      cmp bl, 'w'     ; Write command
   198 00000143 7503E96001                  je do_write
   199 00000148 80FB57                      cmp bl, 'W'
   200 0000014B 7503E95801                  je do_write
   201                                  
   202 00000150 3C69                        cmp al, 'i'     ; Input Port command
   203 00000152 7503E99401                  je do_in
   204 00000157 3C49                        cmp al, 'I'
   205 00000159 7503E98D01                  je do_in
   206                                  
   207 0000015E 3C6F                        cmp al, 'o'     ; Output Port command
   208 00000160 7503E9AA01                  je do_out
   209 00000165 3C4F                        cmp al, 'O'
   210 00000167 7503E9A301                  je do_out
   211                                  
   212 0000016C 3C73                        cmp al, 's'     ; Scan I/O command
   213 0000016E 7503E9C601                  je do_scan
   214 00000173 3C53                        cmp al, 'S'
   215 00000175 7503E9BF01                  je do_scan
   216                                  
   217 0000017A 3C74                        cmp al, 't'     ; Scan Timer wait command
   218 0000017C 7503E92A02                  je do_timer
   219 00000181 3C54                        cmp al, 'T'
   220 00000183 7503E92302                  je do_timer
   221                                  
   222 00000188 3C3F                        cmp al, '?'     ; Help
   223 0000018A 7503E95F02                  je cmd_help
   224                                  
   225                                      ; 知らないコマンドなら改行して戻る
   226 0000018F E89F02                      call putc_crlf
   227 00000192 E972FF                      jmp monitor_loop
   228                                  
   229                                  ; =================================================================
   230                                  ; Command: Dump Memory
   231                                  ; Usage:
   232                                  ;   D               -> Dump next 64 bytes
   233                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   234                                  ; =================================================================
   235                                  do_dump:
   236 00000195 E89002                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   237 00000198 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   238 0000019A 7418                        je .dump_run
   239 0000019C 3C20                        cmp al, ' '         ; Spaceなら引数解析
   240 0000019E 7405                        je .parse_args
   241                                      
   242                                      ; それ以外なら無視して実行へ（またはエラー処理）
   243 000001A0 E88E02                      call putc_crlf
   244 000001A3 EB12                        jmp .dump_run_start
   245                                  
   246                                  .parse_args:
   247 000001A5 E8B702                      call get_hex_word
   248 000001A8 A3[320A]                    mov [dump_seg], ax
   249 000001AB E8F702                      call skip_space
   250 000001AE E8AE02                      call get_hex_word
   251 000001B1 A3[340A]                    mov [dump_off], ax
   252                                      ; ここでEnter待ちをするか、そのまま実行するか
   253                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   254                                      
   255                                  .dump_run:
   256 000001B4 E87A02                      call putc_crlf              ; 実行直前に改行
   257                                  
   258                                  .dump_run_start:
   259 000001B7 B90400                      mov cx, 4                   ; 4行表示する
   260                                      
   261                                  .line_loop:
   262 000001BA 51                          push cx
   263                                      
   264 000001BB A1[320A]                    mov ax, [dump_seg]          ; セグメントの表示
   265 000001BE E87902                      call print_hex_word
   266 000001C1 B03A                        mov al, ':'                 ; 区切り文字の:を表示
   267 000001C3 E84202                      call putc
   268 000001C6 A1[340A]                    mov ax, [dump_off]          ; オフセットの表示
   269 000001C9 E86E02                      call print_hex_word
   270 000001CC B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   271 000001CE E83702                      call putc
   272                                  
   273 000001D1 8B36[340A]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   274                                  
   275 000001D5 1E                          push ds                     ; モニタのDSを保存
   276 000001D6 8E1E[320A]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   277                                      
   278 000001DA B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   279                                  .hex_loop:
   280 000001DD 8A04                        mov al, [si]
   281 000001DF E85F02                      call print_hex_byte         ; メモリ内容の表示
   282 000001E2 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   283 000001E4 E82102                      call putc
   284 000001E7 46                          inc si                      ; 次のアドレスにする
   285 000001E8 E2F3                        loop .hex_loop              ; 16回繰り返し    
   286                                  
   287 000001EA 1F                          pop ds                      ; DSをモニタ用に戻す
   288                                  
   289 000001EB 8936[340A]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   290                                  
   291 000001EF E83F02                      call putc_crlf              ; 改行する
   292 000001F2 59                          pop cx
   293 000001F3 E2C5                        loop .line_loop             ; 4回繰り返す
   294                                      
   295 000001F5 E90FFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   296                                  
   297                                  ; =================================================================
   298                                  ; Command: Load Intel HEX
   299                                  ; Usage:
   300                                  ;   L           -> Load to default segment (load_seg)
   301                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   302                                  ; =================================================================
   303                                  do_load:
   304                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   305 000001F8 A1[360A]                    mov ax, [load_seg]
   306 000001FB 06                          push es             ; RAM用ESを保存
   307 000001FC 50                          push ax             ; デフォルトセグメントを保存
   308                                      
   309 000001FD E82802                      call getc_echo
   310 00000200 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   311 00000202 7402                        je .parse_seg
   312 00000204 EB05                        jmp .start_load
   313                                  
   314                                  .parse_seg:
   315 00000206 58                          pop ax              ; 不要になったデフォルトを捨てる
   316 00000207 E85502                      call get_hex_word   ; 新しいセグメント取得
   317 0000020A 50                          push ax             ; 保存
   318                                  
   319                                  .start_load:
   320 0000020B E82302                      call putc_crlf      ; メッセージ表示前に改行
   321 0000020E BE[6908]                    mov si, msg_load    ; ロード開始メッセージを表示
   322 00000211 E8E601                      call puts
   323                                      
   324 00000214 58                          pop ax
   325 00000215 8EC0                        mov es, ax          ; ロード先をESに設定
   326                                      
   327                                      ; ターゲット表示
   328 00000217 E82002                      call print_hex_word ; ESの値を表示
   329 0000021A B03A                        mov al, ':'         ; 区切り文字を表示
   330 0000021C E8E901                      call putc
   331 0000021F B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   332 00000221 E8E401                      call putc
   333 00000224 E80A02                      call putc_crlf
   334                                  
   335                                  .wait_record:
   336 00000227 E8EF01                      call getc           ; 開始文字を待つ
   337 0000022A 3C3A                        cmp al, ':'
   338 0000022C 75F9                        jne .wait_record
   339                                  
   340 0000022E E85302                      call get_hex_byte   ; データ長を読み込み
   341 00000231 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   342 00000233 B500                        mov ch, 0
   343                                      
   344 00000235 E84C02                      call get_hex_byte   ; 上位アドレスを読み込み
   345 00000238 88C7                        mov bh, al
   346 0000023A E84702                      call get_hex_byte   ; 下位アドレスを読み込み
   347 0000023D 88C3                        mov bl, al
   348                                      
   349 0000023F E84202                      call get_hex_byte   ; レコードタイプを読み込み
   350 00000242 3C01                        cmp al, 01          ; End of File?
   351 00000244 7422                        je .handle_eof      ; EOFの処理へ
   352 00000246 3C00                        cmp al, 00          ; Data Record?
   353 00000248 7523                        jne .skip_line      ; その他はスキップ
   354                                      
   355 0000024A E312                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   356                                      
   357                                  .data_loop:
   358 0000024C E83502                      call get_hex_byte   ; 1バイト読み取り
   359 0000024F 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   360 00000252 43                          inc bx              ; 次のアドレスにする
   361                                      ; --- 追加: 64KBの境界チェック ---
   362 00000253 7507                        jnz .loop_next      ; bxが0にならなければそのまま
   363 00000255 8CC0                        mov ax, es          ; bxが0(一周)したら
   364 00000257 050010                      add ax, 0x1000      ; セグメントを64KB分(0x1000)進める
   365 0000025A 8EC0                        mov es, ax
   366                                      ; -----------------------------
   367                                  
   368                                  .loop_next:
   369 0000025C E2EE                        loop .data_loop     ; データ長分繰り返す
   370                                      
   371                                  .read_chk:
   372 0000025E E82302                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   373 00000261 B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   374 00000263 E8A201                      call putc
   375 00000266 EBBF                        jmp .wait_record    ; 次のレコード読み取りへ
   376                                  
   377                                  .handle_eof:            ; EOFの場合
   378 00000268 E81902                      call get_hex_byte   ; チェックサムを読み飛ばす
   379 0000026B EB02                        jmp .finish         ; 読み込み終了処理へ
   380                                  
   381                                  .skip_line:
   382 0000026D EBB8                        jmp .wait_record    ; 次のレコード読み込みへ
   383                                  
   384                                  .finish:
   385 0000026F 07                          pop es              ; RAM用ESを復帰
   386 00000270 E8BE01                      call putc_crlf
   387 00000273 BE[7508]                    mov si, msg_ok      ; "OK"を表示
   388 00000276 E88101                      call puts
   389 00000279 E98BFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   390                                  
   391                                  ; =================================================================
   392                                  ; Command: Execute
   393                                  ; Usage:
   394                                  ;   G <Seg> <Off>
   395                                  ; Example: G 1000 0000
   396                                  ; =================================================================
   397                                  do_go:
   398                                      ; Gコマンドは入力後に改行
   399                                      
   400 0000027C E8A901                      call getc_echo      ; Space?
   401 0000027F 3C20                        cmp al, ' '
   402 00000281 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   403                                      
   404                                      ; 1. セグメント (SSSS) を取得
   405 00000283 E8D901                      call get_hex_word   ; AX = Segment
   406 00000286 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   407 00000287 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   408                                      
   409                                      ; スペース読み飛ばし (もしあれば)
   410 00000289 E81902                      call skip_space
   411                                      
   412                                      ; 2. オフセット (OOOO) を取得
   413 0000028C E8D001                      call get_hex_word   ; AX = Offset
   414 0000028F 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   415                                      
   416 00000290 E89E01                      call putc_crlf      ; 実行前に改行
   417 00000293 BE[7808]                    mov si, msg_go
   418 00000296 E86101                      call puts
   419 00000299 E89501                      call putc_crlf
   420                                      
   421                                      ; 3. 実行環境のセットアップ
   422                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   423 0000029C 8EDB                        mov ds, bx
   424 0000029E 8EC3                        mov es, bx
   425                                  
   426                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   427 000002A0 FA                          cli
   428                                  
   429                                      ; 4. ジャンプ！ (Far Return)
   430                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   431 000002A1 CB                          retf                ; Jump!
   432                                  
   433                                  .go_default:
   434 000002A2 E88C01                      call putc_crlf      ; 改行して
   435 000002A5 E95FFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   436                                  
   437                                  ; ==============================================================
   438                                  ; Command: Write Memory
   439                                  ; Usage:
   440                                  ;   W <Seg> <Off> <Val>
   441                                  ; ==============================================================
   442                                  do_write:    
   443 000002A8 E87D01                      call getc_echo      ; Space?
   444 000002AB 3C20                        cmp al, ' '
   445 000002AD 7403E9F701                  jne error           ; 引数なしならリターン(またはエラー)
   446                                  
   447                                      ; 1. セグメント (SSSS) を取得
   448 000002B2 E8AA01                      call get_hex_word   ; AX = Segment
   449 000002B5 50                          push ax             ; ターゲットセグメントを保存
   450                                      
   451 000002B6 E86F01                      call getc_echo      ; Space?
   452 000002B9 3C20                        cmp al, ' '
   453 000002BB 7403E9E901                  jne error           ; 引数なしならリターン(またはエラー)
   454                                      
   455                                      ; 2. オフセット (OOOO) を取得
   456 000002C0 E89C01                      call get_hex_word   ; AX = Offset
   457 000002C3 50                          push ax             ; ターゲットオフセットを保存
   458                                  
   459 000002C4 E86101                      call getc_echo      ; Space?
   460 000002C7 3C20                        cmp al, ' '
   461 000002C9 7403E9DB01                  jne error           ; 引数なしならリターン(またはエラー)
   462                                  
   463                                      ; 3. 設定データ (VV) を取得
   464 000002CE E89D01                      call get_hex_byte_echo   ; AL = Value
   465                                  
   466 000002D1 5B                          pop bx              ; bx = Offset
   467 000002D2 5A                          pop dx              ; dx = Target Segment
   468                                  
   469                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   470 000002D3 8916[320A]                  mov [dump_seg], dx
   471 000002D7 891E[340A]                  mov [dump_off], bx
   472                                      
   473 000002DB 8EDA                        mov ds, dx          ; DS再設定
   474 000002DD 3E8807                      mov [ds:bx], al     ; 書き込み！
   475                                      
   476 000002E0 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   477 000002E1 1F                          pop ds
   478                                  
   479 000002E2 BE[9B08]                    mov si, msg_done
   480 000002E5 E81201                      call puts
   481 000002E8 E91CFE                      jmp monitor_loop
   482                                  
   483                                  ; ==============================================================
   484                                  ; Command: Input from Port
   485                                  ; Usage:
   486                                  ;   I <Port>
   487                                  ; ==============================================================
   488                                  do_in:
   489 000002EB E83A01                      call getc_echo
   490 000002EE 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   491 000002F0 7403E9B401                  jne error           ; パラメタが無い場合はエラー処理へ
   492                                  
   493 000002F5 E86701                      call get_hex_word   ; ポートアドレスを取得
   494 000002F8 89C2                        mov dx, ax          ; 保存
   495 000002FA EC                          in al, dx           ; I/O Read
   496                                      
   497 000002FB 50                          push ax
   498 000002FC E83201                      call putc_crlf      ; メッセージ表示前に改行
   499 000002FF BE[9508]                    mov si, msg_in_res
   500 00000302 E8F500                      call puts
   501 00000305 58                          pop ax
   502                                  
   503 00000306 E83801                      call print_hex_byte ; 値を表示
   504                                  
   505 00000309 E82501                      call putc_crlf      ; 改行して
   506 0000030C E9F8FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   507                                  
   508                                  ; ==============================================================
   509                                  ; Command: Output to Port
   510                                  ; Usage
   511                                  ;   O <Port> <Val>
   512                                  ; ==============================================================
   513                                  do_out:
   514 0000030F E81601                      call getc_echo
   515 00000312 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   516 00000314 7403E99001                  jne error           ; パラメタが無い場合はエラー処理へ
   517                                  
   518 00000319 E84301                      call get_hex_word   ; ポートアドレスを取得
   519 0000031C 50                          push ax             ; スタックに積む
   520                                  
   521 0000031D E80801                      call getc_echo
   522 00000320 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   523 00000322 7511                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   524                                      
   525 00000324 E84701                      call get_hex_byte_echo   ; 出力値を取得
   526 00000327 5A                          pop dx              ; スタックからDXにセット
   527                                      
   528 00000328 EE                          out dx, al          ; I/O Write
   529                                      
   530 00000329 E80501                      call putc_crlf      ; 書き込み完了後、まず改行する
   531 0000032C BE[9B08]                    mov si, msg_done    ; DONEを表示。改行付き。
   532 0000032F E8C800                      call puts
   533                                      
   534 00000332 E9D2FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   535                                  
   536                                  error_pop:
   537 00000335 58                          pop ax              ; 使わなかったスタックを捨てる
   538 00000336 E97001                      jmp error
   539                                  
   540                                  ; ==============================================================
   541                                  ; Command: Scan I/O Ports
   542                                  ; Usage:
   543                                  ;   S <Start_port> <End_port>
   544                                  ; Description: Reads ports and prints if value is NOT 0xFF
   545                                  ; ==============================================================
   546                                  do_scan:
   547 00000339 E8EC00                      call getc_echo
   548 0000033C 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   549 0000033E 7403E96601                  jne error           ; パラメタが無い場合はエラー処理へ
   550                                  
   551 00000343 E81901                      call get_hex_word   ; スタートポートアドレスを取得
   552 00000346 89C3                        mov bx, ax          ; BX = Start Address
   553                                      
   554 00000348 E8DD00                      call getc_echo
   555 0000034B 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   556 0000034D 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   557                                  
   558 0000034F E80D01                      call get_hex_word   ; エンドポートアドレスを取得
   559 00000352 89C1                        mov cx, ax          ; CX = End Address
   560                                  
   561 00000354 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   562 00000356 7603E94E01                  ja error
   563                                  
   564 0000035B E8D300                      call putc_crlf
   565 0000035E BE[2A09]                    mov si, msg_scan_start
   566 00000361 E89600                      call puts
   567                                  
   568                                  .scan_loop:
   569 00000364 89DA                        mov dx, bx          ; DXにポートアドレス設定
   570 00000366 EC                          in al, dx           ; I/O Read
   571                                  
   572 00000367 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   573 00000369 741D                        je .next_port
   574                                  
   575 0000036B 50                          push ax             ; Readした値をスタックに保存
   576                                  
   577                                      ; --- 有効な値が見つかった場合の表示 ---
   578                                      ; [Port]: Value
   579 0000036C 89D8                        mov ax, bx
   580 0000036E E8C900                      call print_hex_word ; ポートアドレスの表示
   581 00000371 B03A                        mov al, ':'
   582 00000373 E89200                      call putc
   583 00000376 B020                        mov al, ' '
   584 00000378 E88D00                      call putc
   585                                      
   586 0000037B 58                          pop ax
   587 0000037C E8C200                      call print_hex_byte ; Readした値の表示
   588                                      
   589 0000037F BE[5509]                    mov si, msg_space   ; "  "
   590 00000382 E87500                      call puts
   591                                  
   592                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   593                                      ; ここでは単純にリスト形式で改行します
   594 00000385 E8A900                      call putc_crlf
   595                                  
   596                                  .next_port:
   597 00000388 43                          inc bx              ; 次のアドレスへ
   598                                      
   599                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   600 00000389 BAA200                      mov dx, MPSC1_A_CTRL
   601 0000038C EC                          in al, dx
   602 0000038D A801                        test al, RX_READY   ; RxRDY?
   603 0000038F 750D                        jnz .abort          ; 何かキーが押されたら中断
   604                                  
   605 00000391 39CB                        cmp bx, cx
   606 00000393 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   607                                  
   608 00000395 BE[9B08]                    mov si, msg_done
   609 00000398 E85F00                      call puts
   610 0000039B E969FD                      jmp monitor_loop
   611                                  
   612                                  .abort:
   613                                      ; 入力バッファを空読みしておく
   614 0000039E BAA000                      mov dx, MPSC1_A_DATA
   615 000003A1 EC                          in al, dx
   616 000003A2 BE[5809]                    mov si, msg_abort
   617 000003A5 E85200                      call puts
   618 000003A8 E95CFD                      jmp monitor_loop
   619                                  
   620                                  ; ==============================================================
   621                                  ; Command: Timer
   622                                  ;   T          -> Show current tick counter (32-bit HEX)
   623                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   624                                  ; ==============================================================
   625                                  do_timer:
   626 000003AB E87A00                      call getc_echo      ; コマンド('T')の次の文字を取得
   627 000003AE 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   628 000003B0 7421                        je .show_counter
   629 000003B2 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   630 000003B4 7403E9F000                  jne error           ; それ以外はエラー
   631                                  
   632                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   633 000003B9 E8A300                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   634                                  
   635                                      ; 開始時刻を保存 (Start Time)
   636 000003BC 8B1E[380A]                  mov bx, [tick_counter_lo]
   637                                  
   638                                  .wait_loop:
   639                                      ; 1. 現在時刻を取得
   640 000003C0 8B0E[380A]                  mov cx, [tick_counter_lo]
   641                                      
   642                                      ; 2. 経過時間を計算 (Current - Start)
   643                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   644 000003C4 29D9                        sub cx, bx          
   645                                      
   646                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   647 000003C6 39C1                        cmp cx, ax
   648 000003C8 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   649                                  
   650                                      ; 指定時間経過した
   651 000003CA BE[9B08]                    mov si, msg_done
   652 000003CD E82A00                      call puts
   653 000003D0 E934FD                      jmp monitor_loop
   654                                  
   655                                  .show_counter:
   656                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   657 000003D3 E85B00                      call putc_crlf
   658                                      
   659 000003D6 BE[6309]                    mov si, msg_tick    ; "Tick: "
   660 000003D9 E81E00                      call puts
   661                                  
   662                                      ; 32bitカウンタを [High][Low] の順で表示
   663 000003DC A1[3A0A]                    mov ax, [tick_counter_hi]
   664 000003DF E85800                      call print_hex_word
   665 000003E2 A1[380A]                    mov ax, [tick_counter_lo]
   666 000003E5 E85200                      call print_hex_word
   667                                      
   668 000003E8 E84600                      call putc_crlf
   669 000003EB E919FD                      jmp monitor_loop
   670                                  
   671                                  ; ==============================================================
   672                                  ; Command: Help
   673                                  ; ==============================================================
   674                                  cmd_help:
   675 000003EE E84000                      call putc_crlf
   676 000003F1 BE[A708]                    mov si, msg_help
   677 000003F4 E80300                      call puts
   678 000003F7 E90DFD                      jmp monitor_loop
   679                                  
   680                                  ; =================================================================
   681                                  ; Utilities
   682                                  ; =================================================================
   683                                  
   684                                  ; 文字列出力
   685                                  puts:
   686 000003FA 2E8A04                      mov al, [cs:si]
   687 000003FD 08C0                        or al, al
   688 000003FF 7406                        jz .ret
   689 00000401 E80400                      call putc
   690 00000404 46                          inc si
   691 00000405 EBF3                        jmp puts
   692 00000407 C3                      .ret: ret
   693                                  
   694                                  ; 1文字出力
   695                                  putc:
   696 00000408 52                          push dx
   697 00000409 50                          push ax
   698 0000040A BAA200                      mov dx, MPSC1_A_CTRL
   699                                  .wait_tx:
   700 0000040D EC                          in al, dx
   701 0000040E A804                        test al, TX_READY   ; D2: Tx Buffer Empty?
   702 00000410 74FB                        jz .wait_tx
   703 00000412 BAA000                      mov dx, MPSC1_A_DATA
   704 00000415 58                          pop ax
   705 00000416 EE                          out dx, al
   706 00000417 5A                          pop dx
   707 00000418 C3                          ret
   708                                  
   709                                  ; 1文字入力
   710                                  getc:
   711 00000419 52                          push dx
   712 0000041A BAA200                      mov dx, MPSC1_A_CTRL
   713                                  .wait_rx:
   714 0000041D EC                          in al, dx
   715 0000041E A801                        test al, RX_READY   ; D0: RX Ready?
   716 00000420 74FB                        jz .wait_rx
   717 00000422 BAA000                      mov dx, MPSC1_A_DATA
   718 00000425 EC                          in al, dx
   719 00000426 5A                          pop dx
   720 00000427 C3                          ret
   721                                  
   722                                  ; 1文字入力　エコーバックあり
   723                                  getc_echo:
   724 00000428 E8EEFF                      call getc
   725 0000042B 50                          push ax
   726 0000042C E8D9FF                      call putc
   727 0000042F 58                          pop ax
   728 00000430 C3                          ret
   729                                  
   730                                  ; 改行出力
   731                                  putc_crlf:
   732 00000431 B00D                        mov al, 0x0D
   733 00000433 E8D2FF                      call putc
   734 00000436 B00A                        mov al, 0x0A
   735 00000438 EBCE                        jmp putc
   736                                  
   737                                  ; -----------------------------------------------------------------
   738                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   739                                  ; Input: AX
   740                                  ; -----------------------------------------------------------------
   741                                  print_hex_word:
   742 0000043A 50                          push ax
   743 0000043B 88E0                        mov al, ah
   744 0000043D E80100                      call print_hex_byte
   745 00000440 58                          pop ax
   746                                  
   747                                  ; -----------------------------------------------------------------
   748                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   749                                  ; Input: AL
   750                                  ; -----------------------------------------------------------------
   751                                  print_hex_byte:
   752 00000441 50                          push ax
   753 00000442 51                          push cx
   754                                  
   755                                      ; 上位バイトの表示
   756 00000443 50                          push ax
   757 00000444 C0E804                      shr al, 4
   758 00000447 E80900                      call .digit
   759                                  
   760                                      ; 下位バイトの表示
   761 0000044A 58                          pop ax
   762 0000044B 240F                        and al, 0x0F
   763 0000044D E80300                      call .digit
   764                                  
   765 00000450 59                          pop cx
   766 00000451 58                          pop ax
   767 00000452 C3                          ret
   768                                  
   769                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   770                                  .digit:
   771 00000453 0430                        add al, '0'
   772 00000455 3C39                        cmp al, '9'
   773 00000457 7602                        jbe .p
   774 00000459 0407                        add al, 7
   775 0000045B E8AAFF                  .p: call putc
   776 0000045E C3                          ret
   777                                  
   778                                  ; -----------------------------------------------------------------
   779                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   780                                  ; Input:  Serial (例: "1", "0", "0", "0")
   781                                  ; Output: AX = 0x1000
   782                                  ; -----------------------------------------------------------------
   783                                  get_hex_word:
   784 0000045F 53                          push bx
   785 00000460 E80B00                      call get_hex_byte_echo
   786 00000463 88C7                        mov bh, al
   787 00000465 E80600                      call get_hex_byte_echo
   788 00000468 88C3                        mov bl, al
   789 0000046A 89D8                        mov ax, bx
   790 0000046C 5B                          pop bx
   791 0000046D C3                          ret
   792                                  
   793                                  ; 16進数2桁入力　エコーバック有り
   794                                  get_hex_byte_echo:
   795 0000046E 53                          push bx
   796 0000046F E8B6FF                      call getc_echo
   797 00000472 E82500                      call hex_char_to_bin
   798 00000475 C0E004                      shl al, 4
   799 00000478 88C3                        mov bl, al
   800 0000047A E8ABFF                      call getc_echo
   801 0000047D E81A00                      call hex_char_to_bin
   802 00000480 08D8                        or al, bl
   803 00000482 5B                          pop bx
   804 00000483 C3                          ret
   805                                  
   806                                  ; -----------------------------------------------------------------
   807                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   808                                  ; Input:  Serial (例: "3", "F")
   809                                  ; Output: AL = 0x3F
   810                                  ; -----------------------------------------------------------------
   811                                  get_hex_byte:
   812 00000484 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   813                                  
   814                                      ; 上位4bit
   815 00000485 E891FF                      call getc
   816 00000488 E80F00                      call hex_char_to_bin
   817 0000048B C0E004                      shl al, 4
   818 0000048E 88C3                        mov bl, al          ; 一時保存
   819                                      
   820                                      ; 下位4bit
   821 00000490 E886FF                      call getc
   822 00000493 E80400                      call hex_char_to_bin
   823 00000496 08D8                        or al, bl           ; 上位を合成して結果はALへ
   824 00000498 5B                          pop bx
   825 00000499 C3                          ret
   826                                  
   827                                  ; -----------------------------------------------------------------
   828                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   829                                  ; Input: AL (ASCII)
   830                                  ; Output: AL (Binary)
   831                                  ; -----------------------------------------------------------------
   832                                  hex_char_to_bin:
   833 0000049A 2C30                        sub al, '0'
   834 0000049C 3C09                        cmp al, 9
   835 0000049E 7604                        jbe .done
   836 000004A0 2C07                        sub al, 7           ; 'A'-'F'対応
   837 000004A2 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   838                                  .done:
   839 000004A4 C3                          ret
   840                                  
   841                                  ; -----------------------------------------------------------------
   842                                  ; Helper: スペースなどを読み飛ばす
   843                                  ; -----------------------------------------------------------------
   844                                  skip_space:
   845 000004A5 E880FF                      call getc_echo
   846 000004A8 C3                          ret
   847                                  
   848                                  ; -----------------------------------------------------------------
   849                                  ; Helper: エラーメッセージ出力後モニタに戻る
   850                                  ; -----------------------------------------------------------------
   851                                  error:
   852 000004A9 BE[7F08]                    mov si, msg_error
   853 000004AC E84BFF                      call puts
   854 000004AF E955FC                      jmp monitor_loop
   855                                  
   856                                  ; ---------------------------------------------------------
   857                                  ; INTP0 (Vector 20h) ハンドラ　Timer0 (100Hz) 割り込み
   858                                  ; ---------------------------------------------------------
   859                                  align 2
   860                                  _isr_intp0:
   861 000004B2 60                          pusha               ; 全汎用レジスタ保存 (AX,CX,DX,BX,SP,BP,SI,DI)
   862 000004B3 1E                          push ds             ; セグメントレジスタ保存
   863 000004B4 06                          push es
   864                                  
   865                                      ; --- DSの設定 (重要: 変数にアクセスするため) ---
   866 000004B5 8CC8                        mov ax, cs
   867 000004B7 8ED8                        mov ds, ax
   868                                  
   869                                      ; --- 32bit カウンタのインクリメント ---
   870 000004B9 FF06[380A]                  inc word [tick_counter_lo]
   871 000004BD 7504                        jnz .skip_carry
   872 000004BF FF06[3A0A]                  inc word [tick_counter_hi]
   873                                  .skip_carry:
   874                                      ; --- EOI (End of Interrupt) 発行 ---
   875                                      ; これを送らないと次の割り込みが発生しません
   876 000004C3 B020                        mov al, 20h         ; Non-Specific EOI
   877 000004C5 BAC000                      mov dx, ICU_REG0
   878 000004C8 EE                          out dx, al
   879                                  
   880                                      ; --- 復帰処理 ---
   881 000004C9 07                          pop es
   882 000004CA 1F                          pop ds
   883 000004CB 61                          popa                ; 保存したレジスタをすべて復帰
   884                                  
   885 000004CC CF                          iret                ; 割り込みから復帰 (IP, CS, Flagsをpop)
   886                                  
   887                                  ; ---------------------------------------------------------
   888                                  ; INTP1 (Vector 21h) ハンドラ - 詳細不明
   889                                  ; ---------------------------------------------------------
   890 000004CD 90                      align 2
   891                                  _isr_intp1:
   892 000004CE 60                          pusha
   893 000004CF 1E                          push ds
   894 000004D0 06                          push es
   895                                  
   896                                      ; 1. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   897 000004D1 8CC8                        mov  ax, cs
   898 000004D3 8ED8                        mov  ds, ax
   899 000004D5 8EC0                        mov  es, ax
   900                                  
   901                                      ; 2. 発生フラグをセット
   902 000004D7 FF06[3C0A]                  inc  word [intp1_flag]
   903                                      
   904                                      ; --- 画面表示 ---
   905 000004DB BE[7609]                    mov  si, msg_intp1
   906 000004DE E819FF                      call puts
   907                                      
   908                                      ; EOI発行
   909 000004E1 B020                        mov  al, 20h
   910 000004E3 BAC000                      mov  dx, ICU_REG0
   911 000004E6 EE                          out  dx, al
   912                                  
   913 000004E7 07                          pop  es
   914 000004E8 1F                          pop  ds
   915 000004E9 61                          popa
   916 000004EA CF                          iret
   917                                  
   918                                  ; ---------------------------------------------------------
   919                                  ; INTP2 (Vector 22h) ハンドラ - 詳細不明
   920                                  ; ---------------------------------------------------------
   921 000004EB 90                      align 2
   922                                  _isr_intp2:
   923 000004EC 60                          pusha
   924 000004ED 1E                          push ds
   925 000004EE 06                          push es
   926                                  
   927                                      ; 1. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   928 000004EF 8CC8                        mov  ax, cs
   929 000004F1 8ED8                        mov  ds, ax
   930 000004F3 8EC0                        mov  es, ax
