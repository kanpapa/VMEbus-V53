   892 000004CB FA                          CLI	                        ;割り込み禁止
   893 000004CC 50                          PUSH AX                     ;レジスタ保存
   894 000004CD 53                          PUSH BX                     ;レジスタ保存
   895 000004CE 52                          PUSH DX                 	;レジスタ保存
   896 000004CF FF06[5409]                  inc word [int12h_flag]      ;発生フラグセット
   897 000004D3 E8DEFF                      CALL send_38h	            ;EOI発行サブルーチン呼出
   898 000004D6 5A                          POP DX
   899 000004D7 5B                          POP BX
   900 000004D8 58                          POP AX	                    ;レジスタ復帰
