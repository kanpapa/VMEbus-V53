  1614                                  ; V53システムレジスタ設定テーブル
  1615                                  ; --------------------------------------------------
  1616                                  ALIGN 2
  1617                                  TABLE_V53_REG:
  1618 000007DE FEFF00                      db 0xFE, 0xFF, 0x00     ; FFFE (SCTL) = 00h 16bit I/O boundary
  1619 000007E1 FDFF06                      db 0xFD, 0xFF, 0x06     ; FFFD (OPSEL)= 06h Enable ICU,TCU  Disable DMAU,SCU
  1620 000007E4 FCFF00                      db 0xFC, 0xFF, 0x00     ; FFFC (OPHA) = 00h
  1621 000007E7 FBFFE0                      db 0xFB, 0xFF, 0xE0     ; FFFB (DULA) = E0h DCU:00E0h
  1622 000007EA FAFFC0                      db 0xFA, 0xFF, 0xC0     ; FFFA (IULA) = C0h ICU:00C0h
  1623 000007ED F9FFD0                      db 0xF9, 0xFF, 0xD0     ; FFF9 (TULA) = D0h TCU:00D0h
  1624 000007F0 F8FFF0                      db 0xF8, 0xFF, 0xF0     ; FFF8 (SULA) = F0h SCU:00F0h
  1625 000007F3 EAFF00                      db 0xEA, 0xFF, 0x00     ; FFEA (WMB0) = 00h
  1626 000007F6 EBFF00                      db 0xEB, 0xFF, 0x00     ; FFEB (WCY1) = 00h
  1627 000007F9 ECFF00                      db 0xEC, 0xFF, 0x00     ; FFEC (WCY0) = 00h
  1628 000007FC F3FF73                      db 0xF3, 0xFF, 0x73     ; FFF3 (WMB1) = 73h
  1629 000007FF EDFF00                      db 0xED, 0xFF, 0x00     ; FFED (WAC)  = 00h
  1630 00000802 F4FF10                      db 0xF4, 0xFF, 0x10     ; FFF4 (WCY2) = 10h
  1631 00000805 F5FF22                      db 0xF5, 0xFF, 0x22     ; FFF5 (WCY3) = 22h
  1632 00000808 F6FF10                      db 0xF6, 0xFF, 0x10     ; FFF6 (WCY4) = 10h
  1633 0000080B F2FF00                      db 0xF2, 0xFF, 0x00     ; FFF2 (RFC)  = 00h
  1634 0000080E E9FF00                      db 0xE9, 0xFF, 0x00     ; FFE9 (BRC)  = 00h
  1635 00000811 F0FF02                      db 0xF0, 0xFF, 0x02     ; FFF0 (TCKS) = 02h
  1636 00000814 F1FF00                      db 0xF1, 0xFF, 0x00     ; FFF1 (SBCR) = 00h
  1637 00000817 FFFFFF                      db 0xFF, 0xFF, 0xFF     ; 終端マーカー
  1638                                  
  1639                                  ; --------------------------------------------------
  1640                                  ; TCU タイマー設定テーブル
  1641                                  ; --------------------------------------------------
  1642                                  ALIGN 2
  1643                                  TABLE_TCU_REG:
  1644                                      ; Port1, Val1, Port2, Val2(16)
  1645 0000081A D60036D000204E              db 0xD6, 0x00, 0x36, 0xD0, 0x00, 0x20, 0x4E ; T0設定
  1646 00000821 D60070D200050D              db 0xD6, 0x00, 0x70, 0xD2, 0x00, 0x05, 0x0D ; T0最大値A
  1647 00000828 D600B0D400050D              db 0xD6, 0x00, 0xB0, 0xD4, 0x00, 0x05, 0x0D ; T0最大値B
  1648 0000082F FFFF                        db 0xFF, 0xFF           ; 終端マーカー
