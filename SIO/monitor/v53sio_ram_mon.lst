  1344                                  ; --------------------------------------------------
  1345                                  ;  V53 システムレジスタ初期化
  1346                                  ; --------------------------------------------------
  1347                                  v53_sysreg_init:
  1348 00000687 BE[E207]                    mov si, TABLE_V53_REG
  1349                                  .next:
  1350 0000068A 2E8B14                      mov dx, [cs:si]      ; Port Number (16bit)
  1351 0000068D 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1352 00000690 740A                        je .done
  1353 00000692 2E8A4402                    mov al, [cs:si+2]    ; Value (8bit)
  1354 00000696 EE                          out dx, al
  1355 00000697 83C603                      add si, 3
  1356 0000069A EBEE                        jmp .next
  1357                                  .done:
  1358 0000069C C3                          ret
  1359                                  
  1360                                  ; --------------------------------------------------
  1361                                  ; TCU (タイマーユニット) 初期化
  1362                                  ; --------------------------------------------------
  1363                                  v53_tcu_init:
  1364 0000069D BE[1E08]                    mov si, TABLE_TCU_REG
  1365                                  .next:
  1366 000006A0 2E8B14                      mov dx, [cs:si]      ; Port1 (16bit)
  1367 000006A3 83FAFF                      cmp dx, 0xFFFF       ; Terminator
  1368 000006A6 7416                        je .done
  1369 000006A8 2E8A4402                    mov al, [cs:si+2]    ; Val1 (8bit)
  1370 000006AC EE                          out dx, al
  1371 000006AD 2E8B5403                    mov dx, [cs:si+3]    ; Port2 (16bit)
  1372 000006B1 2E8B4405                    mov ax, [cs:si+5]    ; Val2 (16bit)
  1373 000006B5 EE                          out dx, al           ; Port2 Low
  1374 000006B6 88E0                        mov al, ah
  1375 000006B8 EE                          out dx, al           ; Port2 High
  1376 000006B9 83C607                      add si, 7
  1377 000006BC EBE2                        jmp .next
  1378                                  .done:
  1379 000006BE C3                          ret
  1380                                  
  1381                                  ; ---------------------------------------------------
  1382                                  ; 物理IOの初期化
  1383                                  ; ---------------------------------------------------
  1384                                  dve554_io_init:
  1385 000006BF B000                        mov al, 0x00
  1386 000006C1 BA8600                      mov dx, 0x0086
  1387 000006C4 EE                          out dx, al
  1388 000006C5 BA8200                      mov dx, 0x0082
  1389 000006C8 EE                          out dx, al
  1390 000006C9 BA8000                      mov dx, 0x0080
  1391 000006CC EE                          out dx, al
  1392 000006CD C3                          ret
  1393                                  
  1394                                  ; ---------------------------------------------------
  1395                                  ; MPSC1/2 初期化シーケンス
  1396                                  ; ---------------------------------------------------
  1397                                  mpsc_init:
  1398                                  ; --- [Phase 1: Hardware Reset] ---
  1399                                  ;   MPSC #1のチャネルA/Bに対して、リセットシーケンスを実行
  1400 000006CE BAA200                      mov dx, MPSC1_A_CTRL
  1401 000006D1 B000                        mov al, 0
  1402 000006D3 EE                          out dx, al          ; Pointer Reset 1
  1403 000006D4 EE                          out dx, al          ; Pointer Reset 2 
  1404                                  
  1405 000006D5 BAAA00                      mov dx, MPSC1_B_CTRL
  1406 000006D8 B000                        mov al, 0
  1407 000006DA EE                          out dx, al          ; Pointer Reset 1 
  1408 000006DB EE                          out dx, al          ; Pointer Reset 2 
  1409                                  
  1410                                      ; Channel Reset (CR0: 0x18)
  1411 000006DC BAA200                      mov dx, MPSC1_A_CTRL
  1412 000006DF B018                        mov al, 0x18        ; Channel Reset command 
  1413 000006E1 EE                          out dx, al          ; Direct Write to WR0
  1414                                  
  1415 000006E2 BAAA00                      mov dx, MPSC1_B_CTRL
  1416 000006E5 B018                        mov al, 0x18
  1417 000006E7 EE                          out dx, al
  1418                                      
  1419                                      ; MPSC #2のチャネルA/Bに対しても同様のリセットシーケンスを実行
  1420 000006E8 BAB200                      mov dx, MPSC2_A_CTRL
  1421 000006EB B000                        mov al, 0
  1422 000006ED EE                          out dx, al          ; Pointer Reset 1
  1423 000006EE EE                          out dx, al          ; Pointer Reset 2 
  1424                                  
  1425 000006EF BABA00                      mov dx, MPSC2_B_CTRL
  1426 000006F2 B000                        mov al, 0
  1427 000006F4 EE                          out dx, al          ; Pointer Reset 1 
  1428 000006F5 EE                          out dx, al          ; Pointer Reset 2 
  1429                                  
  1430                                      ; Channel Reset (CR0: 0x18)
  1431 000006F6 BAB200                      mov dx, MPSC2_A_CTRL
  1432 000006F9 B018                        mov al, 0x18        ; Channel Reset command 
  1433 000006FB EE                          out dx, al          ; Direct Write to WR0
  1434                                  
  1435 000006FC BABA00                      mov dx, MPSC2_B_CTRL
  1436 000006FF B018                        mov al, 0x18
  1437 00000701 EE                          out dx, al
  1438                                  
  1439                                      ; リセット後の安定待ち
  1440 00000702 B96400                      mov cx, 100
  1441                                  .wait_res:
  1442 00000705 90                          nop
  1443 00000706 90                          nop
  1444 00000707 90                          nop
  1445 00000708 E2FB                        loop .wait_res
  1446                                  
  1447                                      ; CR4: 送受信共通の動作設定
  1448 0000070A B004                        mov al, 4
  1449 0000070C B344                        mov bl, 0x44        ; x16, Async, ストップビット 1bit，パリティなし
  1450 0000070E E8AC00                      call mpsc_write_both
  1451                                  
  1452                                      ; CR2: システム全体の構成（割り込み/DMAモードや優先順位）を設定
  1453                                      ; CR2B
  1454 00000711 BAAA00                      mov dx, MPSC1_B_CTRL       ; MPSC #1 Ch.B Control Port
  1455 00000714 B002                        mov al, 02h                ; CR2Bを選択
  1456 00000716 EE                          out dx, al
  1457 00000717 B010                        mov al, 10h         ; ベクタベースを 10h に設定
  1458 00000719 EE                          out dx, al
  1459                                  
  1460                                      ; CR1: バスインターフェース、割り込みおよびDMAの設定
  1461 0000071A B001                        mov al, 1
  1462                                      ;mov bl, 0x00       ; すべての割り込みとDMAを無効化
  1463 0000071C B312                        mov bl, 12h         ; D4-D3=10: 全受信文字で割り込み
  1464                                                          ; D1=1: 送信割り込み有効
  1465                                                          ; D0=0: 外部要因(E/S)割り込み無効
  1466 0000071E E89C00                      call mpsc_write_both
  1467                                      
  1468                                      ; CR12: ボーレートジェネレータ（BRG）の割り込みとレジスタ書き込み設定 
  1469                                      ; MPSC #1のチャネルA/Bに対して、BRGレジスタセットモードを有効化し、ボーレートの値を設定
  1470 00000721 BAA200                      mov dx, MPSC1_A_CTRL
  1471 00000724 B00C                        mov al, 12          ; Select CR12
  1472 00000726 EE                          out dx, al
  1473 00000727 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1474 00000729 EE                          out dx, al
  1475 0000072A B01E                        mov al, 0x1e        ; 下位バイトの値
  1476 0000072C EE                          out dx, al
  1477 0000072D B000                        mov al, 0x00        ; 上位バイトの値
  1478 0000072F EE                          out dx, al
  1479                                      
  1480 00000730 BAAA00                      mov dx, MPSC1_B_CTRL
  1481 00000733 B00C                        mov al, 12          ; Select CR12
  1482 00000735 EE                          out dx, al
  1483 00000736 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1484 00000738 EE                          out dx, al
  1485 00000739 B01E                        mov al, 0x1e        ; 下位バイトの値
  1486 0000073B EE                          out dx, al
  1487 0000073C B000                        mov al, 0x00        ; 上位バイトの値
  1488 0000073E EE                          out dx, al
  1489                                      
  1490 0000073F BAA200                      mov dx, MPSC1_A_CTRL
  1491 00000742 B00C                        mov al, 12          ; Select CR12
  1492 00000744 EE                          out dx, al
  1493 00000745 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1494 00000747 EE                          out dx, al
  1495 00000748 B01E                        mov al, 0x1e        ; 下位バイトの値
  1496 0000074A EE                          out dx, al
  1497 0000074B B000                        mov al, 0x00        ; 上位バイトの値
  1498 0000074D EE                          out dx, al
  1499                                      
  1500 0000074E BAAA00                      mov dx, MPSC1_B_CTRL
  1501 00000751 B00C                        mov al, 12          ; Select CR12
  1502 00000753 EE                          out dx, al
  1503 00000754 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1504 00000756 EE                          out dx, al
  1505 00000757 B01E                        mov al, 0x1e        ; 下位バイトの値
  1506 00000759 EE                          out dx, al
  1507 0000075A B000                        mov al, 0x00        ; 上位バイトの値
  1508 0000075C EE                          out dx, al
  1509                                  
  1510                                      ; MPSC #2のチャネルA/Bに対して、BRGレジスタセットモードを有効化し、ボーレートの値を設定
  1511 0000075D BAB200                      mov dx, MPSC2_A_CTRL
  1512 00000760 B00C                        mov al, 12          ; Select CR12
  1513 00000762 EE                          out dx, al
  1514 00000763 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1515 00000765 EE                          out dx, al
  1516 00000766 B01E                        mov al, 0x1e        ; 下位バイトの値
  1517 00000768 EE                          out dx, al
  1518 00000769 B000                        mov al, 0x00        ; 上位バイトの値
  1519 0000076B EE                          out dx, al
  1520                                      
  1521 0000076C BABA00                      mov dx, MPSC2_B_CTRL
  1522 0000076F B00C                        mov al, 12          ; Select CR12
  1523 00000771 EE                          out dx, al
  1524 00000772 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1525 00000774 EE                          out dx, al
  1526 00000775 B01E                        mov al, 0x1e        ; 下位バイトの値
  1527 00000777 EE                          out dx, al
  1528 00000778 B000                        mov al, 0x00        ; 上位バイトの値
  1529 0000077A EE                          out dx, al
  1530                                      
  1531 0000077B BAB200                      mov dx, MPSC2_A_CTRL
  1532 0000077E B00C                        mov al, 12          ; Select CR12
  1533 00000780 EE                          out dx, al
  1534 00000781 B001                        mov al, 1           ; 受信BRGレジスタセットモード有効 (D0=1)
  1535 00000783 EE                          out dx, al
  1536 00000784 B01E                        mov al, 0x1e        ; 下位バイトの値
  1537 00000786 EE                          out dx, al
  1538 00000787 B000                        mov al, 0x00        ; 上位バイトの値
  1539 00000789 EE                          out dx, al
  1540                                      
  1541 0000078A BABA00                      mov dx, MPSC2_B_CTRL
  1542 0000078D B00C                        mov al, 12          ; Select CR12
  1543 0000078F EE                          out dx, al
  1544 00000790 B002                        mov al, 2           ; 送信BRGレジスタセットモード有効
  1545 00000792 EE                          out dx, al
  1546 00000793 B01E                        mov al, 0x1e        ; 下位バイトの値
  1547 00000795 EE                          out dx, al
  1548 00000796 B000                        mov al, 0x00        ; 上位バイトの値
  1549 00000798 EE                          out dx, al
  1550                                  
  1551                                      ; CR15: クロックソースとピン機能の選択
  1552 00000799 B00F                        mov al, 15
  1553 0000079B B356                        mov bl, 0x56        ; ボーレートジェネレータ使用
  1554 0000079D E81D00                      call mpsc_write_both
  1555                                  
  1556                                      ; CR14: BRGの動作許可とソース設定
  1557 000007A0 B00E                        mov al, 14
  1558 000007A2 B307                        mov bl, 0x07        ; BRGを動作させるソースクロックとして、システムクロック（CLK）を選択,送受信BRGカウント有効
  1559 000007A4 E81600                      call mpsc_write_both
  1560                                  
  1561                                      ; CR10: データエンコーディングなどの設定
  1562 000007A7 B00A                        mov al, 10
  1563 000007A9 B300                        mov bl, 0x00        ; データフォーマットとしてNRZ方式を選択
  1564 000007AB E80F00                      call mpsc_write_both
  1565                                  
  1566                                      ; CR3: 受信動作の有効化
  1567 000007AE B003                        mov al, 3
  1568 000007B0 B3C1                        mov bl, 0xC1        ; データ 8bit，受信イネーブル
  1569 000007B2 E80800                      call mpsc_write_both
  1570                                      
  1571                                      ; CR5: 送信動作の有効化とモデム制御ピンのアサート
  1572 000007B5 B005                        mov al, 5
  1573 000007B7 B3EA                        mov bl, 0xEA        ; データ 8bit，送信イネーブル
  1574 000007B9 E80100                      call mpsc_write_both
  1575                                      
  1576 000007BC C3                          ret
  1577                                  
  1578                                  ; --- Helper: Write to both MPSC #1, MPSC #2 ---
  1579                                  ; Input: AL = Register Index, BL = Value
  1580                                  mpsc_write_both:
  1581                                      ; MPSC #1 A-CHANNEL
  1582 000007BD BAA200                      mov dx, MPSC1_A_CTRL
  1583 000007C0 EE                          out dx, al          ; Write Index
  1584 000007C1 86C3                        xchg al, bl
  1585 000007C3 EE                          out dx, al          ; Write Data
  1586 000007C4 86C3                        xchg al, bl
  1587                                      
  1588                                      ; MPSC #1 B-CHANNEL
  1589 000007C6 BAAA00                      mov dx, MPSC1_B_CTRL
  1590 000007C9 EE                          out dx, al          ; Write Index
  1591 000007CA 86C3                        xchg al, bl
  1592 000007CC EE                          out dx, al          ; Write Data
  1593 000007CD 86C3                        xchg al, bl
  1594                                  
  1595                                      ; MPSC #2 A-CHANNEL
  1596 000007CF BAB200                      mov dx, MPSC2_A_CTRL
  1597 000007D2 EE                          out dx, al          ; Write Index
  1598 000007D3 86C3                        xchg al, bl
  1599 000007D5 EE                          out dx, al          ; Write Data
  1600 000007D6 86C3                        xchg al, bl
  1601                                      
  1602                                      ; MPSC #2 B-CHANNEL
  1603 000007D8 BABA00                      mov dx, MPSC2_B_CTRL
  1604 000007DB EE                          out dx, al          ; Write Index
  1605 000007DC 86C3                        xchg al, bl
  1606 000007DE EE                          out dx, al          ; Write Data
  1607 000007DF 86C3                        xchg al, bl
  1608                                  
  1609 000007E1 C3                          ret
  1610                                  
  1611                                  ; --------------------------------------------------
  1612                                  ; V53システムレジスタ設定テーブル
  1613                                  ; --------------------------------------------------
  1614                                  ALIGN 2
  1615                                  TABLE_V53_REG:
  1616 000007E2 FEFF00                      db 0xFE, 0xFF, 0x00     ; FFFE (SCTL) = 00h 16bit I/O boundary
  1617 000007E5 FDFF06                      db 0xFD, 0xFF, 0x06     ; FFFD (OPSEL)= 06h Enable ICU,TCU  Disable DMAU,SCU
  1618 000007E8 FCFF00                      db 0xFC, 0xFF, 0x00     ; FFFC (OPHA) = 00h
  1619 000007EB FBFFE0                      db 0xFB, 0xFF, 0xE0     ; FFFB (DULA) = E0h DCU:00E0h
  1620 000007EE FAFFC0                      db 0xFA, 0xFF, 0xC0     ; FFFA (IULA) = C0h ICU:00C0h
  1621 000007F1 F9FFD0                      db 0xF9, 0xFF, 0xD0     ; FFF9 (TULA) = D0h TCU:00D0h
  1622 000007F4 F8FFF0                      db 0xF8, 0xFF, 0xF0     ; FFF8 (SULA) = F0h SCU:00F0h
  1623 000007F7 EAFF00                      db 0xEA, 0xFF, 0x00     ; FFEA (WMB0) = 00h
  1624 000007FA EBFF00                      db 0xEB, 0xFF, 0x00     ; FFEB (WCY1) = 00h
  1625 000007FD ECFF00                      db 0xEC, 0xFF, 0x00     ; FFEC (WCY0) = 00h
  1626 00000800 F3FF73                      db 0xF3, 0xFF, 0x73     ; FFF3 (WMB1) = 73h
  1627 00000803 EDFF00                      db 0xED, 0xFF, 0x00     ; FFED (WAC)  = 00h
  1628 00000806 F4FF10                      db 0xF4, 0xFF, 0x10     ; FFF4 (WCY2) = 10h
  1629 00000809 F5FF22                      db 0xF5, 0xFF, 0x22     ; FFF5 (WCY3) = 22h
  1630 0000080C F6FF10                      db 0xF6, 0xFF, 0x10     ; FFF6 (WCY4) = 10h
  1631 0000080F F2FF00                      db 0xF2, 0xFF, 0x00     ; FFF2 (RFC)  = 00h
  1632 00000812 E9FF00                      db 0xE9, 0xFF, 0x00     ; FFE9 (BRC)  = 00h
  1633 00000815 F0FF02                      db 0xF0, 0xFF, 0x02     ; FFF0 (TCKS) = 02h
  1634 00000818 F1FF00                      db 0xF1, 0xFF, 0x00     ; FFF1 (SBCR) = 00h
  1635 0000081B FFFFFF                      db 0xFF, 0xFF, 0xFF     ; 終端マーカー
  1636                                  
  1637                                  ; --------------------------------------------------
  1638                                  ; TCU タイマー設定テーブル
  1639                                  ; --------------------------------------------------
  1640                                  ALIGN 2
  1641                                  TABLE_TCU_REG:
  1642                                      ; Port1, Val1, Port2, Val2(16)
  1643 0000081E D60036D000204E              db 0xD6, 0x00, 0x36, 0xD0, 0x00, 0x20, 0x4E ; T0設定
  1644 00000825 D60070D200050D              db 0xD6, 0x00, 0x70, 0xD2, 0x00, 0x05, 0x0D ; T0最大値A
  1645 0000082C D600B0D400050D              db 0xD6, 0x00, 0xB0, 0xD4, 0x00, 0x05, 0x0D ; T0最大値B
  1646 00000833 FFFF                        db 0xFF, 0xFF           ; 終端マーカー
