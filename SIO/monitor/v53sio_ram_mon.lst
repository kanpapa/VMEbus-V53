   879 000004BE 52                          PUSH DX                 	;レジスタ保存
   880 000004BF FF06[5209]                  inc word [int11h_flag]      ;発生フラグセット
   881 000004C3 E8EEFF                      CALL send_38h	            ;EOI発行サブルーチン呼出
   882 000004C6 5A                          POP DX
   883 000004C7 5B                          POP BX
   884 000004C8 58                          POP AX	                    ;レジスタ復帰
   885 000004C9 FB                          STI	                        ;割り込み許可
