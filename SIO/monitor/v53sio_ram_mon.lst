     1                                  ; =================================================================
     2                                  ; V53 RAM Monitor for DVE-554 v0.3 2026-05-02
     3                                  ; Target: DVE-554 SIO VME Board
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; Real:   nasm -f bin v53sio_ram_mon.asm -o v53sio_ram_mon.bin -l v53sio_ram_mon.lst
     8                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53sio_ram_mon.bin v53sio_ram_mon.hex
     9                                  ; -----------------
    10                                  
    11                                  ; 接続:
    12                                  ;   MPSC#1 INT(Lアクティブ) --[74LS04]--> V53 INTP4 (Hアクティブ)
    13                                  ;   MPSC#2 INT(Lアクティブ) --[74LS04]--> V53 INTP5 (Hアクティブ)
    14                                  ;   MPSC#1 INTAK ----------> V53 INTAK (共通)
    15                                  ;   MPSC#2 INTAK ----------> V53 INTAK (共通)
    16                                  ;
    17                                  ; IOアドレス:
    18                                  ;   MPSC#1 Ch.A CTRL 0x00A2  DATA 0x00A0
    19                                  ;   MPSC#1 Ch.B CTRL 0x00A6  DATA 0x00A4
    20                                  ;   MPSC#2 Ch.A CTRL 0x00AA  DATA 0x00A8
    21                                  ;   MPSC#2 Ch.B CTRL 0x00AE  DATA 0x00AC
    22                                  ;   V53 ICU     REG0 0x00C0  REG1 0x00C2
    23                                  ;
    24                                  ; 割り込みベクタ:
    25                                  ;   ICU Vector base = 0x20
    26                                  ;     TCU TOUT0(INTP0) → INT 0x20 
    27                                  ;   MPSC#1 Vector base = 0x28
    28                                  ;   MPSC#2 Vector base = 0x30
    29                                  
    30                                      org 0
    31                                      cpu 186
    32                                  
    33                                      ; V53 ICU (00C0Hに配置)
    34                                      %define ICU_REG0    0x000C0
    35                                      %define ICU_REG1    0x000C2
    36                                  
    37                                      ; V53 TCU (00D0Hに配置)
    38                                      %define TM0_CNT     0x000D0 ; Timer 0 Counter
    39                                      %define TM1_CNT     0x000D2 ; Timer 1 Counter
    40                                      %define TM2_CNT     0x000D4 ; Timer 2 Counter
    41                                      %define TM_CTL      0x000D6 ; Timer Control
    42                                  
    43                                      ; V53 DMAU (00E0Hに配置)
    44                                      ; DMAUはモニタでは使用しないため、レジスタ定義は省略します。
    45                                  
    46                                      ; V53 SCU (00F0Hに配置）
    47                                      ; SCUはモニタでは使用しないため、レジスタ定義は省略します。
    48                                  
    49                                      ; uPD72001 MPSC #1
    50                                      %define MPSC1_A_DATA 0x00A0 ; MPSC #1 Channel A Data Register
    51                                      %define MPSC1_A_CTRL 0x00A2 ; MPSC #1 Channel A Control Register
    52                                      %define MPSC1_B_DATA 0x00A4 ; MPSC #1 Channel B Data Register
    53                                      %define MPSC1_B_CTRL 0x00A6 ; MPSC #1 Channel B Control Register
    54                                  
    55                                      ; uPD72001 MPSC #2
    56                                      %define MPSC2_A_DATA 0x00A8 ; MPSC #2 Channel A Data Register
    57                                      %define MPSC2_A_CTRL 0x00AA ; MPSC #2 Channel A Control Register
    58                                      %define MPSC2_B_DATA 0x00AC ; MPSC #2 Channel B Data Register
    59                                      %define MPSC2_B_CTRL 0x00AE ; MPSC #2 Channel B Control Register
    60                                  
    61                                      %define TX_READY   0x04
    62                                      %define RX_READY   0x01
    63                                  
    64                                      %define RX_BUF_SIZE 64
    65                                  
    66                                  section .text
    67                                  
    68                                  start:
    69 00000000 FA                          cli             ; 初期化中は割り込み禁止
    70 00000001 FC                          cld             ; 文字列操作で方向フラグをクリアしておく
    71                                  
    72                                      ; ---------------------------------------------
    73                                      ; 1. セグメントレジスタ初期化
    74                                      ; ---------------------------------------------
    75 00000002 0E                          push cs     ; CS -> DS
    76 00000003 1F                          pop ds
    77 00000004 0E                          push cs     ; CS -> ES
    78 00000005 07                          pop es
    79 00000006 8CC8                        mov ax, cs  ; CS -> SS
    80 00000008 8ED0                        mov ss, ax
    81 0000000A BCFF7F                      mov sp, 0x7FFF
    82                                      ; ------------------------------
    83                                  
    84 0000000D E84B06                      call v53_sysreg_init    ; 2. V53 システムレジスタ初期化
    85 00000010 E89B06                      call v53_tcu_init       ; 3. V53 TCU初期化
    86 00000013 E8E006                      call v53_icu_init       ; 4. V53 ICU初期化
    87 00000016 E8CE06                      call dve554_io_init     ; 5. 物理IOの初期化（詳細不明）
    88 00000019 E8F303                      call int_vector_init    ; 6. 割り込みベクタの初期化
    89 0000001C E8FE06                      call mpsc_init          ; 7. MPSC初期化
    90                                  
    91 0000001F FB                          sti
    92                                  
    93                                      ; 変数初期化 (RAMエリアをクリア)
    94 00000020 C706[A209]0000              mov word [dump_seg], 0x0000
    95 00000026 C706[A409]0000              mov word [dump_off], 0x0000
    96 0000002C C706[A609]0020              mov word [load_seg], 0x2000
    97 00000032 C706[9E09]0000              mov word [head_ptr], 0x0000
    98 00000038 C706[AC09]0000              mov word [intsys_flag], 0x0000
    99                                  
   100                                      ; スタートメッセージの表示
   101 0000003E BE[2408]                    mov si, msg_boot
   102 00000041 E8EC02                      call puts
   103                                  
   104                                  ; =================================================================
   105                                  ; Main Loop
   106                                  ; =================================================================
   107                                  monitor_loop:
   108 00000044 B03E                        mov al, '>'
   109 00000046 E8F502                      call putc
   110 00000049 B020                        mov al, ' '
   111 0000004B E8F002                      call putc
   112                                  
   113 0000004E E83403                      call getc_echo  ; コマンド受信（エコーあり）
   114 00000051 88C3                        mov bl, al
   115                                      
   116 00000053 80FB64                      cmp bl, 'd'     ; dump command
   117 00000056 747A                        je do_dump
   118 00000058 80FB44                      cmp bl, 'D'
   119 0000005B 7475                        je do_dump
   120                                      
   121 0000005D 80FB6C                      cmp bl, 'l'     ; load command
   122 00000060 7503E9D000                  je do_load
   123 00000065 80FB4C                      cmp bl, 'L'
   124 00000068 7503E9C800                  je do_load
   125                                      
   126 0000006D 80FB67                      cmp bl, 'g'     ; go command
   127 00000070 7503E94401                  je do_go
   128 00000075 80FB47                      cmp bl, 'G'
   129 00000078 7503E93C01                  je do_go
   130                                  
   131 0000007D 80FB77                      cmp bl, 'w'     ; Write command
   132 00000080 7503E96001                  je do_write
   133 00000085 80FB57                      cmp bl, 'W'
   134 00000088 7503E95801                  je do_write
   135                                  
   136 0000008D 3C69                        cmp al, 'i'     ; Input Port command
   137 0000008F 7503E99401                  je do_in
   138 00000094 3C49                        cmp al, 'I'
   139 00000096 7503E98D01                  je do_in
   140                                  
   141 0000009B 3C6F                        cmp al, 'o'     ; Output Port command
   142 0000009D 7503E9AA01                  je do_out
   143 000000A2 3C4F                        cmp al, 'O'
   144 000000A4 7503E9A301                  je do_out
   145                                  
   146 000000A9 3C73                        cmp al, 's'     ; Scan I/O command
   147 000000AB 7503E9C601                  je do_scan
   148 000000B0 3C53                        cmp al, 'S'
   149 000000B2 7503E9BF01                  je do_scan
   150                                  
   151 000000B7 3C74                        cmp al, 't'     ; Scan Timer wait command
   152 000000B9 7503E92302                  je do_timer
   153 000000BE 3C54                        cmp al, 'T'
   154 000000C0 7503E91C02                  je do_timer
   155                                  
   156 000000C5 3C3F                        cmp al, '?'     ; Help
   157 000000C7 7503E95802                  je cmd_help
   158                                  
   159                                      ; 知らないコマンドなら改行して戻る
   160 000000CC E8BF02                      call putc_crlf
   161 000000CF E972FF                      jmp monitor_loop
   162                                  
   163                                  ; =================================================================
   164                                  ; Command: Dump Memory
   165                                  ; Usage:
   166                                  ;   D               -> Dump next 64 bytes
   167                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   168                                  ; =================================================================
   169                                  do_dump:
   170 000000D2 E8B002                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   171 000000D5 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   172 000000D7 7418                        je .dump_run
   173 000000D9 3C20                        cmp al, ' '         ; Spaceなら引数解析
   174 000000DB 7405                        je .parse_args
   175                                      
   176                                      ; それ以外なら無視して実行へ（またはエラー処理）
   177 000000DD E8AE02                      call putc_crlf
   178 000000E0 EB12                        jmp .dump_run_start
   179                                  
   180                                  .parse_args:
   181 000000E2 E8D702                      call get_hex_word
   182 000000E5 A3[A209]                    mov [dump_seg], ax
   183 000000E8 E81703                      call skip_space
   184 000000EB E8CE02                      call get_hex_word
   185 000000EE A3[A409]                    mov [dump_off], ax
   186                                      ; ここでEnter待ちをするか、そのまま実行するか
   187                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   188                                      
   189                                  .dump_run:
   190 000000F1 E89A02                      call putc_crlf              ; 実行直前に改行
   191                                  
   192                                  .dump_run_start:
   193 000000F4 B90400                      mov cx, 4                   ; 4行表示する
   194                                      
   195                                  .line_loop:
   196 000000F7 51                          push cx
   197                                      
   198 000000F8 A1[A209]                    mov ax, [dump_seg]          ; セグメントの表示
   199 000000FB E89902                      call print_hex_word
   200 000000FE B03A                        mov al, ':'                 ; 区切り文字の:を表示
   201 00000100 E83B02                      call putc
   202 00000103 A1[A409]                    mov ax, [dump_off]          ; オフセットの表示
   203 00000106 E88E02                      call print_hex_word
   204 00000109 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   205 0000010B E83002                      call putc
   206                                  
   207 0000010E 8B36[A409]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   208                                  
   209 00000112 1E                          push ds                     ; モニタのDSを保存
   210 00000113 8E1E[A209]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   211                                      
   212 00000117 B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   213                                  .hex_loop:
   214 0000011A 8A04                        mov al, [si]
   215 0000011C E87F02                      call print_hex_byte         ; メモリ内容の表示
   216 0000011F B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   217 00000121 E81A02                      call putc
   218 00000124 46                          inc si                      ; 次のアドレスにする
   219 00000125 E2F3                        loop .hex_loop              ; 16回繰り返し    
   220                                  
   221 00000127 1F                          pop ds                      ; DSをモニタ用に戻す
   222                                  
   223 00000128 8936[A409]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   224                                  
   225 0000012C E85F02                      call putc_crlf              ; 改行する
   226 0000012F 59                          pop cx
   227 00000130 E2C5                        loop .line_loop             ; 4回繰り返す
   228                                      
   229 00000132 E90FFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   230                                  
   231                                  ; =================================================================
   232                                  ; Command: Load Intel HEX
   233                                  ; Usage:
   234                                  ;   L           -> Load to default segment (load_seg)
   235                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   236                                  ; =================================================================
   237                                  do_load:
   238                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   239 00000135 A1[A609]                    mov ax, [load_seg]
   240 00000138 06                          push es             ; RAM用ESを保存
   241 00000139 50                          push ax             ; デフォルトセグメントを保存
   242                                      
   243 0000013A E84802                      call getc_echo
   244 0000013D 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   245 0000013F 7402                        je .parse_seg
   246 00000141 EB05                        jmp .start_load
   247                                  
   248                                  .parse_seg:
   249 00000143 58                          pop ax              ; 不要になったデフォルトを捨てる
   250 00000144 E87502                      call get_hex_word   ; 新しいセグメント取得
   251 00000147 50                          push ax             ; 保存
   252                                  
   253                                  .start_load:
   254 00000148 E84302                      call putc_crlf      ; メッセージ表示前に改行
   255 0000014B BE[5C08]                    mov si, msg_load    ; ロード開始メッセージを表示
   256 0000014E E8DF01                      call puts
   257                                      
   258 00000151 58                          pop ax
   259 00000152 8EC0                        mov es, ax          ; ロード先をESに設定
   260                                      
   261                                      ; ターゲット表示
   262 00000154 E84002                      call print_hex_word ; ESの値を表示
   263 00000157 B03A                        mov al, ':'         ; 区切り文字を表示
   264 00000159 E8E201                      call putc
   265 0000015C B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   266 0000015E E8DD01                      call putc
   267 00000161 E82A02                      call putc_crlf
   268                                  
   269                                  .wait_record:
   270 00000164 E8E801                      call getc           ; 開始文字を待つ
   271 00000167 3C3A                        cmp al, ':'
   272 00000169 75F9                        jne .wait_record
   273                                  
   274 0000016B E87302                      call get_hex_byte   ; データ長を読み込み
   275 0000016E 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   276 00000170 B500                        mov ch, 0
   277                                      
   278 00000172 E86C02                      call get_hex_byte   ; 上位アドレスを読み込み
   279 00000175 88C7                        mov bh, al
   280 00000177 E86702                      call get_hex_byte   ; 下位アドレスを読み込み
   281 0000017A 88C3                        mov bl, al
   282                                      
   283 0000017C E86202                      call get_hex_byte   ; レコードタイプを読み込み
   284 0000017F 3C01                        cmp al, 01          ; End of File?
   285 00000181 7422                        je .handle_eof      ; EOFの処理へ
   286 00000183 3C00                        cmp al, 00          ; Data Record?
   287 00000185 7523                        jne .skip_line      ; その他はスキップ
   288                                      
   289 00000187 E312                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   290                                      
   291                                  .data_loop:
   292 00000189 E85502                      call get_hex_byte   ; 1バイト読み取り
   293 0000018C 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   294 0000018F 43                          inc bx              ; 次のアドレスにする
   295                                      ; --- 追加: 64KBの境界チェック ---
   296 00000190 7507                        jnz .loop_next      ; bxが0にならなければそのまま
   297 00000192 8CC0                        mov ax, es          ; bxが0(一周)したら
   298 00000194 050010                      add ax, 0x1000      ; セグメントを64KB分(0x1000)進める
   299 00000197 8EC0                        mov es, ax
   300                                      ; -----------------------------
   301                                  
   302                                  .loop_next:
   303 00000199 E2EE                        loop .data_loop     ; データ長分繰り返す
   304                                      
   305                                  .read_chk:
   306 0000019B E84302                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   307 0000019E B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   308 000001A0 E89B01                      call putc
   309 000001A3 EBBF                        jmp .wait_record    ; 次のレコード読み取りへ
   310                                  
   311                                  .handle_eof:            ; EOFの場合
   312 000001A5 E83902                      call get_hex_byte   ; チェックサムを読み飛ばす
   313 000001A8 EB02                        jmp .finish         ; 読み込み終了処理へ
   314                                  
   315                                  .skip_line:
   316 000001AA EBB8                        jmp .wait_record    ; 次のレコード読み込みへ
   317                                  
   318                                  .finish:
   319 000001AC 07                          pop es              ; RAM用ESを復帰
   320 000001AD E8DE01                      call putc_crlf
   321 000001B0 BE[6808]                    mov si, msg_ok      ; "OK"を表示
   322 000001B3 E87A01                      call puts
   323 000001B6 E98BFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   324                                  
   325                                  ; =================================================================
   326                                  ; Command: Execute
   327                                  ; Usage:
   328                                  ;   G <Seg> <Off>
   329                                  ; Example: G 1000 0000
   330                                  ; =================================================================
   331                                  do_go:
   332                                      ; Gコマンドは入力後に改行
   333                                      
   334 000001B9 E8C901                      call getc_echo      ; Space?
   335 000001BC 3C20                        cmp al, ' '
   336 000001BE 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   337                                      
   338                                      ; 1. セグメント (SSSS) を取得
   339 000001C0 E8F901                      call get_hex_word   ; AX = Segment
   340 000001C3 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   341 000001C4 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   342                                      
   343                                      ; スペース読み飛ばし (もしあれば)
   344 000001C6 E83902                      call skip_space
   345                                      
   346                                      ; 2. オフセット (OOOO) を取得
   347 000001C9 E8F001                      call get_hex_word   ; AX = Offset
   348 000001CC 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   349                                      
   350 000001CD E8BE01                      call putc_crlf      ; 実行前に改行
   351 000001D0 BE[6B08]                    mov si, msg_go
   352 000001D3 E85A01                      call puts
   353 000001D6 E8B501                      call putc_crlf
   354                                      
   355                                      ; 3. 実行環境のセットアップ
   356                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   357 000001D9 8EDB                        mov ds, bx
   358 000001DB 8EC3                        mov es, bx
   359                                  
   360                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   361 000001DD FA                          cli
   362                                  
   363                                      ; 4. ジャンプ！ (Far Return)
   364                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   365 000001DE CB                          retf                ; Jump!
   366                                  
   367                                  .go_default:
   368 000001DF E8AC01                      call putc_crlf      ; 改行して
   369 000001E2 E95FFE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   370                                  
   371                                  ; ==============================================================
   372                                  ; Command: Write Memory
   373                                  ; Usage:
   374                                  ;   W <Seg> <Off> <Val>
   375                                  ; ==============================================================
   376                                  do_write:    
   377 000001E5 E89D01                      call getc_echo      ; Space?
   378 000001E8 3C20                        cmp al, ' '
   379 000001EA 7403E91702                  jne error           ; 引数なしならリターン(またはエラー)
   380                                  
   381                                      ; 1. セグメント (SSSS) を取得
   382 000001EF E8CA01                      call get_hex_word   ; AX = Segment
   383 000001F2 50                          push ax             ; ターゲットセグメントを保存
   384                                      
   385 000001F3 E88F01                      call getc_echo      ; Space?
   386 000001F6 3C20                        cmp al, ' '
   387 000001F8 7403E90902                  jne error           ; 引数なしならリターン(またはエラー)
   388                                      
   389                                      ; 2. オフセット (OOOO) を取得
   390 000001FD E8BC01                      call get_hex_word   ; AX = Offset
   391 00000200 50                          push ax             ; ターゲットオフセットを保存
   392                                  
   393 00000201 E88101                      call getc_echo      ; Space?
   394 00000204 3C20                        cmp al, ' '
   395 00000206 7403E9FB01                  jne error           ; 引数なしならリターン(またはエラー)
   396                                  
   397                                      ; 3. 設定データ (VV) を取得
   398 0000020B E8BD01                      call get_hex_byte_echo   ; AL = Value
   399                                  
   400 0000020E 5B                          pop bx              ; bx = Offset
   401 0000020F 5A                          pop dx              ; dx = Target Segment
   402                                  
   403                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   404 00000210 8916[A209]                  mov [dump_seg], dx
   405 00000214 891E[A409]                  mov [dump_off], bx
   406                                      
   407 00000218 8EDA                        mov ds, dx          ; DS再設定
   408 0000021A 3E8807                      mov [ds:bx], al     ; 書き込み！
   409                                      
   410 0000021D 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   411 0000021E 1F                          pop ds
   412                                  
   413 0000021F BE[8E08]                    mov si, msg_done
   414 00000222 E80B01                      call puts
   415 00000225 E91CFE                      jmp monitor_loop
   416                                  
   417                                  ; ==============================================================
   418                                  ; Command: Input from Port
   419                                  ; Usage:
   420                                  ;   I <Port>
   421                                  ; ==============================================================
   422                                  do_in:
   423 00000228 E85A01                      call getc_echo
   424 0000022B 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   425 0000022D 7403E9D401                  jne error           ; パラメタが無い場合はエラー処理へ
   426                                  
   427 00000232 E88701                      call get_hex_word   ; ポートアドレスを取得
   428 00000235 89C2                        mov dx, ax          ; 保存
   429 00000237 EC                          in al, dx           ; I/O Read
   430                                      
   431 00000238 50                          push ax
   432 00000239 E85201                      call putc_crlf      ; メッセージ表示前に改行
   433 0000023C BE[8808]                    mov si, msg_in_res
   434 0000023F E8EE00                      call puts
   435 00000242 58                          pop ax
   436                                  
   437 00000243 E85801                      call print_hex_byte ; 値を表示
   438                                  
   439 00000246 E84501                      call putc_crlf      ; 改行して
   440 00000249 E9F8FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   441                                  
   442                                  ; ==============================================================
   443                                  ; Command: Output to Port
   444                                  ; Usage
   445                                  ;   O <Port> <Val>
   446                                  ; ==============================================================
   447                                  do_out:
   448 0000024C E83601                      call getc_echo
   449 0000024F 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   450 00000251 7403E9B001                  jne error           ; パラメタが無い場合はエラー処理へ
   451                                  
   452 00000256 E86301                      call get_hex_word   ; ポートアドレスを取得
   453 00000259 50                          push ax             ; スタックに積む
   454                                  
   455 0000025A E82801                      call getc_echo
   456 0000025D 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   457 0000025F 7511                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   458                                      
   459 00000261 E86701                      call get_hex_byte_echo   ; 出力値を取得
   460 00000264 5A                          pop dx              ; スタックからDXにセット
   461                                      
   462 00000265 EE                          out dx, al          ; I/O Write
   463                                      
   464 00000266 E82501                      call putc_crlf      ; 書き込み完了後、まず改行する
   465 00000269 BE[8E08]                    mov si, msg_done    ; DONEを表示。改行付き。
   466 0000026C E8C100                      call puts
   467                                      
   468 0000026F E9D2FD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   469                                  
   470                                  error_pop:
   471 00000272 58                          pop ax              ; 使わなかったスタックを捨てる
   472 00000273 E99001                      jmp error
   473                                  
   474                                  ; ==============================================================
   475                                  ; Command: Scan I/O Ports
   476                                  ; Usage:
   477                                  ;   S <Start_port> <End_port>
   478                                  ; Description: Reads ports and prints if value is NOT 0xFF
   479                                  ; ==============================================================
   480                                  do_scan:
   481 00000276 E80C01                      call getc_echo
   482 00000279 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   483 0000027B 7403E98601                  jne error           ; パラメタが無い場合はエラー処理へ
   484                                  
   485 00000280 E83901                      call get_hex_word   ; スタートポートアドレスを取得
   486 00000283 89C3                        mov bx, ax          ; BX = Start Address
   487                                      
   488 00000285 E8FD00                      call getc_echo
   489 00000288 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   490 0000028A 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   491                                  
   492 0000028C E82D01                      call get_hex_word   ; エンドポートアドレスを取得
   493 0000028F 89C1                        mov cx, ax          ; CX = End Address
   494                                  
   495 00000291 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   496 00000293 7603E96E01                  ja error
   497                                  
   498 00000298 E8F300                      call putc_crlf
   499 0000029B BE[1D09]                    mov si, msg_scan_start
   500 0000029E E88F00                      call puts
   501                                  
   502                                  .scan_loop:
   503 000002A1 89DA                        mov dx, bx          ; DXにポートアドレス設定
   504 000002A3 EC                          in al, dx           ; I/O Read
   505                                  
   506 000002A4 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   507 000002A6 741D                        je .next_port
   508                                  
   509 000002A8 50                          push ax             ; Readした値をスタックに保存
   510                                  
   511                                      ; --- 有効な値が見つかった場合の表示 ---
   512                                      ; [Port]: Value
   513 000002A9 89D8                        mov ax, bx
   514 000002AB E8E900                      call print_hex_word ; ポートアドレスの表示
   515 000002AE B03A                        mov al, ':'
   516 000002B0 E88B00                      call putc
   517 000002B3 B020                        mov al, ' '
   518 000002B5 E88600                      call putc
   519                                      
   520 000002B8 58                          pop ax
   521 000002B9 E8E200                      call print_hex_byte ; Readした値の表示
   522                                      
   523 000002BC BE[4809]                    mov si, msg_space   ; "  "
   524 000002BF E86E00                      call puts
   525                                  
   526                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   527                                      ; ここでは単純にリスト形式で改行します
   528 000002C2 E8C900                      call putc_crlf
   529                                  
   530                                  .next_port:
   531 000002C5 43                          inc bx              ; 次のアドレスへ
   532                                      
   533                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   534 000002C6 E88C00                      call getc_noblock   ; 1文字取得関数 (非ブロッキング)
   535 000002C9 720D                        jc .abort           ; Carry Flag(CF)=1なら何かキーが押されたので中断
   536                                  
   537 000002CB 39CB                        cmp bx, cx
   538 000002CD 76D2                        jbe .scan_loop      ; BX <= CX ならループ
   539                                  
   540 000002CF BE[8E08]                    mov si, msg_done    ; 終了メッセージの表示
   541 000002D2 E85B00                      call puts
   542 000002D5 E96CFD                      jmp monitor_loop
   543                                  
   544                                  .abort:
   545 000002D8 BE[4B09]                    mov si, msg_abort   ; 中断メッセージの表示
   546 000002DB E85200                      call puts
   547 000002DE E963FD                      jmp monitor_loop
   548                                  
   549                                  ; ==============================================================
   550                                  ; Command: Timer
   551                                  ;   T          -> Show current tick counter (32-bit HEX)
   552                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   553                                  ; ==============================================================
   554                                  do_timer:
   555 000002E1 E8A100                      call getc_echo      ; コマンド('T')の次の文字を取得
   556 000002E4 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   557 000002E6 7421                        je .show_counter
   558 000002E8 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   559 000002EA 7403E91701                  jne error           ; それ以外はエラー
   560                                  
   561                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   562 000002EF E8CA00                      call get_hex_word   ; AX = 待ち時間 (0x0064 = 1秒)
   563                                  
   564                                      ; 開始時刻を保存 (Start Time)
   565 000002F2 8B1E[A809]                  mov bx, [tick_counter_lo]
   566                                  
   567                                  .wait_loop:
   568                                      ; 1. 現在時刻を取得
   569 000002F6 8B0E[A809]                  mov cx, [tick_counter_lo]
   570                                      
   571                                      ; 2. 経過時間を計算 (Current - Start)
   572                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   573 000002FA 29D9                        sub cx, bx          
   574                                      
   575                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   576 000002FC 39C1                        cmp cx, ax
   577 000002FE 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   578                                  
   579                                      ; 指定時間経過した
   580 00000300 BE[8E08]                    mov si, msg_done
   581 00000303 E82A00                      call puts
   582 00000306 E93BFD                      jmp monitor_loop
   583                                  
   584                                  .show_counter:
   585                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   586 00000309 E88200                      call putc_crlf
   587                                      
   588 0000030C BE[5609]                    mov si, msg_tick    ; "Tick: "
   589 0000030F E81E00                      call puts
   590                                  
   591                                      ; 32bitカウンタを [High][Low] の順で表示
   592 00000312 A1[AA09]                    mov ax, [tick_counter_hi]
   593 00000315 E87F00                      call print_hex_word
   594 00000318 A1[A809]                    mov ax, [tick_counter_lo]
   595 0000031B E87900                      call print_hex_word
   596                                      
   597 0000031E E86D00                      call putc_crlf
   598 00000321 E920FD                      jmp monitor_loop
   599                                  
   600                                  ; ==============================================================
   601                                  ; Command: Help
   602                                  ; ==============================================================
   603                                  cmd_help:
   604 00000324 E86700                      call putc_crlf
   605 00000327 BE[9A08]                    mov si, msg_help
   606 0000032A E80300                      call puts
   607 0000032D E914FD                      jmp monitor_loop
   608                                  
   609                                  ; =================================================================
   610                                  ; Utilities
   611                                  ; =================================================================
   612                                  
   613                                  ; 文字列出力
   614                                  puts:
   615 00000330 2E8A04                      mov al, [cs:si]
   616 00000333 08C0                        or al, al
   617 00000335 7406                        jz .ret
   618 00000337 E80400                      call putc
   619 0000033A 46                          inc si
   620 0000033B EBF3                        jmp puts
   621 0000033D C3                      .ret: ret
   622                                  
   623                                  ; 1文字出力
   624                                  putc:
   625 0000033E 52                          push dx
   626 0000033F 50                          push ax
   627 00000340 BAA200                      mov dx, MPSC1_A_CTRL
   628                                  .wait_tx:
   629 00000343 EC                          in al, dx
   630 00000344 A804                        test al, TX_READY   ; D2: Tx Buffer Empty?
   631 00000346 74FB                        jz .wait_tx
   632 00000348 BAA000                      mov dx, MPSC1_A_DATA
   633 0000034B 58                          pop ax
   634 0000034C EE                          out dx, al
   635 0000034D 5A                          pop dx
   636 0000034E C3                          ret
   637                                  
   638                                  ; 1文字入力
   639                                  getc:
   640                                      ; 1文字取得関数 (ブロッキング) ---
   641 0000034F E80300                      call getc_noblock
   642 00000352 73FB                        jnc getc
   643 00000354 C3                          ret
   644                                  
   645                                      ; 1文字取得関数 (非ブロッキング 受信割り込み方式) ---
   646                                      ; 戻り値: AL=データ, Carry Flag(CF)=1ならデータあり/0なら空
   647                                  getc_noblock:
   648 00000355 53                          push bx
   649 00000356 8B1E[A009]                  mov bx, [tail_ptr]
   650 0000035A 3B1E[9E09]                  cmp bx, [head_ptr]
   651 0000035E 7413                        je  .empty               ; 等しければデータなし
   652                                  
   653 00000360 8A87[5E09]                  mov al, [rx_buffer + bx]
   654 00000364 43                          inc bx
   655 00000365 83FB40                      cmp bx, RX_BUF_SIZE
   656 00000368 7502                        jne .next
   657 0000036A 31DB                        xor bx, bx
   658                                  .next:
   659 0000036C 891E[A009]                  mov [tail_ptr], bx
   660 00000370 F9                          stc                     ; CF = 1
   661 00000371 5B                          pop bx
   662 00000372 C3                          ret
   663                                  .empty:
   664 00000373 F8                          clc                     ; CF = 0
   665 00000374 5B                          pop bx
   666 00000375 C3                          RET
   667                                  
   668                                      ; 1文字取得関数 (ブロッキング ポーリング方式) ---
   669                                  getc_polling:
   670 00000376 52                          push dx
   671 00000377 BAA200                      mov dx, MPSC1_A_CTRL
   672                                  .wait_rx:
   673 0000037A EC                          in al, dx
   674 0000037B A801                        test al, RX_READY   ; D0: RX Ready?
   675 0000037D 74FB                        jz .wait_rx
   676 0000037F BAA000                      mov dx, MPSC1_A_DATA
   677 00000382 EC                          in al, dx
   678 00000383 5A                          pop dx
   679 00000384 C3                          ret
   680                                  
   681                                  ; 1文字入力 エコーバックあり
   682                                  getc_echo:
   683 00000385 E8C7FF                      call getc
   684 00000388 50                          push ax
   685 00000389 E8B2FF                      call putc
   686 0000038C 58                          pop ax
   687 0000038D C3                          ret
   688                                  
   689                                  ; 改行出力
   690                                  putc_crlf:
   691 0000038E B00D                        mov al, 0x0D
   692 00000390 E8ABFF                      call putc
   693 00000393 B00A                        mov al, 0x0A
   694 00000395 EBA7                        jmp putc
   695                                  
   696                                  ; -----------------------------------------------------------------
   697                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   698                                  ; Input: AX
   699                                  ; -----------------------------------------------------------------
   700                                  print_hex_word:
   701 00000397 50                          push ax
   702 00000398 88E0                        mov al, ah
   703 0000039A E80100                      call print_hex_byte
   704 0000039D 58                          pop ax
   705                                  
   706                                  ; -----------------------------------------------------------------
   707                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   708                                  ; Input: AL
   709                                  ; -----------------------------------------------------------------
   710                                  print_hex_byte:
   711 0000039E 50                          push ax
   712 0000039F 51                          push cx
   713                                  
   714                                      ; 上位バイトの表示
   715 000003A0 50                          push ax
   716 000003A1 C0E804                      shr al, 4
   717 000003A4 E80900                      call .digit
   718                                  
   719                                      ; 下位バイトの表示
   720 000003A7 58                          pop ax
   721 000003A8 240F                        and al, 0x0F
   722 000003AA E80300                      call .digit
   723                                  
   724 000003AD 59                          pop cx
   725 000003AE 58                          pop ax
   726 000003AF C3                          ret
   727                                  
   728                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   729                                  .digit:
   730 000003B0 0430                        add al, '0'
   731 000003B2 3C39                        cmp al, '9'
   732 000003B4 7602                        jbe .p
   733 000003B6 0407                        add al, 7
   734 000003B8 E883FF                  .p: call putc
   735 000003BB C3                          ret
   736                                  
   737                                  ; -----------------------------------------------------------------
   738                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   739                                  ; Input:  Serial (例: "1", "0", "0", "0")
   740                                  ; Output: AX = 0x1000
   741                                  ; -----------------------------------------------------------------
   742                                  get_hex_word:
   743 000003BC 53                          push bx
   744 000003BD E80B00                      call get_hex_byte_echo
   745 000003C0 88C7                        mov bh, al
   746 000003C2 E80600                      call get_hex_byte_echo
   747 000003C5 88C3                        mov bl, al
   748 000003C7 89D8                        mov ax, bx
   749 000003C9 5B                          pop bx
   750 000003CA C3                          ret
   751                                  
   752                                  ; 16進数2桁入力 エコーバック有り
   753                                  get_hex_byte_echo:
   754 000003CB 53                          push bx
   755 000003CC E8B6FF                      call getc_echo
   756 000003CF E82500                      call hex_char_to_bin
   757 000003D2 C0E004                      shl al, 4
   758 000003D5 88C3                        mov bl, al
   759 000003D7 E8ABFF                      call getc_echo
   760 000003DA E81A00                      call hex_char_to_bin
   761 000003DD 08D8                        or al, bl
   762 000003DF 5B                          pop bx
   763 000003E0 C3                          ret
   764                                  
   765                                  ; -----------------------------------------------------------------
   766                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   767                                  ; Input:  Serial (例: "3", "F")
   768                                  ; Output: AL = 0x3F
   769                                  ; -----------------------------------------------------------------
   770                                  get_hex_byte:
   771 000003E1 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   772                                  
   773                                      ; 上位4bit
   774 000003E2 E86AFF                      call getc
   775 000003E5 E80F00                      call hex_char_to_bin
   776 000003E8 C0E004                      shl al, 4
   777 000003EB 88C3                        mov bl, al          ; 一時保存
   778                                      
   779                                      ; 下位4bit
   780 000003ED E85FFF                      call getc
   781 000003F0 E80400                      call hex_char_to_bin
   782 000003F3 08D8                        or al, bl           ; 上位を合成して結果はALへ
   783 000003F5 5B                          pop bx
   784 000003F6 C3                          ret
   785                                  
   786                                  ; -----------------------------------------------------------------
   787                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   788                                  ; Input: AL (ASCII)
   789                                  ; Output: AL (Binary)
   790                                  ; -----------------------------------------------------------------
   791                                  hex_char_to_bin:
   792 000003F7 2C30                        sub al, '0'
   793 000003F9 3C09                        cmp al, 9
   794 000003FB 7604                        jbe .done
   795 000003FD 2C07                        sub al, 7           ; 'A'-'F'対応
   796 000003FF 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   797                                  .done:
   798 00000401 C3                          ret
   799                                  
   800                                  ; -----------------------------------------------------------------
   801                                  ; Helper: スペースなどを読み飛ばす
   802                                  ; -----------------------------------------------------------------
   803                                  skip_space:
   804 00000402 E880FF                      call getc_echo
   805 00000405 C3                          ret
   806                                  
   807                                  ; -----------------------------------------------------------------
   808                                  ; Helper: エラーメッセージ出力後モニタに戻る
   809                                  ; -----------------------------------------------------------------
   810                                  error:
   811 00000406 BE[7208]                    mov si, msg_error
   812 00000409 E824FF                      call puts
   813 0000040C E935FC                      jmp monitor_loop
   814                                  
   815                                  ; -----------------------------------------------------------------
   816                                  ; 割り込みベクタの初期化
   817                                  ; -----------------------------------------------------------------
   818                                  int_vector_init:
   819 0000040F 1E                          push ds
   820 00000410 06                          push es
   821 00000411 FC                          cld
   822                                  
   823 00000412 BE[3A04]                    mov si, TABLE_INT_VECTOR
   824 00000415 31C0                        xor ax, ax
   825 00000417 8EC0                        mov es, ax          ; es = 0x0000
   826                                  
   827                                  .set_loop:
   828 00000419 8A04                        mov al, [si]        ; al = ベクタ番号 をロード
   829 0000041B 3CFF                        cmp al, 0xff        ; 終端チェック
   830 0000041D 7418                        je  .done
   831                                      
   832 0000041F 46                          inc si              ; ベクタ番号分進める
   833 00000420 8B14                        mov dx, [si]        ; dx = オフセット退避
   834 00000422 83C602                      add si, 2           ; オフセット分進める
   835                                      
   836                                      ; ベクタテーブルのアドレス計算 (VectorNum * 4)
   837                                      ; V53では 0x0000:0xxxxx がベクタ領域
   838 00000425 30FF                        xor bh, bh
   839 00000427 88C3                        mov bl, al          ; bx = ベクタ番号
   840 00000429 C1E302                      shl bx, 2           ; bx = bx * 4 (1つのベクタは4バイト)
   841                                  
   842                                      ; ベクタの書き換え
   843 0000042C 268917                      mov [es:bx], dx        ; オフセットを書き込み
   844 0000042F 8CC8                        mov ax, cs             ; 現在のcsを取得
   845 00000431 26894702                    mov [es:bx+2], ax      ; セグメントとして書き込み
   846                                  
   847 00000435 EBE2                        jmp  .set_loop       ; 次のベクタへ
   848                                  
   849                                  .done:
   850 00000437 07                          pop  es
   851 00000438 1F                          pop  ds
   852 00000439 C3                          ret
   853                                  
   854                                      ; 割り込みベクタの初期化テーブル
   855                                      ; 設定したいベクタのリスト (ベクタ番号, ハンドラのオフセット)
   856                                  ALIGN 2
   857                                  TABLE_INT_VECTOR:
   858                                      ; INT 0x00 ～ 0x05
   859 0000043A 00                          db 0x00                         
   860 0000043B [9504]                      dw _isr_int0x00      ;INT 0x00: DIV/DIVU Divide Error
   861 0000043D 01                          db 0x01
   862 0000043E [9D04]                      dw _isr_int0x01      ;INT 0x01: BRK Flag (Simgle Step)
   863 00000440 02                          db 0x02
   864 00000441 [A504]                      dw _isr_int0x02      ;INT 0x02: NMI
   865 00000443 03                          db 0x03
   866 00000444 [AD04]                      dw _isr_int0x03      ;INT 0x03: BRK3
   867 00000446 04                          db 0x04
   868 00000447 [B504]                      dw _isr_int0x04      ;INT 0x04: BRKV
   869 00000449 05                          db 0x05
   870 0000044A [BD04]                      dw _isr_int0x05      ;INT 0x05: CHKIND境界オーバー
   871                                      ; INT 0x20 ～ 0x27
   872                                      ; V53 ICUのハンドラ
   873 0000044C 20                          db 0x20
   874 0000044D [C504]                      dw _isr_int0x20      ;INT 0x20 ICU INTP0 割り込みハンドラ (タイマー割り込み)
   875 0000044F 21                          db 0x21
   876 00000450 [E204]                      dw _isr_int0x21      ;INT 0x21 ICU INTP1 未使用
   877 00000452 22                          db 0x22
   878 00000453 [E904]                      dw _isr_int0x22      ;INT 0x22 ICU INTP2 未使用
   879 00000455 23                          db 0x23
   880 00000456 [F004]                      dw _isr_int0x23      ;INT 0x23 ICU INTP3 未使用：TOUT1に接続された割り込み
   881 00000458 24                          db 0x24
   882 00000459 [F704]                      dw _isr_int0x24      ;INT 0x24 ICU INTP4 未使用
   883 0000045B 25                          db 0x25
   884 0000045C [FE04]                      dw _isr_int0x25      ;INT 0x25 ICU INTP5 未使用
   885 0000045E 26                          db 0x26
   886 0000045F [0505]                      dw _isr_int0x26      ;INT 0x26 ICU INTP6 未使用：TOUT2に接続された割り込み
   887 00000461 27                          db 0x27
   888 00000462 [0C05]                      dw _isr_int0x27      ;INT 0x27 ICU INTP7 未使用
   889                                      ; INT 0x28 ～ 0x2f
   890                                      ; MPSC#1のハンドラ
   891 00000464 28                          db 0x28
   892 00000465 [1305]                      dw _isr_int0x28      ;INT 0x28 MPSC#1 Ch.B 未使用
   893 00000467 29                          db 0x29
   894 00000468 [2605]                      dw _isr_int0x29      ;INT 0x29 MPSC#1 Ch.B 未使用
   895 0000046A 2A                          db 0x2a
   896 0000046B [3905]                      dw _isr_int0x2a      ;INT 0x2A MPSC#1 Ch.B 未使用
   897 0000046D 2B                          db 0x2b
   898 0000046E [4C05]                      dw _isr_int0x2b      ;INT 0x2B MPSC#1 Ch.B 未使用
   899 00000470 2C                          db 0x2c
   900 00000471 [5F05]                      dw _isr_int0x2c      ;INT 0x2C MPSC#1 Ch.A 未使用
   901 00000473 2D                          db 0x2d
   902 00000474 [7205]                      dw _isr_int0x2d      ;INT 0x2D MPSC#1 Ch.A 未使用
