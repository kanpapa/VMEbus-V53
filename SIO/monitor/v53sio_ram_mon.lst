   904                                  ; --------------------------------------
   905                                  ; Vector 13h
   906                                  ; --------------------------------------
   907                                  _isr_int13h:
   908 000004DB FA                          CLI	                        ;割り込み禁止
   909 000004DC 50                          PUSH AX                     ;レジスタ保存
   910 000004DD 53                          PUSH BX                     ;レジスタ保存
   911 000004DE 52                          PUSH DX                 	;レジスタ保存
   912 000004DF FF06[5609]                  inc word [int13h_flag]      ;発生フラグセット
   913 000004E3 E8CEFF                      CALL send_38h	            ;EOI発行サブルーチン呼出
