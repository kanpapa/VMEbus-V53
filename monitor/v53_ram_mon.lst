   503 0000021B BE[A705]                    mov si, msg_load    ; ロード開始メッセージを表示
   504 0000021E E8DA01                      call puts
   505                                      
   506 00000221 58                          pop ax
   507 00000222 8EC0                        mov es, ax          ; ロード先をESに設定
   508                                      
   509                                      ; ターゲット表示
   510 00000224 E81602                      call print_hex_word ; ESの値を表示
   511 00000227 B03A                        mov al, ':'         ; 区切り文字を表示
   512 00000229 E8DD01                      call putc
   513 0000022C B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   514 0000022E E8D801                      call putc
   515 00000231 E80002                      call putc_crlf
   516                                  
   517                                  .wait_record:
   518 00000234 E8E501                      call getc           ; 開始文字を待つ
   519 00000237 3C3A                        cmp al, ':'
   520 00000239 75F9                        jne .wait_record
   521                                  
   522 0000023B E84902                      call get_hex_byte   ; データ長を読み込み
   523 0000023E 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   524 00000240 B500                        mov ch, 0
   525                                      
   526 00000242 E84202                      call get_hex_byte   ; 上位アドレスを読み込み
   527 00000245 88C7                        mov bh, al
   528 00000247 E83D02                      call get_hex_byte   ; 下位アドレスを読み込み
   529 0000024A 88C3                        mov bl, al
   530                                      
   531 0000024C E83802                      call get_hex_byte   ; レコードタイプを読み込み
   532 0000024F 3C01                        cmp al, 01          ; End of File?
   533 00000251 7419                        je .handle_eof      ; EOFの処理へ
   534 00000253 3C00                        cmp al, 00          ; Data Record?
   535 00000255 751A                        jne .skip_line      ; その他はスキップ
   536                                      
   537 00000257 E309                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   538                                      
   539                                  .data_loop:
   540 00000259 E82B02                      call get_hex_byte   ; 1バイト読み取り
   541 0000025C 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   542 0000025F 43                          inc bx              ; 次のアドレスにする
   543 00000260 E2F7                        loop .data_loop     ; データ長分繰り返す
   544                                      
   545                                  .read_chk:
   546 00000262 E82202                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   547 00000265 B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   548 00000267 E89F01                      call putc
   549 0000026A EBC8                        jmp .wait_record    ; 次のレコード読み取りへ
   550                                  
   551                                  .handle_eof:            ; EOFの場合
   552 0000026C E81802                      call get_hex_byte   ; チェックサムを読み飛ばす
   553 0000026F EB02                        jmp .finish         ; 読み込み終了処理へ
   554                                  
   555                                  .skip_line:
   556 00000271 EBC1                        jmp .wait_record    ; 次のレコード読み込みへ
   557                                  
   558                                  .finish:
   559 00000273 07                          pop es              ; RAM用ESを復帰
   560 00000274 E8BD01                      call putc_crlf
   561 00000277 BE[B305]                    mov si, msg_ok      ; "OK"を表示
   562 0000027A E87E01                      call puts
   563 0000027D E994FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   564                                  
   565                                  ; =================================================================
   566                                  ; Command: Execute
   567                                  ; Usage:
   568                                  ;   G <Seg> <Off>
   569                                  ; Example: G 1000 0000
   570                                  ; =================================================================
   571                                  do_go:
   572                                      ; Gコマンドは入力後に改行
   573                                      
   574 00000280 E8A801                      call getc_echo      ; Space?
   575 00000283 3C20                        cmp al, ' '
   576 00000285 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   577                                      
   578                                      ; 1. セグメント (SSSS) を取得
   579 00000287 E8D801                      call get_hex_word   ; AX = Segment
   580 0000028A 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   581 0000028B 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   582                                      
   583                                      ; スペース読み飛ばし (もしあれば)
   584 0000028D E81802                      call skip_space
   585                                      
   586                                      ; 2. オフセット (OOOO) を取得
   587 00000290 E8CF01                      call get_hex_word   ; AX = Offset
   588 00000293 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   589                                      
   590 00000294 E89D01                      call putc_crlf      ; 実行前に改行
   591 00000297 BE[B605]                    mov si, msg_go
   592 0000029A E85E01                      call puts
   593 0000029D E89401                      call putc_crlf
   594                                      
   595                                      ; 3. 実行環境のセットアップ
   596                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   597 000002A0 8EDB                        mov ds, bx
   598 000002A2 8EC3                        mov es, bx
   599                                  
   600                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   601 000002A4 FA                          cli
   602                                  
   603                                      ; 4. ジャンプ！ (Far Return)
   604                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   605 000002A5 CB                          retf                ; Jump!
   606                                  
   607                                  .go_default:
   608 000002A6 E88B01                      call putc_crlf      ; 改行して
   609 000002A9 E968FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   610                                  
   611                                  ; ==============================================================
   612                                  ; Command: Write Memory
   613                                  ; Usage:
   614                                  ;   W <Seg> <Off> <Val>
   615                                  ; ==============================================================
   616                                  do_write:    
   617 000002AC E87C01                      call getc_echo      ; Space?
   618 000002AF 3C20                        cmp al, ' '
   619 000002B1 7403E9F601                  jne error           ; 引数なしならリターン(またはエラー)
   620                                  
   621                                      ; 1. セグメント (SSSS) を取得
   622 000002B6 E8A901                      call get_hex_word   ; AX = Segment
   623 000002B9 50                          push ax             ; ターゲットセグメントを保存
   624                                      
   625 000002BA E86E01                      call getc_echo      ; Space?
   626 000002BD 3C20                        cmp al, ' '
   627 000002BF 7403E9E801                  jne error           ; 引数なしならリターン(またはエラー)
   628                                      
   629                                      ; 2. オフセット (OOOO) を取得
   630 000002C4 E89B01                      call get_hex_word   ; AX = Offset
   631 000002C7 50                          push ax             ; ターゲットオフセットを保存
   632                                  
   633 000002C8 E86001                      call getc_echo      ; Space?
   634 000002CB 3C20                        cmp al, ' '
   635 000002CD 7403E9DA01                  jne error           ; 引数なしならリターン(またはエラー)
   636                                  
   637                                      ; 3. 設定データ (VV) を取得
   638 000002D2 E89C01                      call get_hex_byte_echo   ; AL = Value
   639                                  
   640 000002D5 5B                          pop bx              ; bx = Offset
   641 000002D6 5A                          pop dx              ; dx = Target Segment
   642                                  
   643                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   644 000002D7 8916[FA06]                  mov [dump_seg], dx
   645 000002DB 891E[FC06]                  mov [dump_off], bx
   646                                      
   647 000002DF 8EDA                        mov ds, dx          ; DS再設定
   648 000002E1 3E8807                      mov [ds:bx], al     ; 書き込み！
   649                                      
   650 000002E4 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   651 000002E5 1F                          pop ds
   652                                  
   653 000002E6 BE[D905]                    mov si, msg_done
   654 000002E9 E80F01                      call puts
   655 000002EC E925FE                      jmp monitor_loop
   656                                  
   657                                  ; ==============================================================
   658                                  ; Command: Input from Port
   659                                  ; Usage:
   660                                  ;   I <Port>
   661                                  ; ==============================================================
   662                                  do_in:
   663 000002EF E83901                      call getc_echo
   664 000002F2 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   665 000002F4 7403E9B301                  jne error           ; パラメタが無い場合はエラー処理へ
   666                                  
   667 000002F9 E86601                      call get_hex_word   ; ポートアドレスを取得
   668 000002FC 89C2                        mov dx, ax          ; 保存
   669 000002FE EC                          in al, dx           ; I/O Read
   670                                      
   671 000002FF 50                          push ax
   672 00000300 E83101                      call putc_crlf      ; メッセージ表示前に改行
   673 00000303 BE[D305]                    mov si, msg_in_res
   674 00000306 E8F200                      call puts
   675 00000309 58                          pop ax
   676                                  
   677 0000030A E83701                      call print_hex_byte ; 値を表示
   678                                  
   679 0000030D E82401                      call putc_crlf      ; 改行して
   680 00000310 E901FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   681                                  
   682                                  ; ==============================================================
   683                                  ; Command: Output to Port
   684                                  ; Usage
   685                                  ;   O <Port> <Val>
   686                                  ; ==============================================================
   687                                  do_out:
   688 00000313 E81501                      call getc_echo
   689 00000316 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   690 00000318 7403E98F01                  jne error           ; パラメタが無い場合はエラー処理へ
   691                                  
   692 0000031D E84201                      call get_hex_word   ; ポートアドレスを取得
   693 00000320 50                          push ax             ; スタックに積む
   694                                  
   695 00000321 E80701                      call getc_echo
   696 00000324 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   697 00000326 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   698                                      
   699 00000328 E84601                      call get_hex_byte_echo   ; 出力値を取得
   700 0000032B 5A                          pop dx              ; スタックからDXにセット
   701                                      
   702 0000032C EE                          out dx, al          ; I/O Write
   703                                      
   704 0000032D BE[D905]                    mov si, msg_done    ; DONEを表示。改行付き。
   705 00000330 E8C800                      call puts
   706 00000333 E9DEFD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   707                                  
   708                                  error_pop:
