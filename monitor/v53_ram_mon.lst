   875                                  ; ==============================================================
   876                                  ; Command: Timer
   877                                  ;   T          -> Show current tick counter (32-bit HEX)
   878                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   879                                  ; ==============================================================
   880                                  do_timer:
   881 00000400 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   882 00000403 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   883 00000405 7421                        je .show_counter
   884 00000407 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   885 00000409 7403E9F200                  jne error           ; それ以外はエラー
   886                                  
   887                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   888 0000040E E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   889                                  
   890                                      ; 開始時刻を保存 (Start Time)
   891 00000411 8B1E[5409]                  mov bx, [tick_counter_lo]
   892                                  
   893                                  .wait_loop:
   894                                      ; 1. 現在時刻を取得
   895 00000415 8B0E[5409]                  mov cx, [tick_counter_lo]
   896                                      
   897                                      ; 2. 経過時間を計算 (Current - Start)
   898                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   899 00000419 29D9                        sub cx, bx          
   900                                      
   901                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   902 0000041B 39C1                        cmp cx, ax
   903 0000041D 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   904                                  
   905                                      ; 指定時間経過した
   906 0000041F BE[6007]                    mov si, msg_done
   907 00000422 E82A00                      call puts
   908 00000425 E937FD                      jmp monitor_loop
   909                                  
   910                                  .show_counter:
   911                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   912 00000428 E85D00                      call putc_crlf
   913                                      
   914 0000042B BE[2808]                    mov si, msg_tick    ; "Tick: "
   915 0000042E E81E00                      call puts
   916                                  
   917                                      ; 32bitカウンタを [High][Low] の順で表示
   918 00000431 A1[5609]                    mov ax, [tick_counter_hi]
   919 00000434 E85A00                      call print_hex_word
   920 00000437 A1[5409]                    mov ax, [tick_counter_lo]
   921 0000043A E85400                      call print_hex_word
   922                                      
   923 0000043D E84800                      call putc_crlf
   924 00000440 E91CFD                      jmp monitor_loop
   925                                  
   926                                  ; ==============================================================
   927                                  ; Command: Help
   928                                  ; ==============================================================
   929                                  cmd_help:
   930 00000443 E84200                      call putc_crlf
   931 00000446 BE[6C07]                    mov si, msg_help
   932 00000449 E80300                      call puts
   933 0000044C E910FD                      jmp monitor_loop
   934                                  
   935                                  ; =================================================================
   936                                  ; Utilities
   937                                  ; =================================================================
   938                                  
   939                                  ; 文字列出力
   940                                  puts:
   941 0000044F 2E8A04                      mov al, [cs:si]
   942 00000452 08C0                        or al, al
   943 00000454 7406                        jz .ret
   944 00000456 E80400                      call putc
   945 00000459 46                          inc si
   946 0000045A EBF3                        jmp puts
   947 0000045C C3                      .ret: ret
   948                                  
   949                                  ; 1文字出力
   950                                  putc:
   951 0000045D 52                          push dx
   952 0000045E 50                          push ax
   953 0000045F BA6120                      mov dx, SCU_SST
   954 00000462 EC                      .w: in al, dx
   955 00000463 A801                        test al, TX_READY  ; TX Ready?
   956 00000465 74FB                        jz .w
   957 00000467 BA6020                      mov dx, SCU_DATA
   958 0000046A 58                          pop ax
   959 0000046B 50                          push ax
   960 0000046C EE                          out dx, al
   961 0000046D 58                          pop ax
   962 0000046E 5A                          pop dx
   963 0000046F C3                          ret
   964                                  
   965                                  ; 1文字入力
   966                                  getc:
   967 00000470 52                          push dx
   968 00000471 BA6120                      mov dx, SCU_SST
   969 00000474 EC                      .w: in al, dx
   970 00000475 A802                        test al, RX_READY  ; RX Ready?
   971 00000477 74FB                        jz .w
   972 00000479 BA6020                      mov dx, SCU_DATA
   973 0000047C EC                          in al, dx
   974 0000047D 5A                          pop dx
   975 0000047E C3                          ret
   976                                  
   977                                  ; 1文字入力　エコーバックあり
   978                                  getc_echo:
   979 0000047F E8EEFF                      call getc
   980 00000482 50                          push ax
   981 00000483 E8D7FF                      call putc
   982 00000486 58                          pop ax
   983 00000487 C3                          ret
   984                                  
   985                                  ; 改行出力
   986                                  putc_crlf:
   987 00000488 B00D                        mov al, 0x0D
   988 0000048A E8D0FF                      call putc
   989 0000048D B00A                        mov al, 0x0A
   990 0000048F EBCC                        jmp putc
   991                                  
   992                                  ; -----------------------------------------------------------------
   993                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   994                                  ; Input: AX
   995                                  ; -----------------------------------------------------------------
   996                                  print_hex_word:
   997 00000491 50                          push ax
   998 00000492 88E0                        mov al, ah
   999 00000494 E80100                      call print_hex_byte
  1000 00000497 58                          pop ax
  1001                                  
  1002                                  ; -----------------------------------------------------------------
  1003                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
  1004                                  ; Input: AL
  1005                                  ; -----------------------------------------------------------------
  1006                                  print_hex_byte:
  1007 00000498 50                          push ax
  1008 00000499 51                          push cx
  1009                                  
  1010                                      ; 上位バイトの表示
  1011 0000049A 50                          push ax
  1012 0000049B C0E804                      shr al, 4
  1013 0000049E E80900                      call .digit
  1014                                  
  1015                                      ; 下位バイトの表示
  1016 000004A1 58                          pop ax
  1017 000004A2 240F                        and al, 0x0F
  1018 000004A4 E80300                      call .digit
  1019                                  
  1020 000004A7 59                          pop cx
  1021 000004A8 58                          pop ax
  1022 000004A9 C3                          ret
  1023                                  
  1024                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
  1025                                  .digit:
  1026 000004AA 0430                        add al, '0'
  1027 000004AC 3C39                        cmp al, '9'
  1028 000004AE 7602                        jbe .p
  1029 000004B0 0407                        add al, 7
  1030 000004B2 E8A8FF                  .p: call putc
  1031 000004B5 C3                          ret
  1032                                  
  1033                                  ; -----------------------------------------------------------------
  1034                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
  1035                                  ; Input:  Serial (例: "1", "0", "0", "0")
  1036                                  ; Output: AX = 0x1000
  1037                                  ; -----------------------------------------------------------------
  1038                                  get_hex_word:
  1039 000004B6 53                          push bx
  1040 000004B7 E80B00                      call get_hex_byte_echo
  1041 000004BA 88C7                        mov bh, al
  1042 000004BC E80600                      call get_hex_byte_echo
  1043 000004BF 88C3                        mov bl, al
  1044 000004C1 89D8                        mov ax, bx
  1045 000004C3 5B                          pop bx
  1046 000004C4 C3                          ret
  1047                                  
  1048                                  ; 16進数2桁入力　エコーバック有り
  1049                                  get_hex_byte_echo:
  1050 000004C5 53                          push bx
  1051 000004C6 E8B6FF                      call getc_echo
  1052 000004C9 E82500                      call hex_char_to_bin
  1053 000004CC C0E004                      shl al, 4
  1054 000004CF 88C3                        mov bl, al
  1055 000004D1 E8ABFF                      call getc_echo
  1056 000004D4 E81A00                      call hex_char_to_bin
  1057 000004D7 08D8                        or al, bl
  1058 000004D9 5B                          pop bx
  1059 000004DA C3                          ret
  1060                                  
  1061                                  ; -----------------------------------------------------------------
  1062                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1063                                  ; Input:  Serial (例: "3", "F")
  1064                                  ; Output: AL = 0x3F
  1065                                  ; -----------------------------------------------------------------
  1066                                  get_hex_byte:
  1067 000004DB 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1068                                  
  1069                                      ; 上位4bit
  1070 000004DC E891FF                      call getc
  1071 000004DF E80F00                      call hex_char_to_bin
  1072 000004E2 C0E004                      shl al, 4
  1073 000004E5 88C3                        mov bl, al          ; 一時保存
  1074                                      
  1075                                      ; 下位4bit
  1076 000004E7 E886FF                      call getc
  1077 000004EA E80400                      call hex_char_to_bin
  1078 000004ED 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1079 000004EF 5B                          pop bx
  1080 000004F0 C3                          ret
  1081                                  
  1082                                  ; -----------------------------------------------------------------
  1083                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1084                                  ; Input: AL (ASCII)
  1085                                  ; Output: AL (Binary)
  1086                                  ; -----------------------------------------------------------------
  1087                                  hex_char_to_bin:
  1088 000004F1 2C30                        sub al, '0'
  1089 000004F3 3C09                        cmp al, 9
  1090 000004F5 7604                        jbe .done
  1091 000004F7 2C07                        sub al, 7           ; 'A'-'F'対応
  1092 000004F9 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1093                                  .done:
  1094 000004FB C3                          ret
  1095                                  
  1096                                  ; -----------------------------------------------------------------
  1097                                  ; Helper: スペースなどを読み飛ばす
  1098                                  ; -----------------------------------------------------------------
  1099                                  skip_space:
  1100 000004FC E880FF                      call getc_echo
  1101 000004FF C3                          ret
  1102                                  
  1103                                  ; -----------------------------------------------------------------
  1104                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1105                                  ; -----------------------------------------------------------------
  1106                                  error:
  1107 00000500 BE[4407]                    mov si, msg_error
  1108 00000503 E849FF                      call puts
  1109 00000506 E956FC                      jmp monitor_loop
  1110                                  
  1111                                  ;==========================================================
  1112                                  ; NMI (ABORT) Handler
  1113                                  ;==========================================================
  1114                                  
  1115                                  NMI_Handler:
  1116                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1117 00000509 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1118 0000050A 1E                          push ds
  1119 0000050B 06                          push es
  1120                                  
  1121                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1122 0000050C 8CC8                        mov  ax, cs
  1123 0000050E 8ED8                        mov  ds, ax
  1124 00000510 8EC0                        mov  es, ax
  1125                                  
  1126                                      ; 3. スタックフレームへのポインタ設定
  1127 00000512 89E5                        mov  bp, sp
  1128                                  
  1129                                      ; --- 画面表示 ---
  1130 00000514 BE[2F08]                    mov  si, msg_nmi
  1131 00000517 E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1132                                  
  1133                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1134                                      ; Stack Layout after pushes:
  1135                                      ; BP+0: ES
  1136                                      ; BP+2: DS
  1137                                      ; BP+4: DI
  1138                                      ; BP+6: SI
  1139                                      ; BP+8: BP (Old)
  1140                                      ; BP+10: SP (Original)
  1141                                      ; BP+12: BX
  1142                                      ; BP+14: DX
  1143                                      ; BP+16: CX
  1144                                      ; BP+18: AX
  1145                                      ; BP+20: IP (Return Addr)
  1146                                      ; BP+22: CS (Return Addr)
  1147                                      ; BP+24: Flags
  1148                                      
  1149                                      ; AX
  1150 0000051A BE[4708]                    mov  si, msg_ax
  1151 0000051D E82FFF                      call puts
  1152 00000520 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1153 00000523 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1154                                  
  1155                                      ; BX
  1156 00000526 BE[4C08]                    mov  si, msg_bx
  1157 00000529 E823FF                      call puts
  1158 0000052C 8B460C                      mov  ax, [bp+12]
  1159 0000052F E85FFF                      call print_hex_word
  1160                                  
  1161                                      ; CX
  1162 00000532 BE[5108]                    mov  si, msg_cx
  1163 00000535 E817FF                      call puts
  1164 00000538 8B4610                      mov  ax, [bp+16]
  1165 0000053B E853FF                      call print_hex_word
  1166                                  
  1167                                      ; DX
  1168 0000053E BE[5608]                    mov  si, msg_dx
  1169 00000541 E80BFF                      call puts
  1170 00000544 8B460E                      mov  ax, [bp+14]
  1171 00000547 E847FF                      call print_hex_word
  1172                                  
  1173 0000054A E83BFF                      call putc_crlf
  1174                                  
  1175                                      ; --- 中断地点 (CS:IP) の表示 ---
  1176                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1177                                      ; その上が割り込み発生時の IP, CS, Flags です
  1178                                      
  1179 0000054D BE[5B08]                    mov  si, msg_addr
  1180 00000550 E8FCFE                      call puts           ; " Stop at "
  1181 00000553 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1182 00000556 E838FF                      call print_hex_word
  1183 00000559 B03A                        mov  al, ':'
  1184 0000055B E8FFFE                      call putc
  1185 0000055E 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1186 00000561 E82DFF                      call print_hex_word
  1187                                  
  1188 00000564 E821FF                      call putc_crlf
  1189                                  
  1190                                      ; 4. 復帰処理
  1191                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1192                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1193 00000567 E996FA                      jmp  start  ; モニタの開始ラベルへ
  1194                                  
  1195                                  ; ==========================================================
  1196                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1197                                  ; ==========================================================
  1198                                  
  1199                                  ; --- 共通処理部 (Common Handler) ---
  1200                                  _default_int_handler:
  1201                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1202 0000056A 55                          push bp
  1203 0000056B 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1204 0000056C 1E                          push ds
  1205 0000056D 06                          push es
  1206                                  
  1207                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1208 0000056E 8CC8                        mov  ax, cs
  1209 00000570 8ED8                        mov  ds, ax
  1210 00000572 8EC0                        mov  es, ax
  1211                                  
  1212                                      ; 3. スタックフレームへのポインタ設定
  1213 00000574 89E5                        mov  bp, sp
  1214                                  
  1215                                      ; --- メッセージ表示 ---
  1216 00000576 BE[6D08]                    mov  si, msg_int_trap
  1217 00000579 E8D3FE                      call puts           ; "** INT "
  1218                                  
  1219                                      ; --- ベクタ番号の表示 ---
  1220                                      ; スタック構造:
  1221                                      ; [BP+0] Old BP
  1222                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1223                                      ; [BP+4] Return IP ...
  1224                                      
  1225 0000057C 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1226 0000057F E816FF                      call print_hex_byte ; 表示 (例: 25)
  1227                                  
  1228 00000582 BE[7508]                    mov  si, msg_detected
  1229 00000585 E8C7FE                      call puts           ; " detected **" (改行含む)
  1230                                  
  1231                                  ; 3. レジスタ表示 (スタックから読み出して表示)
  1232                                      ; Stack Layout after pushes:
  1233                                      ; BP+0: ES
  1234                                      ; BP+2: DS
  1235                                      ; BP+4: DI
  1236                                      ; BP+6: SI
  1237                                      ; BP+8: BP (Old)
  1238                                      ; BP+10: SP (Original)
  1239                                      ; BP+12: BX
  1240                                      ; BP+14: DX
  1241                                      ; BP+16: CX
  1242                                      ; BP+18: AX
  1243                                      ; BP+20: IP (Return Addr)
  1244                                      ; BP+22: CS (Return Addr)
  1245                                      ; BP+24: Flags
  1246                                      
  1247                                      ; AX
  1248 00000588 BE[4708]                    mov  si, msg_ax
  1249 0000058B E8C1FE                      call puts
  1250 0000058E 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1251 00000591 E8FDFE                      call print_hex_word     ; 4桁HEX表示ルーチン
  1252                                  
  1253                                      ; BX
  1254 00000594 BE[4C08]                    mov  si, msg_bx
  1255 00000597 E8B5FE                      call puts
  1256 0000059A 8B460C                      mov  ax, [bp+12]
  1257 0000059D E8F1FE                      call print_hex_word
  1258                                  
  1259                                      ; CX
  1260 000005A0 BE[5108]                    mov  si, msg_cx
  1261 000005A3 E8A9FE                      call puts
  1262 000005A6 8B4610                      mov  ax, [bp+16]
  1263 000005A9 E8E5FE                      call print_hex_word
  1264                                  
  1265                                      ; DX
  1266 000005AC BE[5608]                    mov  si, msg_dx
  1267 000005AF E89DFE                      call puts
  1268 000005B2 8B460E                      mov  ax, [bp+14]
  1269 000005B5 E8D9FE                      call print_hex_word
  1270                                  
  1271 000005B8 E8CDFE                      call putc_crlf
  1272                                  
  1273                                      ; --- 中断地点 (CS:IP) の表示 ---
  1274                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1275                                      ; その上が割り込み発生時の IP, CS, Flags です
  1276                                      
  1277 000005BB BE[5B08]                    mov  si, msg_addr
  1278 000005BE E88EFE                      call puts           ; " Stop at "
  1279 000005C1 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1280 000005C4 E8CAFE                      call print_hex_word
  1281 000005C7 B03A                        mov  al, ':'
  1282 000005C9 E891FE                      call putc
  1283 000005CC 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1284 000005CF E8BFFE                      call print_hex_word
  1285                                  
  1286 000005D2 E8B3FE                      call putc_crlf
  1287                                  
  1288                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1289 000005D5 B020                        mov al, 20h         ; Non-specific EOI
  1290 000005D7 E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1291 000005D9 BA8020                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1292 000005DC EE                          out dx, al
  1293                                  
  1294 000005DD 07                          pop  es
  1295 000005DE 1F                          pop  ds
  1296 000005DF 61                          popa
  1297 000005E0 5D                          pop  bp
  1298 000005E1 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1299 000005E4 CF                          iret
  1300                                  
  1301                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1302                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1303                                  
  1304 000005E5 6A00                    _isr_stub_0:  push 0x0          ; 0: Division by zero
  1305 000005E7 EB81                                  jmp _default_int_handler
  1306 000005E9 6A01                    _isr_stub_1:  push 0x1          ; 1: Break flag
  1307 000005EB E97CFF                                jmp _default_int_handler
  1308                                                                  ; 2: NMI
  1309 000005EE 6A03                    _isr_stub_3:  push 0x3          ; 3: BRK3
  1310 000005F0 E977FF                                jmp _default_int_handler
  1311 000005F3 6A04                    _isr_stub_4:  push 0x4          ; 4: BRKV
  1312 000005F5 E972FF                                jmp _default_int_handler
  1313 000005F8 6A05                    _isr_stub_5:  push 0x5          ; 5: CHKIND
  1314 000005FA E96DFF                                jmp _default_int_handler
  1315                                  
  1316 000005FD 6A20                    _isr_stub_20: push 0x0020       ; 32: ICU INTP0
  1317 000005FF E968FF                                jmp _default_int_handler
  1318 00000602 6A21                    _isr_stub_21: push 0x0021       ; 33: ICU INTP1
  1319 00000604 E963FF                                jmp _default_int_handler
  1320 00000607 6A22                    _isr_stub_22: push 0x0022       ; 34: ICU INTP2
  1321 00000609 E95EFF                                jmp _default_int_handler
  1322 0000060C 6A23                    _isr_stub_23: push 0x0023       ; 35: ICU INTP3
  1323 0000060E E959FF                                jmp _default_int_handler
  1324 00000611 6A24                    _isr_stub_24: push 0x0024       ; 36: ICU INTP4
  1325 00000613 E954FF                                jmp _default_int_handler
  1326 00000616 6A25                    _isr_stub_25: push 0x0025       ; 37: ICU INTP5
  1327 00000618 E94FFF                                jmp _default_int_handler
  1328 0000061B 6A26                    _isr_stub_26: push 0x0026       ; 38: ICU INTP6
  1329 0000061D E94AFF                                jmp _default_int_handler
  1330                                  
  1331                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1332                                  
  1333                                  ; ==========================================================
  1334                                  ; PIC Dispatch Handler (Vector 27h)
  1335                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1336                                  ; ==========================================================
  1337                                  _pic_dispatch_handler:
  1338 00000620 60                          pusha
  1339 00000621 1E                          push ds
  1340 00000622 06                          push es
  1341                                  
  1342                                      ; DS設定 (Tiny Model)
  1343 00000623 8CC8                        mov ax, cs
  1344 00000625 8ED8                        mov ds, ax
  1345                                  
  1346                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1347                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1348 00000627 B00B                        mov al, 0x0B
  1349 00000629 E6C8                        out PIC_REG0, al
  1350 0000062B E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1351                                  
  1352                                      ; --- 2. 要因判定と分岐 ---
  1353                                      
  1354 0000062D A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1355 0000062F 751E                        jnz .handle_timer0
  1356                                  
  1357 00000631 A802                        test al, 02h        ; Bit 1: SCSI
  1358 00000633 7526                        jnz .handle_scsi
  1359                                  
  1360 00000635 A804                        test al, 04h        ; Bit 2: Timer 1
  1361 00000637 752A                        jnz .handle_timer1
  1362                                  
  1363 00000639 A808                        test al, 08h        ; Bit 3: USART Rx
  1364 0000063B 752E                        jnz .handle_usart_rx
  1365                                  
  1366 0000063D A810                        test al, 10h        ; Bit 4: USART Tx
  1367 0000063F 7532                        jnz .handle_usart_tx
  1368                                  
  1369 00000641 A820                        test al, 20h        ; Bit 5: SCU Rx
  1370 00000643 7536                        jnz .handle_scu_rx
  1371                                  
  1372 00000645 A840                        test al, 40h        ; Bit 6: SCU Tx
  1373 00000647 753A                        jnz .handle_scu_tx
  1374                                  
  1375 00000649 A880                        test al, 80h        ; Bit 7: PPI
  1376 0000064B 753E                        jnz .handle_ppi
  1377                                  
  1378                                      ; 該当なしの場合は無視
  1379 0000064D EB44                        jmp .eoi_exit
  1380                                  
  1381                                  ; --- 各ハンドラ処理 ---
  1382                                  
  1383                                  .handle_timer0:
  1384                                      ; INTP0: Timer 0 (Tick)
  1385                                      ; --- 32bit カウンタのインクリメント ---
  1386 0000064F FF06[5409]                  inc word [tick_counter_lo]
  1387 00000653 7504                        jnz .skip_carry
  1388 00000655 FF06[5609]                  inc word [tick_counter_hi]
  1389                                  .skip_carry:
  1390 00000659 EB38                        jmp .eoi_exit
  1391                                  
  1392                                  .handle_scsi:
  1393                                      ; INTP1: SCSIC
  1394 0000065B BE[8208]                    mov si, msg_int_scsi
  1395 0000065E E8EEFD                      call puts
  1396 00000661 EB30                        jmp .eoi_exit
  1397                                  
  1398                                  .handle_timer1:
  1399                                      ; INTP2: ユーザ用タイマー
  1400 00000663 BE[9908]                    mov si, msg_int_timer1
  1401 00000666 E8E6FD                      call puts
  1402 00000669 EB28                        jmp .eoi_exit
  1403                                  
  1404                                  .handle_usart_rx:
  1405                                      ; INTP3: USART受信準備完了割り込み
  1406 0000066B BE[B208]                    mov si, msg_int_usart_rx
  1407 0000066E E8DEFD                      call puts
  1408 00000671 EB20                        jmp .eoi_exit
  1409                                  
  1410                                  .handle_usart_tx:
  1411                                      ; INTP4: USART送信完了割り込み
  1412 00000673 BE[CD08]                    mov si, msg_int_usart_tx
  1413 00000676 E8D6FD                      call puts
  1414 00000679 EB18                        jmp .eoi_exit
  1415                                  
  1416                                  .handle_scu_rx:
  1417                                      ; INTP5: SCU受信準備完了割り込み
  1418 0000067B BE[E808]                    mov si, msg_int_scu_rx
  1419 0000067E E8CEFD                      call puts
  1420 00000681 EB10                        jmp .eoi_exit
  1421                                  
  1422                                  .handle_scu_tx:
  1423                                      ; INTP6: SCU送信完了割り込み
  1424 00000683 BE[0109]                    mov si, msg_int_scu_tx
  1425 00000686 E8C6FD                      call puts
  1426 00000689 EB08                        jmp .eoi_exit
  1427                                  
  1428                                  .handle_ppi:
  1429                                      ; INTP7: PPI割り込み
  1430 0000068B BE[1A09]                    mov si, msg_int_ppi
  1431 0000068E E8BEFD                      call puts
  1432 00000691 EB00                        jmp .eoi_exit
  1433                                  
  1434                                  ; --- 終了処理 ---
  1435                                  .eoi_exit:
  1436                                      ; --- EOI (End of Interrupt) to PIC ---
  1437 00000693 B020                        mov al, 20h     ; Non-specific EOI
  1438                                  
  1439                                      ; 外部PIC (Slave) の割り込み完了
  1440 00000695 E6C8                        out PIC_REG0, al
  1441                                  
  1442                                      ; V53内蔵ICU (Master) の割り込み完了
  1443 00000697 BA8020                      mov dx, ICU_REG0 
  1444 0000069A EE                          out dx, al
  1445                                  
  1446 0000069B 07                          pop es
  1447 0000069C 1F                          pop ds
  1448 0000069D 61                          popa
  1449 0000069E CF                          iret
  1450                                  
  1451                                  ;--------------------------------------
  1452                                  ; 未定義割り込みベクタ用の簡易トラップ
  1453                                  ;--------------------------------------
  1454                                  _default_int_unknown_handler:
  1455                                      ; 想定外の割り込みが発生したため、
  1456                                      ; 画面に "UNKNOWN INT" と出して停止する
  1457 0000069F FA                          cli                 ; 多重割り込み禁止
  1458                                  
  1459                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1460 000006A0 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1461 000006A1 1E                          push ds
  1462 000006A2 06                          push es
  1463                                  
  1464                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1465 000006A3 8CC8                        mov  ax, cs
  1466 000006A5 8ED8                        mov  ds, ax
  1467 000006A7 8EC0                        mov  es, ax
  1468                                  
  1469                                      ; 3. スタックフレームへのポインタ設定
  1470 000006A9 89E5                        mov  bp, sp
  1471                                  
  1472 000006AB BE[3009]                    mov si, msg_unknown_int
  1473 000006AE E89EFD                      call puts
  1474                                  
  1475                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1476                                      ; Stack Layout after pushes:
  1477                                      ; BP+0: ES
  1478                                      ; BP+2: DS
  1479                                      ; BP+4: DI
  1480                                      ; BP+6: SI
  1481                                      ; BP+8: BP (Old)
  1482                                      ; BP+10: SP (Original)
  1483                                      ; BP+12: BX
  1484                                      ; BP+14: DX
  1485                                      ; BP+16: CX
  1486                                      ; BP+18: AX
  1487                                      ; BP+20: IP (Return Addr)
  1488                                      ; BP+22: CS (Return Addr)
  1489                                      ; BP+24: Flags
  1490                                      
  1491                                      ; AX
  1492 000006B1 BE[4708]                    mov  si, msg_ax
  1493 000006B4 E898FD                      call puts
  1494 000006B7 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1495 000006BA E8D4FD                      call print_hex_word     ; 4桁HEX表示ルーチン
  1496                                  
  1497                                      ; BX
  1498 000006BD BE[4C08]                    mov  si, msg_bx
  1499 000006C0 E88CFD                      call puts
  1500 000006C3 8B460C                      mov  ax, [bp+12]
  1501 000006C6 E8C8FD                      call print_hex_word
  1502                                  
  1503                                      ; CX
  1504 000006C9 BE[5108]                    mov  si, msg_cx
  1505 000006CC E880FD                      call puts
  1506 000006CF 8B4610                      mov  ax, [bp+16]
  1507 000006D2 E8BCFD                      call print_hex_word
  1508                                  
  1509                                      ; DX
  1510 000006D5 BE[5608]                    mov  si, msg_dx
  1511 000006D8 E874FD                      call puts
  1512 000006DB 8B460E                      mov  ax, [bp+14]
  1513 000006DE E8B0FD                      call print_hex_word
  1514                                  
  1515 000006E1 E8A4FD                      call putc_crlf
  1516                                  
  1517                                      ; --- 中断地点 (CS:IP) の表示 ---
  1518                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1519                                      ; その上が割り込み発生時の IP, CS, Flags です
  1520                                      
  1521 000006E4 BE[5B08]                    mov  si, msg_addr
  1522 000006E7 E865FD                      call puts           ; " Stop at "
  1523 000006EA 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1524 000006ED E8A1FD                      call print_hex_word
  1525 000006F0 B03A                        mov  al, ':'
  1526 000006F2 E868FD                      call putc
  1527 000006F5 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1528 000006F8 E896FD                      call print_hex_word
  1529                                  
  1530 000006FB E88AFD                      call putc_crlf
  1531                                  
  1532                                      ; 4. 復帰処理
  1533                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1534                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1535 000006FE E9FFF8                      jmp  start  ; モニタの開始ラベルへ
  1536                                  
  1537                                      ; 停止（暴走を防ぐ）
  1538                                  ;.halt:
  1539                                  ;    hlt
  1540                                  ;    jmp .halt
