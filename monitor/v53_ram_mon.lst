   479                                  ; =================================================================
   480                                  ; Command: Load Intel HEX
   481                                  ; Usage:
   482                                  ;   L           -> Load to default segment (load_seg)
   483                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   484                                  ; =================================================================
   485                                  do_load:
   486                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   487 00000205 A1[FE06]                    mov ax, [load_seg]
   488 00000208 06                          push es             ; RAM用ESを保存
   489 00000209 50                          push ax             ; デフォルトセグメントを保存
   490                                      
   491 0000020A E81E02                      call getc_echo
   492 0000020D 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   493 0000020F 7402                        je .parse_seg
   494 00000211 EB05                        jmp .start_load
   495                                  
   496                                  .parse_seg:
   497 00000213 58                          pop ax              ; 不要になったデフォルトを捨てる
   498 00000214 E84B02                      call get_hex_word   ; 新しいセグメント取得
   499 00000217 50                          push ax             ; 保存
   500                                  
   501                                  .start_load:
