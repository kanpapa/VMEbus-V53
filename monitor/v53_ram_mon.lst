   585 00000275 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   586 00000278 43                          inc bx              ; 次のアドレスにする
   587 00000279 E2F7                        loop .data_loop     ; データ長分繰り返す
   588                                      
