     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.12 2026-03-03
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53_ram_mon.bin v53_ram_mon.hex
    10                                  ; -----------------
    11                                  
    12                                  ; ==========================================
    13                                  ; V53 System Register
    14                                  ; ==========================================
    15                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    16                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    17                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    18                                  %define DULA    0x0FFFB ; 
    19                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    20                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    21                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    22                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    23                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    24                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    25                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    26                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    27                                  %define SBCR    0x0FFF1 ; 
    28                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    29                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    30                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    31                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    32                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    33                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    34                                  %define BADR    0x0FFE1 ; 
    35                                  %define BSEL    0x0FFE0 ; 
    36                                  %define XAM     0x0FF80 ; 
    37                                  %define PGR     0x0FF00 ; 
    38                                  
    39                                  
    40                                  
    41                                  %ifdef SIM
    42                                      ; --- Simulation Mode ---
    43                                      org 0x100
    44                                      cpu 186
    45                                  
    46                                      %define SCU_DATA   0x3F8
    47                                      %define SCU_SST    0x3FD
    48                                      %define TX_READY    0x20                                 
    49                                      %define RX_READY    0x01
    50                                  %else
    51                                      ; --- Real Hardware Mode ---
    52                                      org 0
    53                                      cpu 186
    54                                  
    55                                      ; V53 SCU (F060Hに配置）
    56                                      %define SCU_DATA    0x0F060 ; 送受データ・レジスタ(R:SRB/W:STB)
    57                                      %define SCU_SST     0x0F061 ; ステータス・レジスタ(R:SST)
    58                                      %define SCU_SCM     0x0F061 ; コマンドレジスタ(W:SCM)
    59                                      %define SCU_SMD     0x0F062 ; シリアルモード設定(W:SMD)
    60                                      %define SCU_SIMK    0x0F063 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    61                                      %define TX_READY    00000001b   ; TBRDY                                 
    62                                      %define RX_READY    00000010b   ; RBRDY
    63                                  
    64                                      ; V53 TCU (F070Hに配置)
    65                                      %define TM0_CNT     0x0F070 ; Timer 0 Counter
    66                                      %define TM1_CNT     0x0F071 ; Timer 1 Counter
    67                                      %define TM2_CNT     0x0F072 ; Timer 2 Counter
    68                                      %define TM_CTL      0x0F073 ; Timer Control
    69                                  
    70                                      ; V53 ICU (F080Hに配置)
    71                                      %define ICU_REG0    0x0F080
    72                                      %define ICU_REG1    0x0F081
    73                                  
    74                                      ;-----------------------------------------
    75                                      ; V53 VME Board ペリフェラル
    76                                      ;-----------------------------------------
    77                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    78                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    79                                  
    80                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
    81                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
    82                                  
    83                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
    84                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
    85                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
    86                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
    87                                  %endif
    88                                  
    89                                  section .text
    90                                  
    91                                  start:
    92                                  %ifdef SIM
    93                                      xor ax, ax
    94                                      mov es, ax
    95                                  %else
    96 00000000 FA                          cli             ; 初期化中は割り込み禁止
    97                                  
    98                                      ; ---------------------------------------------
    99                                      ; 1. セグメントレジスタ初期化
   100                                      ; CS=DS=ES を想定
   101                                      ; ---------------------------------------------
   102 00000001 0E                          push cs
   103 00000002 1F                          pop ds
   104 00000003 0E                          push cs
   105 00000004 07                          pop es
   106                                      ; --- 【重要】スタックの初期化 ---
   107                                      ; 現在のCSセグメントの末尾 (FFFEh) にスタックを移動させます。
   108                                      ; これでコード領域との衝突を回避します。
   109 00000005 8CC8                        mov ax, cs
   110 00000007 8ED0                        mov ss, ax
   111 00000009 BCFEFF                      mov sp, 0xFFFE
   112                                      ; ------------------------------
   113                                  
   114                                      ;==============================================
   115                                      ; ABORT (NMI) Handler Setup 
   116                                      ;==============================================
   117                                  Init_NMI:
   118                                      ; ----------------------------------------------------
   119                                      ; 1. 全ベクタ (00h-FFh) をデフォルトハンドラで埋める
   120                                      ;    (予期せぬ割り込みによる暴走を防ぐ安全策)
   121                                      ; ----------------------------------------------------
   122 0000000C 31C0                        xor ax, ax
   123 0000000E 8EC0                        mov es, ax          ; ES = 0000h (Vector Table)
   124 00000010 BF0000                      mov di, 0           ; Offset 0
   125                                  
   126 00000013 B90001                      mov cx, 256         ; 256個のベクタ全てを設定
   127                                  .init_loop:
   128 00000016 B8[B006]                    mov ax, _default_int_unknown_handler ; 共通トラップハンドラ
   129 00000019 AB                          stosw               ; Offset書き込み
   130 0000001A 8CC8                        mov ax, cs
   131 0000001C AB                          stosw               ; Segment書き込み
   132 0000001D E2F7                        loop .init_loop
   133                                  
   134 0000001F 31C0                        xor  ax, ax
   135 00000021 8EC0                        mov  es, ax          ; ES = 0000h
   136                                      
   137                                      ; 専用割り込みベクタを上書き登録 (0 - 5)
   138 00000023 BF0000                      mov  di, 0x0000      ; 0x0 * 4 = 0h
   139 00000026 B8[F605]                    mov  ax, _isr_stub_0
   140 00000029 AB                          stosw
   141 0000002A 8CC8                        mov  ax, cs
   142 0000002C AB                          stosw
   143                                  
   144 0000002D BF0400                      mov  di, 0x0004      ; 0x1 * 4 = 4h
   145 00000030 B8[FA05]                    mov  ax, _isr_stub_1
   146 00000033 AB                          stosw
   147 00000034 8CC8                        mov  ax, cs
   148 00000036 AB                          stosw
   149                                  
   150                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   151 00000037 BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   152 0000003A B8[1A05]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   153 0000003D AB                          stosw                ; [0000:0008] = AX
   154 0000003E 8CC8                        mov  ax, cs          ; 現在のCS
   155 00000040 AB                          stosw                ; [0000:000A] = CS
   156                                  
   157 00000041 BF0C00                      mov  di, 0x000c      ; 0x3 * 4 = 0ch
   158 00000044 B8[FF05]                    mov  ax, _isr_stub_3
   159 00000047 AB                          stosw
   160 00000048 8CC8                        mov  ax, cs
   161 0000004A AB                          stosw
   162                                  
   163 0000004B BF1000                      mov  di, 0x0010      ; 0x4 * 4 = 10h
   164 0000004E B8[0406]                    mov  ax, _isr_stub_4
   165 00000051 AB                          stosw
   166 00000052 8CC8                        mov  ax, cs
   167 00000054 AB                          stosw
   168                                  
   169 00000055 BF1400                      mov  di, 0x0014      ; 0x5 * 4 = 14h
   170 00000058 B8[0906]                    mov  ax, _isr_stub_5
   171 0000005B AB                          stosw
   172 0000005C 8CC8                        mov  ax, cs
   173 0000005E AB                          stosw
   174                                  
   175                                      ; ICU割り込みベクタを上書き登録 (0x20 - 0x27)
   176                                      
   177                                      ; Vector 20h (ICU INTP0)
   178 0000005F BF8000                      mov  di, 0x0080      ; 0x20 * 4 = 80h
   179 00000062 B8[0E06]                    mov  ax, _isr_stub_20
   180 00000065 AB                          stosw
   181 00000066 8CC8                        mov  ax, cs
   182 00000068 AB                          stosw
   183                                  
   184                                      ; Vector 21h (ICU INTP1)
   185 00000069 BF8400                      mov  di, 0x0084
   186 0000006C B8[1306]                    mov  ax, _isr_stub_21
   187 0000006F AB                          stosw
   188 00000070 8CC8                        mov  ax, cs
   189 00000072 AB                          stosw
   190                                  
   191                                      ; Vector 22h (ICU INTP2)
   192 00000073 BF8800                      mov  di, 0x0088
   193 00000076 B8[1806]                    mov  ax, _isr_stub_22
   194 00000079 AB                          stosw
   195 0000007A 8CC8                        mov  ax, cs
   196 0000007C AB                          stosw
   197                                  
   198                                      ; Vector 23h (ICU INTP3)
   199 0000007D BF8C00                      mov  di, 0x008C
   200 00000080 B8[1D06]                    mov  ax, _isr_stub_23
   201 00000083 AB                          stosw
   202 00000084 8CC8                        mov  ax, cs
   203 00000086 AB                          stosw
   204                                  
   205                                      ; Vector 24h (ICU INTP4)
   206 00000087 BF9000                      mov  di, 0x0090
   207 0000008A B8[2206]                    mov  ax, _isr_stub_24
   208 0000008D AB                          stosw
   209 0000008E 8CC8                        mov  ax, cs
   210 00000090 AB                          stosw
   211                                  
   212                                      ; Vector 25h (ICU INTP5)
   213 00000091 BF9400                      mov  di, 0x0094
   214 00000094 B8[2706]                    mov  ax, _isr_stub_25
   215 00000097 AB                          stosw
   216 00000098 8CC8                        mov  ax, cs
   217 0000009A AB                          stosw
   218                                  
   219                                      ; Vector 26h (ICU INTP6)
   220 0000009B BF9800                      mov  di, 0x0098
   221 0000009E B8[2C06]                    mov  ax, _isr_stub_26
   222 000000A1 AB                          stosw
   223 000000A2 8CC8                        mov  ax, cs
   224 000000A4 AB                          stosw
   225                                  
   226                                      ; Vector 27h (ICU INTP7 <-- PIC)
   227                                      ; PIC Dispatcher
   228 000000A5 BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   229 000000A8 B8[3106]                    mov  ax, _pic_dispatch_handler
   230 000000AB AB                          stosw                ; [0000:009c] = AX
   231 000000AC 8CC8                        mov  ax, cs          ; 現在のCS
   232 000000AE AB                          stosw                ; [0000:009e] = CS
   233                                  
   234                                      ; ---------------------------------------------
   235                                      ; 1.2 メモリウェイト値の設定
   236                                      ; オンボードRAMは35nsなので0Waitで良さそう
   237                                      ; 拡張RAMボードは70nsなので途中1waitの領域も設定
   238                                      ; ROMは70nsなので2waitに、外部I/Oは不明のためとりあえず3waitで
   239                                      ; ---------------------------------------------
   240                                      ; リセット時の値
   241                                      ; WMB0  -111-111  16MBのメモリ空間の上位、下位で8MB
   242                                      ; WMB1  -111-111　1MBメモリ空間の上位、下位で512KB
   243                                      ; WCY0-WCY3 すべて7wait
   244                                      ;
   245 000000AF BAF3FF                      mov dx, WMB1
   246 000000B2 B073                        mov al, 01110011b	; L=512KB(Onboard RAM) M=384KB(VME RAM) H=128KB(Onboard ROM)
   247 000000B4 EE                          out dx, al
   248                                  
   249 000000B5 BAF4FF                      mov dx, WCY2
   250 000000B8 B000                        mov al, 00000000b	; M=0wait L=0wait
   251 000000BA EE                          out dx, al
   252                                  
   253 000000BB BAF5FF                      mov dx, WCY3
   254 000000BE B032                        mov al, 00110010b	; IO=1wait H=1wait
   255 000000C0 EE                          out dx, al
   256                                  
   257                                      ;------------------------------------------
   258                                      ; V53 内蔵ペリフェラルのIOアドレスを設定 (OPHA)
   259                                      ;------------------------------------------
   260 000000C1 BAFCFF                      mov  dx, OPHA ; 内蔵ペリフェラル・リロケーション・レジスタ
   261 000000C4 B0F0                        mov  al, 0xF0 ; 0xF0xxに配置
   262 000000C6 EE                          out  dx, al
   263                                      ;------------------------------------------
   264                                      ; ICU レジスタ配置アドレスの設定 (IULA) 0xF080
   265                                      ;------------------------------------------
   266 000000C7 BAFAFF                      mov dx, IULA
   267 000000CA B080                        mov al, 0x80    ; 下位アドレス
   268 000000CC EE                          out dx, al
   269                                      ;------------------------------------------
   270                                      ; TCU レジスタ配置アドレスの設定 (TULA) 0xF070
   271                                      ;------------------------------------------
   272 000000CD BAF9FF                      mov dx, TULA
   273 000000D0 B070                        mov al, 0x70    ; 下位アドレス
   274 000000D2 EE                          out dx, al
   275                                      ;------------------------------------------
   276                                      ; SCU レジスタ配置アドレスの設定 (SULA) 0xF060
   277                                      ;------------------------------------------
   278 000000D3 BAF8FF                      mov dx, SULA
   279 000000D6 B060                        mov al, 0x60    ; 下位アドレス
   280 000000D8 EE                          out dx, al
   281                                      
   282                                      ;------------------------------------------
   283                                      ; V53 内蔵ペリフェラルの有効化 (OPSEL)
   284                                      ; 有効化する前にOPHA,DULA,IULA,TULA,SULAの設定が必要
   285                                      ;------------------------------------------
   286 000000D9 BAFDFF                      mov  dx, OPSEL
   287 000000DC EC                          in   al, dx
   288 000000DD 0C0E                        or   al, 00001110b   ; Bit 1(ICU),Bit 2(TCU),Bit 3(SCU)をセット
   289 000000DF EE                          out  dx, al
   290                                  
   291                                      ;------------------------------------------
   292                                      ; TCUの設定
   293                                      ;------------------------------------------
   294                                      ; 3. TCKS: タイマクロック入力選択
   295                                      ;------------------------------------------
   296 000000E0 BAF0FF                      mov  dx, TCKS
   297 000000E3 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   298 000000E5 EE                          out  dx, al
   299                                  
   300                                      ;------------------------------------------
   301                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   302                                      ;------------------------------------------
   303 000000E6 BA73F0                      mov  dx, TM_CTL
   304                                  
   305                                      ; --- Timer 0 Setup ---
   306 000000E9 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   307 000000EB EE                          out  dx, al
   308                                      
   309                                      ; --- Timer 1 Setup ---
   310 000000EC B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   311 000000EE EE                          out  dx, al
   312                                  
   313                                      ; --- Timer 2 Setup ---
   314 000000EF B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   315 000000F1 EE                          out  dx, al
   316                                  
   317                                      ;------------------------------------------
   318                                      ; 4. カウンタ値 (分周比) のロード
   319                                      ;------------------------------------------
   320                                      ; Timer 0 (INTP0)
   321                                      ; 1.2288MHz / 12288 = 100Hz
   322 000000F2 BA70F0                      mov  dx, TM0_CNT
   323 000000F5 B000                        mov  al, 0x00
   324 000000F7 EE                          out  dx, al
   325 000000F8 B030                        mov  al, 0x30
   326 000000FA EE                          out  dx, al
   327                                  
   328                                      ; Timer 1 (INTP2)
   329                                      ; 1.2288MHz / 61440 = 20Hz
   330 000000FB BA71F0                      mov  dx, TM1_CNT
   331 000000FE B000                        mov  al, 0x00
   332 00000100 EE                          out  dx, al
   333 00000101 B0F0                        mov  al, 0xF0
   334 00000103 EE                          out  dx, al
   335                                  
   336                                      ; Timer 2 (USART Tx/RxCLK)
   337                                      ; 1.2288MHz / 4 = 307.20KHz
   338                                      ; USART CLOCK 19200bps
   339 00000104 BA72F0                      mov  dx, TM2_CNT
   340 00000107 B004                        mov  al, 4
   341 00000109 EE                          out  dx, al
   342 0000010A B000                        mov  al, 0
   343 0000010C EE                          out  dx, al
   344                                  
   345                                      ;------------------------------------------
   346                                      ; μPD71051 (USART) 初期化
   347                                      ;------------------------------------------
   348 0000010D B000                        mov al, 0
   349 0000010F E6DA                        out USART_CMD, al
   350                                   
   351 00000111 F7E1                        mul cx              ; wait
   352 00000113 F7E1                        mul cx              ; wait
   353 00000115 E6DA                        out USART_CMD, al
   354                                   
   355 00000117 F7E1                        mul cx              ; wait
   356 00000119 F7E1                        mul cx              ; wait
   357 0000011B E6DA                        out USART_CMD, al
   358                                   
   359 0000011D F7E1                        mul cx              ; wait
   360 0000011F F7E1                        mul cx              ; wait
   361 00000121 B040                        mov al, 0x40        ; reset
   362 00000123 E6DA                        out USART_CMD, al
   363                                   
   364 00000125 F7E1                        mul cx              ; wait
   365 00000127 F7E1                        mul cx              ; wait
   366 00000129 B04E                        mov al, 0x4e        ; set mode
   367 0000012B E6DA                        out USART_CMD, al
   368                                   
   369 0000012D F7E1                        mul cx              ; wait
   370 0000012F F7E1                        mul cx              ; wait
   371 00000131 B037                        mov al, 0x37        ; rx,tx ready
   372 00000133 E6DA                        out USART_CMD, al
   373                                  
   374                                      ;------------------------------------------
   375                                      ; μPD71059 (PIC) 初期化
   376                                      ;------------------------------------------
   377 00000135 B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   378 00000137 E6C8                        out PIC_REG0, al
   379                                  
   380 00000139 B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   381 0000013B E6CA                        out PIC_REG1, al
   382                                                          ; ICW3 is skipped in Single Mode
   383 0000013D B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   384 0000013F E6CA                        out PIC_REG1, al
   385                                  
   386 00000141 B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   387 00000143 E6CA                        out PIC_REG1, al
   388                                  
   389                                      ;------------------------------------------
   390                                      ; ICUの追加設定
   391                                      ;------------------------------------------
   392                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   393                                      ;------------------------------------------
   394 00000145 BA80F0                      mov dx, ICU_REG0
   395 00000148 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   396 0000014A EE                          out dx, al
   397                                  
   398 0000014B BA81F0                      mov dx, ICU_REG1
   399 0000014E B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   400 00000150 EE                          out dx, al
   401                                                      ; ICW3 is skipped in Single Mode
   402 00000151 B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   403 00000153 EE                          out dx, al
   404                                  
   405                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   406 00000154 B07F                        mov al, 7Fh     ; 0111 1111
   407 00000156 EE                          out dx, al
   408                                  
   409                                      ;-------------------------------------------
   410                                      ; 割り込み許可
   411                                      ;-------------------------------------------
   412 00000157 FB                          sti
   413                                  
   414                                   %endif
   415                                  
   416                                      ; 変数初期化 (RAMエリアをクリア)
   417 00000158 C706[5F09]0000              mov word [dump_seg], 0x0000
   418 0000015E C706[6109]0000              mov word [dump_off], 0x0000
   419 00000164 C706[6309]0020              mov word [load_seg], 0x2000
   420                                  
   421                                      ; スタートメッセージの表示
   422 0000016A BE[1207]                    mov si, msg_boot
   423 0000016D E8F002                      call puts
   424                                  
   425                                  ; =================================================================
   426                                  ; Main Loop
   427                                  ; =================================================================
   428                                  monitor_loop:
   429 00000170 B03E                        mov al, '>'
   430 00000172 E8F902                      call putc
   431 00000175 B020                        mov al, ' '
   432 00000177 E8F402                      call putc
   433                                  
   434 0000017A E81303                      call getc_echo  ; コマンド受信（エコーあり）
   435 0000017D 88C3                        mov bl, al
   436                                      
   437 0000017F 80FB64                      cmp bl, 'd'     ; dump command
   438 00000182 747A                        je do_dump
   439 00000184 80FB44                      cmp bl, 'D'
   440 00000187 7475                        je do_dump
   441                                      
   442 00000189 80FB6C                      cmp bl, 'l'     ; load command
   443 0000018C 7503E9D000                  je do_load
   444 00000191 80FB4C                      cmp bl, 'L'
   445 00000194 7503E9C800                  je do_load
   446                                      
   447 00000199 80FB67                      cmp bl, 'g'     ; go command
   448 0000019C 7503E94401                  je do_go
   449 000001A1 80FB47                      cmp bl, 'G'
   450 000001A4 7503E93C01                  je do_go
   451                                  
   452 000001A9 80FB77                      cmp bl, 'w'     ; Write command
   453 000001AC 7503E96001                  je do_write
   454 000001B1 80FB57                      cmp bl, 'W'
   455 000001B4 7503E95801                  je do_write
   456                                  
   457 000001B9 3C69                        cmp al, 'i'     ; Input Port command
   458 000001BB 7503E99401                  je do_in
   459 000001C0 3C49                        cmp al, 'I'
   460 000001C2 7503E98D01                  je do_in
   461                                  
