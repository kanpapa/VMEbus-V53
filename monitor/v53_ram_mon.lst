   652                                      
   653                                      ; 1. セグメント (SSSS) を取得
   654 000002D2 E8D801                      call get_hex_word   ; AX = Segment
   655 000002D5 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   656 000002D6 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   657                                      
   658                                      ; スペース読み飛ばし (もしあれば)
