  1362                                  ; Data
  1363                                  ; =================================================================
  1364 00000606 0D0A2A2A2020563533-     msg_boot: db 0x0D,0x0A,"**  V53 RAM MONITOR v0.8 2026-02-01  **",0x0D,0x0A,0
  1364 0000060F 2052414D204D4F4E49-
  1364 00000618 544F522076302E3820-
  1364 00000621 323032362D30322D30-
