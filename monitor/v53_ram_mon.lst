   648                                  ; =================================================================
   649                                  ; Command: Execute
   650                                  ; Usage:
   651                                  ;   G <Seg> <Off>
   652                                  ; Example: G 1000 0000
   653                                  ; =================================================================
   654                                  do_go:
   655                                      ; Gコマンドは入力後に改行
   656                                      
   657 000002D4 E8A801                      call getc_echo      ; Space?
   658 000002D7 3C20                        cmp al, ' '
   659 000002D9 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   660                                      
   661                                      ; 1. セグメント (SSSS) を取得
   662 000002DB E8D801                      call get_hex_word   ; AX = Segment
   663 000002DE 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   664 000002DF 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   665                                      
   666                                      ; スペース読み飛ばし (もしあれば)
