   725                                  
   726                                  ; ==============================================================
   727                                  ; Command: Output to Port
   728                                  ; Usage
   729                                  ;   O <Port> <Val>
   730                                  ; ==============================================================
   731                                  do_out:
   732 0000032C E81501                      call getc_echo
   733 0000032F 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   734 00000331 7403E98F01                  jne error           ; パラメタが無い場合はエラー処理へ
   735                                  
   736 00000336 E84201                      call get_hex_word   ; ポートアドレスを取得
   737 00000339 50                          push ax             ; スタックに積む
   738                                  
   739 0000033A E80701                      call getc_echo
   740 0000033D 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   741 0000033F 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   742                                      
   743 00000341 E84601                      call get_hex_byte_echo   ; 出力値を取得
   744 00000344 5A                          pop dx              ; スタックからDXにセット
   745                                      
   746 00000345 EE                          out dx, al          ; I/O Write
   747                                      
   748 00000346 BE[6406]                    mov si, msg_done    ; DONEを表示。改行付き。
   749 00000349 E8C800                      call puts
   750 0000034C E9DEFD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   751                                  
   752                                  error_pop:
