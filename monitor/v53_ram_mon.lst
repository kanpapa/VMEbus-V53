   581                                  ; =================================================================
   582                                  ; Command: Execute
   583                                  ; Usage:
   584                                  ;   G <Seg> <Off>
   585                                  ; Example: G 1000 0000
   586                                  ; =================================================================
   587                                  do_go:
   588                                      ; Gコマンドは入力後に改行
   589                                      
   590 00000293 E8A801                      call getc_echo      ; Space?
   591 00000296 3C20                        cmp al, ' '
   592 00000298 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   593                                      
   594                                      ; 1. セグメント (SSSS) を取得
   595 0000029A E8D801                      call get_hex_word   ; AX = Segment
   596 0000029D 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   597 0000029E 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   598                                      
   599                                      ; スペース読み飛ばし (もしあれば)
   600 000002A0 E81802                      call skip_space
   601                                      
   602                                      ; 2. オフセット (OOOO) を取得
   603 000002A3 E8CF01                      call get_hex_word   ; AX = Offset
   604 000002A6 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   605                                      
   606 000002A7 E89D01                      call putc_crlf      ; 実行前に改行
   607 000002AA BE[3B06]                    mov si, msg_go
   608 000002AD E85E01                      call puts
   609 000002B0 E89401                      call putc_crlf
   610                                      
   611                                      ; 3. 実行環境のセットアップ
   612                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   613 000002B3 8EDB                        mov ds, bx
   614 000002B5 8EC3                        mov es, bx
   615                                  
   616                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   617 000002B7 FA                          cli
   618                                  
   619                                      ; 4. ジャンプ！ (Far Return)
   620                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   621 000002B8 CB                          retf                ; Jump!
   622                                  
   623                                  .go_default:
   624 000002B9 E88B01                      call putc_crlf      ; 改行して
   625 000002BC E968FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   626                                  
   627                                  ; ==============================================================
   628                                  ; Command: Write Memory
   629                                  ; Usage:
   630                                  ;   W <Seg> <Off> <Val>
   631                                  ; ==============================================================
   632                                  do_write:    
   633 000002BF E87C01                      call getc_echo      ; Space?
   634 000002C2 3C20                        cmp al, ' '
   635 000002C4 7403E9F601                  jne error           ; 引数なしならリターン(またはエラー)
   636                                  
   637                                      ; 1. セグメント (SSSS) を取得
   638 000002C9 E8A901                      call get_hex_word   ; AX = Segment
   639 000002CC 50                          push ax             ; ターゲットセグメントを保存
   640                                      
   641 000002CD E86E01                      call getc_echo      ; Space?
   642 000002D0 3C20                        cmp al, ' '
   643 000002D2 7403E9E801                  jne error           ; 引数なしならリターン(またはエラー)
   644                                      
   645                                      ; 2. オフセット (OOOO) を取得
   646 000002D7 E89B01                      call get_hex_word   ; AX = Offset
   647 000002DA 50                          push ax             ; ターゲットオフセットを保存
   648                                  
   649 000002DB E86001                      call getc_echo      ; Space?
   650 000002DE 3C20                        cmp al, ' '
   651 000002E0 7403E9DA01                  jne error           ; 引数なしならリターン(またはエラー)
   652                                  
   653                                      ; 3. 設定データ (VV) を取得
   654 000002E5 E89C01                      call get_hex_byte_echo   ; AL = Value
   655                                  
   656 000002E8 5B                          pop bx              ; bx = Offset
   657 000002E9 5A                          pop dx              ; dx = Target Segment
   658                                  
   659                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   660 000002EA 8916[4B08]                  mov [dump_seg], dx
   661 000002EE 891E[4D08]                  mov [dump_off], bx
   662                                      
   663 000002F2 8EDA                        mov ds, dx          ; DS再設定
   664 000002F4 3E8807                      mov [ds:bx], al     ; 書き込み！
   665                                      
   666 000002F7 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   667 000002F8 1F                          pop ds
   668                                  
   669 000002F9 BE[5E06]                    mov si, msg_done
   670 000002FC E80F01                      call puts
   671 000002FF E925FE                      jmp monitor_loop
