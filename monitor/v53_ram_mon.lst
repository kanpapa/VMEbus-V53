   795                                  ; ==============================================================
   796                                  ; Command: Scan I/O Ports
   797                                  ; Usage:
   798                                  ;   S <Start_port> <End_port>
   799                                  ; Description: Reads ports and prints if value is NOT 0xFF
   800                                  ; ==============================================================
   801                                  do_scan:
   802 0000038E E8EE00                      call getc_echo
   803 00000391 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   804 00000393 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   805                                  
   806 00000398 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   807 0000039B 89C3                        mov bx, ax          ; BX = Start Address
   808                                      
   809 0000039D E8DF00                      call getc_echo
   810 000003A0 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   811 000003A2 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   812                                  
   813 000003A4 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   814 000003A7 89C1                        mov cx, ax          ; CX = End Address
   815                                  
   816 000003A9 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   817 000003AB 7603E95001                  ja error
   818                                  
   819 000003B0 E8D500                      call putc_crlf
   820 000003B3 BE[EF07]                    mov si, msg_scan_start
   821 000003B6 E89600                      call puts
   822                                  
   823                                  .scan_loop:
   824 000003B9 89DA                        mov dx, bx          ; DXにポートアドレス設定
   825 000003BB EC                          in al, dx           ; I/O Read
   826                                  
   827 000003BC 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   828 000003BE 741D                        je .next_port
   829                                  
   830 000003C0 50                          push ax             ; Readした値をスタックに保存
   831                                  
   832                                      ; --- 有効な値が見つかった場合の表示 ---
   833                                      ; [Port]: Value
   834 000003C1 89D8                        mov ax, bx
   835 000003C3 E8CB00                      call print_hex_word ; ポートアドレスの表示
   836 000003C6 B03A                        mov al, ':'
   837 000003C8 E89200                      call putc
   838 000003CB B020                        mov al, ' '
   839 000003CD E88D00                      call putc
   840                                      
   841 000003D0 58                          pop ax
   842 000003D1 E8C400                      call print_hex_byte ; Readした値の表示
   843                                      
   844 000003D4 BE[1A08]                    mov si, msg_space   ; "  "
   845 000003D7 E87500                      call puts
   846                                  
   847                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   848                                      ; ここでは単純にリスト形式で改行します
   849 000003DA E8AB00                      call putc_crlf
   850                                  
   851                                  .next_port:
   852 000003DD 43                          inc bx              ; 次のアドレスへ
   853                                      
   854                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   855 000003DE BA6120                      mov dx, SCU_SST
   856 000003E1 EC                          in al, dx
   857 000003E2 A802                        test al, RX_READY   ; RxRDY?
   858 000003E4 750D                        jnz .abort          ; 何かキーが押されたら中断
   859                                  
   860 000003E6 39CB                        cmp bx, cx
   861 000003E8 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   862                                  
   863 000003EA BE[6007]                    mov si, msg_done
   864 000003ED E85F00                      call puts
   865 000003F0 E96CFD                      jmp monitor_loop
   866                                  
