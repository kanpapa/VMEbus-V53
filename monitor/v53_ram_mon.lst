     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.11 2026-02-25
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53_ram_mon.bin v53_ram_mon.hex
    10                                  ; -----------------
    11                                  
    12                                  ; ==========================================
    13                                  ; V53 System Register
    14                                  ; ==========================================
    15                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    16                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    17                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    18                                  %define DULA    0x0FFFB ; 
    19                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    20                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    21                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    22                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    23                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    24                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    25                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    26                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    27                                  %define SBCR    0x0FFF1 ; 
    28                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    29                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    30                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    31                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    32                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    33                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    34                                  %define BADR    0x0FFE1 ; 
    35                                  %define BSEL    0x0FFE0 ; 
    36                                  %define XAM     0x0FF80 ; 
    37                                  %define PGR     0x0FF00 ; 
    38                                  
    39                                  
    40                                  
    41                                  %ifdef SIM
    42                                      ; --- Simulation Mode ---
    43                                      org 0x100
    44                                      cpu 186
    45                                  
    46                                      %define SCU_DATA   0x3F8
    47                                      %define SCU_SST    0x3FD
    48                                      %define TX_READY    0x20                                 
    49                                      %define RX_READY    0x01
    50                                  %else
    51                                      ; --- Real Hardware Mode ---
    52                                      org 0
    53                                      cpu 186
    54                                  
    55                                      ; 旧アドレス
    56                                      ; V53 SCU (1260Hに配置）
    57                                      ;%define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    58                                      ;%define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    59                                      ;%define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    60                                      ;%define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    61                                      ;%define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    62                                      ;%define TX_READY    00000001b   ; TBRDY                                 
    63                                      ;%define RX_READY    00000010b   ; RBRDY
    64                                  
    65                                      ; V53 TCU (1270Hに配置)
    66                                      ;%define TM0_CNT     0x01270 ; Timer 0 Counter
    67                                      ;%define TM1_CNT     0x01271 ; Timer 1 Counter
    68                                      ;%define TM2_CNT     0x01272 ; Timer 2 Counter
    69                                      ;%define TM_CTL      0x01273 ; Timer Control
    70                                  
    71                                      ; V53 ICU (1280Hに配置)
    72                                      ;%define ICU_REG0    0x01280
    73                                      ;%define ICU_REG1    0x01281
    74                                  
    75                                      ; 新アドレス
    76                                      ; V53 SCU (2060Hに配置）
    77                                      %define SCU_DATA    0x02060 ; 送受データ・レジスタ(R:SRB/W:STB)
    78                                      %define SCU_SST     0x02061 ; ステータス・レジスタ(R:SST)
    79                                      %define SCU_SCM     0x02061 ; コマンドレジスタ(W:SCM)
    80                                      %define SCU_SMD     0x02062 ; シリアルモード設定(W:SMD)
    81                                      %define SCU_SIMK    0x02063 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    82                                      %define TX_READY    00000001b   ; TBRDY                                 
    83                                      %define RX_READY    00000010b   ; RBRDY
    84                                  
    85                                      ; V53 TCU (2070Hに配置)
    86                                      %define TM0_CNT     0x02070 ; Timer 0 Counter
    87                                      %define TM1_CNT     0x02071 ; Timer 1 Counter
    88                                      %define TM2_CNT     0x02072 ; Timer 2 Counter
    89                                      %define TM_CTL      0x02073 ; Timer Control
    90                                  
    91                                      ; V53 ICU (2080Hに配置)
    92                                      %define ICU_REG0    0x02080
    93                                      %define ICU_REG1    0x02081
    94                                  
    95                                      ;-----------------------------------------
    96                                      ; V53 VME Board ペリフェラル
    97                                      ;-----------------------------------------
    98                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    99                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
   100                                  
   101                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
   102                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
   103                                  
   104                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
   105                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
   106                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
   107                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
   108                                  %endif
   109                                  
   110                                  section .text
   111                                  
   112                                  start:
   113                                  %ifdef SIM
   114                                      xor ax, ax
   115                                      mov es, ax
   116                                  %else
   117 00000000 FA                          cli             ; 初期化中は割り込み禁止
   118                                  
   119                                      ; ---------------------------------------------
   120                                      ; 1. セグメントレジスタ初期化
   121                                      ; CS=DS=ES を想定
   122                                      ; ---------------------------------------------
   123 00000001 0E                          push cs
   124 00000002 1F                          pop ds
   125 00000003 0E                          push cs
   126 00000004 07                          pop es
   127                                      ; --- 【重要】スタックの初期化 ---
   128                                      ; 現在のCSセグメントの末尾 (FFFEh) にスタックを移動させます。
   129                                      ; これでコード領域との衝突を回避します。
   130 00000005 8CC8                        mov ax, cs
   131 00000007 8ED0                        mov ss, ax
   132 00000009 BCFEFF                      mov sp, 0xFFFE
   133                                      ; ------------------------------
   134                                  
   135                                      ;==============================================
   136                                      ; ABORT (NMI) Handler Setup 
   137                                      ;==============================================
   138                                  Init_NMI:
   139                                      ; ----------------------------------------------------
   140                                      ; 1. 全ベクタ (00h-FFh) をデフォルトハンドラで埋める
   141                                      ;    (予期せぬ割り込みによる暴走を防ぐ安全策)
   142                                      ; ----------------------------------------------------
   143 0000000C 31C0                        xor ax, ax
   144 0000000E 8EC0                        mov es, ax          ; ES = 0000h (Vector Table)
   145 00000010 BF0000                      mov di, 0           ; Offset 0
   146                                  
   147 00000013 B90001                      mov cx, 256         ; 256個のベクタ全てを設定
   148                                  .init_loop:
   149 00000016 B8[B006]                    mov ax, _default_int_unknown_handler ; 共通トラップハンドラ
   150 00000019 AB                          stosw               ; Offset書き込み
   151 0000001A 8CC8                        mov ax, cs
   152 0000001C AB                          stosw               ; Segment書き込み
   153 0000001D E2F7                        loop .init_loop
   154                                  
   155 0000001F 31C0                        xor  ax, ax
   156 00000021 8EC0                        mov  es, ax          ; ES = 0000h
   157                                      
   158                                      ; 専用割り込みベクタを上書き登録 (0 - 5)
   159 00000023 BF0000                      mov  di, 0x0000      ; 0x0 * 4 = 0h
   160 00000026 B8[F605]                    mov  ax, _isr_stub_0
   161 00000029 AB                          stosw
   162 0000002A 8CC8                        mov  ax, cs
   163 0000002C AB                          stosw
   164                                  
   165 0000002D BF0400                      mov  di, 0x0004      ; 0x1 * 4 = 4h
   166 00000030 B8[FA05]                    mov  ax, _isr_stub_1
   167 00000033 AB                          stosw
   168 00000034 8CC8                        mov  ax, cs
   169 00000036 AB                          stosw
   170                                  
   171                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   172 00000037 BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   173 0000003A B8[1A05]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   174 0000003D AB                          stosw                ; [0000:0008] = AX
   175 0000003E 8CC8                        mov  ax, cs          ; 現在のCS
   176 00000040 AB                          stosw                ; [0000:000A] = CS
   177                                  
   178 00000041 BF0C00                      mov  di, 0x000c      ; 0x3 * 4 = 0ch
   179 00000044 B8[FF05]                    mov  ax, _isr_stub_3
   180 00000047 AB                          stosw
   181 00000048 8CC8                        mov  ax, cs
   182 0000004A AB                          stosw
   183                                  
   184 0000004B BF1000                      mov  di, 0x0010      ; 0x4 * 4 = 10h
   185 0000004E B8[0406]                    mov  ax, _isr_stub_4
   186 00000051 AB                          stosw
   187 00000052 8CC8                        mov  ax, cs
   188 00000054 AB                          stosw
   189                                  
   190 00000055 BF1400                      mov  di, 0x0014      ; 0x5 * 4 = 14h
   191 00000058 B8[0906]                    mov  ax, _isr_stub_5
   192 0000005B AB                          stosw
   193 0000005C 8CC8                        mov  ax, cs
   194 0000005E AB                          stosw
   195                                  
   196                                      ; ICU割り込みベクタを上書き登録 (0x20 - 0x27)
   197                                      
   198                                      ; Vector 20h (ICU INTP0)
   199 0000005F BF8000                      mov  di, 0x0080      ; 0x20 * 4 = 80h
   200 00000062 B8[0E06]                    mov  ax, _isr_stub_20
   201 00000065 AB                          stosw
   202 00000066 8CC8                        mov  ax, cs
   203 00000068 AB                          stosw
   204                                  
   205                                      ; Vector 21h (ICU INTP1)
   206 00000069 BF8400                      mov  di, 0x0084
   207 0000006C B8[1306]                    mov  ax, _isr_stub_21
   208 0000006F AB                          stosw
   209 00000070 8CC8                        mov  ax, cs
   210 00000072 AB                          stosw
   211                                  
   212                                      ; Vector 22h (ICU INTP2)
   213 00000073 BF8800                      mov  di, 0x0088
   214 00000076 B8[1806]                    mov  ax, _isr_stub_22
   215 00000079 AB                          stosw
   216 0000007A 8CC8                        mov  ax, cs
   217 0000007C AB                          stosw
   218                                  
   219                                      ; Vector 23h (ICU INTP3)
   220 0000007D BF8C00                      mov  di, 0x008C
   221 00000080 B8[1D06]                    mov  ax, _isr_stub_23
   222 00000083 AB                          stosw
   223 00000084 8CC8                        mov  ax, cs
   224 00000086 AB                          stosw
   225                                  
   226                                      ; Vector 24h (ICU INTP4)
   227 00000087 BF9000                      mov  di, 0x0090
   228 0000008A B8[2206]                    mov  ax, _isr_stub_24
   229 0000008D AB                          stosw
   230 0000008E 8CC8                        mov  ax, cs
   231 00000090 AB                          stosw
   232                                  
   233                                      ; Vector 25h (ICU INTP5)
   234 00000091 BF9400                      mov  di, 0x0094
   235 00000094 B8[2706]                    mov  ax, _isr_stub_25
   236 00000097 AB                          stosw
   237 00000098 8CC8                        mov  ax, cs
   238 0000009A AB                          stosw
   239                                  
   240                                      ; Vector 26h (ICU INTP6)
   241 0000009B BF9800                      mov  di, 0x0098
   242 0000009E B8[2C06]                    mov  ax, _isr_stub_26
   243 000000A1 AB                          stosw
   244 000000A2 8CC8                        mov  ax, cs
   245 000000A4 AB                          stosw
   246                                  
   247                                      ; Vector 27h (ICU INTP7 <-- PIC)
   248                                      ; PIC Dispatcher
   249 000000A5 BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   250 000000A8 B8[3106]                    mov  ax, _pic_dispatch_handler
   251 000000AB AB                          stosw                ; [0000:009c] = AX
   252 000000AC 8CC8                        mov  ax, cs          ; 現在のCS
   253 000000AE AB                          stosw                ; [0000:009e] = CS
   254                                  
   255                                      ; ---------------------------------------------
   256                                      ; 1.2 メモリウェイト値の設定
   257                                      ; オンボードRAMは35nsなので0Waitで良さそう
   258                                      ; 拡張RAMボードは70nsなので途中1waitの領域も設定
   259                                      ; ROMは70nsなので2waitに、外部I/Oは不明のためとりあえず3waitで
   260                                      ; ---------------------------------------------
   261                                      ; リセット時の値
   262                                      ; WMB0  -111-111  16MBのメモリ空間の上位、下位で8MB
   263                                      ; WMB1  -111-111　1MBメモリ空間の上位、下位で512KB
   264                                      ; WCY0-WCY3 すべて7wait
   265                                      ;
   266 000000AF BAF3FF                      mov dx, WMB1
   267 000000B2 B073                        mov al, 01110011b	; L=512KB(Onboard RAM) M=384KB(VME RAM) H=128KB(Onboard ROM)
   268 000000B4 EE                          out dx, al
   269                                  
   270 000000B5 BAF4FF                      mov dx, WCY2
   271 000000B8 B000                        mov al, 00000000b	; M=0wait L=0wait
   272 000000BA EE                          out dx, al
   273                                  
   274 000000BB BAF5FF                      mov dx, WCY3
   275 000000BE B032                        mov al, 00110010b	; IO=1wait H=1wait
   276 000000C0 EE                          out dx, al
   277                                  
   278                                      ;------------------------------------------
   279                                      ; V53 内蔵ペリフェラルのIOアドレスを設定 (OPHA)
   280                                      ;------------------------------------------
   281 000000C1 BAFCFF                      mov  dx, OPHA ; 内蔵ペリフェラル・リロケーション・レジスタ
   282 000000C4 B020                        mov  al, 0x20 ; 0x20xxに配置
   283 000000C6 EE                          out  dx, al
   284                                      ;------------------------------------------
   285                                      ; ICU レジスタ配置アドレスの設定 (IULA) 0x2080
   286                                      ;------------------------------------------
   287 000000C7 BAFAFF                      mov dx, IULA
   288 000000CA B080                        mov al, 0x80    ; 下位アドレス
   289 000000CC EE                          out dx, al
   290                                      ;------------------------------------------
   291                                      ; TCU レジスタ配置アドレスの設定 (TULA) 0x2070
   292                                      ;------------------------------------------
   293 000000CD BAF9FF                      mov dx, TULA
   294 000000D0 B070                        mov al, 0x70    ; 下位アドレス
   295 000000D2 EE                          out dx, al
   296                                      ;------------------------------------------
   297                                      ; SCU レジスタ配置アドレスの設定 (SULA) 0x2060
   298                                      ;------------------------------------------
   299 000000D3 BAF8FF                      mov dx, SULA
   300 000000D6 B060                        mov al, 0x60    ; 下位アドレス
   301 000000D8 EE                          out dx, al
   302                                      
   303                                      ;------------------------------------------
   304                                      ; V53 内蔵ペリフェラルの有効化 (OPSEL)
   305                                      ; 有効化する前にOPHA,DULA,IULA,TULA,SULAの設定が必要
   306                                      ;------------------------------------------
   307 000000D9 BAFDFF                      mov  dx, OPSEL
   308 000000DC EC                          in   al, dx
   309 000000DD 0C0E                        or   al, 00001110b   ; Bit 1(ICU),Bit 2(TCU),Bit 3(SCU)をセット
   310 000000DF EE                          out  dx, al
   311                                  
   312                                      ;------------------------------------------
   313                                      ; TCUの設定
   314                                      ;------------------------------------------
   315                                      ; 3. TCKS: タイマクロック入力選択
   316                                      ;------------------------------------------
   317 000000E0 BAF0FF                      mov  dx, TCKS
   318 000000E3 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   319 000000E5 EE                          out  dx, al
   320                                  
   321                                      ;------------------------------------------
   322                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   323                                      ;------------------------------------------
   324 000000E6 BA7320                      mov  dx, TM_CTL
   325                                  
   326                                      ; --- Timer 0 Setup ---
   327 000000E9 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   328 000000EB EE                          out  dx, al
   329                                      
   330                                      ; --- Timer 1 Setup ---
   331 000000EC B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   332 000000EE EE                          out  dx, al
   333                                  
   334                                      ; --- Timer 2 Setup ---
   335 000000EF B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   336 000000F1 EE                          out  dx, al
   337                                  
   338                                      ;------------------------------------------
   339                                      ; 4. カウンタ値 (分周比) のロード
   340                                      ;------------------------------------------
   341                                      ; Timer 0 (INTP0)
   342                                      ; 1.2288MHz / 12288 = 100Hz
   343 000000F2 BA7020                      mov  dx, TM0_CNT
   344 000000F5 B000                        mov  al, 0x00
   345 000000F7 EE                          out  dx, al
   346 000000F8 B030                        mov  al, 0x30
   347 000000FA EE                          out  dx, al
   348                                  
   349                                      ; Timer 1 (INTP2)
   350                                      ; 1.2288MHz / 61440 = 20Hz
   351 000000FB BA7120                      mov  dx, TM1_CNT
   352 000000FE B000                        mov  al, 0x00
   353 00000100 EE                          out  dx, al
   354 00000101 B0F0                        mov  al, 0xF0
   355 00000103 EE                          out  dx, al
   356                                  
   357                                      ; Timer 2 (USART Tx/RxCLK)
   358                                      ; 1.2288MHz / 4 = 307.20KHz
   359                                      ; USART CLOCK 19200bps
   360 00000104 BA7220                      mov  dx, TM2_CNT
   361 00000107 B004                        mov  al, 4
   362 00000109 EE                          out  dx, al
   363 0000010A B000                        mov  al, 0
   364 0000010C EE                          out  dx, al
   365                                  
   366                                      ;------------------------------------------
   367                                      ; μPD71051 (USART) 初期化
   368                                      ;------------------------------------------
   369 0000010D B000                        mov al, 0
   370 0000010F E6DA                        out USART_CMD, al
   371                                   
   372 00000111 F7E1                        mul cx              ; wait
   373 00000113 F7E1                        mul cx              ; wait
   374 00000115 E6DA                        out USART_CMD, al
   375                                   
   376 00000117 F7E1                        mul cx              ; wait
   377 00000119 F7E1                        mul cx              ; wait
   378 0000011B E6DA                        out USART_CMD, al
   379                                   
   380 0000011D F7E1                        mul cx              ; wait
   381 0000011F F7E1                        mul cx              ; wait
   382 00000121 B040                        mov al, 0x40        ; reset
   383 00000123 E6DA                        out USART_CMD, al
   384                                   
   385 00000125 F7E1                        mul cx              ; wait
   386 00000127 F7E1                        mul cx              ; wait
   387 00000129 B04E                        mov al, 0x4e        ; set mode
   388 0000012B E6DA                        out USART_CMD, al
   389                                   
   390 0000012D F7E1                        mul cx              ; wait
   391 0000012F F7E1                        mul cx              ; wait
   392 00000131 B037                        mov al, 0x37        ; rx,tx ready
   393 00000133 E6DA                        out USART_CMD, al
   394                                  
   395                                      ;------------------------------------------
   396                                      ; μPD71059 (PIC) 初期化
   397                                      ;------------------------------------------
   398 00000135 B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   399 00000137 E6C8                        out PIC_REG0, al
   400                                  
   401 00000139 B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   402 0000013B E6CA                        out PIC_REG1, al
   403                                                          ; ICW3 is skipped in Single Mode
   404 0000013D B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   405 0000013F E6CA                        out PIC_REG1, al
   406                                  
   407 00000141 B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   408 00000143 E6CA                        out PIC_REG1, al
   409                                  
   410                                      ;------------------------------------------
   411                                      ; ICUの追加設定
   412                                      ;------------------------------------------
   413                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   414                                      ;------------------------------------------
   415 00000145 BA8020                      mov dx, ICU_REG0
   416 00000148 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   417 0000014A EE                          out dx, al
   418                                  
   419 0000014B BA8120                      mov dx, ICU_REG1
   420 0000014E B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   421 00000150 EE                          out dx, al
   422                                                      ; ICW3 is skipped in Single Mode
   423 00000151 B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   424 00000153 EE                          out dx, al
   425                                  
   426                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   427 00000154 B07F                        mov al, 7Fh     ; 0111 1111
   428 00000156 EE                          out dx, al
   429                                  
   430                                      ;-------------------------------------------
   431                                      ; 割り込み許可
   432                                      ;-------------------------------------------
   433 00000157 FB                          sti
   434                                  
   435                                   %endif
   436                                  
   437                                      ; 変数初期化 (RAMエリアをクリア)
   438 00000158 C706[5F09]0000              mov word [dump_seg], 0x0000
   439 0000015E C706[6109]0000              mov word [dump_off], 0x0000
   440 00000164 C706[6309]0020              mov word [load_seg], 0x2000
   441                                  
   442                                      ; スタートメッセージの表示
   443 0000016A BE[1207]                    mov si, msg_boot
   444 0000016D E8F002                      call puts
   445                                  
   446                                  ; =================================================================
   447                                  ; Main Loop
   448                                  ; =================================================================
   449                                  monitor_loop:
   450 00000170 B03E                        mov al, '>'
   451 00000172 E8F902                      call putc
   452 00000175 B020                        mov al, ' '
   453 00000177 E8F402                      call putc
   454                                  
