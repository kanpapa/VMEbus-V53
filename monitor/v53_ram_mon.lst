   673                                  ; ==============================================================
   674                                  ; Command: Input from Port
   675                                  ; Usage:
   676                                  ;   I <Port>
   677                                  ; ==============================================================
   678                                  do_in:
   679 00000302 E83901                      call getc_echo
   680 00000305 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   681 00000307 7403E9B301                  jne error           ; パラメタが無い場合はエラー処理へ
   682                                  
   683 0000030C E86601                      call get_hex_word   ; ポートアドレスを取得
   684 0000030F 89C2                        mov dx, ax          ; 保存
   685 00000311 EC                          in al, dx           ; I/O Read
   686                                      
   687 00000312 50                          push ax
   688 00000313 E83101                      call putc_crlf      ; メッセージ表示前に改行
   689 00000316 BE[5806]                    mov si, msg_in_res
   690 00000319 E8F200                      call puts
   691 0000031C 58                          pop ax
   692                                  
   693 0000031D E83701                      call print_hex_byte ; 値を表示
   694                                  
   695 00000320 E82401                      call putc_crlf      ; 改行して
   696 00000323 E901FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   697                                  
   698                                  ; ==============================================================
   699                                  ; Command: Output to Port
   700                                  ; Usage
   701                                  ;   O <Port> <Val>
   702                                  ; ==============================================================
   703                                  do_out:
   704 00000326 E81501                      call getc_echo
   705 00000329 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   706 0000032B 7403E98F01                  jne error           ; パラメタが無い場合はエラー処理へ
   707                                  
   708 00000330 E84201                      call get_hex_word   ; ポートアドレスを取得
   709 00000333 50                          push ax             ; スタックに積む
   710                                  
   711 00000334 E80701                      call getc_echo
   712 00000337 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   713 00000339 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   714                                      
   715 0000033B E84601                      call get_hex_byte_echo   ; 出力値を取得
   716 0000033E 5A                          pop dx              ; スタックからDXにセット
   717                                      
   718 0000033F EE                          out dx, al          ; I/O Write
   719                                      
   720 00000340 BE[5E06]                    mov si, msg_done    ; DONEを表示。改行付き。
   721 00000343 E8C800                      call puts
   722 00000346 E9DEFD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   723                                  
   724                                  error_pop:
