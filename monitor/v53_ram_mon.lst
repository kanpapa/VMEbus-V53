   492 00000222 E89F01                      call putc
   493 00000225 EBC8                        jmp .wait_record    ; 次のレコード読み取りへ
   494                                  
   495                                  .handle_eof:            ; EOFの場合
   496 00000227 E81802                      call get_hex_byte   ; チェックサムを読み飛ばす
   497 0000022A EB02                        jmp .finish         ; 読み込み終了処理へ
   498                                  
   499                                  .skip_line:
   500 0000022C EBC1                        jmp .wait_record    ; 次のレコード読み込みへ
   501                                  
   502                                  .finish:
   503 0000022E 07                          pop es              ; RAM用ESを復帰
   504 0000022F E8BD01                      call putc_crlf
   505 00000232 BE[2405]                    mov si, msg_ok      ; "OK"を表示
   506 00000235 E87E01                      call puts
   507 00000238 E994FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
