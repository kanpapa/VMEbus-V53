   852                                      ; [Port]: Value
   853 000003D2 89D8                        mov ax, bx
   854 000003D4 E8CB00                      call print_hex_word ; ポートアドレスの表示
   855 000003D7 B03A                        mov al, ':'
   856 000003D9 E89200                      call putc
   857 000003DC B020                        mov al, ' '
   858 000003DE E88D00                      call putc
   859                                      
