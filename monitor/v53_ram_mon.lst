     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.10 2026-02-15
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; 旧アドレス
    55                                      ; V53 SCU (1260Hに配置）
    56                                      ;%define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    57                                      ;%define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    58                                      ;%define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    59                                      ;%define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    60                                      ;%define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    61                                      ;%define TX_READY    00000001b   ; TBRDY                                 
    62                                      ;%define RX_READY    00000010b   ; RBRDY
    63                                  
    64                                      ; V53 TCU (1270Hに配置)
    65                                      ;%define TM0_CNT     0x01270 ; Timer 0 Counter
    66                                      ;%define TM1_CNT     0x01271 ; Timer 1 Counter
    67                                      ;%define TM2_CNT     0x01272 ; Timer 2 Counter
    68                                      ;%define TM_CTL      0x01273 ; Timer Control
    69                                  
    70                                      ; V53 ICU (1280Hに配置)
    71                                      ;%define ICU_REG0    0x01280
    72                                      ;%define ICU_REG1    0x01281
    73                                  
    74                                      ; 新アドレス
    75                                      ; V53 SCU (2060Hに配置）
    76                                      %define SCU_DATA    0x02060 ; 送受データ・レジスタ(R:SRB/W:STB)
    77                                      %define SCU_SST     0x02061 ; ステータス・レジスタ(R:SST)
    78                                      %define SCU_SCM     0x02061 ; コマンドレジスタ(W:SCM)
    79                                      %define SCU_SMD     0x02062 ; シリアルモード設定(W:SMD)
    80                                      %define SCU_SIMK    0x02063 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    81                                      %define TX_READY    00000001b   ; TBRDY                                 
    82                                      %define RX_READY    00000010b   ; RBRDY
    83                                  
    84                                      ; V53 TCU (2070Hに配置)
    85                                      %define TM0_CNT     0x02070 ; Timer 0 Counter
    86                                      %define TM1_CNT     0x02071 ; Timer 1 Counter
    87                                      %define TM2_CNT     0x02072 ; Timer 2 Counter
    88                                      %define TM_CTL      0x02073 ; Timer Control
    89                                  
    90                                      ; V53 ICU (2080Hに配置)
    91                                      %define ICU_REG0    0x02080
    92                                      %define ICU_REG1    0x02081
    93                                  
    94                                      ;-----------------------------------------
    95                                      ; V53 VME Board ペリフェラル
    96                                      ;-----------------------------------------
    97                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    98                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    99                                  
   100                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
   101                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
   102                                  
   103                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
   104                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
   105                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
   106                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
   107                                  %endif
   108                                  
   109                                  section .text
   110                                  
   111                                  start:
   112                                  %ifdef SIM
   113                                      xor ax, ax
   114                                      mov es, ax
   115                                  %else
   116 00000000 FA                          cli             ; 初期化中は割り込み禁止
   117                                  
   118                                      ; --- 【重要】スタックの初期化 ---
   119                                      ; 現在のセグメント (CS=2000h) の末尾 (FFFEh) にスタックを移動させます。
   120                                      ; これでコード領域との衝突を回避します。
   121 00000001 8CC8                        mov ax, cs
   122 00000003 8ED0                        mov ss, ax
   123 00000005 BCFEFF                      mov sp, 0xFFFE
   124                                      ; ------------------------------
   125                                  
   126                                      ;==============================================
   127                                      ; ABORT (NMI) Handler Setup 
   128                                      ;==============================================
   129                                  Init_NMI:
   130                                      ; ----------------------------------------------------
   131                                      ; 1. 全ベクタ (00h-FFh) をデフォルトハンドラで埋める
   132                                      ;    (予期せぬ割り込みによる暴走を防ぐ安全策)
   133                                      ; ----------------------------------------------------
   134 00000008 31C0                        xor ax, ax
   135 0000000A 8EC0                        mov es, ax          ; ES = 0000h (Vector Table)
   136 0000000C BF0000                      mov di, 0           ; Offset 0
   137                                  
   138 0000000F B90001                      mov cx, 256         ; 256個のベクタ全てを設定
   139                                  .init_loop:
   140 00000012 B8[9F06]                    mov ax, _default_int_unknown_handler ; 共通トラップハンドラ
   141 00000015 AB                          stosw               ; Offset書き込み
   142 00000016 8CC8                        mov ax, cs
   143 00000018 AB                          stosw               ; Segment書き込み
   144 00000019 E2F7                        loop .init_loop
   145                                  
   146 0000001B 31C0                        xor  ax, ax
   147 0000001D 8EC0                        mov  es, ax          ; ES = 0000h
   148                                      
   149                                      ; 専用割り込みベクタを上書き登録 (0 - 5)
   150 0000001F BF0000                      mov  di, 0x0000      ; 0x0 * 4 = 0h
   151 00000022 B8[E505]                    mov  ax, _isr_stub_0
   152 00000025 AB                          stosw
   153 00000026 8CC8                        mov  ax, cs
   154 00000028 AB                          stosw
   155                                  
   156 00000029 BF0400                      mov  di, 0x0004      ; 0x1 * 4 = 4h
   157 0000002C B8[E905]                    mov  ax, _isr_stub_1
   158 0000002F AB                          stosw
   159 00000030 8CC8                        mov  ax, cs
   160 00000032 AB                          stosw
   161                                  
   162                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   163 00000033 BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   164 00000036 B8[0905]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   165 00000039 AB                          stosw                ; [0000:0008] = AX
   166 0000003A 8CC8                        mov  ax, cs          ; 現在のCS
   167 0000003C AB                          stosw                ; [0000:000A] = CS
   168                                  
   169 0000003D BF0C00                      mov  di, 0x000c      ; 0x3 * 4 = 0ch
   170 00000040 B8[EE05]                    mov  ax, _isr_stub_3
   171 00000043 AB                          stosw
   172 00000044 8CC8                        mov  ax, cs
   173 00000046 AB                          stosw
   174                                  
   175 00000047 BF1000                      mov  di, 0x0010      ; 0x4 * 4 = 10h
   176 0000004A B8[F305]                    mov  ax, _isr_stub_4
   177 0000004D AB                          stosw
   178 0000004E 8CC8                        mov  ax, cs
   179 00000050 AB                          stosw
   180                                  
   181 00000051 BF1400                      mov  di, 0x0014      ; 0x5 * 4 = 14h
   182 00000054 B8[F805]                    mov  ax, _isr_stub_5
   183 00000057 AB                          stosw
   184 00000058 8CC8                        mov  ax, cs
   185 0000005A AB                          stosw
   186                                  
   187                                      ; ICU割り込みベクタを上書き登録 (0x20 - 0x27)
   188                                      
   189                                      ; Vector 20h (ICU INTP0)
   190 0000005B BF8000                      mov  di, 0x0080      ; 0x20 * 4 = 80h
   191 0000005E B8[FD05]                    mov  ax, _isr_stub_20
   192 00000061 AB                          stosw
   193 00000062 8CC8                        mov  ax, cs
   194 00000064 AB                          stosw
   195                                  
   196                                      ; Vector 21h (ICU INTP1)
   197 00000065 BF8400                      mov  di, 0x0084
   198 00000068 B8[0206]                    mov  ax, _isr_stub_21
   199 0000006B AB                          stosw
   200 0000006C 8CC8                        mov  ax, cs
   201 0000006E AB                          stosw
   202                                  
   203                                      ; Vector 22h (ICU INTP2)
   204 0000006F BF8800                      mov  di, 0x0088
   205 00000072 B8[0706]                    mov  ax, _isr_stub_22
   206 00000075 AB                          stosw
   207 00000076 8CC8                        mov  ax, cs
   208 00000078 AB                          stosw
   209                                  
   210                                      ; Vector 23h (ICU INTP3)
   211 00000079 BF8C00                      mov  di, 0x008C
   212 0000007C B8[0C06]                    mov  ax, _isr_stub_23
   213 0000007F AB                          stosw
   214 00000080 8CC8                        mov  ax, cs
   215 00000082 AB                          stosw
   216                                  
   217                                      ; Vector 24h (ICU INTP4)
   218 00000083 BF9000                      mov  di, 0x0090
   219 00000086 B8[1106]                    mov  ax, _isr_stub_24
   220 00000089 AB                          stosw
   221 0000008A 8CC8                        mov  ax, cs
   222 0000008C AB                          stosw
   223                                  
   224                                      ; Vector 25h (ICU INTP5)
   225 0000008D BF9400                      mov  di, 0x0094
   226 00000090 B8[1606]                    mov  ax, _isr_stub_25
   227 00000093 AB                          stosw
   228 00000094 8CC8                        mov  ax, cs
   229 00000096 AB                          stosw
   230                                  
   231                                      ; Vector 26h (ICU INTP6)
   232 00000097 BF9800                      mov  di, 0x0098
   233 0000009A B8[1B06]                    mov  ax, _isr_stub_26
   234 0000009D AB                          stosw
   235 0000009E 8CC8                        mov  ax, cs
   236 000000A0 AB                          stosw
   237                                  
   238                                      ; Vector 27h (ICU INTP7 <-- PIC)
   239                                      ; PIC Dispatcher
   240 000000A1 BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   241 000000A4 B8[2006]                    mov  ax, _pic_dispatch_handler
   242 000000A7 AB                          stosw                ; [0000:009c] = AX
   243 000000A8 8CC8                        mov  ax, cs          ; 現在のCS
   244 000000AA AB                          stosw                ; [0000:009e] = CS
   245                                  
   246                                      ; ---------------------------------------------
   247                                      ; 1. セグメントレジスタ初期化
   248                                      ; CS=DS=ES を想定
   249                                      ; ---------------------------------------------
   250 000000AB 0E                          push cs
   251 000000AC 1F                          pop ds
   252 000000AD 0E                          push cs
   253 000000AE 07                          pop es
   254                                      ; スタックは簡易モニタのものをそのまま使う
   255                                  
   256                                      ;------------------------------------------
   257                                      ; V53 内蔵ペリフェラルのIOアドレスを再設定
   258                                      ;------------------------------------------
   259 000000AF BAFCFF                      mov  dx, OPHA ; 内蔵ペリフェラル・リロケーション・レジスタ
   260 000000B2 B020                        mov  al, 0x20 ; 0x20xxに配置
   261 000000B4 EE                          out  dx, al
   262                                  
   263                                      ;------------------------------------------
   264                                      ; TCUの追加設定
   265                                      ;------------------------------------------
   266                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   267                                      ;------------------------------------------
   268 000000B5 BAFDFF                      mov  dx, OPSEL
   269 000000B8 EC                          in   al, dx
   270 000000B9 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   271 000000BB EE                          out  dx, al
   272                                  
   273                                      ;------------------------------------------
   274                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   275                                      ;------------------------------------------
   276 000000BC BAF9FF                      mov dx, TULA
   277 000000BF B070                        mov al, 0x70    ; 下位アドレス
   278 000000C1 EE                          out dx, al
   279                                  
   280                                      ;------------------------------------------
   281                                      ; 3. TCKS: タイマクロック入力選択
   282                                      ;------------------------------------------
   283 000000C2 BAF0FF                      mov  dx, TCKS
   284 000000C5 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   285 000000C7 EE                          out  dx, al
   286                                  
   287                                      ;------------------------------------------
   288                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   289                                      ;------------------------------------------
   290 000000C8 BA7320                      mov  dx, TM_CTL
   291                                  
   292                                      ; --- Timer 0 Setup ---
   293 000000CB B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   294 000000CD EE                          out  dx, al
   295                                      
   296                                      ; --- Timer 1 Setup ---
   297 000000CE B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   298 000000D0 EE                          out  dx, al
   299                                  
   300                                      ; --- Timer 2 Setup ---
   301 000000D1 B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   302 000000D3 EE                          out  dx, al
   303                                  
   304                                      ;------------------------------------------
   305                                      ; 4. カウンタ値 (分周比) のロード
   306                                      ;------------------------------------------
   307                                      ; Timer 0 (INTP0)
   308                                      ; 1.2288MHz / 12288 = 100Hz
   309 000000D4 BA7020                      mov  dx, TM0_CNT
   310 000000D7 B000                        mov  al, 0x00
   311 000000D9 EE                          out  dx, al
   312 000000DA B030                        mov  al, 0x30
   313 000000DC EE                          out  dx, al
   314                                  
   315                                      ; Timer 1 (INTP2)
   316                                      ; 1.2288MHz / 61440 = 20Hz
   317 000000DD BA7120                      mov  dx, TM1_CNT
   318 000000E0 B000                        mov  al, 0x00
   319 000000E2 EE                          out  dx, al
   320 000000E3 B0F0                        mov  al, 0xF0
   321 000000E5 EE                          out  dx, al
   322                                  
   323                                      ; Timer 2 (USART Tx/RxCLK)
   324                                      ; 1.2288MHz / 4 = 307.20KHz
   325                                      ; USART CLOCK 19200bps
   326 000000E6 BA7220                      mov  dx, TM2_CNT
   327 000000E9 B004                        mov  al, 4
   328 000000EB EE                          out  dx, al
   329 000000EC B000                        mov  al, 0
   330 000000EE EE                          out  dx, al
   331                                  
   332                                      ;------------------------------------------
   333                                      ; μPD71051 (USART) 初期化
   334                                      ;------------------------------------------
   335 000000EF B000                        mov al, 0
   336 000000F1 E6DA                        out USART_CMD, al
   337                                   
   338 000000F3 F7E1                        mul cx              ; wait
   339 000000F5 F7E1                        mul cx              ; wait
   340 000000F7 E6DA                        out USART_CMD, al
   341                                   
   342 000000F9 F7E1                        mul cx              ; wait
   343 000000FB F7E1                        mul cx              ; wait
   344 000000FD E6DA                        out USART_CMD, al
   345                                   
   346 000000FF F7E1                        mul cx              ; wait
   347 00000101 F7E1                        mul cx              ; wait
   348 00000103 B040                        mov al, 0x40        ; reset
   349 00000105 E6DA                        out USART_CMD, al
   350                                   
   351 00000107 F7E1                        mul cx              ; wait
   352 00000109 F7E1                        mul cx              ; wait
   353 0000010B B04E                        mov al, 0x4e        ; set mode
   354 0000010D E6DA                        out USART_CMD, al
   355                                   
   356 0000010F F7E1                        mul cx              ; wait
   357 00000111 F7E1                        mul cx              ; wait
   358 00000113 B037                        mov al, 0x37        ; rx,tx ready
   359 00000115 E6DA                        out USART_CMD, al
   360                                  
   361                                      ;------------------------------------------
   362                                      ; μPD71059 (PIC) 初期化
   363                                      ;------------------------------------------
   364 00000117 B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   365 00000119 E6C8                        out PIC_REG0, al
   366                                  
   367 0000011B B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   368 0000011D E6CA                        out PIC_REG1, al
   369                                                          ; ICW3 is skipped in Single Mode
   370 0000011F B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   371 00000121 E6CA                        out PIC_REG1, al
   372                                  
   373 00000123 B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   374 00000125 E6CA                        out PIC_REG1, al
   375                                  
   376                                      ;------------------------------------------
   377                                      ; ICUの追加設定
   378                                      ;------------------------------------------
   379                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   380                                      ;------------------------------------------
   381 00000127 BAFDFF                      mov  dx, OPSEL
   382 0000012A EC                          in   al, dx
   383 0000012B 0C02                        or   al, 00000010b   ; Bit 1 (ICU) をセット
   384 0000012D EE                          out  dx, al
   385                                  
   386                                      ;------------------------------------------
   387                                      ; 2. レジスタ配置アドレスの設定 (IULA)
   388                                      ;------------------------------------------
   389 0000012E BAFAFF                      mov dx, IULA
   390 00000131 B080                        mov al, 0x80    ; 下位アドレス
   391 00000133 EE                          out dx, al
   392                                  
   393                                      ;------------------------------------------
   394                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   395                                      ;------------------------------------------
   396 00000134 BA8020                      mov dx, ICU_REG0
   397 00000137 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   398 00000139 EE                          out dx, al
   399                                  
   400 0000013A BA8120                      mov dx, ICU_REG1
   401 0000013D B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   402 0000013F EE                          out dx, al
   403                                                      ; ICW3 is skipped in Single Mode
   404 00000140 B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   405 00000142 EE                          out dx, al
   406                                  
   407                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   408 00000143 B07F                        mov al, 7Fh     ; 0111 1111
   409 00000145 EE                          out dx, al
   410                                  
   411                                      ;-------------------------------------------
   412                                      ; 割り込み許可
   413                                      ;-------------------------------------------
   414 00000146 FB                          sti
   415                                  
   416                                   %endif
   417                                  
   418                                      ; 変数初期化 (RAMエリアをクリア)
   419 00000147 C706[4E09]0000              mov word [dump_seg], 0x0000
   420 0000014D C706[5009]0000              mov word [dump_off], 0x0000
   421 00000153 C706[5209]0020              mov word [load_seg], 0x2000
   422                                  
   423                                      ; スタートメッセージの表示
   424 00000159 BE[0107]                    mov si, msg_boot
   425 0000015C E8F002                      call puts
   426                                  
   427                                  ; =================================================================
   428                                  ; Main Loop
   429                                  ; =================================================================
   430                                  monitor_loop:
   431 0000015F B03E                        mov al, '>'
   432 00000161 E8F902                      call putc
   433 00000164 B020                        mov al, ' '
   434 00000166 E8F402                      call putc
   435                                  
   436 00000169 E81303                      call getc_echo  ; コマンド受信（エコーあり）
   437 0000016C 88C3                        mov bl, al
   438                                      
   439 0000016E 80FB64                      cmp bl, 'd'     ; dump command
   440 00000171 747A                        je do_dump
   441 00000173 80FB44                      cmp bl, 'D'
   442 00000176 7475                        je do_dump
   443                                      
   444 00000178 80FB6C                      cmp bl, 'l'     ; load command
   445 0000017B 7503E9D000                  je do_load
   446 00000180 80FB4C                      cmp bl, 'L'
   447 00000183 7503E9C800                  je do_load
   448                                      
   449 00000188 80FB67                      cmp bl, 'g'     ; go command
   450 0000018B 7503E94401                  je do_go
   451 00000190 80FB47                      cmp bl, 'G'
   452 00000193 7503E93C01                  je do_go
   453                                  
   454 00000198 80FB77                      cmp bl, 'w'     ; Write command
   455 0000019B 7503E96001                  je do_write
   456 000001A0 80FB57                      cmp bl, 'W'
   457 000001A3 7503E95801                  je do_write
   458                                  
   459 000001A8 3C69                        cmp al, 'i'     ; Input Port command
   460 000001AA 7503E99401                  je do_in
   461 000001AF 3C49                        cmp al, 'I'
   462 000001B1 7503E98D01                  je do_in
   463                                  
   464 000001B6 3C6F                        cmp al, 'o'     ; Output Port command
