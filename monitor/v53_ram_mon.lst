  1365 00000632 4C6F6164204845582E-     msg_load: db "Load HEX...",0
  1365 0000063B 2E2E00             
  1366 0000063E 4F4B00                  msg_ok:   db "OK",0
  1367 00000641 476F2100                msg_go:   db "Go!",0
  1368                                  
  1369 00000645 3E2000                  msg_prompt: db "> ", 0
  1370 00000648 4572726F720D0A00        msg_error:  db "Error", 0x0D, 0x0A, 0
