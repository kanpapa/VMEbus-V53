   815 00000415 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   816                                  
   817 00000417 BE[2B07]                    mov si, msg_done
   818 0000041A E85F00                      call puts
   819 0000041D E96CFD                      jmp monitor_loop
