   756                                  ; ==============================================================
   757                                  ; Command: Scan I/O Ports
   758                                  ; Usage:
   759                                  ;   S <Start_port> <End_port>
   760                                  ; Description: Reads ports and prints if value is NOT 0xFF
   761                                  ; ==============================================================
   762                                  do_scan:
   763 00000353 E8EE00                      call getc_echo
   764 00000356 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   765 00000358 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   766                                  
   767 0000035D E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   768 00000360 89C3                        mov bx, ax          ; BX = Start Address
   769                                      
   770 00000362 E8DF00                      call getc_echo
   771 00000365 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   772 00000367 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   773                                  
   774 00000369 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   775 0000036C 89C1                        mov cx, ax          ; CX = End Address
   776                                  
   777 0000036E 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   778 00000370 7603E95001                  ja error
   779                                  
   780 00000375 E8D500                      call putc_crlf
   781 00000378 BE[F306]                    mov si, msg_scan_start
   782 0000037B E89600                      call puts
   783                                  
   784                                  .scan_loop:
   785 0000037E 89DA                        mov dx, bx          ; DXにポートアドレス設定
   786 00000380 EC                          in al, dx           ; I/O Read
   787                                  
   788 00000381 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   789 00000383 741D                        je .next_port
   790                                  
   791 00000385 50                          push ax             ; Readした値をスタックに保存
   792                                  
   793                                      ; --- 有効な値が見つかった場合の表示 ---
   794                                      ; [Port]: Value
   795 00000386 89D8                        mov ax, bx
   796 00000388 E8CB00                      call print_hex_word ; ポートアドレスの表示
   797 0000038B B03A                        mov al, ':'
   798 0000038D E89200                      call putc
   799 00000390 B020                        mov al, ' '
   800 00000392 E88D00                      call putc
   801                                      
   802 00000395 58                          pop ax
   803 00000396 E8C400                      call print_hex_byte ; Readした値の表示
   804                                      
   805 00000399 BE[1E07]                    mov si, msg_space   ; "  "
   806 0000039C E87500                      call puts
   807                                  
   808                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   809                                      ; ここでは単純にリスト形式で改行します
   810 0000039F E8AB00                      call putc_crlf
   811                                  
   812                                  .next_port:
   813 000003A2 43                          inc bx              ; 次のアドレスへ
   814                                      
   815                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   816 000003A3 BA6120                      mov dx, SCU_SST
   817 000003A6 EC                          in al, dx
   818 000003A7 A802                        test al, RX_READY   ; RxRDY?
   819 000003A9 750D                        jnz .abort          ; 何かキーが押されたら中断
   820                                  
   821 000003AB 39CB                        cmp bx, cx
   822 000003AD 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   823                                  
   824 000003AF BE[6406]                    mov si, msg_done
   825 000003B2 E85F00                      call puts
   826 000003B5 E975FD                      jmp monitor_loop
   827                                  
   828                                  .abort:
   829                                      ; 入力バッファを空読みしておく
   830 000003B8 BA6020                      mov dx, SCU_DATA
   831 000003BB EC                          in al, dx
   832 000003BC BE[2107]                    mov si, msg_abort
   833 000003BF E85200                      call puts
   834 000003C2 E968FD                      jmp monitor_loop
   835                                  
   836                                  ; ==============================================================
   837                                  ; Command: Timer
   838                                  ;   T          -> Show current tick counter (32-bit HEX)
   839                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   840                                  ; ==============================================================
   841                                  do_timer:
   842 000003C5 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   843 000003C8 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   844 000003CA 7421                        je .show_counter
   845 000003CC 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   846 000003CE 7403E9F200                  jne error           ; それ以外はエラー
   847                                  
   848                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   849 000003D3 E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   850                                  
   851                                      ; 開始時刻を保存 (Start Time)
   852 000003D6 8B1E[5808]                  mov bx, [tick_counter_lo]
   853                                  
   854                                  .wait_loop:
   855                                      ; 1. 現在時刻を取得
   856 000003DA 8B0E[5808]                  mov cx, [tick_counter_lo]
   857                                      
   858                                      ; 2. 経過時間を計算 (Current - Start)
   859                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   860 000003DE 29D9                        sub cx, bx          
   861                                      
   862                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   863 000003E0 39C1                        cmp cx, ax
   864 000003E2 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   865                                  
   866                                      ; 指定時間経過した
   867 000003E4 BE[6406]                    mov si, msg_done
   868 000003E7 E82A00                      call puts
   869 000003EA E940FD                      jmp monitor_loop
   870                                  
   871                                  .show_counter:
   872                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   873 000003ED E85D00                      call putc_crlf
   874                                      
   875 000003F0 BE[2C07]                    mov si, msg_tick    ; "Tick: "
   876 000003F3 E81E00                      call puts
   877                                  
   878                                      ; 32bitカウンタを [High][Low] の順で表示
   879 000003F6 A1[5A08]                    mov ax, [tick_counter_hi]
   880 000003F9 E85A00                      call print_hex_word
   881 000003FC A1[5808]                    mov ax, [tick_counter_lo]
   882 000003FF E85400                      call print_hex_word
   883                                      
   884 00000402 E84800                      call putc_crlf
   885 00000405 E925FD                      jmp monitor_loop
   886                                  
   887                                  ; ==============================================================
   888                                  ; Command: Help
