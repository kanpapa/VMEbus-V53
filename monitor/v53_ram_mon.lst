   609                                  ; =================================================================
   610                                  ; Command: Execute
   611                                  ; Usage:
   612                                  ;   G <Seg> <Off>
   613                                  ; Example: G 1000 0000
   614                                  ; =================================================================
   615                                  do_go:
   616                                      ; Gコマンドは入力後に改行
   617                                      
   618 00000299 E8A801                      call getc_echo      ; Space?
   619 0000029C 3C20                        cmp al, ' '
   620 0000029E 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   621                                      
   622                                      ; 1. セグメント (SSSS) を取得
   623 000002A0 E8D801                      call get_hex_word   ; AX = Segment
   624 000002A3 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   625 000002A4 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   626                                      
   627                                      ; スペース読み飛ばし (もしあれば)
   628 000002A6 E81802                      call skip_space
   629                                      
   630                                      ; 2. オフセット (OOOO) を取得
   631 000002A9 E8CF01                      call get_hex_word   ; AX = Offset
   632 000002AC 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   633                                      
   634 000002AD E89D01                      call putc_crlf      ; 実行前に改行
   635 000002B0 BE[4106]                    mov si, msg_go
   636 000002B3 E85E01                      call puts
   637 000002B6 E89401                      call putc_crlf
   638                                      
   639                                      ; 3. 実行環境のセットアップ
   640                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   641 000002B9 8EDB                        mov ds, bx
   642 000002BB 8EC3                        mov es, bx
   643                                  
   644                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   645 000002BD FA                          cli
   646                                  
   647                                      ; 4. ジャンプ！ (Far Return)
   648                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   649 000002BE CB                          retf                ; Jump!
   650                                  
   651                                  .go_default:
