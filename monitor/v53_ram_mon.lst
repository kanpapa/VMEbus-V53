   749                                  ; ==============================================================
   750                                  ; Command: Scan I/O Ports
   751                                  ; Usage:
   752                                  ;   S <Start_port> <End_port>
   753                                  ; Description: Reads ports and prints if value is NOT 0xFF
   754                                  ; ==============================================================
   755                                  do_scan:
   756 000003BB E8EE00                      call getc_echo
   757 000003BE 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   758 000003C0 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   759                                  
   760 000003C5 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   761 000003C8 89C3                        mov bx, ax          ; BX = Start Address
   762                                      
   763 000003CA E8DF00                      call getc_echo
   764 000003CD 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   765 000003CF 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   766                                  
   767 000003D1 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   768 000003D4 89C1                        mov cx, ax          ; CX = End Address
   769                                  
   770 000003D6 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   771 000003D8 7603E95001                  ja error
   772                                  
   773 000003DD E8D500                      call putc_crlf
   774 000003E0 BE[BA07]                    mov si, msg_scan_start
   775 000003E3 E89600                      call puts
   776                                  
   777                                  .scan_loop:
   778 000003E6 89DA                        mov dx, bx          ; DXにポートアドレス設定
   779 000003E8 EC                          in al, dx           ; I/O Read
   780                                  
   781 000003E9 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   782 000003EB 741D                        je .next_port
   783                                  
   784 000003ED 50                          push ax             ; Readした値をスタックに保存
   785                                  
   786                                      ; --- 有効な値が見つかった場合の表示 ---
   787                                      ; [Port]: Value
   788 000003EE 89D8                        mov ax, bx
   789 000003F0 E8CB00                      call print_hex_word ; ポートアドレスの表示
   790 000003F3 B03A                        mov al, ':'
   791 000003F5 E89200                      call putc
   792 000003F8 B020                        mov al, ' '
   793 000003FA E88D00                      call putc
   794                                      
   795 000003FD 58                          pop ax
   796 000003FE E8C400                      call print_hex_byte ; Readした値の表示
   797                                      
   798 00000401 BE[E507]                    mov si, msg_space   ; "  "
   799 00000404 E87500                      call puts
   800                                  
   801                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   802                                      ; ここでは単純にリスト形式で改行します
   803 00000407 E8AB00                      call putc_crlf
   804                                  
   805                                  .next_port:
   806 0000040A 43                          inc bx              ; 次のアドレスへ
   807                                      
   808                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   809 0000040B BA61F0                      mov dx, SCU_SST
   810 0000040E EC                          in al, dx
   811 0000040F A802                        test al, RX_READY   ; RxRDY?
   812 00000411 750D                        jnz .abort          ; 何かキーが押されたら中断
   813                                  
