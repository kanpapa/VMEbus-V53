   602                                  ; =================================================================
   603                                  ; Command: Execute
   604                                  ; Usage:
   605                                  ;   G <Seg> <Off>
   606                                  ; Example: G 1000 0000
   607                                  ; =================================================================
   608                                  do_go:
   609                                      ; Gコマンドは入力後に改行
   610                                      
   611 00000301 E8AB01                      call getc_echo      ; Space?
   612 00000304 3C20                        cmp al, ' '
   613 00000306 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   614                                      
   615                                      ; 1. セグメント (SSSS) を取得
   616 00000308 E8DB01                      call get_hex_word   ; AX = Segment
   617 0000030B 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   618 0000030C 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   619                                      
   620                                      ; スペース読み飛ばし (もしあれば)
   621 0000030E E81B02                      call skip_space
   622                                      
   623                                      ; 2. オフセット (OOOO) を取得
   624 00000311 E8D201                      call get_hex_word   ; AX = Offset
   625 00000314 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   626                                      
   627 00000315 E8A001                      call putc_crlf      ; 実行前に改行
   628 00000318 BE[0B07]                    mov si, msg_go
   629 0000031B E86101                      call puts
   630 0000031E E89701                      call putc_crlf
   631                                      
   632                                      ; 3. 実行環境のセットアップ
   633                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   634 00000321 8EDB                        mov ds, bx
   635 00000323 8EC3                        mov es, bx
