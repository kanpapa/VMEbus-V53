   660                                      
   661                                      ; 2. オフセット (OOOO) を取得
   662 000002DB E8CF01                      call get_hex_word   ; AX = Offset
   663 000002DE 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   664                                      
   665 000002DF E89D01                      call putc_crlf      ; 実行前に改行
   666 000002E2 BE[3307]                    mov si, msg_go
   667 000002E5 E85E01                      call puts
