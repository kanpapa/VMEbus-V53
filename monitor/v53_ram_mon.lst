   668                                      
   669                                      ; 2. オフセット (OOOO) を取得
   670 000002E4 E8CF01                      call get_hex_word   ; AX = Offset
   671 000002E7 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   672                                      
   673 000002E8 E89D01                      call putc_crlf      ; 実行前に改行
   674 000002EB BE[3D07]                    mov si, msg_go
   675 000002EE E85E01                      call puts
   676 000002F1 E89401                      call putc_crlf
   677                                      
   678                                      ; 3. 実行環境のセットアップ
