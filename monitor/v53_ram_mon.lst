   894                                  ; ==============================================================
   895                                  ; Command: Timer
   896                                  ;   T          -> Show current tick counter (32-bit HEX)
   897                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   898                                  ; ==============================================================
   899                                  do_timer:
   900 00000411 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   901 00000414 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   902 00000416 7421                        je .show_counter
   903 00000418 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   904 0000041A 7403E9F200                  jne error           ; それ以外はエラー
   905                                  
   906                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   907 0000041F E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   908                                  
   909                                      ; 開始時刻を保存 (Start Time)
   910 00000422 8B1E[6509]                  mov bx, [tick_counter_lo]
   911                                  
   912                                  .wait_loop:
   913                                      ; 1. 現在時刻を取得
   914 00000426 8B0E[6509]                  mov cx, [tick_counter_lo]
   915                                      
   916                                      ; 2. 経過時間を計算 (Current - Start)
   917                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   918 0000042A 29D9                        sub cx, bx          
   919                                      
   920                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   921 0000042C 39C1                        cmp cx, ax
   922 0000042E 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   923                                  
   924                                      ; 指定時間経過した
   925 00000430 BE[7107]                    mov si, msg_done
   926 00000433 E82A00                      call puts
   927 00000436 E937FD                      jmp monitor_loop
   928                                  
   929                                  .show_counter:
   930                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   931 00000439 E85D00                      call putc_crlf
   932                                      
   933 0000043C BE[3908]                    mov si, msg_tick    ; "Tick: "
   934 0000043F E81E00                      call puts
   935                                  
   936                                      ; 32bitカウンタを [High][Low] の順で表示
   937 00000442 A1[6709]                    mov ax, [tick_counter_hi]
   938 00000445 E85A00                      call print_hex_word
   939 00000448 A1[6509]                    mov ax, [tick_counter_lo]
   940 0000044B E85400                      call print_hex_word
   941                                      
   942 0000044E E84800                      call putc_crlf
   943 00000451 E91CFD                      jmp monitor_loop
   944                                  
   945                                  ; ==============================================================
   946                                  ; Command: Help
   947                                  ; ==============================================================
   948                                  cmd_help:
   949 00000454 E84200                      call putc_crlf
   950 00000457 BE[7D07]                    mov si, msg_help
   951 0000045A E80300                      call puts
   952 0000045D E910FD                      jmp monitor_loop
   953                                  
   954                                  ; =================================================================
   955                                  ; Utilities
   956                                  ; =================================================================
   957                                  
   958                                  ; 文字列出力
   959                                  puts:
   960 00000460 2E8A04                      mov al, [cs:si]
   961 00000463 08C0                        or al, al
   962 00000465 7406                        jz .ret
   963 00000467 E80400                      call putc
   964 0000046A 46                          inc si
   965 0000046B EBF3                        jmp puts
   966 0000046D C3                      .ret: ret
   967                                  
   968                                  ; 1文字出力
   969                                  putc:
   970 0000046E 52                          push dx
   971 0000046F 50                          push ax
   972 00000470 BA6120                      mov dx, SCU_SST
   973 00000473 EC                      .w: in al, dx
   974 00000474 A801                        test al, TX_READY  ; TX Ready?
   975 00000476 74FB                        jz .w
   976 00000478 BA6020                      mov dx, SCU_DATA
   977 0000047B 58                          pop ax
   978 0000047C 50                          push ax
   979 0000047D EE                          out dx, al
   980 0000047E 58                          pop ax
   981 0000047F 5A                          pop dx
   982 00000480 C3                          ret
   983                                  
   984                                  ; 1文字入力
   985                                  getc:
   986 00000481 52                          push dx
   987 00000482 BA6120                      mov dx, SCU_SST
   988 00000485 EC                      .w: in al, dx
   989 00000486 A802                        test al, RX_READY  ; RX Ready?
   990 00000488 74FB                        jz .w
   991 0000048A BA6020                      mov dx, SCU_DATA
   992 0000048D EC                          in al, dx
   993 0000048E 5A                          pop dx
   994 0000048F C3                          ret
   995                                  
   996                                  ; 1文字入力　エコーバックあり
   997                                  getc_echo:
   998 00000490 E8EEFF                      call getc
   999 00000493 50                          push ax
  1000 00000494 E8D7FF                      call putc
  1001 00000497 58                          pop ax
  1002 00000498 C3                          ret
  1003                                  
  1004                                  ; 改行出力
  1005                                  putc_crlf:
  1006 00000499 B00D                        mov al, 0x0D
  1007 0000049B E8D0FF                      call putc
  1008 0000049E B00A                        mov al, 0x0A
  1009 000004A0 EBCC                        jmp putc
  1010                                  
  1011                                  ; -----------------------------------------------------------------
  1012                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
  1013                                  ; Input: AX
  1014                                  ; -----------------------------------------------------------------
  1015                                  print_hex_word:
  1016 000004A2 50                          push ax
  1017 000004A3 88E0                        mov al, ah
  1018 000004A5 E80100                      call print_hex_byte
  1019 000004A8 58                          pop ax
  1020                                  
  1021                                  ; -----------------------------------------------------------------
  1022                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
  1023                                  ; Input: AL
  1024                                  ; -----------------------------------------------------------------
  1025                                  print_hex_byte:
  1026 000004A9 50                          push ax
  1027 000004AA 51                          push cx
  1028                                  
  1029                                      ; 上位バイトの表示
  1030 000004AB 50                          push ax
  1031 000004AC C0E804                      shr al, 4
  1032 000004AF E80900                      call .digit
  1033                                  
  1034                                      ; 下位バイトの表示
  1035 000004B2 58                          pop ax
  1036 000004B3 240F                        and al, 0x0F
  1037 000004B5 E80300                      call .digit
  1038                                  
  1039 000004B8 59                          pop cx
  1040 000004B9 58                          pop ax
  1041 000004BA C3                          ret
  1042                                  
  1043                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
  1044                                  .digit:
  1045 000004BB 0430                        add al, '0'
  1046 000004BD 3C39                        cmp al, '9'
  1047 000004BF 7602                        jbe .p
  1048 000004C1 0407                        add al, 7
  1049 000004C3 E8A8FF                  .p: call putc
  1050 000004C6 C3                          ret
  1051                                  
  1052                                  ; -----------------------------------------------------------------
  1053                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
  1054                                  ; Input:  Serial (例: "1", "0", "0", "0")
  1055                                  ; Output: AX = 0x1000
  1056                                  ; -----------------------------------------------------------------
  1057                                  get_hex_word:
  1058 000004C7 53                          push bx
  1059 000004C8 E80B00                      call get_hex_byte_echo
  1060 000004CB 88C7                        mov bh, al
  1061 000004CD E80600                      call get_hex_byte_echo
  1062 000004D0 88C3                        mov bl, al
  1063 000004D2 89D8                        mov ax, bx
  1064 000004D4 5B                          pop bx
  1065 000004D5 C3                          ret
  1066                                  
  1067                                  ; 16進数2桁入力　エコーバック有り
  1068                                  get_hex_byte_echo:
  1069 000004D6 53                          push bx
  1070 000004D7 E8B6FF                      call getc_echo
  1071 000004DA E82500                      call hex_char_to_bin
  1072 000004DD C0E004                      shl al, 4
  1073 000004E0 88C3                        mov bl, al
  1074 000004E2 E8ABFF                      call getc_echo
  1075 000004E5 E81A00                      call hex_char_to_bin
  1076 000004E8 08D8                        or al, bl
  1077 000004EA 5B                          pop bx
  1078 000004EB C3                          ret
  1079                                  
  1080                                  ; -----------------------------------------------------------------
  1081                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1082                                  ; Input:  Serial (例: "3", "F")
  1083                                  ; Output: AL = 0x3F
  1084                                  ; -----------------------------------------------------------------
  1085                                  get_hex_byte:
  1086 000004EC 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1087                                  
  1088                                      ; 上位4bit
  1089 000004ED E891FF                      call getc
  1090 000004F0 E80F00                      call hex_char_to_bin
  1091 000004F3 C0E004                      shl al, 4
  1092 000004F6 88C3                        mov bl, al          ; 一時保存
  1093                                      
  1094                                      ; 下位4bit
  1095 000004F8 E886FF                      call getc
  1096 000004FB E80400                      call hex_char_to_bin
  1097 000004FE 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1098 00000500 5B                          pop bx
  1099 00000501 C3                          ret
  1100                                  
  1101                                  ; -----------------------------------------------------------------
  1102                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1103                                  ; Input: AL (ASCII)
  1104                                  ; Output: AL (Binary)
  1105                                  ; -----------------------------------------------------------------
  1106                                  hex_char_to_bin:
  1107 00000502 2C30                        sub al, '0'
  1108 00000504 3C09                        cmp al, 9
  1109 00000506 7604                        jbe .done
  1110 00000508 2C07                        sub al, 7           ; 'A'-'F'対応
  1111 0000050A 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1112                                  .done:
  1113 0000050C C3                          ret
  1114                                  
  1115                                  ; -----------------------------------------------------------------
  1116                                  ; Helper: スペースなどを読み飛ばす
  1117                                  ; -----------------------------------------------------------------
  1118                                  skip_space:
  1119 0000050D E880FF                      call getc_echo
  1120 00000510 C3                          ret
  1121                                  
  1122                                  ; -----------------------------------------------------------------
  1123                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1124                                  ; -----------------------------------------------------------------
  1125                                  error:
  1126 00000511 BE[5507]                    mov si, msg_error
  1127 00000514 E849FF                      call puts
  1128 00000517 E956FC                      jmp monitor_loop
  1129                                  
  1130                                  ;==========================================================
  1131                                  ; NMI (ABORT) Handler
  1132                                  ;==========================================================
  1133                                  
  1134                                  NMI_Handler:
  1135                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1136 0000051A 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1137 0000051B 1E                          push ds
  1138 0000051C 06                          push es
  1139                                  
  1140                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1141 0000051D 8CC8                        mov  ax, cs
  1142 0000051F 8ED8                        mov  ds, ax
  1143 00000521 8EC0                        mov  es, ax
  1144                                  
  1145                                      ; 3. スタックフレームへのポインタ設定
  1146 00000523 89E5                        mov  bp, sp
  1147                                  
  1148                                      ; --- 画面表示 ---
  1149 00000525 BE[4008]                    mov  si, msg_nmi
  1150 00000528 E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1151                                  
  1152                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1153                                      ; Stack Layout after pushes:
  1154                                      ; BP+0: ES
  1155                                      ; BP+2: DS
  1156                                      ; BP+4: DI
  1157                                      ; BP+6: SI
  1158                                      ; BP+8: BP (Old)
  1159                                      ; BP+10: SP (Original)
  1160                                      ; BP+12: BX
  1161                                      ; BP+14: DX
  1162                                      ; BP+16: CX
  1163                                      ; BP+18: AX
  1164                                      ; BP+20: IP (Return Addr)
  1165                                      ; BP+22: CS (Return Addr)
  1166                                      ; BP+24: Flags
  1167                                      
  1168                                      ; AX
  1169 0000052B BE[5808]                    mov  si, msg_ax
  1170 0000052E E82FFF                      call puts
  1171 00000531 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1172 00000534 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1173                                  
  1174                                      ; BX
  1175 00000537 BE[5D08]                    mov  si, msg_bx
  1176 0000053A E823FF                      call puts
  1177 0000053D 8B460C                      mov  ax, [bp+12]
  1178 00000540 E85FFF                      call print_hex_word
  1179                                  
  1180                                      ; CX
  1181 00000543 BE[6208]                    mov  si, msg_cx
  1182 00000546 E817FF                      call puts
  1183 00000549 8B4610                      mov  ax, [bp+16]
  1184 0000054C E853FF                      call print_hex_word
  1185                                  
  1186                                      ; DX
  1187 0000054F BE[6708]                    mov  si, msg_dx
  1188 00000552 E80BFF                      call puts
  1189 00000555 8B460E                      mov  ax, [bp+14]
  1190 00000558 E847FF                      call print_hex_word
  1191                                  
  1192 0000055B E83BFF                      call putc_crlf
  1193                                  
  1194                                      ; --- 中断地点 (CS:IP) の表示 ---
  1195                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1196                                      ; その上が割り込み発生時の IP, CS, Flags です
  1197                                      
  1198 0000055E BE[6C08]                    mov  si, msg_addr
  1199 00000561 E8FCFE                      call puts           ; " Stop at "
  1200 00000564 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1201 00000567 E838FF                      call print_hex_word
  1202 0000056A B03A                        mov  al, ':'
  1203 0000056C E8FFFE                      call putc
  1204 0000056F 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1205 00000572 E82DFF                      call print_hex_word
  1206                                  
  1207 00000575 E821FF                      call putc_crlf
  1208                                  
  1209                                      ; 4. 復帰処理
  1210                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1211                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1212 00000578 E985FA                      jmp  start  ; モニタの開始ラベルへ
  1213                                  
  1214                                  ; ==========================================================
  1215                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1216                                  ; ==========================================================
  1217                                  
  1218                                  ; --- 共通処理部 (Common Handler) ---
  1219                                  _default_int_handler:
  1220                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1221 0000057B 55                          push bp
  1222 0000057C 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1223 0000057D 1E                          push ds
  1224 0000057E 06                          push es
  1225                                  
  1226                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1227 0000057F 8CC8                        mov  ax, cs
  1228 00000581 8ED8                        mov  ds, ax
  1229 00000583 8EC0                        mov  es, ax
  1230                                  
  1231                                      ; 3. スタックフレームへのポインタ設定
  1232 00000585 89E5                        mov  bp, sp
  1233                                  
  1234                                      ; --- メッセージ表示 ---
  1235 00000587 BE[7E08]                    mov  si, msg_int_trap
  1236 0000058A E8D3FE                      call puts           ; "** INT "
  1237                                  
  1238                                      ; --- ベクタ番号の表示 ---
  1239                                      ; スタック構造:
  1240                                      ; [BP+0] Old BP
  1241                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1242                                      ; [BP+4] Return IP ...
  1243                                      
  1244 0000058D 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1245 00000590 E816FF                      call print_hex_byte ; 表示 (例: 25)
  1246                                  
  1247 00000593 BE[8608]                    mov  si, msg_detected
  1248 00000596 E8C7FE                      call puts           ; " detected **" (改行含む)
  1249                                  
  1250                                  ; 3. レジスタ表示 (スタックから読み出して表示)
  1251                                      ; Stack Layout after pushes:
  1252                                      ; BP+0: ES
  1253                                      ; BP+2: DS
  1254                                      ; BP+4: DI
  1255                                      ; BP+6: SI
  1256                                      ; BP+8: BP (Old)
  1257                                      ; BP+10: SP (Original)
  1258                                      ; BP+12: BX
  1259                                      ; BP+14: DX
  1260                                      ; BP+16: CX
  1261                                      ; BP+18: AX
  1262                                      ; BP+20: IP (Return Addr)
  1263                                      ; BP+22: CS (Return Addr)
  1264                                      ; BP+24: Flags
  1265                                      
  1266                                      ; AX
  1267 00000599 BE[5808]                    mov  si, msg_ax
  1268 0000059C E8C1FE                      call puts
  1269 0000059F 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1270 000005A2 E8FDFE                      call print_hex_word     ; 4桁HEX表示ルーチン
  1271                                  
  1272                                      ; BX
  1273 000005A5 BE[5D08]                    mov  si, msg_bx
  1274 000005A8 E8B5FE                      call puts
  1275 000005AB 8B460C                      mov  ax, [bp+12]
  1276 000005AE E8F1FE                      call print_hex_word
  1277                                  
  1278                                      ; CX
  1279 000005B1 BE[6208]                    mov  si, msg_cx
  1280 000005B4 E8A9FE                      call puts
  1281 000005B7 8B4610                      mov  ax, [bp+16]
  1282 000005BA E8E5FE                      call print_hex_word
  1283                                  
  1284                                      ; DX
  1285 000005BD BE[6708]                    mov  si, msg_dx
  1286 000005C0 E89DFE                      call puts
  1287 000005C3 8B460E                      mov  ax, [bp+14]
  1288 000005C6 E8D9FE                      call print_hex_word
  1289                                  
  1290 000005C9 E8CDFE                      call putc_crlf
  1291                                  
  1292                                      ; --- 中断地点 (CS:IP) の表示 ---
  1293                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1294                                      ; その上が割り込み発生時の IP, CS, Flags です
  1295                                      
  1296 000005CC BE[6C08]                    mov  si, msg_addr
  1297 000005CF E88EFE                      call puts           ; " Stop at "
  1298 000005D2 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1299 000005D5 E8CAFE                      call print_hex_word
  1300 000005D8 B03A                        mov  al, ':'
  1301 000005DA E891FE                      call putc
  1302 000005DD 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1303 000005E0 E8BFFE                      call print_hex_word
  1304                                  
  1305 000005E3 E8B3FE                      call putc_crlf
  1306                                  
  1307                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1308 000005E6 B020                        mov al, 20h         ; Non-specific EOI
  1309 000005E8 E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1310 000005EA BA8020                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1311 000005ED EE                          out dx, al
  1312                                  
  1313 000005EE 07                          pop  es
  1314 000005EF 1F                          pop  ds
  1315 000005F0 61                          popa
  1316 000005F1 5D                          pop  bp
  1317 000005F2 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1318 000005F5 CF                          iret
  1319                                  
  1320                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1321                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1322                                  
  1323 000005F6 6A00                    _isr_stub_0:  push 0x0          ; 0: Division by zero
  1324 000005F8 EB81                                  jmp _default_int_handler
  1325 000005FA 6A01                    _isr_stub_1:  push 0x1          ; 1: Break flag
  1326 000005FC E97CFF                                jmp _default_int_handler
  1327                                                                  ; 2: NMI
  1328 000005FF 6A03                    _isr_stub_3:  push 0x3          ; 3: BRK3
  1329 00000601 E977FF                                jmp _default_int_handler
  1330 00000604 6A04                    _isr_stub_4:  push 0x4          ; 4: BRKV
  1331 00000606 E972FF                                jmp _default_int_handler
  1332 00000609 6A05                    _isr_stub_5:  push 0x5          ; 5: CHKIND
  1333 0000060B E96DFF                                jmp _default_int_handler
  1334                                  
  1335 0000060E 6A20                    _isr_stub_20: push 0x0020       ; 32: ICU INTP0
  1336 00000610 E968FF                                jmp _default_int_handler
  1337 00000613 6A21                    _isr_stub_21: push 0x0021       ; 33: ICU INTP1
  1338 00000615 E963FF                                jmp _default_int_handler
  1339 00000618 6A22                    _isr_stub_22: push 0x0022       ; 34: ICU INTP2
  1340 0000061A E95EFF                                jmp _default_int_handler
  1341 0000061D 6A23                    _isr_stub_23: push 0x0023       ; 35: ICU INTP3
  1342 0000061F E959FF                                jmp _default_int_handler
  1343 00000622 6A24                    _isr_stub_24: push 0x0024       ; 36: ICU INTP4
  1344 00000624 E954FF                                jmp _default_int_handler
  1345 00000627 6A25                    _isr_stub_25: push 0x0025       ; 37: ICU INTP5
  1346 00000629 E94FFF                                jmp _default_int_handler
  1347 0000062C 6A26                    _isr_stub_26: push 0x0026       ; 38: ICU INTP6
  1348 0000062E E94AFF                                jmp _default_int_handler
  1349                                  
  1350                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1351                                  
  1352                                  ; ==========================================================
  1353                                  ; PIC Dispatch Handler (Vector 27h)
  1354                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1355                                  ; ==========================================================
  1356                                  _pic_dispatch_handler:
  1357 00000631 60                          pusha
  1358 00000632 1E                          push ds
  1359 00000633 06                          push es
  1360                                  
  1361                                      ; DS設定 (Tiny Model)
  1362 00000634 8CC8                        mov ax, cs
  1363 00000636 8ED8                        mov ds, ax
  1364                                  
  1365                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1366                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1367 00000638 B00B                        mov al, 0x0B
  1368 0000063A E6C8                        out PIC_REG0, al
  1369 0000063C E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1370                                  
  1371                                      ; --- 2. 要因判定と分岐 ---
  1372                                      
  1373 0000063E A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1374 00000640 751E                        jnz .handle_timer0
  1375                                  
  1376 00000642 A802                        test al, 02h        ; Bit 1: SCSI
  1377 00000644 7526                        jnz .handle_scsi
  1378                                  
  1379 00000646 A804                        test al, 04h        ; Bit 2: Timer 1
  1380 00000648 752A                        jnz .handle_timer1
  1381                                  
  1382 0000064A A808                        test al, 08h        ; Bit 3: USART Rx
  1383 0000064C 752E                        jnz .handle_usart_rx
  1384                                  
  1385 0000064E A810                        test al, 10h        ; Bit 4: USART Tx
  1386 00000650 7532                        jnz .handle_usart_tx
  1387                                  
  1388 00000652 A820                        test al, 20h        ; Bit 5: SCU Rx
  1389 00000654 7536                        jnz .handle_scu_rx
  1390                                  
  1391 00000656 A840                        test al, 40h        ; Bit 6: SCU Tx
  1392 00000658 753A                        jnz .handle_scu_tx
  1393                                  
  1394 0000065A A880                        test al, 80h        ; Bit 7: PPI
  1395 0000065C 753E                        jnz .handle_ppi
  1396                                  
  1397                                      ; 該当なしの場合は無視
  1398 0000065E EB44                        jmp .eoi_exit
  1399                                  
  1400                                  ; --- 各ハンドラ処理 ---
  1401                                  
  1402                                  .handle_timer0:
  1403                                      ; INTP0: Timer 0 (Tick)
  1404                                      ; --- 32bit カウンタのインクリメント ---
  1405 00000660 FF06[6509]                  inc word [tick_counter_lo]
  1406 00000664 7504                        jnz .skip_carry
  1407 00000666 FF06[6709]                  inc word [tick_counter_hi]
  1408                                  .skip_carry:
  1409 0000066A EB38                        jmp .eoi_exit
  1410                                  
  1411                                  .handle_scsi:
  1412                                      ; INTP1: SCSIC
  1413 0000066C BE[9308]                    mov si, msg_int_scsi
  1414 0000066F E8EEFD                      call puts
  1415 00000672 EB30                        jmp .eoi_exit
  1416                                  
  1417                                  .handle_timer1:
  1418                                      ; INTP2: ユーザ用タイマー
  1419 00000674 BE[AA08]                    mov si, msg_int_timer1
  1420 00000677 E8E6FD                      call puts
  1421 0000067A EB28                        jmp .eoi_exit
  1422                                  
  1423                                  .handle_usart_rx:
  1424                                      ; INTP3: USART受信準備完了割り込み
  1425 0000067C BE[C308]                    mov si, msg_int_usart_rx
  1426 0000067F E8DEFD                      call puts
  1427 00000682 EB20                        jmp .eoi_exit
  1428                                  
  1429                                  .handle_usart_tx:
  1430                                      ; INTP4: USART送信完了割り込み
  1431 00000684 BE[DE08]                    mov si, msg_int_usart_tx
  1432 00000687 E8D6FD                      call puts
  1433 0000068A EB18                        jmp .eoi_exit
  1434                                  
  1435                                  .handle_scu_rx:
  1436                                      ; INTP5: SCU受信準備完了割り込み
  1437 0000068C BE[F908]                    mov si, msg_int_scu_rx
  1438 0000068F E8CEFD                      call puts
  1439 00000692 EB10                        jmp .eoi_exit
  1440                                  
  1441                                  .handle_scu_tx:
  1442                                      ; INTP6: SCU送信完了割り込み
  1443 00000694 BE[1209]                    mov si, msg_int_scu_tx
  1444 00000697 E8C6FD                      call puts
  1445 0000069A EB08                        jmp .eoi_exit
  1446                                  
  1447                                  .handle_ppi:
  1448                                      ; INTP7: PPI割り込み
  1449 0000069C BE[2B09]                    mov si, msg_int_ppi
  1450 0000069F E8BEFD                      call puts
  1451 000006A2 EB00                        jmp .eoi_exit
  1452                                  
  1453                                  ; --- 終了処理 ---
  1454                                  .eoi_exit:
  1455                                      ; --- EOI (End of Interrupt) to PIC ---
  1456 000006A4 B020                        mov al, 20h     ; Non-specific EOI
  1457                                  
  1458                                      ; 外部PIC (Slave) の割り込み完了
  1459 000006A6 E6C8                        out PIC_REG0, al
  1460                                  
  1461                                      ; V53内蔵ICU (Master) の割り込み完了
  1462 000006A8 BA8020                      mov dx, ICU_REG0 
  1463 000006AB EE                          out dx, al
  1464                                  
  1465 000006AC 07                          pop es
  1466 000006AD 1F                          pop ds
  1467 000006AE 61                          popa
  1468 000006AF CF                          iret
  1469                                  
  1470                                  ;--------------------------------------
  1471                                  ; 未定義割り込みベクタ用の簡易トラップ
  1472                                  ;--------------------------------------
  1473                                  _default_int_unknown_handler:
  1474                                      ; 想定外の割り込みが発生したため、
  1475                                      ; 画面に "UNKNOWN INT" と出して停止する
  1476 000006B0 FA                          cli                 ; 多重割り込み禁止
  1477                                  
  1478                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1479 000006B1 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1480 000006B2 1E                          push ds
  1481 000006B3 06                          push es
  1482                                  
  1483                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1484 000006B4 8CC8                        mov  ax, cs
  1485 000006B6 8ED8                        mov  ds, ax
  1486 000006B8 8EC0                        mov  es, ax
  1487                                  
  1488                                      ; 3. スタックフレームへのポインタ設定
  1489 000006BA 89E5                        mov  bp, sp
  1490                                  
  1491 000006BC BE[4109]                    mov si, msg_unknown_int
  1492 000006BF E89EFD                      call puts
  1493                                  
  1494                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1495                                      ; Stack Layout after pushes:
  1496                                      ; BP+0: ES
  1497                                      ; BP+2: DS
  1498                                      ; BP+4: DI
  1499                                      ; BP+6: SI
  1500                                      ; BP+8: BP (Old)
  1501                                      ; BP+10: SP (Original)
  1502                                      ; BP+12: BX
  1503                                      ; BP+14: DX
  1504                                      ; BP+16: CX
  1505                                      ; BP+18: AX
  1506                                      ; BP+20: IP (Return Addr)
  1507                                      ; BP+22: CS (Return Addr)
  1508                                      ; BP+24: Flags
  1509                                      
  1510                                      ; AX
  1511 000006C2 BE[5808]                    mov  si, msg_ax
  1512 000006C5 E898FD                      call puts
  1513 000006C8 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1514 000006CB E8D4FD                      call print_hex_word     ; 4桁HEX表示ルーチン
  1515                                  
  1516                                      ; BX
  1517 000006CE BE[5D08]                    mov  si, msg_bx
  1518 000006D1 E88CFD                      call puts
  1519 000006D4 8B460C                      mov  ax, [bp+12]
  1520 000006D7 E8C8FD                      call print_hex_word
  1521                                  
  1522                                      ; CX
  1523 000006DA BE[6208]                    mov  si, msg_cx
  1524 000006DD E880FD                      call puts
  1525 000006E0 8B4610                      mov  ax, [bp+16]
  1526 000006E3 E8BCFD                      call print_hex_word
  1527                                  
  1528                                      ; DX
  1529 000006E6 BE[6708]                    mov  si, msg_dx
  1530 000006E9 E874FD                      call puts
  1531 000006EC 8B460E                      mov  ax, [bp+14]
  1532 000006EF E8B0FD                      call print_hex_word
  1533                                  
  1534 000006F2 E8A4FD                      call putc_crlf
  1535                                  
  1536                                      ; --- 中断地点 (CS:IP) の表示 ---
  1537                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1538                                      ; その上が割り込み発生時の IP, CS, Flags です
  1539                                      
  1540 000006F5 BE[6C08]                    mov  si, msg_addr
  1541 000006F8 E865FD                      call puts           ; " Stop at "
  1542 000006FB 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1543 000006FE E8A1FD                      call print_hex_word
  1544 00000701 B03A                        mov  al, ':'
  1545 00000703 E868FD                      call putc
  1546 00000706 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1547 00000709 E896FD                      call print_hex_word
  1548                                  
  1549 0000070C E88AFD                      call putc_crlf
  1550                                  
  1551                                      ; 4. 復帰処理
  1552                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1553                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1554 0000070F E9EEF8                      jmp  start  ; モニタの開始ラベルへ
  1555                                  
  1556                                      ; 停止（暴走を防ぐ）
  1557                                  ;.halt:
  1558                                  ;    hlt
  1559                                  ;    jmp .halt
  1560                                  
