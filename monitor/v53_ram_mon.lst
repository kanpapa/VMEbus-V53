     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.6  2026-01-29
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; SCUレジスタ (SCUは1260Hに配置）
    55                                      %define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    56                                      %define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    57                                      %define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    58                                      %define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    59                                      %define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    60                                      %define TX_READY    00000001b   ; TBRDY                                 
    61                                      %define RX_READY    00000010b   ; RBRDY
    62                                  
    63                                      ; --- タイマーレジスタ (TCUは1270Hに配置) ---
    64                                      %define TM0_CNT     0x01270 ; Timer 0 Counter
    65                                      %define TM1_CNT     0x01271 ; Timer 1 Counter
    66                                      %define TM2_CNT     0x01272 ; Timer 2 Counter
    67                                      %define TM_CTL      0x01273 ; Timer Control
    68                                  
    69                                      %define DIV_LOW     0x04 ; 分周比 4 (1.2288MHz -> 307.2kHz)
    70                                      %define DIV_HIGH    0x00
    71                                  
    72                                      ; V53 ICU (1280Hに配置)
    73                                      %define ICU_REG0    0x01280
    74                                      %define ICU_REG1    0x01281
    75                                      
    76                                      ;-----------------------------------------
    77                                      ; V53 VME Board ペリフェラル
    78                                      ;-----------------------------------------
    79                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    80                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    81                                  
    82                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
    83                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
    84                                  %endif
    85                                  
    86                                  section .text
    87                                  
    88                                  start:
    89                                  %ifdef SIM
    90                                      xor ax, ax
    91                                      mov es, ax
    92                                  %else
    93 00000000 FA                          cli             ; 初期化中は割り込み禁止
    94                                  
    95                                      ; --- 【重要】スタックの初期化 ---
    96                                      ; 現在のセグメント (CS=2000h) の末尾 (FFFEh) にスタックを移動させます。
    97                                      ; これでコード領域との衝突を回避します。
    98 00000001 8CC8                        mov ax, cs
    99 00000003 8ED0                        mov ss, ax
   100 00000005 BCFEFF                      mov sp, 0xFFFE
   101                                      ; ------------------------------
   102                                  
   103                                      ;==============================================
   104                                      ; ABORT (NMI) Handler Setup 
   105                                      ;==============================================
   106                                  Init_NMI:
   107                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   108 00000008 31C0                        xor  ax, ax
   109 0000000A 8EC0                        mov  es, ax          ; ES = 0000h
   110                                      
   111 0000000C BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   112 0000000F B8[1E04]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   113 00000012 AB                          stosw                ; [0000:0008] = AX
   114 00000013 8CC8                        mov  ax, cs          ; 現在のCS
   115 00000015 AB                          stosw                ; [0000:000A] = CS
   116                                  
   117                                      ; Tick用割り込みベクタテーブル (Vector 27h = V53 INTP7)
   118                                      ; 0x27 * 4 = 9Ch
   119 00000016 BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   120 00000019 B8[7F04]                    mov  ax, _tick_handler ; ハンドラのアドレス (IP)
   121 0000001C AB                          stosw                ; [0000:009c] = AX
   122 0000001D 8CC8                        mov  ax, cs          ; 現在のCS
   123 0000001F AB                          stosw                ; [0000:009e] = CS
   124                                  
   125                                      ; ---------------------------------------------
   126                                      ; 1. セグメントレジスタ初期化
   127                                      ; CS=DS=ES を想定
   128                                      ; ---------------------------------------------
   129 00000020 0E                          push cs
   130 00000021 1F                          pop ds
   131 00000022 0E                          push cs
   132 00000023 07                          pop es
   133                                      ; スタックは簡易モニタのものをそのまま使う
   134                                  
   135                                      ;------------------------------------------
   136                                      ; TCUの追加設定
   137                                      ;------------------------------------------
   138                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   139                                      ;------------------------------------------
   140 00000024 BAFDFF                      mov  dx, OPSEL
   141 00000027 EC                          in   al, dx
   142 00000028 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   143 0000002A EE                          out  dx, al
   144                                  
   145                                      ;------------------------------------------
   146                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   147                                      ;------------------------------------------
   148 0000002B BAF9FF                      mov dx, TULA
   149 0000002E B070                        mov al, 0x70    ; 下位アドレス
   150 00000030 EE                          out dx, al
   151                                  
   152                                      ;------------------------------------------
   153                                      ; 3. TCKS: タイマクロック入力選択
   154                                      ;------------------------------------------
   155 00000031 BAF0FF                      mov  dx, TCKS
   156 00000034 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   157 00000036 EE                          out  dx, al
   158                                  
   159                                      ;------------------------------------------
   160                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   161                                      ;------------------------------------------
   162 00000037 BA7312                      mov  dx, TM_CTL
   163                                  
   164                                      ; --- Timer 0 Setup ---
   165 0000003A B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   166 0000003C EE                          out  dx, al
   167                                      
   168                                      ; --- Timer 1 Setup ---
   169 0000003D B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   170 0000003F EE                          out  dx, al
   171                                  
   172                                      ; --- Timer 2 Setup ---
   173 00000040 B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   174 00000042 EE                          out  dx, al
   175                                  
   176                                      ;------------------------------------------
   177                                      ; 4. カウンタ値 (分周比) のロード
   178                                      ;------------------------------------------
   179                                      ; Timer 0 (INTP0) 100Hz
   180 00000043 BA7012                      mov  dx, TM0_CNT
   181 00000046 B000                        mov  al, 0
   182 00000048 EE                          out  dx, al
   183 00000049 B030                        mov  al, 0x30
   184 0000004B EE                          out  dx, al
   185                                  
   186                                      ; Timer 1 (INTP2) 100Hz
   187 0000004C BA7112                      mov  dx, TM1_CNT
   188 0000004F B000                        mov  al, 0
   189 00000051 EE                          out  dx, al
   190 00000052 B030                        mov  al, 0x30
   191 00000054 EE                          out  dx, al
   192                                  
   193                                      ; Timer 2 (USART Tx/RxCLK)
   194 00000055 BA7212                      mov  dx, TM2_CNT
   195 00000058 B004                        mov  al, DIV_LOW
   196 0000005A EE                          out  dx, al
   197 0000005B B000                        mov  al, DIV_HIGH
   198 0000005D EE                          out  dx, al
   199                                  
   200                                      ;------------------------------------------
   201                                      ; μPD71051 (USART) 初期化
   202                                      ;------------------------------------------
   203 0000005E B000                        mov al, 0
   204 00000060 E6DA                        out USART_CMD, al
   205                                   
   206 00000062 F7E1                        mul cx              ; wait
   207 00000064 F7E1                        mul cx              ; wait
   208 00000066 E6DA                        out USART_CMD, al
   209                                   
   210 00000068 F7E1                        mul cx              ; wait
   211 0000006A F7E1                        mul cx              ; wait
   212 0000006C E6DA                        out USART_CMD, al
   213                                   
   214 0000006E F7E1                        mul cx              ; wait
   215 00000070 F7E1                        mul cx              ; wait
   216 00000072 B040                        mov al, 0x40        ; reset
   217 00000074 E6DA                        out USART_CMD, al
   218                                   
   219 00000076 F7E1                        mul cx              ; wait
   220 00000078 F7E1                        mul cx              ; wait
   221 0000007A B04E                        mov al, 0x4e        ; set mode
   222 0000007C E6DA                        out USART_CMD, al
   223                                   
   224 0000007E F7E1                        mul cx              ; wait
   225 00000080 F7E1                        mul cx              ; wait
   226 00000082 B037                        mov al, 0x37        ; rx,tx ready
   227 00000084 E6DA                        out USART_CMD, al
   228                                  
   229                                      ;------------------------------------------
   230                                      ; μPD71059 (PIC) 初期化
   231                                      ;------------------------------------------
   232 00000086 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   233 00000088 E6C8                        out PIC_REG0, al
   234                                  
   235 0000008A B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   236 0000008C E6CA                        out PIC_REG1, al
   237                                                      ; ICW3 is skipped in Single Mode
   238 0000008E B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   239 00000090 E6CA                        out PIC_REG1, al
   240                                  
   241 00000092 B0FE                        mov al, 0FEh     ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   242 00000094 E6CA                        out PIC_REG1, al
   243                                  
   244                                      ;------------------------------------------
   245                                      ; ICUの追加設定
   246                                      ;------------------------------------------
   247                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   248                                      ;------------------------------------------
   249 00000096 BAFDFF                      mov  dx, OPSEL
   250 00000099 EC                          in   al, dx
   251 0000009A 0C02                        or   al, 00000010b   ; Bit 1 (ICU) をセット
   252 0000009C EE                          out  dx, al
   253                                  
   254                                      ;------------------------------------------
   255                                      ; 2. レジスタ配置アドレスの設定 (IULA)
   256                                      ;------------------------------------------
   257 0000009D BAFAFF                      mov dx, IULA
   258 000000A0 B080                        mov al, 0x80    ; 下位アドレス
   259 000000A2 EE                          out dx, al
   260                                  
   261                                      ;------------------------------------------
   262                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   263                                      ;------------------------------------------
   264 000000A3 BA8012                      mov dx, ICU_REG0
   265 000000A6 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   266 000000A8 EE                          out dx, al
   267                                  
   268 000000A9 BA8112                      mov dx, ICU_REG1
   269 000000AC B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   270 000000AE EE                          out dx, al
   271                                                      ; ICW3 is skipped in Single Mode
   272 000000AF B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   273 000000B1 EE                          out dx, al
   274                                  
   275                                      ; Bit 7 (INTP7) を 0 (許可) にします。
   276 000000B2 EC                          in  al, dx
   277 000000B3 247F                        and al, 7Fh     ; 0111 1111 (Bit 7をクリア)
   278 000000B5 EE                          out dx, al
   279                                  
   280                                      ;-------------------------------------------
   281                                      ; 割り込み許可
   282                                      ;-------------------------------------------
   283 000000B6 FB                          sti
   284                                  
   285                                   %endif
   286                                  
   287                                      ; 変数初期化 (RAMエリアをクリア)
   288 000000B7 C706[EB05]0000              mov word [dump_seg], 0x0000
   289 000000BD C706[ED05]0000              mov word [dump_off], 0x0000
   290 000000C3 C706[EF05]0020              mov word [load_seg], 0x2000
   291                                  
   292                                      ; スタートメッセージの表示
   293 000000C9 BE[9004]                    mov si, msg_boot
   294 000000CC E89502                      call puts
   295                                  
   296                                  ; =================================================================
   297                                  ; Main Loop
   298                                  ; =================================================================
   299                                  monitor_loop:
   300 000000CF B03E                        mov al, '>'
   301 000000D1 E89E02                      call putc
   302 000000D4 B020                        mov al, ' '
   303 000000D6 E89902                      call putc
   304                                  
   305 000000D9 E8B802                      call getc_echo  ; コマンド受信（エコーあり）
   306 000000DC 88C3                        mov bl, al
   307                                      
   308 000000DE 80FB64                      cmp bl, 'd'     ; dump command
   309 000000E1 746B                        je do_dump
   310 000000E3 80FB44                      cmp bl, 'D'
   311 000000E6 7466                        je do_dump
   312                                      
   313 000000E8 80FB6C                      cmp bl, 'l'     ; load command
   314 000000EB 7503E9C100                  je do_load
   315 000000F0 80FB4C                      cmp bl, 'L'
   316 000000F3 7503E9B900                  je do_load
   317                                      
   318 000000F8 80FB67                      cmp bl, 'g'     ; go command
   319 000000FB 7503E92C01                  je do_go
   320 00000100 80FB47                      cmp bl, 'G'
   321 00000103 7503E92401                  je do_go
   322                                  
   323 00000108 80FB77                      cmp bl, 'w'     ; Write command
   324 0000010B 7503E94801                  je do_write
   325 00000110 80FB57                      cmp bl, 'W'
   326 00000113 7503E94001                  je do_write
   327                                  
   328 00000118 3C69                        cmp al, 'i'     ; Input Port command
   329 0000011A 7503E97C01                  je do_in
   330 0000011F 3C49                        cmp al, 'I'
   331 00000121 7503E97501                  je do_in
   332                                  
   333 00000126 3C6F                        cmp al, 'o'     ; Output Port command
   334 00000128 7503E99201                  je do_out
   335 0000012D 3C4F                        cmp al, 'O'
   336 0000012F 7503E98B01                  je do_out
   337                                  
   338 00000134 3C73                        cmp al, 's'     ; Scan I/O command
   339 00000136 7503E9AB01                  je do_scan
   340 0000013B 3C53                        cmp al, 'S'
   341 0000013D 7503E9A401                  je do_scan
   342                                      
   343 00000142 3C3F                        cmp al, '?'     ; Help
   344 00000144 7503E90F02                  je cmd_help
   345                                  
   346                                      ; 知らないコマンドなら改行して戻る
   347 00000149 E85102                      call putc_crlf
   348 0000014C EB81                        jmp monitor_loop
   349                                  
   350                                  ; =================================================================
   351                                  ; Command: Dump Memory
   352                                  ; Usage:
   353                                  ;   D               -> Dump next 64 bytes
   354                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   355                                  ; =================================================================
   356                                  do_dump:
   357 0000014E E84302                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   358 00000151 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   359 00000153 7418                        je .dump_run
   360 00000155 3C20                        cmp al, ' '         ; Spaceなら引数解析
   361 00000157 7405                        je .parse_args
   362                                      
   363                                      ; それ以外なら無視して実行へ（またはエラー処理）
   364 00000159 E84102                      call putc_crlf
   365 0000015C EB12                        jmp .dump_run_start
   366                                  
   367                                  .parse_args:
   368 0000015E E86A02                      call get_hex_word
   369 00000161 A3[EB05]                    mov [dump_seg], ax
   370 00000164 E8AA02                      call skip_space
   371 00000167 E86102                      call get_hex_word
   372 0000016A A3[ED05]                    mov [dump_off], ax
   373                                      ; ここでEnter待ちをするか、そのまま実行するか
   374                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   375                                      
   376                                  .dump_run:
   377 0000016D E82D02                      call putc_crlf              ; 実行直前に改行
   378                                  
   379                                  .dump_run_start:
   380 00000170 B90400                      mov cx, 4                   ; 4行表示する
   381                                      
   382                                  .line_loop:
   383 00000173 51                          push cx
   384                                      
   385 00000174 A1[EB05]                    mov ax, [dump_seg]          ; セグメントの表示
   386 00000177 E82C02                      call print_hex_word
   387 0000017A B03A                        mov al, ':'                 ; 区切り文字の:を表示
   388 0000017C E8F301                      call putc
   389 0000017F A1[ED05]                    mov ax, [dump_off]          ; オフセットの表示
   390 00000182 E82102                      call print_hex_word
   391 00000185 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   392 00000187 E8E801                      call putc
   393                                  
   394 0000018A 8B36[ED05]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   395                                  
   396 0000018E 1E                          push ds                     ; モニタのDSを保存
   397 0000018F 8E1E[EB05]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   398                                      
   399 00000193 B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   400                                  .hex_loop:
   401 00000196 8A04                        mov al, [si]
   402 00000198 E81202                      call print_hex_byte         ; メモリ内容の表示
   403 0000019B B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   404 0000019D E8D201                      call putc
   405 000001A0 46                          inc si                      ; 次のアドレスにする
   406 000001A1 E2F3                        loop .hex_loop              ; 16回繰り返し    
   407                                  
   408 000001A3 1F                          pop ds                      ; DSをモニタ用に戻す
   409                                  
   410 000001A4 8936[ED05]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   411                                  
   412 000001A8 E8F201                      call putc_crlf              ; 改行する
   413 000001AB 59                          pop cx
   414 000001AC E2C5                        loop .line_loop             ; 4回繰り返す
   415                                      
   416 000001AE E91EFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   417                                  
   418                                  ; =================================================================
   419                                  ; Command: Load Intel HEX
   420                                  ; Usage:
   421                                  ;   L           -> Load to default segment (load_seg)
   422                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   423                                  ; =================================================================
   424                                  do_load:
   425                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   426 000001B1 A1[EF05]                    mov ax, [load_seg]
   427 000001B4 06                          push es             ; RAM用ESを保存
   428 000001B5 50                          push ax             ; デフォルトセグメントを保存
   429                                      
   430 000001B6 E8DB01                      call getc_echo
   431 000001B9 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   432 000001BB 7402                        je .parse_seg
   433 000001BD EB05                        jmp .start_load
   434                                  
   435                                  .parse_seg:
   436 000001BF 58                          pop ax              ; 不要になったデフォルトを捨てる
   437 000001C0 E80802                      call get_hex_word   ; 新しいセグメント取得
   438 000001C3 50                          push ax             ; 保存
   439                                  
   440                                  .start_load:
   441 000001C4 E8D601                      call putc_crlf      ; メッセージ表示前に改行
   442 000001C7 BE[BC04]                    mov si, msg_load    ; ロード開始メッセージを表示
   443 000001CA E89701                      call puts
   444                                      
   445 000001CD 58                          pop ax
   446 000001CE 8EC0                        mov es, ax          ; ロード先をESに設定
   447                                      
   448                                      ; ターゲット表示
   449 000001D0 E8D301                      call print_hex_word ; ESの値を表示
   450 000001D3 B03A                        mov al, ':'         ; 区切り文字を表示
   451 000001D5 E89A01                      call putc
   452 000001D8 B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   453 000001DA E89501                      call putc
   454 000001DD E8BD01                      call putc_crlf
   455                                  
   456                                  .wait_record:
   457 000001E0 E8A201                      call getc           ; 開始文字を待つ
   458 000001E3 3C3A                        cmp al, ':'
   459 000001E5 75F9                        jne .wait_record
   460                                  
   461 000001E7 E80602                      call get_hex_byte   ; データ長を読み込み
   462 000001EA 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   463 000001EC B500                        mov ch, 0
   464                                      
   465 000001EE E8FF01                      call get_hex_byte   ; 上位アドレスを読み込み
   466 000001F1 88C7                        mov bh, al
   467 000001F3 E8FA01                      call get_hex_byte   ; 下位アドレスを読み込み
   468 000001F6 88C3                        mov bl, al
   469                                      
   470 000001F8 E8F501                      call get_hex_byte   ; レコードタイプを読み込み
   471 000001FB 3C01                        cmp al, 01          ; End of File?
   472 000001FD 7419                        je .handle_eof      ; EOFの処理へ
   473 000001FF 3C00                        cmp al, 00          ; Data Record?
   474 00000201 751A                        jne .skip_line      ; その他はスキップ
   475                                      
   476 00000203 E309                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   477                                      
   478                                  .data_loop:
   479 00000205 E8E801                      call get_hex_byte   ; 1バイト読み取り
   480 00000208 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   481 0000020B 43                          inc bx              ; 次のアドレスにする
   482 0000020C E2F7                        loop .data_loop     ; データ長分繰り返す
   483                                      
   484                                  .read_chk:
   485 0000020E E8DF01                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   486 00000211 B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   487 00000213 E85C01                      call putc
   488 00000216 EBC8                        jmp .wait_record    ; 次のレコード読み取りへ
   489                                  
   490                                  .handle_eof:            ; EOFの場合
   491 00000218 E8D501                      call get_hex_byte   ; チェックサムを読み飛ばす
   492 0000021B EB02                        jmp .finish         ; 読み込み終了処理へ
   493                                  
   494                                  .skip_line:
   495 0000021D EBC1                        jmp .wait_record    ; 次のレコード読み込みへ
   496                                  
   497                                  .finish:
   498 0000021F 07                          pop es              ; RAM用ESを復帰
   499 00000220 E87A01                      call putc_crlf
   500 00000223 BE[C804]                    mov si, msg_ok      ; "OK"を表示
   501 00000226 E83B01                      call puts
   502 00000229 E9A3FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   503                                  
   504                                  ; =================================================================
   505                                  ; Command: Execute
   506                                  ; Usage:
   507                                  ;   G <Seg> <Off>
   508                                  ; Example: G 1000 0000
   509                                  ; =================================================================
   510                                  do_go:
   511                                      ; Gコマンドは入力後に改行
   512                                      
   513 0000022C E86501                      call getc_echo      ; Space?
   514 0000022F 3C20                        cmp al, ' '
   515 00000231 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   516                                      
   517                                      ; 1. セグメント (SSSS) を取得
   518 00000233 E89501                      call get_hex_word   ; AX = Segment
   519 00000236 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   520 00000237 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   521                                      
   522                                      ; スペース読み飛ばし (もしあれば)
   523 00000239 E8D501                      call skip_space
   524                                      
   525                                      ; 2. オフセット (OOOO) を取得
   526 0000023C E88C01                      call get_hex_word   ; AX = Offset
   527 0000023F 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   528                                      
   529 00000240 E85A01                      call putc_crlf      ; 実行前に改行
   530 00000243 BE[CB04]                    mov si, msg_go
   531 00000246 E81B01                      call puts
   532 00000249 E85101                      call putc_crlf
   533                                      
   534                                      ; 3. 実行環境のセットアップ
   535                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   536 0000024C 8EDB                        mov ds, bx
   537 0000024E 8EC3                        mov es, bx
   538                                  
   539                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   540 00000250 FA                          cli
   541                                  
   542                                      ; 4. ジャンプ！ (Far Return)
   543                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   544 00000251 CB                          retf                ; Jump!
   545                                  
   546                                  .go_default:
   547 00000252 E84801                      call putc_crlf      ; 改行して
   548 00000255 E977FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   549                                  
   550                                  ; ==============================================================
   551                                  ; Command: Write Memory
   552                                  ; Usage:
   553                                  ;   W <Seg> <Off> <Val>
   554                                  ; ==============================================================
   555                                  do_write:    
   556 00000258 E83901                      call getc_echo      ; Space?
   557 0000025B 3C20                        cmp al, ' '
   558 0000025D 7403E9B301                  jne error           ; 引数なしならリターン(またはエラー)
   559                                  
   560                                      ; 1. セグメント (SSSS) を取得
   561 00000262 E86601                      call get_hex_word   ; AX = Segment
   562 00000265 50                          push ax             ; ターゲットセグメントを保存
   563                                      
   564 00000266 E82B01                      call getc_echo      ; Space?
   565 00000269 3C20                        cmp al, ' '
   566 0000026B 7403E9A501                  jne error           ; 引数なしならリターン(またはエラー)
   567                                      
   568                                      ; 2. オフセット (OOOO) を取得
   569 00000270 E85801                      call get_hex_word   ; AX = Offset
   570 00000273 50                          push ax             ; ターゲットオフセットを保存
   571                                  
   572 00000274 E81D01                      call getc_echo      ; Space?
   573 00000277 3C20                        cmp al, ' '
   574 00000279 7403E99701                  jne error           ; 引数なしならリターン(またはエラー)
   575                                  
   576                                      ; 3. 設定データ (VV) を取得
   577 0000027E E85901                      call get_hex_byte_echo   ; AL = Value
   578                                  
   579 00000281 5B                          pop bx              ; bx = Offset
   580 00000282 5A                          pop dx              ; dx = Target Segment
   581                                  
   582                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   583 00000283 8916[EB05]                  mov [dump_seg], dx
   584 00000287 891E[ED05]                  mov [dump_off], bx
   585                                      
   586 0000028B 8EDA                        mov ds, dx          ; DS再設定
   587 0000028D 3E8807                      mov [ds:bx], al     ; 書き込み！
   588                                      
   589 00000290 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   590 00000291 1F                          pop ds
   591                                  
   592 00000292 BE[EE04]                    mov si, msg_done
   593 00000295 E8CC00                      call puts
   594 00000298 E934FE                      jmp monitor_loop
   595                                  
   596                                  ; ==============================================================
   597                                  ; Command: Input from Port
   598                                  ; Usage:
   599                                  ;   I <Port>
   600                                  ; ==============================================================
   601                                  do_in:
   602 0000029B E8F600                      call getc_echo
   603 0000029E 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   604 000002A0 7403E97001                  jne error           ; パラメタが無い場合はエラー処理へ
   605                                  
   606 000002A5 E82301                      call get_hex_word   ; ポートアドレスを取得
   607 000002A8 89C2                        mov dx, ax          ; 保存
   608 000002AA EC                          in al, dx           ; I/O Read
   609                                      
   610 000002AB 50                          push ax
   611 000002AC E8EE00                      call putc_crlf      ; メッセージ表示前に改行
   612 000002AF BE[E804]                    mov si, msg_in_res
   613 000002B2 E8AF00                      call puts
   614 000002B5 58                          pop ax
   615                                  
   616 000002B6 E8F400                      call print_hex_byte ; 値を表示
   617                                  
   618 000002B9 E8E100                      call putc_crlf      ; 改行して
   619 000002BC E910FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   620                                  
   621                                  ; ==============================================================
   622                                  ; Command: Output to Port
   623                                  ; Usage
   624                                  ;   O <Port> <Val>
   625                                  ; ==============================================================
   626                                  do_out:
   627 000002BF E8D200                      call getc_echo
   628 000002C2 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   629 000002C4 7403E94C01                  jne error           ; パラメタが無い場合はエラー処理へ
   630                                  
   631 000002C9 E8FF00                      call get_hex_word   ; ポートアドレスを取得
   632 000002CC 50                          push ax             ; スタックに積む
   633                                  
   634 000002CD E8C400                      call getc_echo
   635 000002D0 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   636 000002D2 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   637                                      
   638 000002D4 E80301                      call get_hex_byte_echo   ; 出力値を取得
   639 000002D7 5A                          pop dx              ; スタックからDXにセット
   640                                      
   641 000002D8 EE                          out dx, al          ; I/O Write
   642                                      
   643 000002D9 BE[EE04]                    mov si, msg_done    ; DONEを表示。改行付き。
   644 000002DC E88500                      call puts
   645 000002DF E9EDFD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   646                                  
   647                                  error_pop:
   648 000002E2 58                          pop ax              ; 使わなかったスタックを捨てる
   649 000002E3 E92F01                      jmp error
   650                                  
   651                                  ; ==============================================================
   652                                  ; Command: Scan I/O Ports
   653                                  ; Usage:
   654                                  ;   S <Start_port> <End_port>
   655                                  ; Description: Reads ports and prints if value is NOT 0xFF
   656                                  ; ==============================================================
   657                                  do_scan:
   658 000002E6 E8AB00                      call getc_echo
   659 000002E9 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   660 000002EB 7403E92501                  jne error           ; パラメタが無い場合はエラー処理へ
   661                                  
   662 000002F0 E8D800                      call get_hex_word   ; スタートポートアドレスを取得
   663 000002F3 89C3                        mov bx, ax          ; BX = Start Address
   664                                      
   665 000002F5 E89C00                      call getc_echo
   666 000002F8 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   667 000002FA 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   668                                  
   669 000002FC E8CC00                      call get_hex_word   ; エンドポートアドレスを取得
   670 000002FF 89C1                        mov cx, ax          ; CX = End Address
   671                                  
   672 00000301 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   673 00000303 7603E90D01                  ja error
   674                                  
   675 00000308 E89200                      call putc_crlf
   676 0000030B BE[7405]                    mov si, msg_scan_start
   677 0000030E E85300                      call puts
   678                                  
   679                                  .scan_loop:
   680 00000311 89DA                        mov dx, bx          ; DXにポートアドレス設定
   681 00000313 EC                          in al, dx           ; I/O Read
   682                                  
   683 00000314 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   684 00000316 741D                        je .next_port
   685                                  
   686 00000318 50                          push ax             ; Readした値をスタックに保存
   687                                  
   688                                      ; --- 有効な値が見つかった場合の表示 ---
   689                                      ; [Port]: Value
   690 00000319 89D8                        mov ax, bx
   691 0000031B E88800                      call print_hex_word ; ポートアドレスの表示
   692 0000031E B03A                        mov al, ':'
   693 00000320 E84F00                      call putc
   694 00000323 B020                        mov al, ' '
   695 00000325 E84A00                      call putc
   696                                      
   697 00000328 58                          pop ax
   698 00000329 E88100                      call print_hex_byte ; Readした値の表示
   699                                      
   700 0000032C BE[9F05]                    mov si, msg_space   ; "  "
   701 0000032F E83200                      call puts
   702                                  
   703                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   704                                      ; ここでは単純にリスト形式で改行します
   705 00000332 E86800                      call putc_crlf
   706                                  
   707                                  .next_port:
   708 00000335 43                          inc bx              ; 次のアドレスへ
   709                                      
   710                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   711 00000336 BA6112                      mov dx, SCU_SST
   712 00000339 EC                          in al, dx
   713 0000033A A802                        test al, RX_READY   ; RxRDY?
   714 0000033C 750D                        jnz .abort          ; 何かキーが押されたら中断
   715                                  
   716 0000033E 39CB                        cmp bx, cx
   717 00000340 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   718                                  
   719 00000342 BE[EE04]                    mov si, msg_done
   720 00000345 E81C00                      call puts
   721 00000348 E984FD                      jmp monitor_loop
   722                                  
   723                                  .abort:
   724                                      ; 入力バッファを空読みしておく
   725 0000034B BA6012                      mov dx, SCU_DATA
   726 0000034E EC                          in al, dx
   727 0000034F BE[A205]                    mov si, msg_abort
   728 00000352 E80F00                      call puts
   729 00000355 E977FD                      jmp monitor_loop
   730                                  
   731                                  ; ==============================================================
   732                                  ; Command: Help
   733                                  ; ==============================================================
   734                                  cmd_help:
   735 00000358 E84200                      call putc_crlf
   736 0000035B BE[F904]                    mov si, msg_help
   737 0000035E E80300                      call puts
   738 00000361 E96BFD                      jmp monitor_loop
   739                                  
   740                                  ; =================================================================
   741                                  ; Utilities
   742                                  ; =================================================================
   743                                  
   744                                  ; 文字列出力
   745                                  puts:
   746 00000364 2E8A04                      mov al, [cs:si]
   747 00000367 08C0                        or al, al
   748 00000369 7406                        jz .ret
   749 0000036B E80400                      call putc
   750 0000036E 46                          inc si
   751 0000036F EBF3                        jmp puts
   752 00000371 C3                      .ret: ret
   753                                  
   754                                  ; 1文字出力
   755                                  putc:
   756 00000372 52                          push dx
   757 00000373 50                          push ax
   758 00000374 BA6112                      mov dx, SCU_SST
   759 00000377 EC                      .w: in al, dx
   760 00000378 A801                        test al, TX_READY  ; TX Ready?
   761 0000037A 74FB                        jz .w
   762 0000037C BA6012                      mov dx, SCU_DATA
   763 0000037F 58                          pop ax
   764 00000380 50                          push ax
   765 00000381 EE                          out dx, al
   766 00000382 58                          pop ax
   767 00000383 5A                          pop dx
   768 00000384 C3                          ret
   769                                  
   770                                  ; 1文字入力
   771                                  getc:
   772 00000385 52                          push dx
   773 00000386 BA6112                      mov dx, SCU_SST
   774 00000389 EC                      .w: in al, dx
   775 0000038A A802                        test al, RX_READY  ; RX Ready?
   776 0000038C 74FB                        jz .w
   777 0000038E BA6012                      mov dx, SCU_DATA
   778 00000391 EC                          in al, dx
   779 00000392 5A                          pop dx
   780 00000393 C3                          ret
   781                                  
   782                                  ; 1文字入力　エコーバックあり
   783                                  getc_echo:
   784 00000394 E8EEFF                      call getc
   785 00000397 50                          push ax
   786 00000398 E8D7FF                      call putc
   787 0000039B 58                          pop ax
   788 0000039C C3                          ret
   789                                  
   790                                  ; 改行出力
   791                                  putc_crlf:
   792 0000039D B00D                        mov al, 0x0D
   793 0000039F E8D0FF                      call putc
   794 000003A2 B00A                        mov al, 0x0A
   795 000003A4 EBCC                        jmp putc
   796                                  
   797                                  ; -----------------------------------------------------------------
   798                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   799                                  ; Input: AX
   800                                  ; -----------------------------------------------------------------
   801                                  print_hex_word:
   802 000003A6 50                          push ax
   803 000003A7 88E0                        mov al, ah
   804 000003A9 E80100                      call print_hex_byte
   805 000003AC 58                          pop ax
   806                                  
   807                                  ; -----------------------------------------------------------------
   808                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   809                                  ; Input: AL
   810                                  ; -----------------------------------------------------------------
   811                                  print_hex_byte:
   812 000003AD 50                          push ax
   813 000003AE 51                          push cx
   814                                  
   815                                      ; 上位バイトの表示
   816 000003AF 50                          push ax
   817 000003B0 C0E804                      shr al, 4
   818 000003B3 E80900                      call .digit
   819                                  
   820                                      ; 下位バイトの表示
   821 000003B6 58                          pop ax
   822 000003B7 240F                        and al, 0x0F
   823 000003B9 E80300                      call .digit
   824                                  
   825 000003BC 59                          pop cx
   826 000003BD 58                          pop ax
   827 000003BE C3                          ret
   828                                  
   829                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   830                                  .digit:
   831 000003BF 0430                        add al, '0'
   832 000003C1 3C39                        cmp al, '9'
   833 000003C3 7602                        jbe .p
   834 000003C5 0407                        add al, 7
   835 000003C7 E8A8FF                  .p: call putc
   836 000003CA C3                          ret
   837                                  
   838                                  ; -----------------------------------------------------------------
   839                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   840                                  ; Input:  Serial (例: "1", "0", "0", "0")
   841                                  ; Output: AX = 0x1000
   842                                  ; -----------------------------------------------------------------
   843                                  get_hex_word:
   844 000003CB 53                          push bx
   845 000003CC E80B00                      call get_hex_byte_echo
   846 000003CF 88C7                        mov bh, al
   847 000003D1 E80600                      call get_hex_byte_echo
   848 000003D4 88C3                        mov bl, al
   849 000003D6 89D8                        mov ax, bx
   850 000003D8 5B                          pop bx
   851 000003D9 C3                          ret
   852                                  
   853                                  ; 16進数2桁入力　エコーバック有り
   854                                  get_hex_byte_echo:
   855 000003DA 53                          push bx
   856 000003DB E8B6FF                      call getc_echo
   857 000003DE E82500                      call hex_char_to_bin
   858 000003E1 C0E004                      shl al, 4
   859 000003E4 88C3                        mov bl, al
   860 000003E6 E8ABFF                      call getc_echo
   861 000003E9 E81A00                      call hex_char_to_bin
   862 000003EC 08D8                        or al, bl
   863 000003EE 5B                          pop bx
   864 000003EF C3                          ret
   865                                  
   866                                  ; -----------------------------------------------------------------
   867                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   868                                  ; Input:  Serial (例: "3", "F")
   869                                  ; Output: AL = 0x3F
   870                                  ; -----------------------------------------------------------------
   871                                  get_hex_byte:
   872 000003F0 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   873                                  
   874                                      ; 上位4bit
   875 000003F1 E891FF                      call getc
   876 000003F4 E80F00                      call hex_char_to_bin
   877 000003F7 C0E004                      shl al, 4
   878 000003FA 88C3                        mov bl, al          ; 一時保存
   879                                      
   880                                      ; 下位4bit
   881 000003FC E886FF                      call getc
   882 000003FF E80400                      call hex_char_to_bin
   883 00000402 08D8                        or al, bl           ; 上位を合成して結果はALへ
   884 00000404 5B                          pop bx
   885 00000405 C3                          ret
   886                                  
   887                                  ; -----------------------------------------------------------------
   888                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   889                                  ; Input: AL (ASCII)
   890                                  ; Output: AL (Binary)
   891                                  ; -----------------------------------------------------------------
   892                                  hex_char_to_bin:
   893 00000406 2C30                        sub al, '0'
   894 00000408 3C09                        cmp al, 9
   895 0000040A 7604                        jbe .done
   896 0000040C 2C07                        sub al, 7           ; 'A'-'F'対応
   897 0000040E 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   898                                  .done:
   899 00000410 C3                          ret
   900                                  
   901                                  ; -----------------------------------------------------------------
   902                                  ; Helper: スペースなどを読み飛ばす
   903                                  ; -----------------------------------------------------------------
   904                                  skip_space:
   905 00000411 E880FF                      call getc_echo
   906 00000414 C3                          ret
   907                                  
   908                                  ; -----------------------------------------------------------------
   909                                  ; Helper: エラーメッセージ出力後モニタに戻る
   910                                  ; -----------------------------------------------------------------
   911                                  error:
   912 00000415 BE[D204]                    mov si, msg_error
   913 00000418 E849FF                      call puts
   914 0000041B E9B1FC                      jmp monitor_loop
   915                                  
   916                                  ;==========================================================
   917                                  ; NMI (ABORT) Handler
   918                                  ;==========================================================
   919                                  
   920                                  NMI_Handler:
   921                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
   922 0000041E 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
   923 0000041F 1E                          push ds
   924 00000420 06                          push es
   925                                  
   926                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   927 00000421 8CC8                        mov  ax, cs
   928 00000423 8ED8                        mov  ds, ax
   929 00000425 8EC0                        mov  es, ax
   930                                  
   931                                      ; 3. スタックフレームへのポインタ設定
   932 00000427 89E5                        mov  bp, sp
   933                                  
   934                                      ; --- 画面表示 ---
   935 00000429 BE[AD05]                    mov  si, msg_nmi
   936 0000042C E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
   937                                  
   938                                      ; 3. レジスタ表示 (スタックから読み出して表示)
   939                                      ; Stack Layout after pushes:
   940                                      ; BP+0: ES
   941                                      ; BP+2: DS
   942                                      ; BP+4: DI
   943                                      ; BP+6: SI
   944                                      ; BP+8: BP (Old)
   945                                      ; BP+10: SP (Original)
   946                                      ; BP+12: BX
   947                                      ; BP+14: DX
   948                                      ; BP+16: CX
   949                                      ; BP+18: AX
   950                                      ; BP+20: IP (Return Addr)
   951                                      ; BP+22: CS (Return Addr)
   952                                      ; BP+24: Flags
   953                                      
   954                                      ; AX
   955 0000042F BE[C505]                    mov  si, msg_ax
   956 00000432 E82FFF                      call puts
   957 00000435 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
   958 00000438 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
   959                                  
   960                                      ; BX
   961 0000043B BE[CA05]                    mov  si, msg_bx
   962 0000043E E823FF                      call puts
   963 00000441 8B460C                      mov  ax, [bp+12]
   964 00000444 E85FFF                      call print_hex_word
   965                                  
   966                                      ; CX
   967 00000447 BE[CF05]                    mov  si, msg_cx
   968 0000044A E817FF                      call puts
   969 0000044D 8B4610                      mov  ax, [bp+16]
   970 00000450 E853FF                      call print_hex_word
   971                                  
   972                                      ; DX
   973 00000453 BE[D405]                    mov  si, msg_dx
   974 00000456 E80BFF                      call puts
   975 00000459 8B460E                      mov  ax, [bp+14]
   976 0000045C E847FF                      call print_hex_word
   977                                  
   978 0000045F E83BFF                      call putc_crlf
   979                                  
   980                                      ; --- 中断地点 (CS:IP) の表示 ---
   981                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
   982                                      ; その上が割り込み発生時の IP, CS, Flags です
   983                                      
   984 00000462 BE[D905]                    mov  si, msg_addr
   985 00000465 E8FCFE                      call puts           ; " Stop at "
   986 00000468 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
   987 0000046B E838FF                      call print_hex_word
   988 0000046E B03A                        mov  al, ':'
   989 00000470 E8FFFE                      call putc
   990 00000473 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
   991 00000476 E82DFF                      call print_hex_word
   992                                  
   993 00000479 E821FF                      call putc_crlf
   994                                  
   995                                      ; 4. 復帰処理
   996                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
   997                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
   998 0000047C E981FB                      jmp  start  ; モニタの開始ラベルへ
   999                                  
  1000                                  ;==========================================================
  1001                                  ; Tick Handler
  1002                                  ;==========================================================
  1003                                  _tick_handler:
  1004 0000047F 50                          push ax
  1005 00000480 52                          push dx
  1006                                  
  1007                                      ; シリアルポートに'.'を出力
  1008 00000481 B02E                        mov al, '.'          ; debug char
  1009 00000483 E6D8                        out USART_DATA, al   ; USARTのDataポートに出力
  1010                                  
  1011                                      ; --- EOI (End of Interrupt) to PIC ---
  1012 00000485 B020                        mov al, 20h     ; Non-specific EOI
  1013                                  
  1014                                      ; 外部PIC (Slave) の割り込み完了
  1015 00000487 E6C8                        out PIC_REG0, al
  1016                                  
  1017                                      ; V53内蔵ICU (Master) の割り込み完了
  1018 00000489 BA8012                      mov dx, ICU_REG0 
  1019 0000048C EE                          out dx, al
  1020                                  
  1021 0000048D 5A                          pop dx
  1022 0000048E 58                          pop ax
  1023 0000048F CF                          iret
  1024                                  
