   771 0000037D 7403E98F01                  jne error           ; パラメタが無い場合はエラー処理へ
   772                                  
   773 00000382 E84201                      call get_hex_word   ; ポートアドレスを取得
   774 00000385 50                          push ax             ; スタックに積む
   775                                  
   776 00000386 E80701                      call getc_echo
   777 00000389 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   778 0000038B 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
