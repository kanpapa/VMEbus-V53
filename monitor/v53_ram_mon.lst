   751                                  ; ==============================================================
   752                                  ; Command: Scan I/O Ports
   753                                  ; Usage:
   754                                  ;   S <Start_port> <End_port>
   755                                  ; Description: Reads ports and prints if value is NOT 0xFF
   756                                  ; ==============================================================
   757                                  do_scan:
   758 000003BE E8EE00                      call getc_echo
   759 000003C1 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   760 000003C3 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   761                                  
   762 000003C8 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   763 000003CB 89C3                        mov bx, ax          ; BX = Start Address
   764                                      
   765 000003CD E8DF00                      call getc_echo
   766 000003D0 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   767 000003D2 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   768                                  
   769 000003D4 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   770 000003D7 89C1                        mov cx, ax          ; CX = End Address
   771                                  
   772 000003D9 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   773 000003DB 7603E95001                  ja error
   774                                  
   775 000003E0 E8D500                      call putc_crlf
   776 000003E3 BE[BD07]                    mov si, msg_scan_start
   777 000003E6 E89600                      call puts
   778                                  
   779                                  .scan_loop:
   780 000003E9 89DA                        mov dx, bx          ; DXにポートアドレス設定
   781 000003EB EC                          in al, dx           ; I/O Read
   782                                  
   783 000003EC 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   784 000003EE 741D                        je .next_port
   785                                  
   786 000003F0 50                          push ax             ; Readした値をスタックに保存
   787                                  
   788                                      ; --- 有効な値が見つかった場合の表示 ---
   789                                      ; [Port]: Value
   790 000003F1 89D8                        mov ax, bx
   791 000003F3 E8CB00                      call print_hex_word ; ポートアドレスの表示
   792 000003F6 B03A                        mov al, ':'
   793 000003F8 E89200                      call putc
   794 000003FB B020                        mov al, ' '
   795 000003FD E88D00                      call putc
   796                                      
   797 00000400 58                          pop ax
   798 00000401 E8C400                      call print_hex_byte ; Readした値の表示
   799                                      
   800 00000404 BE[E807]                    mov si, msg_space   ; "  "
   801 00000407 E87500                      call puts
   802                                  
   803                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   804                                      ; ここでは単純にリスト形式で改行します
   805 0000040A E8AB00                      call putc_crlf
   806                                  
   807                                  .next_port:
   808 0000040D 43                          inc bx              ; 次のアドレスへ
   809                                      
   810                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   811 0000040E BA61F0                      mov dx, SCU_SST
   812 00000411 EC                          in al, dx
   813 00000412 A802                        test al, RX_READY   ; RxRDY?
   814 00000414 750D                        jnz .abort          ; 何かキーが押されたら中断
   815                                  
   816 00000416 39CB                        cmp bx, cx
   817 00000418 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   818                                  
   819 0000041A BE[2E07]                    mov si, msg_done
   820 0000041D E85F00                      call puts
   821 00000420 E969FD                      jmp monitor_loop
   822                                  
   823                                  .abort:
