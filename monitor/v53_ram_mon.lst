     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.8 2026-02-01
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; 旧アドレス
    55                                      ; V53 SCU (1260Hに配置）
    56                                      ;%define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    57                                      ;%define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    58                                      ;%define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    59                                      ;%define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    60                                      ;%define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    61                                      ;%define TX_READY    00000001b   ; TBRDY                                 
    62                                      ;%define RX_READY    00000010b   ; RBRDY
    63                                  
    64                                      ; V53 TCU (1270Hに配置)
    65                                      ;%define TM0_CNT     0x01270 ; Timer 0 Counter
    66                                      ;%define TM1_CNT     0x01271 ; Timer 1 Counter
    67                                      ;%define TM2_CNT     0x01272 ; Timer 2 Counter
    68                                      ;%define TM_CTL      0x01273 ; Timer Control
    69                                  
    70                                      ; V53 ICU (1280Hに配置)
    71                                      ;%define ICU_REG0    0x01280
    72                                      ;%define ICU_REG1    0x01281
    73                                  
    74                                      ; 新アドレス
    75                                      ; V53 SCU (2060Hに配置）
    76                                      %define SCU_DATA    0x02060 ; 送受データ・レジスタ(R:SRB/W:STB)
    77                                      %define SCU_SST     0x02061 ; ステータス・レジスタ(R:SST)
    78                                      %define SCU_SCM     0x02061 ; コマンドレジスタ(W:SCM)
    79                                      %define SCU_SMD     0x02062 ; シリアルモード設定(W:SMD)
    80                                      %define SCU_SIMK    0x02063 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    81                                      %define TX_READY    00000001b   ; TBRDY                                 
    82                                      %define RX_READY    00000010b   ; RBRDY
    83                                  
    84                                      ; V53 TCU (2070Hに配置)
    85                                      %define TM0_CNT     0x02070 ; Timer 0 Counter
    86                                      %define TM1_CNT     0x02071 ; Timer 1 Counter
    87                                      %define TM2_CNT     0x02072 ; Timer 2 Counter
    88                                      %define TM_CTL      0x02073 ; Timer Control
    89                                  
    90                                      ; V53 ICU (2080Hに配置)
    91                                      %define ICU_REG0    0x02080
    92                                      %define ICU_REG1    0x02081
    93                                  
    94                                      ;-----------------------------------------
    95                                      ; V53 VME Board ペリフェラル
    96                                      ;-----------------------------------------
    97                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    98                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    99                                  
   100                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
   101                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
   102                                  
   103                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
   104                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
   105                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
   106                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
   107                                  %endif
   108                                  
   109                                  section .text
   110                                  
   111                                  start:
   112                                  %ifdef SIM
   113                                      xor ax, ax
   114                                      mov es, ax
   115                                  %else
   116 00000000 FA                          cli             ; 初期化中は割り込み禁止
   117                                  
   118                                      ; --- 【重要】スタックの初期化 ---
   119                                      ; 現在のセグメント (CS=2000h) の末尾 (FFFEh) にスタックを移動させます。
   120                                      ; これでコード領域との衝突を回避します。
   121 00000001 8CC8                        mov ax, cs
   122 00000003 8ED0                        mov ss, ax
   123 00000005 BCFEFF                      mov sp, 0xFFFE
   124                                      ; ------------------------------
   125                                  
   126                                      ;==============================================
   127                                      ; ABORT (NMI) Handler Setup 
   128                                      ;==============================================
   129                                  Init_NMI:
   130                                      ; ----------------------------------------------------
   131                                      ; 1. 全ベクタ (00h-FFh) をデフォルトハンドラで埋める
   132                                      ;    (予期せぬ割り込みによる暴走を防ぐ安全策)
   133                                      ; ----------------------------------------------------
   134 00000008 31C0                        xor ax, ax
   135 0000000A 8EC0                        mov es, ax          ; ES = 0000h (Vector Table)
   136 0000000C BF0000                      mov di, 0           ; Offset 0
   137                                  
   138 0000000F B90001                      mov cx, 256         ; 256個のベクタ全てを設定
   139                                  .init_loop:
   140 00000012 B8[F805]                    mov ax, _default_int_unknown_handler ; 共通トラップハンドラ
   141 00000015 AB                          stosw               ; Offset書き込み
   142 00000016 8CC8                        mov ax, cs
   143 00000018 AB                          stosw               ; Segment書き込み
   144 00000019 E2F7                        loop .init_loop
   145                                  
   146                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   147 0000001B 31C0                        xor  ax, ax
   148 0000001D 8EC0                        mov  es, ax          ; ES = 0000h
   149                                      
   150 0000001F BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   151 00000022 B8[CE04]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   152 00000025 AB                          stosw                ; [0000:0008] = AX
   153 00000026 8CC8                        mov  ax, cs          ; 現在のCS
   154 00000028 AB                          stosw                ; [0000:000A] = CS
   155                                  
   156                                      ; ICU割り込みベクタを上書き登録 (0x20 - 0x27)
   157                                      
   158                                      ; Vector 20h (ICU INTP0)
   159 00000029 BF8000                      mov  di, 0x0080      ; 0x20 * 4 = 80h
   160 0000002C B8[5D05]                    mov  ax, _isr_stub_20
   161 0000002F AB                          stosw
   162 00000030 8CC8                        mov  ax, cs
   163 00000032 AB                          stosw
   164                                  
   165                                      ; Vector 21h (ICU INTP1)
   166 00000033 BF8400                      mov  di, 0x0084
   167 00000036 B8[6105]                    mov  ax, _isr_stub_21
   168 00000039 AB                          stosw
   169 0000003A 8CC8                        mov  ax, cs
   170 0000003C AB                          stosw
   171                                  
   172                                      ; Vector 22h (ICU INTP2)
   173 0000003D BF8800                      mov  di, 0x0088
   174 00000040 B8[6505]                    mov  ax, _isr_stub_22
   175 00000043 AB                          stosw
   176 00000044 8CC8                        mov  ax, cs
   177 00000046 AB                          stosw
   178                                  
   179                                      ; Vector 23h (ICU INTP3)
   180 00000047 BF8C00                      mov  di, 0x008C
   181 0000004A B8[6905]                    mov  ax, _isr_stub_23
   182 0000004D AB                          stosw
   183 0000004E 8CC8                        mov  ax, cs
   184 00000050 AB                          stosw
   185                                  
   186                                      ; Vector 24h (ICU INTP4)
   187 00000051 BF9000                      mov  di, 0x0090
   188 00000054 B8[6D05]                    mov  ax, _isr_stub_24
   189 00000057 AB                          stosw
   190 00000058 8CC8                        mov  ax, cs
   191 0000005A AB                          stosw
   192                                  
   193                                      ; Vector 25h (ICU INTP5)
   194 0000005B BF9400                      mov  di, 0x0094
   195 0000005E B8[7105]                    mov  ax, _isr_stub_25
   196 00000061 AB                          stosw
   197 00000062 8CC8                        mov  ax, cs
   198 00000064 AB                          stosw
   199                                  
   200                                      ; Vector 26h (ICU INTP6)
   201 00000065 BF9800                      mov  di, 0x0098
   202 00000068 B8[7505]                    mov  ax, _isr_stub_26
   203 0000006B AB                          stosw
   204 0000006C 8CC8                        mov  ax, cs
   205 0000006E AB                          stosw
   206                                  
   207                                      ; Vector 27h (ICU INTP7 <-- PIC)
   208                                      ; PIC Dispatcher
   209 0000006F BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   210 00000072 B8[7905]                    mov  ax, _pic_dispatch_handler
   211 00000075 AB                          stosw                ; [0000:009c] = AX
   212 00000076 8CC8                        mov  ax, cs          ; 現在のCS
   213 00000078 AB                          stosw                ; [0000:009e] = CS
   214                                  
   215                                      ; ---------------------------------------------
   216                                      ; 1. セグメントレジスタ初期化
   217                                      ; CS=DS=ES を想定
   218                                      ; ---------------------------------------------
   219 00000079 0E                          push cs
   220 0000007A 1F                          pop ds
   221 0000007B 0E                          push cs
   222 0000007C 07                          pop es
   223                                      ; スタックは簡易モニタのものをそのまま使う
   224                                  
   225                                      ;------------------------------------------
   226                                      ; V53 内蔵ペリフェラルのIOアドレスを再設定
   227                                      ;------------------------------------------
   228 0000007D BAFCFF                      mov  dx, OPHA ; 内蔵ペリフェラル・リロケーション・レジスタ
   229 00000080 B020                        mov  al, 0x20 ; 0x20xxに配置
   230 00000082 EE                          out  dx, al
   231                                  
   232                                      ;------------------------------------------
   233                                      ; TCUの追加設定
   234                                      ;------------------------------------------
   235                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   236                                      ;------------------------------------------
   237 00000083 BAFDFF                      mov  dx, OPSEL
   238 00000086 EC                          in   al, dx
   239 00000087 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   240 00000089 EE                          out  dx, al
   241                                  
   242                                      ;------------------------------------------
   243                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   244                                      ;------------------------------------------
   245 0000008A BAF9FF                      mov dx, TULA
   246 0000008D B070                        mov al, 0x70    ; 下位アドレス
   247 0000008F EE                          out dx, al
   248                                  
   249                                      ;------------------------------------------
   250                                      ; 3. TCKS: タイマクロック入力選択
   251                                      ;------------------------------------------
   252 00000090 BAF0FF                      mov  dx, TCKS
   253 00000093 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   254 00000095 EE                          out  dx, al
   255                                  
   256                                      ;------------------------------------------
   257                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   258                                      ;------------------------------------------
   259 00000096 BA7320                      mov  dx, TM_CTL
   260                                  
   261                                      ; --- Timer 0 Setup ---
   262 00000099 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   263 0000009B EE                          out  dx, al
   264                                      
   265                                      ; --- Timer 1 Setup ---
   266 0000009C B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   267 0000009E EE                          out  dx, al
   268                                  
   269                                      ; --- Timer 2 Setup ---
   270 0000009F B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   271 000000A1 EE                          out  dx, al
   272                                  
   273                                      ;------------------------------------------
   274                                      ; 4. カウンタ値 (分周比) のロード
   275                                      ;------------------------------------------
   276                                      ; Timer 0 (INTP0)
   277                                      ; 1.2288MHz / 12288 = 100Hz
   278 000000A2 BA7020                      mov  dx, TM0_CNT
   279 000000A5 B000                        mov  al, 0x00
   280 000000A7 EE                          out  dx, al
   281 000000A8 B030                        mov  al, 0x30
   282 000000AA EE                          out  dx, al
   283                                  
   284                                      ; Timer 1 (INTP2)
   285                                      ; 1.2288MHz / 61440 = 20Hz
   286 000000AB BA7120                      mov  dx, TM1_CNT
   287 000000AE B000                        mov  al, 0x00
   288 000000B0 EE                          out  dx, al
   289 000000B1 B0F0                        mov  al, 0xF0
   290 000000B3 EE                          out  dx, al
   291                                  
   292                                      ; Timer 2 (USART Tx/RxCLK)
   293                                      ; 1.2288MHz / 4 = 307.20KHz
   294                                      ; USART CLOCK 19200bps
   295 000000B4 BA7220                      mov  dx, TM2_CNT
   296 000000B7 B004                        mov  al, 4
   297 000000B9 EE                          out  dx, al
   298 000000BA B000                        mov  al, 0
   299 000000BC EE                          out  dx, al
   300                                  
   301                                      ;------------------------------------------
   302                                      ; μPD71051 (USART) 初期化
   303                                      ;------------------------------------------
   304 000000BD B000                        mov al, 0
   305 000000BF E6DA                        out USART_CMD, al
   306                                   
   307 000000C1 F7E1                        mul cx              ; wait
   308 000000C3 F7E1                        mul cx              ; wait
   309 000000C5 E6DA                        out USART_CMD, al
   310                                   
   311 000000C7 F7E1                        mul cx              ; wait
   312 000000C9 F7E1                        mul cx              ; wait
   313 000000CB E6DA                        out USART_CMD, al
   314                                   
   315 000000CD F7E1                        mul cx              ; wait
   316 000000CF F7E1                        mul cx              ; wait
   317 000000D1 B040                        mov al, 0x40        ; reset
   318 000000D3 E6DA                        out USART_CMD, al
   319                                   
   320 000000D5 F7E1                        mul cx              ; wait
   321 000000D7 F7E1                        mul cx              ; wait
   322 000000D9 B04E                        mov al, 0x4e        ; set mode
   323 000000DB E6DA                        out USART_CMD, al
   324                                   
   325 000000DD F7E1                        mul cx              ; wait
   326 000000DF F7E1                        mul cx              ; wait
   327 000000E1 B037                        mov al, 0x37        ; rx,tx ready
   328 000000E3 E6DA                        out USART_CMD, al
   329                                  
   330                                      ;------------------------------------------
   331                                      ; μPD71059 (PIC) 初期化
   332                                      ;------------------------------------------
   333 000000E5 B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   334 000000E7 E6C8                        out PIC_REG0, al
   335                                  
   336 000000E9 B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   337 000000EB E6CA                        out PIC_REG1, al
   338                                                          ; ICW3 is skipped in Single Mode
   339 000000ED B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   340 000000EF E6CA                        out PIC_REG1, al
   341                                  
   342 000000F1 B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   343 000000F3 E6CA                        out PIC_REG1, al
   344                                  
   345                                      ;------------------------------------------
   346                                      ; ICUの追加設定
   347                                      ;------------------------------------------
   348                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   349                                      ;------------------------------------------
   350 000000F5 BAFDFF                      mov  dx, OPSEL
   351 000000F8 EC                          in   al, dx
   352 000000F9 0C02                        or   al, 00000010b   ; Bit 1 (ICU) をセット
   353 000000FB EE                          out  dx, al
   354                                  
   355                                      ;------------------------------------------
   356                                      ; 2. レジスタ配置アドレスの設定 (IULA)
   357                                      ;------------------------------------------
   358 000000FC BAFAFF                      mov dx, IULA
   359 000000FF B080                        mov al, 0x80    ; 下位アドレス
   360 00000101 EE                          out dx, al
   361                                  
   362                                      ;------------------------------------------
   363                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   364                                      ;------------------------------------------
   365 00000102 BA8020                      mov dx, ICU_REG0
   366 00000105 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   367 00000107 EE                          out dx, al
   368                                  
   369 00000108 BA8120                      mov dx, ICU_REG1
   370 0000010B B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   371 0000010D EE                          out dx, al
   372                                                      ; ICW3 is skipped in Single Mode
   373 0000010E B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   374 00000110 EE                          out dx, al
   375                                  
   376                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   377 00000111 B07F                        mov al, 7Fh     ; 0111 1111
   378 00000113 EE                          out dx, al
   379                                  
   380                                      ;-------------------------------------------
   381                                      ; 割り込み許可
   382                                      ;-------------------------------------------
   383 00000114 FB                          sti
   384                                  
   385                                   %endif
   386                                  
   387                                      ; 変数初期化 (RAMエリアをクリア)
   388 00000115 C706[5208]0000              mov word [dump_seg], 0x0000
   389 0000011B C706[5408]0000              mov word [dump_off], 0x0000
   390 00000121 C706[5608]0020              mov word [load_seg], 0x2000
   391                                  
   392                                      ; スタートメッセージの表示
   393 00000127 BE[0606]                    mov si, msg_boot
   394 0000012A E8E702                      call puts
   395                                  
   396                                  ; =================================================================
   397                                  ; Main Loop
   398                                  ; =================================================================
   399                                  monitor_loop:
   400 0000012D B03E                        mov al, '>'
   401 0000012F E8F002                      call putc
   402 00000132 B020                        mov al, ' '
   403 00000134 E8EB02                      call putc
   404                                  
   405 00000137 E80A03                      call getc_echo  ; コマンド受信（エコーあり）
   406 0000013A 88C3                        mov bl, al
   407                                      
   408 0000013C 80FB64                      cmp bl, 'd'     ; dump command
   409 0000013F 747A                        je do_dump
   410 00000141 80FB44                      cmp bl, 'D'
   411 00000144 7475                        je do_dump
   412                                      
   413 00000146 80FB6C                      cmp bl, 'l'     ; load command
   414 00000149 7503E9D000                  je do_load
   415 0000014E 80FB4C                      cmp bl, 'L'
   416 00000151 7503E9C800                  je do_load
   417                                      
   418 00000156 80FB67                      cmp bl, 'g'     ; go command
   419 00000159 7503E93B01                  je do_go
   420 0000015E 80FB47                      cmp bl, 'G'
   421 00000161 7503E93301                  je do_go
   422                                  
   423 00000166 80FB77                      cmp bl, 'w'     ; Write command
   424 00000169 7503E95701                  je do_write
   425 0000016E 80FB57                      cmp bl, 'W'
   426 00000171 7503E94F01                  je do_write
   427                                  
   428 00000176 3C69                        cmp al, 'i'     ; Input Port command
   429 00000178 7503E98B01                  je do_in
   430 0000017D 3C49                        cmp al, 'I'
   431 0000017F 7503E98401                  je do_in
   432                                  
   433 00000184 3C6F                        cmp al, 'o'     ; Output Port command
   434 00000186 7503E9A101                  je do_out
   435 0000018B 3C4F                        cmp al, 'O'
   436 0000018D 7503E99A01                  je do_out
   437                                  
   438 00000192 3C73                        cmp al, 's'     ; Scan I/O command
   439 00000194 7503E9BA01                  je do_scan
   440 00000199 3C53                        cmp al, 'S'
   441 0000019B 7503E9B301                  je do_scan
   442                                  
   443 000001A0 3C74                        cmp al, 't'     ; Scan Timer wait command
   444 000001A2 7503E91E02                  je do_timer
   445 000001A7 3C54                        cmp al, 'T'
   446 000001A9 7503E91702                  je do_timer
   447                                  
   448 000001AE 3C3F                        cmp al, '?'     ; Help
   449 000001B0 7503E95302                  je cmd_help
   450                                  
   451                                      ; 知らないコマンドなら改行して戻る
   452 000001B5 E89502                      call putc_crlf
   453 000001B8 E972FF                      jmp monitor_loop
   454                                  
   455                                  ; =================================================================
   456                                  ; Command: Dump Memory
   457                                  ; Usage:
   458                                  ;   D               -> Dump next 64 bytes
   459                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   460                                  ; =================================================================
   461                                  do_dump:
   462 000001BB E88602                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   463 000001BE 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   464 000001C0 7418                        je .dump_run
   465 000001C2 3C20                        cmp al, ' '         ; Spaceなら引数解析
   466 000001C4 7405                        je .parse_args
   467                                      
