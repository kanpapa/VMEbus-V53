   710 00000337 E97201                      jmp error
   711                                  
   712                                  ; ==============================================================
   713                                  ; Command: Scan I/O Ports
   714                                  ; Usage:
   715                                  ;   S <Start_port> <End_port>
   716                                  ; Description: Reads ports and prints if value is NOT 0xFF
   717                                  ; ==============================================================
   718                                  do_scan:
   719 0000033A E8EE00                      call getc_echo
   720 0000033D 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   721 0000033F 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   722                                  
   723 00000344 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   724 00000347 89C3                        mov bx, ax          ; BX = Start Address
   725                                      
   726 00000349 E8DF00                      call getc_echo
   727 0000034C 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   728 0000034E 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   729                                  
   730 00000350 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   731 00000353 89C1                        mov cx, ax          ; CX = End Address
   732                                  
   733 00000355 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   734 00000357 7603E95001                  ja error
   735                                  
   736 0000035C E8D500                      call putc_crlf
   737 0000035F BE[6706]                    mov si, msg_scan_start
   738 00000362 E89600                      call puts
   739                                  
   740                                  .scan_loop:
   741 00000365 89DA                        mov dx, bx          ; DXにポートアドレス設定
   742 00000367 EC                          in al, dx           ; I/O Read
   743                                  
   744 00000368 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   745 0000036A 741D                        je .next_port
   746                                  
   747 0000036C 50                          push ax             ; Readした値をスタックに保存
   748                                  
   749                                      ; --- 有効な値が見つかった場合の表示 ---
   750                                      ; [Port]: Value
   751 0000036D 89D8                        mov ax, bx
   752 0000036F E8CB00                      call print_hex_word ; ポートアドレスの表示
   753 00000372 B03A                        mov al, ':'
   754 00000374 E89200                      call putc
   755 00000377 B020                        mov al, ' '
   756 00000379 E88D00                      call putc
   757                                      
   758 0000037C 58                          pop ax
   759 0000037D E8C400                      call print_hex_byte ; Readした値の表示
   760                                      
   761 00000380 BE[9206]                    mov si, msg_space   ; "  "
   762 00000383 E87500                      call puts
   763                                  
   764                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   765                                      ; ここでは単純にリスト形式で改行します
   766 00000386 E8AB00                      call putc_crlf
   767                                  
   768                                  .next_port:
   769 00000389 43                          inc bx              ; 次のアドレスへ
   770                                      
   771                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   772 0000038A BA6112                      mov dx, SCU_SST
   773 0000038D EC                          in al, dx
   774 0000038E A802                        test al, RX_READY   ; RxRDY?
   775 00000390 750D                        jnz .abort          ; 何かキーが押されたら中断
   776                                  
   777 00000392 39CB                        cmp bx, cx
   778 00000394 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   779                                  
   780 00000396 BE[D905]                    mov si, msg_done
   781 00000399 E85F00                      call puts
   782 0000039C E975FD                      jmp monitor_loop
   783                                  
   784                                  .abort:
   785                                      ; 入力バッファを空読みしておく
   786 0000039F BA6012                      mov dx, SCU_DATA
   787 000003A2 EC                          in al, dx
   788 000003A3 BE[9506]                    mov si, msg_abort
   789 000003A6 E85200                      call puts
   790 000003A9 E968FD                      jmp monitor_loop
   791                                  
   792                                  ; ==============================================================
   793                                  ; Command: Timer (ms)
   794                                  ;   T          -> Show current tick counter (32-bit HEX)
   795                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   796                                  ; ==============================================================
   797                                  do_timer:
   798 000003AC E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   799 000003AF 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   800 000003B1 7421                        je .show_counter
   801 000003B3 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   802 000003B5 7403E9F200                  jne error           ; それ以外はエラー
   803                                  
   804                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   805 000003BA E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   806                                  
   807                                      ; 開始時刻を保存 (Start Time)
   808 000003BD 8B1E[0007]                  mov bx, [tick_counter_lo]
   809                                  
   810                                  .wait_loop:
   811                                      ; 1. 現在時刻を取得
   812 000003C1 8B0E[0007]                  mov cx, [tick_counter_lo]
   813                                      
   814                                      ; 2. 経過時間を計算 (Current - Start)
   815                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   816 000003C5 29D9                        sub cx, bx          
   817                                      
   818                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   819 000003C7 39C1                        cmp cx, ax
   820 000003C9 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   821                                  
   822                                      ; 指定時間経過した
   823 000003CB BE[D905]                    mov si, msg_done
   824 000003CE E82A00                      call puts
   825 000003D1 E940FD                      jmp monitor_loop
   826                                  
   827                                  .show_counter:
   828                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   829 000003D4 E85D00                      call putc_crlf
   830                                      
   831 000003D7 BE[A006]                    mov si, msg_tick    ; "Tick: "
   832 000003DA E81E00                      call puts
   833                                  
   834                                      ; 32bitカウンタを [High][Low] の順で表示
   835 000003DD A1[0207]                    mov ax, [tick_counter_hi]
   836 000003E0 E85A00                      call print_hex_word
   837 000003E3 A1[0007]                    mov ax, [tick_counter_lo]
   838 000003E6 E85400                      call print_hex_word
   839                                      
   840 000003E9 E84800                      call putc_crlf
   841 000003EC E925FD                      jmp monitor_loop
   842                                  
   843                                  ; ==============================================================
   844                                  ; Command: Help
   845                                  ; ==============================================================
   846                                  cmd_help:
   847 000003EF E84200                      call putc_crlf
   848 000003F2 BE[E505]                    mov si, msg_help
   849 000003F5 E80300                      call puts
   850 000003F8 E919FD                      jmp monitor_loop
   851                                  
   852                                  ; =================================================================
   853                                  ; Utilities
   854                                  ; =================================================================
   855                                  
   856                                  ; 文字列出力
   857                                  puts:
   858 000003FB 2E8A04                      mov al, [cs:si]
   859 000003FE 08C0                        or al, al
   860 00000400 7406                        jz .ret
   861 00000402 E80400                      call putc
   862 00000405 46                          inc si
   863 00000406 EBF3                        jmp puts
   864 00000408 C3                      .ret: ret
   865                                  
   866                                  ; 1文字出力
   867                                  putc:
   868 00000409 52                          push dx
   869 0000040A 50                          push ax
   870 0000040B BA6112                      mov dx, SCU_SST
   871 0000040E EC                      .w: in al, dx
   872 0000040F A801                        test al, TX_READY  ; TX Ready?
   873 00000411 74FB                        jz .w
   874 00000413 BA6012                      mov dx, SCU_DATA
   875 00000416 58                          pop ax
   876 00000417 50                          push ax
   877 00000418 EE                          out dx, al
   878 00000419 58                          pop ax
   879 0000041A 5A                          pop dx
   880 0000041B C3                          ret
   881                                  
   882                                  ; 1文字入力
   883                                  getc:
   884 0000041C 52                          push dx
   885 0000041D BA6112                      mov dx, SCU_SST
   886 00000420 EC                      .w: in al, dx
   887 00000421 A802                        test al, RX_READY  ; RX Ready?
   888 00000423 74FB                        jz .w
   889 00000425 BA6012                      mov dx, SCU_DATA
   890 00000428 EC                          in al, dx
   891 00000429 5A                          pop dx
   892 0000042A C3                          ret
   893                                  
   894                                  ; 1文字入力　エコーバックあり
   895                                  getc_echo:
   896 0000042B E8EEFF                      call getc
   897 0000042E 50                          push ax
   898 0000042F E8D7FF                      call putc
   899 00000432 58                          pop ax
   900 00000433 C3                          ret
   901                                  
   902                                  ; 改行出力
   903                                  putc_crlf:
   904 00000434 B00D                        mov al, 0x0D
   905 00000436 E8D0FF                      call putc
   906 00000439 B00A                        mov al, 0x0A
   907 0000043B EBCC                        jmp putc
   908                                  
   909                                  ; -----------------------------------------------------------------
   910                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   911                                  ; Input: AX
   912                                  ; -----------------------------------------------------------------
   913                                  print_hex_word:
   914 0000043D 50                          push ax
   915 0000043E 88E0                        mov al, ah
   916 00000440 E80100                      call print_hex_byte
   917 00000443 58                          pop ax
   918                                  
   919                                  ; -----------------------------------------------------------------
   920                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   921                                  ; Input: AL
   922                                  ; -----------------------------------------------------------------
   923                                  print_hex_byte:
   924 00000444 50                          push ax
   925 00000445 51                          push cx
   926                                  
   927                                      ; 上位バイトの表示
   928 00000446 50                          push ax
   929 00000447 C0E804                      shr al, 4
   930 0000044A E80900                      call .digit
   931                                  
   932                                      ; 下位バイトの表示
   933 0000044D 58                          pop ax
   934 0000044E 240F                        and al, 0x0F
   935 00000450 E80300                      call .digit
   936                                  
   937 00000453 59                          pop cx
   938 00000454 58                          pop ax
   939 00000455 C3                          ret
   940                                  
   941                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   942                                  .digit:
   943 00000456 0430                        add al, '0'
   944 00000458 3C39                        cmp al, '9'
   945 0000045A 7602                        jbe .p
   946 0000045C 0407                        add al, 7
   947 0000045E E8A8FF                  .p: call putc
   948 00000461 C3                          ret
   949                                  
   950                                  ; -----------------------------------------------------------------
   951                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   952                                  ; Input:  Serial (例: "1", "0", "0", "0")
   953                                  ; Output: AX = 0x1000
   954                                  ; -----------------------------------------------------------------
   955                                  get_hex_word:
   956 00000462 53                          push bx
   957 00000463 E80B00                      call get_hex_byte_echo
   958 00000466 88C7                        mov bh, al
   959 00000468 E80600                      call get_hex_byte_echo
   960 0000046B 88C3                        mov bl, al
   961 0000046D 89D8                        mov ax, bx
   962 0000046F 5B                          pop bx
   963 00000470 C3                          ret
   964                                  
   965                                  ; 16進数2桁入力　エコーバック有り
   966                                  get_hex_byte_echo:
   967 00000471 53                          push bx
   968 00000472 E8B6FF                      call getc_echo
   969 00000475 E82500                      call hex_char_to_bin
   970 00000478 C0E004                      shl al, 4
   971 0000047B 88C3                        mov bl, al
   972 0000047D E8ABFF                      call getc_echo
   973 00000480 E81A00                      call hex_char_to_bin
   974 00000483 08D8                        or al, bl
   975 00000485 5B                          pop bx
   976 00000486 C3                          ret
   977                                  
   978                                  ; -----------------------------------------------------------------
   979                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   980                                  ; Input:  Serial (例: "3", "F")
   981                                  ; Output: AL = 0x3F
   982                                  ; -----------------------------------------------------------------
   983                                  get_hex_byte:
   984 00000487 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   985                                  
   986                                      ; 上位4bit
   987 00000488 E891FF                      call getc
   988 0000048B E80F00                      call hex_char_to_bin
   989 0000048E C0E004                      shl al, 4
   990 00000491 88C3                        mov bl, al          ; 一時保存
   991                                      
   992                                      ; 下位4bit
   993 00000493 E886FF                      call getc
   994 00000496 E80400                      call hex_char_to_bin
   995 00000499 08D8                        or al, bl           ; 上位を合成して結果はALへ
   996 0000049B 5B                          pop bx
   997 0000049C C3                          ret
   998                                  
   999                                  ; -----------------------------------------------------------------
  1000                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1001                                  ; Input: AL (ASCII)
  1002                                  ; Output: AL (Binary)
  1003                                  ; -----------------------------------------------------------------
  1004                                  hex_char_to_bin:
  1005 0000049D 2C30                        sub al, '0'
  1006 0000049F 3C09                        cmp al, 9
  1007 000004A1 7604                        jbe .done
  1008 000004A3 2C07                        sub al, 7           ; 'A'-'F'対応
  1009 000004A5 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1010                                  .done:
  1011 000004A7 C3                          ret
  1012                                  
  1013                                  ; -----------------------------------------------------------------
  1014                                  ; Helper: スペースなどを読み飛ばす
  1015                                  ; -----------------------------------------------------------------
  1016                                  skip_space:
  1017 000004A8 E880FF                      call getc_echo
  1018 000004AB C3                          ret
  1019                                  
  1020                                  ; -----------------------------------------------------------------
  1021                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1022                                  ; -----------------------------------------------------------------
  1023                                  error:
  1024 000004AC BE[BD05]                    mov si, msg_error
  1025 000004AF E849FF                      call puts
  1026 000004B2 E95FFC                      jmp monitor_loop
  1027                                  
  1028                                  ;==========================================================
  1029                                  ; NMI (ABORT) Handler
  1030                                  ;==========================================================
  1031                                  
  1032                                  NMI_Handler:
  1033                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1034 000004B5 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1035 000004B6 1E                          push ds
  1036 000004B7 06                          push es
  1037                                  
  1038                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1039 000004B8 8CC8                        mov  ax, cs
  1040 000004BA 8ED8                        mov  ds, ax
  1041 000004BC 8EC0                        mov  es, ax
  1042                                  
  1043                                      ; 3. スタックフレームへのポインタ設定
  1044 000004BE 89E5                        mov  bp, sp
  1045                                  
  1046                                      ; --- 画面表示 ---
  1047 000004C0 BE[A706]                    mov  si, msg_nmi
  1048 000004C3 E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1049                                  
  1050                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1051                                      ; Stack Layout after pushes:
  1052                                      ; BP+0: ES
  1053                                      ; BP+2: DS
  1054                                      ; BP+4: DI
  1055                                      ; BP+6: SI
  1056                                      ; BP+8: BP (Old)
  1057                                      ; BP+10: SP (Original)
  1058                                      ; BP+12: BX
  1059                                      ; BP+14: DX
  1060                                      ; BP+16: CX
  1061                                      ; BP+18: AX
  1062                                      ; BP+20: IP (Return Addr)
  1063                                      ; BP+22: CS (Return Addr)
  1064                                      ; BP+24: Flags
  1065                                      
  1066                                      ; AX
  1067 000004C6 BE[BF06]                    mov  si, msg_ax
  1068 000004C9 E82FFF                      call puts
  1069 000004CC 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1070 000004CF E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1071                                  
  1072                                      ; BX
  1073 000004D2 BE[C406]                    mov  si, msg_bx
  1074 000004D5 E823FF                      call puts
  1075 000004D8 8B460C                      mov  ax, [bp+12]
  1076 000004DB E85FFF                      call print_hex_word
  1077                                  
  1078                                      ; CX
  1079 000004DE BE[C906]                    mov  si, msg_cx
  1080 000004E1 E817FF                      call puts
  1081 000004E4 8B4610                      mov  ax, [bp+16]
  1082 000004E7 E853FF                      call print_hex_word
  1083                                  
  1084                                      ; DX
  1085 000004EA BE[CE06]                    mov  si, msg_dx
  1086 000004ED E80BFF                      call puts
  1087 000004F0 8B460E                      mov  ax, [bp+14]
  1088 000004F3 E847FF                      call print_hex_word
  1089                                  
  1090 000004F6 E83BFF                      call putc_crlf
  1091                                  
  1092                                      ; --- 中断地点 (CS:IP) の表示 ---
  1093                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1094                                      ; その上が割り込み発生時の IP, CS, Flags です
  1095                                      
  1096 000004F9 BE[D306]                    mov  si, msg_addr
  1097 000004FC E8FCFE                      call puts           ; " Stop at "
  1098 000004FF 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1099 00000502 E838FF                      call print_hex_word
  1100 00000505 B03A                        mov  al, ':'
  1101 00000507 E8FFFE                      call putc
  1102 0000050A 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1103 0000050D E82DFF                      call print_hex_word
  1104                                  
  1105 00000510 E821FF                      call putc_crlf
  1106                                  
  1107                                      ; 4. 復帰処理
  1108                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1109                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1110 00000513 E9EAFA                      jmp  start  ; モニタの開始ラベルへ
  1111                                  
  1112                                  ; ==========================================================
  1113                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1114                                  ; ==========================================================
  1115                                  
  1116                                  ; --- 共通処理部 (Common Handler) ---
  1117                                  _default_int_handler:
  1118 00000516 55                          push bp
  1119 00000517 89E5                        mov  bp, sp
  1120 00000519 60                          pusha               ; 全レジスタ保存 (AX,CX,DX,BX,SP,BP,SI,DI)
  1121 0000051A 1E                          push ds
  1122 0000051B 06                          push es
  1123                                  
  1124                                      ; セグメント設定 (Tiny Model的な動作のためCSをDS/ESにコピー)
  1125 0000051C 8CC8                        mov  ax, cs
  1126 0000051E 8ED8                        mov  ds, ax
  1127 00000520 8EC0                        mov  es, ax
  1128                                  
  1129                                      ; --- メッセージ表示 ---
  1130 00000522 BE[E506]                    mov  si, msg_int_trap
  1131 00000525 E8D3FE                      call puts           ; "** INT "
  1132                                  
  1133                                      ; --- ベクタ番号の表示 ---
  1134                                      ; スタック構造:
  1135                                      ; [BP+0] Old BP
  1136                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1137                                      ; [BP+4] Return IP ...
  1138                                      
  1139 00000528 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1140 0000052B E816FF                      call print_hex_byte ; 表示 (例: 25)
  1141                                  
  1142 0000052E BE[ED06]                    mov  si, msg_detected
  1143 00000531 E8C7FE                      call puts           ; " detected **" (改行含む)
  1144                                  
  1145                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1146 00000534 B020                        mov al, 20h         ; Non-specific EOI
  1147 00000536 E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1148 00000538 BA8012                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1149 0000053B EE                          out dx, al
  1150                                  
  1151 0000053C 07                          pop  es
  1152 0000053D 1F                          pop  ds
  1153 0000053E 61                          popa
  1154 0000053F 5D                          pop  bp
  1155 00000540 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1156 00000543 CF                          iret
  1157                                  
  1158                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1159                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1160                                  
  1161 00000544 6A20                    _isr_stub_20: push 0x0020       ; ICU INTP0
  1162 00000546 EBCE                                  jmp _default_int_handler
  1163 00000548 6A21                    _isr_stub_21: push 0x0021       ; ICU INTP1
  1164 0000054A EBCA                                  jmp _default_int_handler
  1165 0000054C 6A22                    _isr_stub_22: push 0x0022       ; ICU INTP2
  1166 0000054E EBC6                                  jmp _default_int_handler
  1167 00000550 6A23                    _isr_stub_23: push 0x0023       ; ICU INTP3
  1168 00000552 EBC2                                  jmp _default_int_handler
  1169 00000554 6A24                    _isr_stub_24: push 0x0024       ; ICU INTP4
  1170 00000556 EBBE                                  jmp _default_int_handler
  1171 00000558 6A25                    _isr_stub_25: push 0x0025       ; ICU INTP5
  1172 0000055A EBBA                                  jmp _default_int_handler
  1173 0000055C 6A26                    _isr_stub_26: push 0x0026       ; ICU INTP6
  1174 0000055E EBB6                                  jmp _default_int_handler
  1175                                  
  1176                                  ; Note: Vector 27h (INTP7) は _tick_handler で使用中なのでここには含めません
  1177                                  
  1178                                  ;==========================================================
  1179                                  ; Tick Handler
  1180                                  ;==========================================================
  1181                                  _tick_handler:
  1182 00000560 50                          push ax
  1183 00000561 52                          push dx
  1184                                  
  1185                                      ; CS (コードセグメント) と DS (データセグメント) を合わせる
  1186                                      ; (Tiny Model的な動作のため)
  1187 00000562 8CC8                        mov ax, cs
  1188 00000564 8ED8                        mov ds, ax
  1189                                  
  1190                                      ; --- 32bit カウンタのインクリメント ---
  1191 00000566 FF06[0007]                  inc word [tick_counter_lo]
  1192 0000056A 7504                        jnz .skip_carry
  1193 0000056C FF06[0207]                  inc word [tick_counter_hi]
  1194                                  .skip_carry:
  1195                                  
  1196                                      ; --- EOI (End of Interrupt) to PIC ---
  1197 00000570 B020                        mov al, 20h     ; Non-specific EOI
  1198                                  
  1199                                      ; 外部PIC (Slave) の割り込み完了
  1200 00000572 E6C8                        out PIC_REG0, al
  1201                                  
  1202                                      ; V53内蔵ICU (Master) の割り込み完了
  1203 00000574 BA8012                      mov dx, ICU_REG0 
  1204 00000577 EE                          out dx, al
  1205                                  
  1206 00000578 5A                          pop dx
  1207 00000579 58                          pop ax
  1208 0000057A CF                          iret
  1209                                  
