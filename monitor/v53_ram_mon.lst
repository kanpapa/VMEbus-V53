   787                                  ; ==============================================================
   788                                  ; Command: Scan I/O Ports
   789                                  ; Usage:
   790                                  ;   S <Start_port> <End_port>
   791                                  ; Description: Reads ports and prints if value is NOT 0xFF
   792                                  ; ==============================================================
   793                                  do_scan:
   794 00000385 E8EE00                      call getc_echo
   795 00000388 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   796 0000038A 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   797                                  
   798 0000038F E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   799 00000392 89C3                        mov bx, ax          ; BX = Start Address
   800                                      
   801 00000394 E8DF00                      call getc_echo
   802 00000397 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   803 00000399 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   804                                  
   805 0000039B E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   806 0000039E 89C1                        mov cx, ax          ; CX = End Address
   807                                  
   808 000003A0 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   809 000003A2 7603E95001                  ja error
   810                                  
   811 000003A7 E8D500                      call putc_crlf
   812 000003AA BE[E507]                    mov si, msg_scan_start
   813 000003AD E89600                      call puts
   814                                  
   815                                  .scan_loop:
   816 000003B0 89DA                        mov dx, bx          ; DXにポートアドレス設定
   817 000003B2 EC                          in al, dx           ; I/O Read
   818                                  
   819 000003B3 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   820 000003B5 741D                        je .next_port
   821                                  
   822 000003B7 50                          push ax             ; Readした値をスタックに保存
   823                                  
   824                                      ; --- 有効な値が見つかった場合の表示 ---
   825                                      ; [Port]: Value
   826 000003B8 89D8                        mov ax, bx
   827 000003BA E8CB00                      call print_hex_word ; ポートアドレスの表示
   828 000003BD B03A                        mov al, ':'
   829 000003BF E89200                      call putc
   830 000003C2 B020                        mov al, ' '
   831 000003C4 E88D00                      call putc
   832                                      
   833 000003C7 58                          pop ax
   834 000003C8 E8C400                      call print_hex_byte ; Readした値の表示
   835                                      
   836 000003CB BE[1008]                    mov si, msg_space   ; "  "
   837 000003CE E87500                      call puts
   838                                  
   839                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   840                                      ; ここでは単純にリスト形式で改行します
   841 000003D1 E8AB00                      call putc_crlf
   842                                  
   843                                  .next_port:
   844 000003D4 43                          inc bx              ; 次のアドレスへ
   845                                      
   846                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   847 000003D5 BA6120                      mov dx, SCU_SST
   848 000003D8 EC                          in al, dx
