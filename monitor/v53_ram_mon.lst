   568 00000259 B500                        mov ch, 0
   569                                      
   570 0000025B E84202                      call get_hex_byte   ; 上位アドレスを読み込み
   571 0000025E 88C7                        mov bh, al
   572 00000260 E83D02                      call get_hex_byte   ; 下位アドレスを読み込み
