   509                                  ; =================================================================
   510                                  ; Command: Execute
   511                                  ; Usage:
   512                                  ;   G <Seg> <Off>
   513                                  ; Example: G 1000 0000
   514                                  ; =================================================================
   515                                  do_go:
   516                                      ; Gコマンドは入力後に改行
   517                                      
   518 0000023B E8A801                      call getc_echo      ; Space?
   519 0000023E 3C20                        cmp al, ' '
   520 00000240 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   521                                      
   522                                      ; 1. セグメント (SSSS) を取得
   523 00000242 E8D801                      call get_hex_word   ; AX = Segment
   524 00000245 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   525 00000246 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   526                                      
   527                                      ; スペース読み飛ばし (もしあれば)
   528 00000248 E81802                      call skip_space
   529                                      
   530                                      ; 2. オフセット (OOOO) を取得
   531 0000024B E8CF01                      call get_hex_word   ; AX = Offset
   532 0000024E 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   533                                      
   534 0000024F E89D01                      call putc_crlf      ; 実行前に改行
   535 00000252 BE[2705]                    mov si, msg_go
   536 00000255 E85E01                      call puts
   537 00000258 E89401                      call putc_crlf
   538                                      
   539                                      ; 3. 実行環境のセットアップ
   540                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   541 0000025B 8EDB                        mov ds, bx
   542 0000025D 8EC3                        mov es, bx
   543                                  
   544                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   545 0000025F FA                          cli
   546                                  
   547                                      ; 4. ジャンプ！ (Far Return)
   548                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   549 00000260 CB                          retf                ; Jump!
   550                                  
   551                                  .go_default:
   552 00000261 E88B01                      call putc_crlf      ; 改行して
   553 00000264 E968FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   554                                  
   555                                  ; ==============================================================
   556                                  ; Command: Write Memory
   557                                  ; Usage:
   558                                  ;   W <Seg> <Off> <Val>
   559                                  ; ==============================================================
   560                                  do_write:    
   561 00000267 E87C01                      call getc_echo      ; Space?
   562 0000026A 3C20                        cmp al, ' '
   563 0000026C 7403E9F601                  jne error           ; 引数なしならリターン(またはエラー)
   564                                  
   565                                      ; 1. セグメント (SSSS) を取得
   566 00000271 E8A901                      call get_hex_word   ; AX = Segment
   567 00000274 50                          push ax             ; ターゲットセグメントを保存
   568                                      
   569 00000275 E86E01                      call getc_echo      ; Space?
   570 00000278 3C20                        cmp al, ' '
   571 0000027A 7403E9E801                  jne error           ; 引数なしならリターン(またはエラー)
   572                                      
   573                                      ; 2. オフセット (OOOO) を取得
   574 0000027F E89B01                      call get_hex_word   ; AX = Offset
   575 00000282 50                          push ax             ; ターゲットオフセットを保存
   576                                  
   577 00000283 E86001                      call getc_echo      ; Space?
   578 00000286 3C20                        cmp al, ' '
   579 00000288 7403E9DA01                  jne error           ; 引数なしならリターン(またはエラー)
   580                                  
   581                                      ; 3. 設定データ (VV) を取得
   582 0000028D E89C01                      call get_hex_byte_echo   ; AL = Value
   583                                  
   584 00000290 5B                          pop bx              ; bx = Offset
   585 00000291 5A                          pop dx              ; dx = Target Segment
   586                                  
   587                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   588 00000292 8916[5606]                  mov [dump_seg], dx
   589 00000296 891E[5806]                  mov [dump_off], bx
   590                                      
   591 0000029A 8EDA                        mov ds, dx          ; DS再設定
   592 0000029C 3E8807                      mov [ds:bx], al     ; 書き込み！
   593                                      
   594 0000029F 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   595 000002A0 1F                          pop ds
   596                                  
   597 000002A1 BE[4A05]                    mov si, msg_done
   598 000002A4 E80F01                      call puts
   599 000002A7 E925FE                      jmp monitor_loop
   600                                  
   601                                  ; ==============================================================
   602                                  ; Command: Input from Port
   603                                  ; Usage:
   604                                  ;   I <Port>
   605                                  ; ==============================================================
   606                                  do_in:
   607 000002AA E83901                      call getc_echo
   608 000002AD 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   609 000002AF 7403E9B301                  jne error           ; パラメタが無い場合はエラー処理へ
   610                                  
   611 000002B4 E86601                      call get_hex_word   ; ポートアドレスを取得
   612 000002B7 89C2                        mov dx, ax          ; 保存
   613 000002B9 EC                          in al, dx           ; I/O Read
   614                                      
   615 000002BA 50                          push ax
   616 000002BB E83101                      call putc_crlf      ; メッセージ表示前に改行
   617 000002BE BE[4405]                    mov si, msg_in_res
   618 000002C1 E8F200                      call puts
   619 000002C4 58                          pop ax
   620                                  
   621 000002C5 E83701                      call print_hex_byte ; 値を表示
   622                                  
   623 000002C8 E82401                      call putc_crlf      ; 改行して
   624 000002CB E901FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   625                                  
   626                                  ; ==============================================================
   627                                  ; Command: Output to Port
   628                                  ; Usage
   629                                  ;   O <Port> <Val>
   630                                  ; ==============================================================
   631                                  do_out:
   632 000002CE E81501                      call getc_echo
   633 000002D1 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   634 000002D3 7403E98F01                  jne error           ; パラメタが無い場合はエラー処理へ
   635                                  
   636 000002D8 E84201                      call get_hex_word   ; ポートアドレスを取得
   637 000002DB 50                          push ax             ; スタックに積む
   638                                  
   639 000002DC E80701                      call getc_echo
   640 000002DF 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   641 000002E1 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   642                                      
   643 000002E3 E84601                      call get_hex_byte_echo   ; 出力値を取得
   644 000002E6 5A                          pop dx              ; スタックからDXにセット
   645                                      
   646 000002E7 EE                          out dx, al          ; I/O Write
   647                                      
   648 000002E8 BE[4A05]                    mov si, msg_done    ; DONEを表示。改行付き。
   649 000002EB E8C800                      call puts
   650 000002EE E9DEFD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   651                                  
   652                                  error_pop:
   653 000002F1 58                          pop ax              ; 使わなかったスタックを捨てる
   654 000002F2 E97201                      jmp error
   655                                  
   656                                  ; ==============================================================
   657                                  ; Command: Scan I/O Ports
   658                                  ; Usage:
   659                                  ;   S <Start_port> <End_port>
   660                                  ; Description: Reads ports and prints if value is NOT 0xFF
   661                                  ; ==============================================================
   662                                  do_scan:
   663 000002F5 E8EE00                      call getc_echo
   664 000002F8 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   665 000002FA 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   666                                  
   667 000002FF E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   668 00000302 89C3                        mov bx, ax          ; BX = Start Address
   669                                      
   670 00000304 E8DF00                      call getc_echo
   671 00000307 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   672 00000309 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   673                                  
   674 0000030B E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   675 0000030E 89C1                        mov cx, ax          ; CX = End Address
   676                                  
   677 00000310 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   678 00000312 7603E95001                  ja error
   679                                  
   680 00000317 E8D500                      call putc_crlf
   681 0000031A BE[D805]                    mov si, msg_scan_start
   682 0000031D E89600                      call puts
   683                                  
   684                                  .scan_loop:
   685 00000320 89DA                        mov dx, bx          ; DXにポートアドレス設定
   686 00000322 EC                          in al, dx           ; I/O Read
   687                                  
   688 00000323 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   689 00000325 741D                        je .next_port
   690                                  
   691 00000327 50                          push ax             ; Readした値をスタックに保存
   692                                  
   693                                      ; --- 有効な値が見つかった場合の表示 ---
   694                                      ; [Port]: Value
   695 00000328 89D8                        mov ax, bx
   696 0000032A E8CB00                      call print_hex_word ; ポートアドレスの表示
   697 0000032D B03A                        mov al, ':'
   698 0000032F E89200                      call putc
   699 00000332 B020                        mov al, ' '
   700 00000334 E88D00                      call putc
   701                                      
   702 00000337 58                          pop ax
   703 00000338 E8C400                      call print_hex_byte ; Readした値の表示
   704                                      
   705 0000033B BE[0306]                    mov si, msg_space   ; "  "
   706 0000033E E87500                      call puts
   707                                  
   708                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   709                                      ; ここでは単純にリスト形式で改行します
   710 00000341 E8AB00                      call putc_crlf
   711                                  
   712                                  .next_port:
   713 00000344 43                          inc bx              ; 次のアドレスへ
   714                                      
   715                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   716 00000345 BA6112                      mov dx, SCU_SST
   717 00000348 EC                          in al, dx
   718 00000349 A802                        test al, RX_READY   ; RxRDY?
   719 0000034B 750D                        jnz .abort          ; 何かキーが押されたら中断
   720                                  
   721 0000034D 39CB                        cmp bx, cx
   722 0000034F 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   723                                  
   724 00000351 BE[4A05]                    mov si, msg_done
   725 00000354 E85F00                      call puts
   726 00000357 E975FD                      jmp monitor_loop
   727                                  
   728                                  .abort:
   729                                      ; 入力バッファを空読みしておく
   730 0000035A BA6012                      mov dx, SCU_DATA
   731 0000035D EC                          in al, dx
   732 0000035E BE[0606]                    mov si, msg_abort
   733 00000361 E85200                      call puts
   734 00000364 E968FD                      jmp monitor_loop
   735                                  
   736                                  ; ==============================================================
   737                                  ; Command: Timer (ms)
   738                                  ;   T          -> Show current tick counter (32-bit HEX)
   739                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   740                                  ; ==============================================================
   741                                  do_timer:
   742 00000367 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   743 0000036A 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   744 0000036C 7421                        je .show_counter
   745 0000036E 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   746 00000370 7403E9F200                  jne error           ; それ以外はエラー
   747                                  
   748                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   749 00000375 E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   750                                  
   751                                      ; 開始時刻を保存 (Start Time)
   752 00000378 8B1E[5C06]                  mov bx, [tick_counter_lo]
   753                                  
   754                                  .wait_loop:
   755                                      ; 1. 現在時刻を取得
   756 0000037C 8B0E[5C06]                  mov cx, [tick_counter_lo]
   757                                      
   758                                      ; 2. 経過時間を計算 (Current - Start)
   759                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   760 00000380 29D9                        sub cx, bx          
   761                                      
   762                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   763 00000382 39C1                        cmp cx, ax
   764 00000384 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   765                                  
   766                                      ; 指定時間経過した
   767 00000386 BE[4A05]                    mov si, msg_done
   768 00000389 E82A00                      call puts
   769 0000038C E940FD                      jmp monitor_loop
   770                                  
   771                                  .show_counter:
   772                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   773 0000038F E85D00                      call putc_crlf
   774                                      
   775 00000392 BE[1106]                    mov si, msg_tick    ; "Tick: "
   776 00000395 E81E00                      call puts
   777                                  
   778                                      ; 32bitカウンタを [High][Low] の順で表示
   779 00000398 A1[5E06]                    mov ax, [tick_counter_hi]
   780 0000039B E85A00                      call print_hex_word
   781 0000039E A1[5C06]                    mov ax, [tick_counter_lo]
   782 000003A1 E85400                      call print_hex_word
   783                                      
   784 000003A4 E84800                      call putc_crlf
   785 000003A7 E925FD                      jmp monitor_loop
   786                                  
   787                                  ; ==============================================================
   788                                  ; Command: Help
   789                                  ; ==============================================================
   790                                  cmd_help:
   791 000003AA E84200                      call putc_crlf
   792 000003AD BE[5605]                    mov si, msg_help
   793 000003B0 E80300                      call puts
   794 000003B3 E919FD                      jmp monitor_loop
   795                                  
   796                                  ; =================================================================
   797                                  ; Utilities
   798                                  ; =================================================================
   799                                  
   800                                  ; 文字列出力
   801                                  puts:
   802 000003B6 2E8A04                      mov al, [cs:si]
   803 000003B9 08C0                        or al, al
   804 000003BB 7406                        jz .ret
   805 000003BD E80400                      call putc
   806 000003C0 46                          inc si
   807 000003C1 EBF3                        jmp puts
   808 000003C3 C3                      .ret: ret
   809                                  
   810                                  ; 1文字出力
   811                                  putc:
   812 000003C4 52                          push dx
   813 000003C5 50                          push ax
   814 000003C6 BA6112                      mov dx, SCU_SST
   815 000003C9 EC                      .w: in al, dx
   816 000003CA A801                        test al, TX_READY  ; TX Ready?
   817 000003CC 74FB                        jz .w
   818 000003CE BA6012                      mov dx, SCU_DATA
   819 000003D1 58                          pop ax
   820 000003D2 50                          push ax
   821 000003D3 EE                          out dx, al
   822 000003D4 58                          pop ax
   823 000003D5 5A                          pop dx
   824 000003D6 C3                          ret
   825                                  
   826                                  ; 1文字入力
   827                                  getc:
   828 000003D7 52                          push dx
   829 000003D8 BA6112                      mov dx, SCU_SST
   830 000003DB EC                      .w: in al, dx
   831 000003DC A802                        test al, RX_READY  ; RX Ready?
   832 000003DE 74FB                        jz .w
   833 000003E0 BA6012                      mov dx, SCU_DATA
   834 000003E3 EC                          in al, dx
   835 000003E4 5A                          pop dx
   836 000003E5 C3                          ret
   837                                  
   838                                  ; 1文字入力　エコーバックあり
   839                                  getc_echo:
   840 000003E6 E8EEFF                      call getc
   841 000003E9 50                          push ax
   842 000003EA E8D7FF                      call putc
   843 000003ED 58                          pop ax
   844 000003EE C3                          ret
   845                                  
   846                                  ; 改行出力
   847                                  putc_crlf:
   848 000003EF B00D                        mov al, 0x0D
   849 000003F1 E8D0FF                      call putc
   850 000003F4 B00A                        mov al, 0x0A
   851 000003F6 EBCC                        jmp putc
   852                                  
   853                                  ; -----------------------------------------------------------------
   854                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   855                                  ; Input: AX
   856                                  ; -----------------------------------------------------------------
   857                                  print_hex_word:
   858 000003F8 50                          push ax
   859 000003F9 88E0                        mov al, ah
   860 000003FB E80100                      call print_hex_byte
   861 000003FE 58                          pop ax
   862                                  
   863                                  ; -----------------------------------------------------------------
   864                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   865                                  ; Input: AL
   866                                  ; -----------------------------------------------------------------
   867                                  print_hex_byte:
   868 000003FF 50                          push ax
   869 00000400 51                          push cx
   870                                  
   871                                      ; 上位バイトの表示
   872 00000401 50                          push ax
   873 00000402 C0E804                      shr al, 4
   874 00000405 E80900                      call .digit
   875                                  
   876                                      ; 下位バイトの表示
   877 00000408 58                          pop ax
   878 00000409 240F                        and al, 0x0F
   879 0000040B E80300                      call .digit
   880                                  
   881 0000040E 59                          pop cx
   882 0000040F 58                          pop ax
   883 00000410 C3                          ret
   884                                  
   885                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   886                                  .digit:
   887 00000411 0430                        add al, '0'
   888 00000413 3C39                        cmp al, '9'
   889 00000415 7602                        jbe .p
   890 00000417 0407                        add al, 7
   891 00000419 E8A8FF                  .p: call putc
   892 0000041C C3                          ret
   893                                  
   894                                  ; -----------------------------------------------------------------
   895                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   896                                  ; Input:  Serial (例: "1", "0", "0", "0")
   897                                  ; Output: AX = 0x1000
   898                                  ; -----------------------------------------------------------------
   899                                  get_hex_word:
   900 0000041D 53                          push bx
   901 0000041E E80B00                      call get_hex_byte_echo
   902 00000421 88C7                        mov bh, al
   903 00000423 E80600                      call get_hex_byte_echo
   904 00000426 88C3                        mov bl, al
   905 00000428 89D8                        mov ax, bx
   906 0000042A 5B                          pop bx
   907 0000042B C3                          ret
   908                                  
   909                                  ; 16進数2桁入力　エコーバック有り
   910                                  get_hex_byte_echo:
   911 0000042C 53                          push bx
   912 0000042D E8B6FF                      call getc_echo
   913 00000430 E82500                      call hex_char_to_bin
   914 00000433 C0E004                      shl al, 4
   915 00000436 88C3                        mov bl, al
   916 00000438 E8ABFF                      call getc_echo
   917 0000043B E81A00                      call hex_char_to_bin
   918 0000043E 08D8                        or al, bl
   919 00000440 5B                          pop bx
   920 00000441 C3                          ret
   921                                  
   922                                  ; -----------------------------------------------------------------
   923                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   924                                  ; Input:  Serial (例: "3", "F")
   925                                  ; Output: AL = 0x3F
   926                                  ; -----------------------------------------------------------------
   927                                  get_hex_byte:
   928 00000442 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   929                                  
   930                                      ; 上位4bit
   931 00000443 E891FF                      call getc
   932 00000446 E80F00                      call hex_char_to_bin
   933 00000449 C0E004                      shl al, 4
   934 0000044C 88C3                        mov bl, al          ; 一時保存
   935                                      
   936                                      ; 下位4bit
   937 0000044E E886FF                      call getc
   938 00000451 E80400                      call hex_char_to_bin
   939 00000454 08D8                        or al, bl           ; 上位を合成して結果はALへ
   940 00000456 5B                          pop bx
   941 00000457 C3                          ret
   942                                  
   943                                  ; -----------------------------------------------------------------
   944                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   945                                  ; Input: AL (ASCII)
   946                                  ; Output: AL (Binary)
   947                                  ; -----------------------------------------------------------------
   948                                  hex_char_to_bin:
   949 00000458 2C30                        sub al, '0'
   950 0000045A 3C09                        cmp al, 9
   951 0000045C 7604                        jbe .done
   952 0000045E 2C07                        sub al, 7           ; 'A'-'F'対応
   953 00000460 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   954                                  .done:
   955 00000462 C3                          ret
   956                                  
   957                                  ; -----------------------------------------------------------------
   958                                  ; Helper: スペースなどを読み飛ばす
   959                                  ; -----------------------------------------------------------------
   960                                  skip_space:
   961 00000463 E880FF                      call getc_echo
   962 00000466 C3                          ret
   963                                  
   964                                  ; -----------------------------------------------------------------
   965                                  ; Helper: エラーメッセージ出力後モニタに戻る
   966                                  ; -----------------------------------------------------------------
   967                                  error:
   968 00000467 BE[2E05]                    mov si, msg_error
   969 0000046A E849FF                      call puts
   970 0000046D E95FFC                      jmp monitor_loop
   971                                  
   972                                  ;==========================================================
   973                                  ; NMI (ABORT) Handler
   974                                  ;==========================================================
   975                                  
   976                                  NMI_Handler:
   977                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
   978 00000470 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
   979 00000471 1E                          push ds
   980 00000472 06                          push es
   981                                  
   982                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   983 00000473 8CC8                        mov  ax, cs
   984 00000475 8ED8                        mov  ds, ax
   985 00000477 8EC0                        mov  es, ax
   986                                  
   987                                      ; 3. スタックフレームへのポインタ設定
   988 00000479 89E5                        mov  bp, sp
   989                                  
   990                                      ; --- 画面表示 ---
   991 0000047B BE[1806]                    mov  si, msg_nmi
   992 0000047E E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
   993                                  
   994                                      ; 3. レジスタ表示 (スタックから読み出して表示)
   995                                      ; Stack Layout after pushes:
   996                                      ; BP+0: ES
   997                                      ; BP+2: DS
   998                                      ; BP+4: DI
   999                                      ; BP+6: SI
  1000                                      ; BP+8: BP (Old)
  1001                                      ; BP+10: SP (Original)
  1002                                      ; BP+12: BX
  1003                                      ; BP+14: DX
  1004                                      ; BP+16: CX
  1005                                      ; BP+18: AX
  1006                                      ; BP+20: IP (Return Addr)
  1007                                      ; BP+22: CS (Return Addr)
  1008                                      ; BP+24: Flags
  1009                                      
  1010                                      ; AX
  1011 00000481 BE[3006]                    mov  si, msg_ax
  1012 00000484 E82FFF                      call puts
  1013 00000487 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1014 0000048A E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1015                                  
  1016                                      ; BX
  1017 0000048D BE[3506]                    mov  si, msg_bx
  1018 00000490 E823FF                      call puts
  1019 00000493 8B460C                      mov  ax, [bp+12]
  1020 00000496 E85FFF                      call print_hex_word
  1021                                  
  1022                                      ; CX
  1023 00000499 BE[3A06]                    mov  si, msg_cx
  1024 0000049C E817FF                      call puts
  1025 0000049F 8B4610                      mov  ax, [bp+16]
  1026 000004A2 E853FF                      call print_hex_word
  1027                                  
  1028                                      ; DX
  1029 000004A5 BE[3F06]                    mov  si, msg_dx
  1030 000004A8 E80BFF                      call puts
  1031 000004AB 8B460E                      mov  ax, [bp+14]
  1032 000004AE E847FF                      call print_hex_word
  1033                                  
  1034 000004B1 E83BFF                      call putc_crlf
  1035                                  
  1036                                      ; --- 中断地点 (CS:IP) の表示 ---
  1037                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1038                                      ; その上が割り込み発生時の IP, CS, Flags です
  1039                                      
  1040 000004B4 BE[4406]                    mov  si, msg_addr
  1041 000004B7 E8FCFE                      call puts           ; " Stop at "
  1042 000004BA 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1043 000004BD E838FF                      call print_hex_word
  1044 000004C0 B03A                        mov  al, ':'
  1045 000004C2 E8FFFE                      call putc
  1046 000004C5 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1047 000004C8 E82DFF                      call print_hex_word
  1048                                  
  1049 000004CB E821FF                      call putc_crlf
  1050                                  
  1051                                      ; 4. 復帰処理
  1052                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1053                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1054 000004CE E92FFB                      jmp  start  ; モニタの開始ラベルへ
  1055                                  
  1056                                  ;==========================================================
  1057                                  ; Tick Handler
  1058                                  ;==========================================================
  1059                                  _tick_handler:
  1060 000004D1 50                          push ax
  1061 000004D2 52                          push dx
  1062                                  
  1063                                      ; CS (コードセグメント) と DS (データセグメント) を合わせる
  1064                                      ; (Tiny Model的な動作のため)
  1065 000004D3 8CC8                        mov ax, cs
  1066 000004D5 8ED8                        mov ds, ax
  1067                                  
  1068                                      ; --- 32bit カウンタのインクリメント ---
  1069 000004D7 FF06[5C06]                  inc word [tick_counter_lo]
  1070 000004DB 7504                        jnz .skip_carry
  1071 000004DD FF06[5E06]                  inc word [tick_counter_hi]
  1072                                  .skip_carry:
  1073                                  
  1074                                      ; --- EOI (End of Interrupt) to PIC ---
  1075 000004E1 B020                        mov al, 20h     ; Non-specific EOI
  1076                                  
  1077                                      ; 外部PIC (Slave) の割り込み完了
  1078 000004E3 E6C8                        out PIC_REG0, al
  1079                                  
  1080                                      ; V53内蔵ICU (Master) の割り込み完了
  1081 000004E5 BA8012                      mov dx, ICU_REG0 
  1082 000004E8 EE                          out dx, al
  1083                                  
  1084 000004E9 5A                          pop dx
  1085 000004EA 58                          pop ax
  1086 000004EB CF                          iret
  1087                                  
