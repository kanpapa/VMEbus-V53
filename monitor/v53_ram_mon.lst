   867                                  ; ==============================================================
   868                                  ; Command: Timer
   869                                  ;   T          -> Show current tick counter (32-bit HEX)
   870                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   871                                  ; ==============================================================
   872                                  do_timer:
   873 000003F7 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   874 000003FA 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   875 000003FC 7421                        je .show_counter
   876 000003FE 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   877 00000400 7403E9F200                  jne error           ; それ以外はエラー
   878                                  
   879                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   880 00000405 E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   881                                  
   882                                      ; 開始時刻を保存 (Start Time)
   883 00000408 8B1E[4A09]                  mov bx, [tick_counter_lo]
   884                                  
   885                                  .wait_loop:
   886                                      ; 1. 現在時刻を取得
   887 0000040C 8B0E[4A09]                  mov cx, [tick_counter_lo]
   888                                      
   889                                      ; 2. 経過時間を計算 (Current - Start)
   890                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   891 00000410 29D9                        sub cx, bx          
   892                                      
   893                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   894 00000412 39C1                        cmp cx, ax
   895 00000414 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   896                                  
   897                                      ; 指定時間経過した
   898 00000416 BE[5607]                    mov si, msg_done
   899 00000419 E82A00                      call puts
   900 0000041C E940FD                      jmp monitor_loop
   901                                  
   902                                  .show_counter:
   903                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   904 0000041F E85D00                      call putc_crlf
   905                                      
   906 00000422 BE[1E08]                    mov si, msg_tick    ; "Tick: "
   907 00000425 E81E00                      call puts
   908                                  
   909                                      ; 32bitカウンタを [High][Low] の順で表示
   910 00000428 A1[4C09]                    mov ax, [tick_counter_hi]
   911 0000042B E85A00                      call print_hex_word
   912 0000042E A1[4A09]                    mov ax, [tick_counter_lo]
   913 00000431 E85400                      call print_hex_word
   914                                      
   915 00000434 E84800                      call putc_crlf
   916 00000437 E925FD                      jmp monitor_loop
   917                                  
   918                                  ; ==============================================================
   919                                  ; Command: Help
   920                                  ; ==============================================================
   921                                  cmd_help:
   922 0000043A E84200                      call putc_crlf
   923 0000043D BE[6207]                    mov si, msg_help
   924 00000440 E80300                      call puts
   925 00000443 E919FD                      jmp monitor_loop
   926                                  
   927                                  ; =================================================================
   928                                  ; Utilities
   929                                  ; =================================================================
   930                                  
   931                                  ; 文字列出力
   932                                  puts:
   933 00000446 2E8A04                      mov al, [cs:si]
   934 00000449 08C0                        or al, al
   935 0000044B 7406                        jz .ret
   936 0000044D E80400                      call putc
   937 00000450 46                          inc si
   938 00000451 EBF3                        jmp puts
   939 00000453 C3                      .ret: ret
   940                                  
   941                                  ; 1文字出力
   942                                  putc:
   943 00000454 52                          push dx
   944 00000455 50                          push ax
   945 00000456 BA6120                      mov dx, SCU_SST
   946 00000459 EC                      .w: in al, dx
   947 0000045A A801                        test al, TX_READY  ; TX Ready?
   948 0000045C 74FB                        jz .w
   949 0000045E BA6020                      mov dx, SCU_DATA
   950 00000461 58                          pop ax
   951 00000462 50                          push ax
   952 00000463 EE                          out dx, al
   953 00000464 58                          pop ax
   954 00000465 5A                          pop dx
   955 00000466 C3                          ret
   956                                  
   957                                  ; 1文字入力
   958                                  getc:
   959 00000467 52                          push dx
   960 00000468 BA6120                      mov dx, SCU_SST
   961 0000046B EC                      .w: in al, dx
   962 0000046C A802                        test al, RX_READY  ; RX Ready?
   963 0000046E 74FB                        jz .w
   964 00000470 BA6020                      mov dx, SCU_DATA
   965 00000473 EC                          in al, dx
   966 00000474 5A                          pop dx
   967 00000475 C3                          ret
   968                                  
   969                                  ; 1文字入力　エコーバックあり
   970                                  getc_echo:
   971 00000476 E8EEFF                      call getc
   972 00000479 50                          push ax
   973 0000047A E8D7FF                      call putc
   974 0000047D 58                          pop ax
   975 0000047E C3                          ret
   976                                  
   977                                  ; 改行出力
   978                                  putc_crlf:
   979 0000047F B00D                        mov al, 0x0D
   980 00000481 E8D0FF                      call putc
   981 00000484 B00A                        mov al, 0x0A
   982 00000486 EBCC                        jmp putc
   983                                  
   984                                  ; -----------------------------------------------------------------
   985                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   986                                  ; Input: AX
   987                                  ; -----------------------------------------------------------------
   988                                  print_hex_word:
   989 00000488 50                          push ax
   990 00000489 88E0                        mov al, ah
   991 0000048B E80100                      call print_hex_byte
   992 0000048E 58                          pop ax
   993                                  
   994                                  ; -----------------------------------------------------------------
   995                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   996                                  ; Input: AL
   997                                  ; -----------------------------------------------------------------
   998                                  print_hex_byte:
   999 0000048F 50                          push ax
  1000 00000490 51                          push cx
  1001                                  
  1002                                      ; 上位バイトの表示
  1003 00000491 50                          push ax
  1004 00000492 C0E804                      shr al, 4
  1005 00000495 E80900                      call .digit
  1006                                  
  1007                                      ; 下位バイトの表示
  1008 00000498 58                          pop ax
  1009 00000499 240F                        and al, 0x0F
  1010 0000049B E80300                      call .digit
  1011                                  
  1012 0000049E 59                          pop cx
  1013 0000049F 58                          pop ax
  1014 000004A0 C3                          ret
  1015                                  
  1016                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
  1017                                  .digit:
  1018 000004A1 0430                        add al, '0'
  1019 000004A3 3C39                        cmp al, '9'
  1020 000004A5 7602                        jbe .p
  1021 000004A7 0407                        add al, 7
  1022 000004A9 E8A8FF                  .p: call putc
  1023 000004AC C3                          ret
  1024                                  
  1025                                  ; -----------------------------------------------------------------
  1026                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
  1027                                  ; Input:  Serial (例: "1", "0", "0", "0")
  1028                                  ; Output: AX = 0x1000
  1029                                  ; -----------------------------------------------------------------
  1030                                  get_hex_word:
  1031 000004AD 53                          push bx
  1032 000004AE E80B00                      call get_hex_byte_echo
  1033 000004B1 88C7                        mov bh, al
  1034 000004B3 E80600                      call get_hex_byte_echo
  1035 000004B6 88C3                        mov bl, al
  1036 000004B8 89D8                        mov ax, bx
  1037 000004BA 5B                          pop bx
  1038 000004BB C3                          ret
  1039                                  
  1040                                  ; 16進数2桁入力　エコーバック有り
  1041                                  get_hex_byte_echo:
  1042 000004BC 53                          push bx
  1043 000004BD E8B6FF                      call getc_echo
  1044 000004C0 E82500                      call hex_char_to_bin
  1045 000004C3 C0E004                      shl al, 4
  1046 000004C6 88C3                        mov bl, al
  1047 000004C8 E8ABFF                      call getc_echo
  1048 000004CB E81A00                      call hex_char_to_bin
  1049 000004CE 08D8                        or al, bl
  1050 000004D0 5B                          pop bx
  1051 000004D1 C3                          ret
  1052                                  
  1053                                  ; -----------------------------------------------------------------
  1054                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1055                                  ; Input:  Serial (例: "3", "F")
  1056                                  ; Output: AL = 0x3F
  1057                                  ; -----------------------------------------------------------------
  1058                                  get_hex_byte:
  1059 000004D2 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1060                                  
  1061                                      ; 上位4bit
  1062 000004D3 E891FF                      call getc
  1063 000004D6 E80F00                      call hex_char_to_bin
  1064 000004D9 C0E004                      shl al, 4
  1065 000004DC 88C3                        mov bl, al          ; 一時保存
  1066                                      
  1067                                      ; 下位4bit
  1068 000004DE E886FF                      call getc
  1069 000004E1 E80400                      call hex_char_to_bin
  1070 000004E4 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1071 000004E6 5B                          pop bx
  1072 000004E7 C3                          ret
  1073                                  
  1074                                  ; -----------------------------------------------------------------
  1075                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1076                                  ; Input: AL (ASCII)
  1077                                  ; Output: AL (Binary)
  1078                                  ; -----------------------------------------------------------------
  1079                                  hex_char_to_bin:
  1080 000004E8 2C30                        sub al, '0'
  1081 000004EA 3C09                        cmp al, 9
  1082 000004EC 7604                        jbe .done
  1083 000004EE 2C07                        sub al, 7           ; 'A'-'F'対応
  1084 000004F0 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1085                                  .done:
  1086 000004F2 C3                          ret
  1087                                  
  1088                                  ; -----------------------------------------------------------------
  1089                                  ; Helper: スペースなどを読み飛ばす
  1090                                  ; -----------------------------------------------------------------
  1091                                  skip_space:
  1092 000004F3 E880FF                      call getc_echo
  1093 000004F6 C3                          ret
  1094                                  
  1095                                  ; -----------------------------------------------------------------
  1096                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1097                                  ; -----------------------------------------------------------------
  1098                                  error:
  1099 000004F7 BE[3A07]                    mov si, msg_error
  1100 000004FA E849FF                      call puts
  1101 000004FD E95FFC                      jmp monitor_loop
  1102                                  
  1103                                  ;==========================================================
  1104                                  ; NMI (ABORT) Handler
  1105                                  ;==========================================================
  1106                                  
  1107                                  NMI_Handler:
  1108                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1109 00000500 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1110 00000501 1E                          push ds
  1111 00000502 06                          push es
  1112                                  
  1113                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1114 00000503 8CC8                        mov  ax, cs
  1115 00000505 8ED8                        mov  ds, ax
  1116 00000507 8EC0                        mov  es, ax
  1117                                  
  1118                                      ; 3. スタックフレームへのポインタ設定
  1119 00000509 89E5                        mov  bp, sp
  1120                                  
  1121                                      ; --- 画面表示 ---
  1122 0000050B BE[2508]                    mov  si, msg_nmi
  1123 0000050E E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1124                                  
  1125                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1126                                      ; Stack Layout after pushes:
  1127                                      ; BP+0: ES
  1128                                      ; BP+2: DS
  1129                                      ; BP+4: DI
  1130                                      ; BP+6: SI
  1131                                      ; BP+8: BP (Old)
  1132                                      ; BP+10: SP (Original)
  1133                                      ; BP+12: BX
  1134                                      ; BP+14: DX
  1135                                      ; BP+16: CX
  1136                                      ; BP+18: AX
  1137                                      ; BP+20: IP (Return Addr)
  1138                                      ; BP+22: CS (Return Addr)
  1139                                      ; BP+24: Flags
  1140                                      
  1141                                      ; AX
  1142 00000511 BE[3D08]                    mov  si, msg_ax
  1143 00000514 E82FFF                      call puts
  1144 00000517 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1145 0000051A E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1146                                  
  1147                                      ; BX
  1148 0000051D BE[4208]                    mov  si, msg_bx
  1149 00000520 E823FF                      call puts
  1150 00000523 8B460C                      mov  ax, [bp+12]
  1151 00000526 E85FFF                      call print_hex_word
  1152                                  
  1153                                      ; CX
  1154 00000529 BE[4708]                    mov  si, msg_cx
  1155 0000052C E817FF                      call puts
  1156 0000052F 8B4610                      mov  ax, [bp+16]
  1157 00000532 E853FF                      call print_hex_word
  1158                                  
  1159                                      ; DX
  1160 00000535 BE[4C08]                    mov  si, msg_dx
  1161 00000538 E80BFF                      call puts
  1162 0000053B 8B460E                      mov  ax, [bp+14]
  1163 0000053E E847FF                      call print_hex_word
  1164                                  
  1165 00000541 E83BFF                      call putc_crlf
  1166                                  
  1167                                      ; --- 中断地点 (CS:IP) の表示 ---
  1168                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1169                                      ; その上が割り込み発生時の IP, CS, Flags です
  1170                                      
  1171 00000544 BE[5108]                    mov  si, msg_addr
  1172 00000547 E8FCFE                      call puts           ; " Stop at "
  1173 0000054A 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1174 0000054D E838FF                      call print_hex_word
  1175 00000550 B03A                        mov  al, ':'
  1176 00000552 E8FFFE                      call putc
  1177 00000555 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1178 00000558 E82DFF                      call print_hex_word
  1179                                  
  1180 0000055B E821FF                      call putc_crlf
  1181                                  
  1182                                      ; 4. 復帰処理
  1183                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1184                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1185 0000055E E99FFA                      jmp  start  ; モニタの開始ラベルへ
  1186                                  
  1187                                  ; ==========================================================
  1188                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1189                                  ; ==========================================================
  1190                                  
  1191                                  ; --- 共通処理部 (Common Handler) ---
  1192                                  _default_int_handler:
  1193                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1194 00000561 55                          push bp
  1195 00000562 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1196 00000563 1E                          push ds
  1197 00000564 06                          push es
  1198                                  
  1199                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1200 00000565 8CC8                        mov  ax, cs
  1201 00000567 8ED8                        mov  ds, ax
  1202 00000569 8EC0                        mov  es, ax
  1203                                  
  1204                                      ; 3. スタックフレームへのポインタ設定
  1205 0000056B 89E5                        mov  bp, sp
  1206                                  
  1207                                      ; --- メッセージ表示 ---
  1208 0000056D BE[6308]                    mov  si, msg_int_trap
  1209 00000570 E8D3FE                      call puts           ; "** INT "
  1210                                  
  1211                                      ; --- ベクタ番号の表示 ---
  1212                                      ; スタック構造:
  1213                                      ; [BP+0] Old BP
  1214                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1215                                      ; [BP+4] Return IP ...
  1216                                      
  1217 00000573 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1218 00000576 E816FF                      call print_hex_byte ; 表示 (例: 25)
  1219                                  
  1220 00000579 BE[6B08]                    mov  si, msg_detected
  1221 0000057C E8C7FE                      call puts           ; " detected **" (改行含む)
  1222                                  
  1223                                  ; 3. レジスタ表示 (スタックから読み出して表示)
  1224                                      ; Stack Layout after pushes:
  1225                                      ; BP+0: ES
  1226                                      ; BP+2: DS
  1227                                      ; BP+4: DI
  1228                                      ; BP+6: SI
  1229                                      ; BP+8: BP (Old)
  1230                                      ; BP+10: SP (Original)
  1231                                      ; BP+12: BX
  1232                                      ; BP+14: DX
  1233                                      ; BP+16: CX
  1234                                      ; BP+18: AX
  1235                                      ; BP+20: IP (Return Addr)
  1236                                      ; BP+22: CS (Return Addr)
  1237                                      ; BP+24: Flags
  1238                                      
  1239                                      ; AX
  1240 0000057F BE[3D08]                    mov  si, msg_ax
  1241 00000582 E8C1FE                      call puts
  1242 00000585 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1243 00000588 E8FDFE                      call print_hex_word     ; 4桁HEX表示ルーチン
  1244                                  
  1245                                      ; BX
  1246 0000058B BE[4208]                    mov  si, msg_bx
  1247 0000058E E8B5FE                      call puts
  1248 00000591 8B460C                      mov  ax, [bp+12]
  1249 00000594 E8F1FE                      call print_hex_word
  1250                                  
  1251                                      ; CX
  1252 00000597 BE[4708]                    mov  si, msg_cx
  1253 0000059A E8A9FE                      call puts
  1254 0000059D 8B4610                      mov  ax, [bp+16]
  1255 000005A0 E8E5FE                      call print_hex_word
  1256                                  
  1257                                      ; DX
  1258 000005A3 BE[4C08]                    mov  si, msg_dx
  1259 000005A6 E89DFE                      call puts
  1260 000005A9 8B460E                      mov  ax, [bp+14]
  1261 000005AC E8D9FE                      call print_hex_word
  1262                                  
  1263 000005AF E8CDFE                      call putc_crlf
  1264                                  
  1265                                      ; --- 中断地点 (CS:IP) の表示 ---
  1266                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1267                                      ; その上が割り込み発生時の IP, CS, Flags です
  1268                                      
  1269 000005B2 BE[5108]                    mov  si, msg_addr
  1270 000005B5 E88EFE                      call puts           ; " Stop at "
  1271 000005B8 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1272 000005BB E8CAFE                      call print_hex_word
  1273 000005BE B03A                        mov  al, ':'
  1274 000005C0 E891FE                      call putc
  1275 000005C3 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1276 000005C6 E8BFFE                      call print_hex_word
  1277                                  
  1278 000005C9 E8B3FE                      call putc_crlf
  1279                                  
  1280                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1281 000005CC B020                        mov al, 20h         ; Non-specific EOI
  1282 000005CE E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1283 000005D0 BA8020                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1284 000005D3 EE                          out dx, al
  1285                                  
  1286 000005D4 07                          pop  es
  1287 000005D5 1F                          pop  ds
  1288 000005D6 61                          popa
  1289 000005D7 5D                          pop  bp
  1290 000005D8 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1291 000005DB CF                          iret
  1292                                  
  1293                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1294                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1295                                  
  1296 000005DC 6A00                    _isr_stub_0:  push 0x0          ; 0: Division by zero
  1297 000005DE EB81                                  jmp _default_int_handler
  1298 000005E0 6A01                    _isr_stub_1:  push 0x1          ; 1: Break flag
  1299 000005E2 E97CFF                                jmp _default_int_handler
  1300                                                                  ; 2: NMI
  1301 000005E5 6A03                    _isr_stub_3:  push 0x3          ; 3: BRK3
  1302 000005E7 E977FF                                jmp _default_int_handler
  1303 000005EA 6A04                    _isr_stub_4:  push 0x4          ; 4: BRKV
  1304 000005EC E972FF                                jmp _default_int_handler
  1305 000005EF 6A05                    _isr_stub_5:  push 0x5          ; 5: CHKIND
  1306 000005F1 E96DFF                                jmp _default_int_handler
  1307                                  
  1308 000005F4 6A20                    _isr_stub_20: push 0x0020       ; 32: ICU INTP0
  1309 000005F6 E968FF                                jmp _default_int_handler
  1310 000005F9 6A21                    _isr_stub_21: push 0x0021       ; 33: ICU INTP1
  1311 000005FB E963FF                                jmp _default_int_handler
  1312 000005FE 6A22                    _isr_stub_22: push 0x0022       ; 34: ICU INTP2
  1313 00000600 E95EFF                                jmp _default_int_handler
  1314 00000603 6A23                    _isr_stub_23: push 0x0023       ; 35: ICU INTP3
  1315 00000605 E959FF                                jmp _default_int_handler
  1316 00000608 6A24                    _isr_stub_24: push 0x0024       ; 36: ICU INTP4
  1317 0000060A E954FF                                jmp _default_int_handler
  1318 0000060D 6A25                    _isr_stub_25: push 0x0025       ; 37: ICU INTP5
  1319 0000060F E94FFF                                jmp _default_int_handler
  1320 00000612 6A26                    _isr_stub_26: push 0x0026       ; 38: ICU INTP6
  1321 00000614 E94AFF                                jmp _default_int_handler
  1322                                  
  1323                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1324                                  
  1325                                  ; ==========================================================
  1326                                  ; PIC Dispatch Handler (Vector 27h)
  1327                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1328                                  ; ==========================================================
  1329                                  _pic_dispatch_handler:
  1330 00000617 60                          pusha
  1331 00000618 1E                          push ds
  1332 00000619 06                          push es
  1333                                  
  1334                                      ; DS設定 (Tiny Model)
  1335 0000061A 8CC8                        mov ax, cs
  1336 0000061C 8ED8                        mov ds, ax
  1337                                  
  1338                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1339                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1340 0000061E B00B                        mov al, 0x0B
  1341 00000620 E6C8                        out PIC_REG0, al
  1342 00000622 E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1343                                  
  1344                                      ; --- 2. 要因判定と分岐 ---
  1345                                      
  1346 00000624 A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1347 00000626 751E                        jnz .handle_timer0
  1348                                  
  1349 00000628 A802                        test al, 02h        ; Bit 1: SCSI
  1350 0000062A 7526                        jnz .handle_scsi
  1351                                  
  1352 0000062C A804                        test al, 04h        ; Bit 2: Timer 1
  1353 0000062E 752A                        jnz .handle_timer1
  1354                                  
  1355 00000630 A808                        test al, 08h        ; Bit 3: USART Rx
  1356 00000632 752E                        jnz .handle_usart_rx
  1357                                  
  1358 00000634 A810                        test al, 10h        ; Bit 4: USART Tx
  1359 00000636 7532                        jnz .handle_usart_tx
  1360                                  
  1361 00000638 A820                        test al, 20h        ; Bit 5: SCU Rx
  1362 0000063A 7536                        jnz .handle_scu_rx
  1363                                  
  1364 0000063C A840                        test al, 40h        ; Bit 6: SCU Tx
  1365 0000063E 753A                        jnz .handle_scu_tx
  1366                                  
  1367 00000640 A880                        test al, 80h        ; Bit 7: PPI
  1368 00000642 753E                        jnz .handle_ppi
  1369                                  
  1370                                      ; 該当なしの場合は無視
  1371 00000644 EB44                        jmp .eoi_exit
  1372                                  
  1373                                  ; --- 各ハンドラ処理 ---
  1374                                  
  1375                                  .handle_timer0:
  1376                                      ; INTP0: Timer 0 (Tick)
  1377                                      ; --- 32bit カウンタのインクリメント ---
  1378 00000646 FF06[4A09]                  inc word [tick_counter_lo]
  1379 0000064A 7504                        jnz .skip_carry
  1380 0000064C FF06[4C09]                  inc word [tick_counter_hi]
  1381                                  .skip_carry:
  1382 00000650 EB38                        jmp .eoi_exit
  1383                                  
  1384                                  .handle_scsi:
  1385                                      ; INTP1: SCSIC
  1386 00000652 BE[7808]                    mov si, msg_int_scsi
  1387 00000655 E8EEFD                      call puts
  1388 00000658 EB30                        jmp .eoi_exit
  1389                                  
  1390                                  .handle_timer1:
  1391                                      ; INTP2: ユーザ用タイマー
  1392 0000065A BE[8F08]                    mov si, msg_int_timer1
  1393 0000065D E8E6FD                      call puts
  1394 00000660 EB28                        jmp .eoi_exit
  1395                                  
  1396                                  .handle_usart_rx:
  1397                                      ; INTP3: USART受信準備完了割り込み
  1398 00000662 BE[A808]                    mov si, msg_int_usart_rx
  1399 00000665 E8DEFD                      call puts
  1400 00000668 EB20                        jmp .eoi_exit
  1401                                  
  1402                                  .handle_usart_tx:
  1403                                      ; INTP4: USART送信完了割り込み
  1404 0000066A BE[C308]                    mov si, msg_int_usart_tx
  1405 0000066D E8D6FD                      call puts
  1406 00000670 EB18                        jmp .eoi_exit
  1407                                  
  1408                                  .handle_scu_rx:
  1409                                      ; INTP5: SCU受信準備完了割り込み
  1410 00000672 BE[DE08]                    mov si, msg_int_scu_rx
  1411 00000675 E8CEFD                      call puts
  1412 00000678 EB10                        jmp .eoi_exit
  1413                                  
  1414                                  .handle_scu_tx:
  1415                                      ; INTP6: SCU送信完了割り込み
  1416 0000067A BE[F708]                    mov si, msg_int_scu_tx
  1417 0000067D E8C6FD                      call puts
  1418 00000680 EB08                        jmp .eoi_exit
  1419                                  
  1420                                  .handle_ppi:
  1421                                      ; INTP7: PPI割り込み
  1422 00000682 BE[1009]                    mov si, msg_int_ppi
  1423 00000685 E8BEFD                      call puts
  1424 00000688 EB00                        jmp .eoi_exit
  1425                                  
  1426                                  ; --- 終了処理 ---
  1427                                  .eoi_exit:
  1428                                      ; --- EOI (End of Interrupt) to PIC ---
  1429 0000068A B020                        mov al, 20h     ; Non-specific EOI
  1430                                  
  1431                                      ; 外部PIC (Slave) の割り込み完了
  1432 0000068C E6C8                        out PIC_REG0, al
  1433                                  
  1434                                      ; V53内蔵ICU (Master) の割り込み完了
  1435 0000068E BA8020                      mov dx, ICU_REG0 
  1436 00000691 EE                          out dx, al
  1437                                  
  1438 00000692 07                          pop es
  1439 00000693 1F                          pop ds
  1440 00000694 61                          popa
  1441 00000695 CF                          iret
  1442                                  
  1443                                  ;--------------------------------------
  1444                                  ; 未定義割り込みベクタ用の簡易トラップ
  1445                                  ;--------------------------------------
  1446                                  _default_int_unknown_handler:
  1447                                      ; 想定外の割り込みが発生したため、
  1448                                      ; 画面に "UNKNOWN INT" と出して停止する
  1449 00000696 FA                          cli                 ; 多重割り込み禁止
  1450                                  
  1451                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1452 00000697 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1453 00000698 1E                          push ds
  1454 00000699 06                          push es
  1455                                  
  1456                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1457 0000069A 8CC8                        mov  ax, cs
  1458 0000069C 8ED8                        mov  ds, ax
  1459 0000069E 8EC0                        mov  es, ax
  1460                                  
  1461                                      ; 3. スタックフレームへのポインタ設定
  1462 000006A0 89E5                        mov  bp, sp
  1463                                  
  1464 000006A2 BE[2609]                    mov si, msg_unknown_int
  1465 000006A5 E89EFD                      call puts
  1466                                  
  1467                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1468                                      ; Stack Layout after pushes:
  1469                                      ; BP+0: ES
  1470                                      ; BP+2: DS
  1471                                      ; BP+4: DI
  1472                                      ; BP+6: SI
  1473                                      ; BP+8: BP (Old)
  1474                                      ; BP+10: SP (Original)
  1475                                      ; BP+12: BX
  1476                                      ; BP+14: DX
  1477                                      ; BP+16: CX
  1478                                      ; BP+18: AX
  1479                                      ; BP+20: IP (Return Addr)
  1480                                      ; BP+22: CS (Return Addr)
  1481                                      ; BP+24: Flags
  1482                                      
  1483                                      ; AX
  1484 000006A8 BE[3D08]                    mov  si, msg_ax
  1485 000006AB E898FD                      call puts
  1486 000006AE 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1487 000006B1 E8D4FD                      call print_hex_word     ; 4桁HEX表示ルーチン
  1488                                  
  1489                                      ; BX
  1490 000006B4 BE[4208]                    mov  si, msg_bx
  1491 000006B7 E88CFD                      call puts
  1492 000006BA 8B460C                      mov  ax, [bp+12]
  1493 000006BD E8C8FD                      call print_hex_word
  1494                                  
  1495                                      ; CX
  1496 000006C0 BE[4708]                    mov  si, msg_cx
  1497 000006C3 E880FD                      call puts
  1498 000006C6 8B4610                      mov  ax, [bp+16]
  1499 000006C9 E8BCFD                      call print_hex_word
  1500                                  
  1501                                      ; DX
  1502 000006CC BE[4C08]                    mov  si, msg_dx
  1503 000006CF E874FD                      call puts
  1504 000006D2 8B460E                      mov  ax, [bp+14]
  1505 000006D5 E8B0FD                      call print_hex_word
  1506                                  
  1507 000006D8 E8A4FD                      call putc_crlf
  1508                                  
  1509                                      ; --- 中断地点 (CS:IP) の表示 ---
  1510                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1511                                      ; その上が割り込み発生時の IP, CS, Flags です
  1512                                      
  1513 000006DB BE[5108]                    mov  si, msg_addr
  1514 000006DE E865FD                      call puts           ; " Stop at "
  1515 000006E1 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1516 000006E4 E8A1FD                      call print_hex_word
  1517 000006E7 B03A                        mov  al, ':'
  1518 000006E9 E868FD                      call putc
  1519 000006EC 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1520 000006EF E896FD                      call print_hex_word
  1521                                  
  1522 000006F2 E88AFD                      call putc_crlf
  1523                                  
  1524                                      ; 4. 復帰処理
  1525                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1526                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1527 000006F5 E908F9                      jmp  start  ; モニタの開始ラベルへ
  1528                                  
  1529                                      ; 停止（暴走を防ぐ）
  1530                                  ;.halt:
  1531                                  ;    hlt
  1532                                  ;    jmp .halt
  1533                                  
