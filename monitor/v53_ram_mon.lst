   793                                  ; ==============================================================
   794                                  ; Command: Scan I/O Ports
   795                                  ; Usage:
   796                                  ;   S <Start_port> <End_port>
   797                                  ; Description: Reads ports and prints if value is NOT 0xFF
   798                                  ; ==============================================================
   799                                  do_scan:
   800 0000039F E8EE00                      call getc_echo
   801 000003A2 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   802 000003A4 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   803                                  
   804 000003A9 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   805 000003AC 89C3                        mov bx, ax          ; BX = Start Address
   806                                      
   807 000003AE E8DF00                      call getc_echo
   808 000003B1 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   809 000003B3 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   810                                  
   811 000003B5 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   812 000003B8 89C1                        mov cx, ax          ; CX = End Address
   813                                  
   814 000003BA 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   815 000003BC 7603E95001                  ja error
   816                                  
   817 000003C1 E8D500                      call putc_crlf
   818 000003C4 BE[0008]                    mov si, msg_scan_start
   819 000003C7 E89600                      call puts
   820                                  
   821                                  .scan_loop:
   822 000003CA 89DA                        mov dx, bx          ; DXにポートアドレス設定
   823 000003CC EC                          in al, dx           ; I/O Read
   824                                  
   825 000003CD 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   826 000003CF 741D                        je .next_port
   827                                  
   828 000003D1 50                          push ax             ; Readした値をスタックに保存
   829                                  
   830                                      ; --- 有効な値が見つかった場合の表示 ---
   831                                      ; [Port]: Value
   832 000003D2 89D8                        mov ax, bx
   833 000003D4 E8CB00                      call print_hex_word ; ポートアドレスの表示
   834 000003D7 B03A                        mov al, ':'
   835 000003D9 E89200                      call putc
   836 000003DC B020                        mov al, ' '
   837 000003DE E88D00                      call putc
   838                                      
   839 000003E1 58                          pop ax
   840 000003E2 E8C400                      call print_hex_byte ; Readした値の表示
   841                                      
   842 000003E5 BE[2B08]                    mov si, msg_space   ; "  "
   843 000003E8 E87500                      call puts
   844                                  
   845                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   846                                      ; ここでは単純にリスト形式で改行します
   847 000003EB E8AB00                      call putc_crlf
   848                                  
   849                                  .next_port:
   850 000003EE 43                          inc bx              ; 次のアドレスへ
   851                                      
   852                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   853 000003EF BA61F0                      mov dx, SCU_SST
   854 000003F2 EC                          in al, dx
   855 000003F3 A802                        test al, RX_READY   ; RxRDY?
   856 000003F5 750D                        jnz .abort          ; 何かキーが押されたら中断
   857                                  
   858 000003F7 39CB                        cmp bx, cx
   859 000003F9 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   860                                  
   861 000003FB BE[7107]                    mov si, msg_done
   862 000003FE E85F00                      call puts
   863 00000401 E96CFD                      jmp monitor_loop
