   728                                  ; ==============================================================
   729                                  ; Command: Scan I/O Ports
   730                                  ; Usage:
   731                                  ;   S <Start_port> <End_port>
   732                                  ; Description: Reads ports and prints if value is NOT 0xFF
   733                                  ; ==============================================================
   734                                  do_scan:
   735 0000034D E8EE00                      call getc_echo
   736 00000350 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   737 00000352 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   738                                  
   739 00000357 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   740 0000035A 89C3                        mov bx, ax          ; BX = Start Address
   741                                      
   742 0000035C E8DF00                      call getc_echo
   743 0000035F 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   744 00000361 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   745                                  
   746 00000363 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   747 00000366 89C1                        mov cx, ax          ; CX = End Address
   748                                  
   749 00000368 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   750 0000036A 7603E95001                  ja error
   751                                  
   752 0000036F E8D500                      call putc_crlf
   753 00000372 BE[EC06]                    mov si, msg_scan_start
   754 00000375 E89600                      call puts
   755                                  
   756                                  .scan_loop:
   757 00000378 89DA                        mov dx, bx          ; DXにポートアドレス設定
   758 0000037A EC                          in al, dx           ; I/O Read
   759                                  
   760 0000037B 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   761 0000037D 741D                        je .next_port
   762                                  
   763 0000037F 50                          push ax             ; Readした値をスタックに保存
   764                                  
   765                                      ; --- 有効な値が見つかった場合の表示 ---
   766                                      ; [Port]: Value
   767 00000380 89D8                        mov ax, bx
   768 00000382 E8CB00                      call print_hex_word ; ポートアドレスの表示
   769 00000385 B03A                        mov al, ':'
   770 00000387 E89200                      call putc
   771 0000038A B020                        mov al, ' '
   772 0000038C E88D00                      call putc
   773                                      
   774 0000038F 58                          pop ax
   775 00000390 E8C400                      call print_hex_byte ; Readした値の表示
   776                                      
   777 00000393 BE[1707]                    mov si, msg_space   ; "  "
   778 00000396 E87500                      call puts
   779                                  
   780                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   781                                      ; ここでは単純にリスト形式で改行します
   782 00000399 E8AB00                      call putc_crlf
   783                                  
   784                                  .next_port:
   785 0000039C 43                          inc bx              ; 次のアドレスへ
   786                                      
   787                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   788 0000039D BA6112                      mov dx, SCU_SST
   789 000003A0 EC                          in al, dx
   790 000003A1 A802                        test al, RX_READY   ; RxRDY?
   791 000003A3 750D                        jnz .abort          ; 何かキーが押されたら中断
   792                                  
   793 000003A5 39CB                        cmp bx, cx
   794 000003A7 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   795                                  
   796 000003A9 BE[5E06]                    mov si, msg_done
   797 000003AC E85F00                      call puts
   798 000003AF E975FD                      jmp monitor_loop
   799                                  
   800                                  .abort:
   801                                      ; 入力バッファを空読みしておく
   802 000003B2 BA6012                      mov dx, SCU_DATA
   803 000003B5 EC                          in al, dx
   804 000003B6 BE[1A07]                    mov si, msg_abort
   805 000003B9 E85200                      call puts
   806 000003BC E968FD                      jmp monitor_loop
   807                                  
   808                                  ; ==============================================================
   809                                  ; Command: Timer (ms)
   810                                  ;   T          -> Show current tick counter (32-bit HEX)
   811                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   812                                  ; ==============================================================
   813                                  do_timer:
   814 000003BF E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   815 000003C2 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   816 000003C4 7421                        je .show_counter
   817 000003C6 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   818 000003C8 7403E9F200                  jne error           ; それ以外はエラー
   819                                  
   820                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   821 000003CD E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   822                                  
   823                                      ; 開始時刻を保存 (Start Time)
   824 000003D0 8B1E[5108]                  mov bx, [tick_counter_lo]
   825                                  
   826                                  .wait_loop:
   827                                      ; 1. 現在時刻を取得
   828 000003D4 8B0E[5108]                  mov cx, [tick_counter_lo]
   829                                      
   830                                      ; 2. 経過時間を計算 (Current - Start)
   831                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   832 000003D8 29D9                        sub cx, bx          
   833                                      
   834                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   835 000003DA 39C1                        cmp cx, ax
   836 000003DC 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   837                                  
   838                                      ; 指定時間経過した
   839 000003DE BE[5E06]                    mov si, msg_done
   840 000003E1 E82A00                      call puts
   841 000003E4 E940FD                      jmp monitor_loop
   842                                  
   843                                  .show_counter:
   844                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   845 000003E7 E85D00                      call putc_crlf
   846                                      
   847 000003EA BE[2507]                    mov si, msg_tick    ; "Tick: "
   848 000003ED E81E00                      call puts
   849                                  
   850                                      ; 32bitカウンタを [High][Low] の順で表示
   851 000003F0 A1[5308]                    mov ax, [tick_counter_hi]
   852 000003F3 E85A00                      call print_hex_word
   853 000003F6 A1[5108]                    mov ax, [tick_counter_lo]
   854 000003F9 E85400                      call print_hex_word
   855                                      
   856 000003FC E84800                      call putc_crlf
   857 000003FF E925FD                      jmp monitor_loop
   858                                  
   859                                  ; ==============================================================
   860                                  ; Command: Help
   861                                  ; ==============================================================
   862                                  cmd_help:
   863 00000402 E84200                      call putc_crlf
   864 00000405 BE[6A06]                    mov si, msg_help
   865 00000408 E80300                      call puts
   866 0000040B E919FD                      jmp monitor_loop
   867                                  
   868                                  ; =================================================================
   869                                  ; Utilities
   870                                  ; =================================================================
   871                                  
   872                                  ; 文字列出力
   873                                  puts:
   874 0000040E 2E8A04                      mov al, [cs:si]
   875 00000411 08C0                        or al, al
   876 00000413 7406                        jz .ret
   877 00000415 E80400                      call putc
   878 00000418 46                          inc si
   879 00000419 EBF3                        jmp puts
   880 0000041B C3                      .ret: ret
   881                                  
   882                                  ; 1文字出力
   883                                  putc:
   884 0000041C 52                          push dx
   885 0000041D 50                          push ax
   886 0000041E BA6112                      mov dx, SCU_SST
   887 00000421 EC                      .w: in al, dx
   888 00000422 A801                        test al, TX_READY  ; TX Ready?
   889 00000424 74FB                        jz .w
   890 00000426 BA6012                      mov dx, SCU_DATA
   891 00000429 58                          pop ax
   892 0000042A 50                          push ax
   893 0000042B EE                          out dx, al
   894 0000042C 58                          pop ax
   895 0000042D 5A                          pop dx
   896 0000042E C3                          ret
   897                                  
   898                                  ; 1文字入力
   899                                  getc:
   900 0000042F 52                          push dx
   901 00000430 BA6112                      mov dx, SCU_SST
   902 00000433 EC                      .w: in al, dx
   903 00000434 A802                        test al, RX_READY  ; RX Ready?
   904 00000436 74FB                        jz .w
   905 00000438 BA6012                      mov dx, SCU_DATA
   906 0000043B EC                          in al, dx
   907 0000043C 5A                          pop dx
   908 0000043D C3                          ret
   909                                  
   910                                  ; 1文字入力　エコーバックあり
   911                                  getc_echo:
   912 0000043E E8EEFF                      call getc
   913 00000441 50                          push ax
   914 00000442 E8D7FF                      call putc
   915 00000445 58                          pop ax
   916 00000446 C3                          ret
   917                                  
   918                                  ; 改行出力
   919                                  putc_crlf:
   920 00000447 B00D                        mov al, 0x0D
   921 00000449 E8D0FF                      call putc
   922 0000044C B00A                        mov al, 0x0A
   923 0000044E EBCC                        jmp putc
   924                                  
   925                                  ; -----------------------------------------------------------------
   926                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   927                                  ; Input: AX
   928                                  ; -----------------------------------------------------------------
   929                                  print_hex_word:
   930 00000450 50                          push ax
   931 00000451 88E0                        mov al, ah
   932 00000453 E80100                      call print_hex_byte
   933 00000456 58                          pop ax
   934                                  
   935                                  ; -----------------------------------------------------------------
   936                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   937                                  ; Input: AL
   938                                  ; -----------------------------------------------------------------
   939                                  print_hex_byte:
   940 00000457 50                          push ax
   941 00000458 51                          push cx
   942                                  
   943                                      ; 上位バイトの表示
   944 00000459 50                          push ax
   945 0000045A C0E804                      shr al, 4
   946 0000045D E80900                      call .digit
   947                                  
   948                                      ; 下位バイトの表示
   949 00000460 58                          pop ax
   950 00000461 240F                        and al, 0x0F
   951 00000463 E80300                      call .digit
   952                                  
   953 00000466 59                          pop cx
   954 00000467 58                          pop ax
   955 00000468 C3                          ret
   956                                  
   957                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   958                                  .digit:
   959 00000469 0430                        add al, '0'
   960 0000046B 3C39                        cmp al, '9'
   961 0000046D 7602                        jbe .p
   962 0000046F 0407                        add al, 7
   963 00000471 E8A8FF                  .p: call putc
   964 00000474 C3                          ret
   965                                  
   966                                  ; -----------------------------------------------------------------
   967                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   968                                  ; Input:  Serial (例: "1", "0", "0", "0")
   969                                  ; Output: AX = 0x1000
   970                                  ; -----------------------------------------------------------------
   971                                  get_hex_word:
   972 00000475 53                          push bx
   973 00000476 E80B00                      call get_hex_byte_echo
   974 00000479 88C7                        mov bh, al
   975 0000047B E80600                      call get_hex_byte_echo
   976 0000047E 88C3                        mov bl, al
   977 00000480 89D8                        mov ax, bx
   978 00000482 5B                          pop bx
   979 00000483 C3                          ret
   980                                  
   981                                  ; 16進数2桁入力　エコーバック有り
   982                                  get_hex_byte_echo:
   983 00000484 53                          push bx
   984 00000485 E8B6FF                      call getc_echo
   985 00000488 E82500                      call hex_char_to_bin
   986 0000048B C0E004                      shl al, 4
   987 0000048E 88C3                        mov bl, al
   988 00000490 E8ABFF                      call getc_echo
   989 00000493 E81A00                      call hex_char_to_bin
   990 00000496 08D8                        or al, bl
   991 00000498 5B                          pop bx
   992 00000499 C3                          ret
   993                                  
   994                                  ; -----------------------------------------------------------------
   995                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   996                                  ; Input:  Serial (例: "3", "F")
   997                                  ; Output: AL = 0x3F
   998                                  ; -----------------------------------------------------------------
   999                                  get_hex_byte:
  1000 0000049A 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1001                                  
  1002                                      ; 上位4bit
  1003 0000049B E891FF                      call getc
  1004 0000049E E80F00                      call hex_char_to_bin
  1005 000004A1 C0E004                      shl al, 4
  1006 000004A4 88C3                        mov bl, al          ; 一時保存
  1007                                      
  1008                                      ; 下位4bit
  1009 000004A6 E886FF                      call getc
  1010 000004A9 E80400                      call hex_char_to_bin
  1011 000004AC 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1012 000004AE 5B                          pop bx
  1013 000004AF C3                          ret
  1014                                  
  1015                                  ; -----------------------------------------------------------------
  1016                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1017                                  ; Input: AL (ASCII)
  1018                                  ; Output: AL (Binary)
  1019                                  ; -----------------------------------------------------------------
  1020                                  hex_char_to_bin:
  1021 000004B0 2C30                        sub al, '0'
  1022 000004B2 3C09                        cmp al, 9
  1023 000004B4 7604                        jbe .done
  1024 000004B6 2C07                        sub al, 7           ; 'A'-'F'対応
  1025 000004B8 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1026                                  .done:
  1027 000004BA C3                          ret
  1028                                  
  1029                                  ; -----------------------------------------------------------------
  1030                                  ; Helper: スペースなどを読み飛ばす
  1031                                  ; -----------------------------------------------------------------
  1032                                  skip_space:
  1033 000004BB E880FF                      call getc_echo
  1034 000004BE C3                          ret
  1035                                  
  1036                                  ; -----------------------------------------------------------------
  1037                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1038                                  ; -----------------------------------------------------------------
  1039                                  error:
  1040 000004BF BE[4206]                    mov si, msg_error
  1041 000004C2 E849FF                      call puts
  1042 000004C5 E95FFC                      jmp monitor_loop
  1043                                  
  1044                                  ;==========================================================
  1045                                  ; NMI (ABORT) Handler
  1046                                  ;==========================================================
  1047                                  
  1048                                  NMI_Handler:
  1049                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1050 000004C8 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1051 000004C9 1E                          push ds
  1052 000004CA 06                          push es
  1053                                  
  1054                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1055 000004CB 8CC8                        mov  ax, cs
  1056 000004CD 8ED8                        mov  ds, ax
  1057 000004CF 8EC0                        mov  es, ax
  1058                                  
  1059                                      ; 3. スタックフレームへのポインタ設定
  1060 000004D1 89E5                        mov  bp, sp
  1061                                  
  1062                                      ; --- 画面表示 ---
  1063 000004D3 BE[2C07]                    mov  si, msg_nmi
  1064 000004D6 E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1065                                  
  1066                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1067                                      ; Stack Layout after pushes:
  1068                                      ; BP+0: ES
  1069                                      ; BP+2: DS
  1070                                      ; BP+4: DI
  1071                                      ; BP+6: SI
  1072                                      ; BP+8: BP (Old)
  1073                                      ; BP+10: SP (Original)
  1074                                      ; BP+12: BX
  1075                                      ; BP+14: DX
  1076                                      ; BP+16: CX
  1077                                      ; BP+18: AX
  1078                                      ; BP+20: IP (Return Addr)
  1079                                      ; BP+22: CS (Return Addr)
  1080                                      ; BP+24: Flags
  1081                                      
  1082                                      ; AX
  1083 000004D9 BE[4407]                    mov  si, msg_ax
  1084 000004DC E82FFF                      call puts
  1085 000004DF 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1086 000004E2 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1087                                  
  1088                                      ; BX
  1089 000004E5 BE[4907]                    mov  si, msg_bx
  1090 000004E8 E823FF                      call puts
  1091 000004EB 8B460C                      mov  ax, [bp+12]
  1092 000004EE E85FFF                      call print_hex_word
  1093                                  
  1094                                      ; CX
  1095 000004F1 BE[4E07]                    mov  si, msg_cx
  1096 000004F4 E817FF                      call puts
  1097 000004F7 8B4610                      mov  ax, [bp+16]
  1098 000004FA E853FF                      call print_hex_word
  1099                                  
  1100                                      ; DX
  1101 000004FD BE[5307]                    mov  si, msg_dx
  1102 00000500 E80BFF                      call puts
  1103 00000503 8B460E                      mov  ax, [bp+14]
  1104 00000506 E847FF                      call print_hex_word
  1105                                  
  1106 00000509 E83BFF                      call putc_crlf
  1107                                  
  1108                                      ; --- 中断地点 (CS:IP) の表示 ---
  1109                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1110                                      ; その上が割り込み発生時の IP, CS, Flags です
  1111                                      
  1112 0000050C BE[5807]                    mov  si, msg_addr
  1113 0000050F E8FCFE                      call puts           ; " Stop at "
  1114 00000512 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1115 00000515 E838FF                      call print_hex_word
  1116 00000518 B03A                        mov  al, ':'
  1117 0000051A E8FFFE                      call putc
  1118 0000051D 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1119 00000520 E82DFF                      call print_hex_word
  1120                                  
  1121 00000523 E821FF                      call putc_crlf
  1122                                  
  1123                                      ; 4. 復帰処理
  1124                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1125                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1126 00000526 E9D7FA                      jmp  start  ; モニタの開始ラベルへ
  1127                                  
  1128                                  ; ==========================================================
  1129                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1130                                  ; ==========================================================
  1131                                  
  1132                                  ; --- 共通処理部 (Common Handler) ---
  1133                                  _default_int_handler:
  1134 00000529 55                          push bp
  1135 0000052A 89E5                        mov  bp, sp
  1136 0000052C 60                          pusha               ; 全レジスタ保存 (AX,CX,DX,BX,SP,BP,SI,DI)
  1137 0000052D 1E                          push ds
  1138 0000052E 06                          push es
  1139                                  
  1140                                      ; セグメント設定 (Tiny Model的な動作のためCSをDS/ESにコピー)
  1141 0000052F 8CC8                        mov  ax, cs
  1142 00000531 8ED8                        mov  ds, ax
  1143 00000533 8EC0                        mov  es, ax
  1144                                  
  1145                                      ; --- メッセージ表示 ---
  1146 00000535 BE[6A07]                    mov  si, msg_int_trap
  1147 00000538 E8D3FE                      call puts           ; "** INT "
  1148                                  
  1149                                      ; --- ベクタ番号の表示 ---
  1150                                      ; スタック構造:
  1151                                      ; [BP+0] Old BP
  1152                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1153                                      ; [BP+4] Return IP ...
  1154                                      
  1155 0000053B 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1156 0000053E E816FF                      call print_hex_byte ; 表示 (例: 25)
  1157                                  
  1158 00000541 BE[7207]                    mov  si, msg_detected
  1159 00000544 E8C7FE                      call puts           ; " detected **" (改行含む)
  1160                                  
  1161                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1162 00000547 B020                        mov al, 20h         ; Non-specific EOI
  1163 00000549 E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1164 0000054B BA8012                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1165 0000054E EE                          out dx, al
  1166                                  
  1167 0000054F 07                          pop  es
  1168 00000550 1F                          pop  ds
  1169 00000551 61                          popa
  1170 00000552 5D                          pop  bp
  1171 00000553 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1172 00000556 CF                          iret
  1173                                  
  1174                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1175                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1176                                  
  1177 00000557 6A20                    _isr_stub_20: push 0x0020       ; ICU INTP0
  1178 00000559 EBCE                                  jmp _default_int_handler
  1179 0000055B 6A21                    _isr_stub_21: push 0x0021       ; ICU INTP1
  1180 0000055D EBCA                                  jmp _default_int_handler
  1181 0000055F 6A22                    _isr_stub_22: push 0x0022       ; ICU INTP2
  1182 00000561 EBC6                                  jmp _default_int_handler
  1183 00000563 6A23                    _isr_stub_23: push 0x0023       ; ICU INTP3
  1184 00000565 EBC2                                  jmp _default_int_handler
  1185 00000567 6A24                    _isr_stub_24: push 0x0024       ; ICU INTP4
  1186 00000569 EBBE                                  jmp _default_int_handler
  1187 0000056B 6A25                    _isr_stub_25: push 0x0025       ; ICU INTP5
  1188 0000056D EBBA                                  jmp _default_int_handler
  1189 0000056F 6A26                    _isr_stub_26: push 0x0026       ; ICU INTP6
  1190 00000571 EBB6                                  jmp _default_int_handler
  1191                                  
  1192                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1193                                  
  1194                                  ; ==========================================================
  1195                                  ; PIC Dispatch Handler (Vector 27h)
  1196                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1197                                  ; ==========================================================
  1198                                  _pic_dispatch_handler:
  1199 00000573 60                          pusha
  1200 00000574 1E                          push ds
  1201 00000575 06                          push es
  1202                                  
  1203                                      ; DS設定 (Tiny Model)
  1204 00000576 8CC8                        mov ax, cs
  1205 00000578 8ED8                        mov ds, ax
  1206                                  
  1207                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1208                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1209 0000057A B00B                        mov al, 0x0B
  1210 0000057C E6C8                        out PIC_REG0, al
  1211 0000057E E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1212                                  
  1213                                      ; --- 2. 要因判定と分岐 ---
  1214                                      
  1215 00000580 A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1216 00000582 751E                        jnz .handle_timer0
  1217                                  
  1218 00000584 A802                        test al, 02h        ; Bit 1: SCSI
  1219 00000586 7526                        jnz .handle_scsi
  1220                                  
  1221 00000588 A804                        test al, 04h        ; Bit 2: Timer 1
  1222 0000058A 752A                        jnz .handle_timer1
  1223                                  
  1224 0000058C A808                        test al, 08h        ; Bit 3: USART Rx
  1225 0000058E 752E                        jnz .handle_usart_rx
  1226                                  
  1227 00000590 A810                        test al, 10h        ; Bit 4: USART Tx
  1228 00000592 7532                        jnz .handle_usart_tx
  1229                                  
  1230 00000594 A820                        test al, 20h        ; Bit 5: SCU Rx
  1231 00000596 7536                        jnz .handle_scu_rx
  1232                                  
  1233 00000598 A840                        test al, 40h        ; Bit 6: SCU Tx
  1234 0000059A 753A                        jnz .handle_scu_tx
  1235                                  
  1236 0000059C A880                        test al, 80h        ; Bit 7: PPI
  1237 0000059E 753E                        jnz .handle_ppi
  1238                                  
  1239                                      ; 該当なしの場合は無視
  1240 000005A0 EB44                        jmp .eoi_exit
  1241                                  
  1242                                  ; --- 各ハンドラ処理 ---
  1243                                  
  1244                                  .handle_timer0:
  1245                                      ; INTP0: Timer 0 (Tick)
  1246                                      ; --- 32bit カウンタのインクリメント ---
  1247 000005A2 FF06[5108]                  inc word [tick_counter_lo]
  1248 000005A6 7504                        jnz .skip_carry
  1249 000005A8 FF06[5308]                  inc word [tick_counter_hi]
  1250                                  .skip_carry:
  1251 000005AC EB38                        jmp .eoi_exit
  1252                                  
  1253                                  .handle_scsi:
  1254                                      ; INTP1: SCSIC
  1255 000005AE BE[7F07]                    mov si, msg_int_scsi
  1256 000005B1 E85AFE                      call puts
  1257 000005B4 EB30                        jmp .eoi_exit
  1258                                  
  1259                                  .handle_timer1:
  1260                                      ; INTP2: ユーザ用タイマー
  1261 000005B6 BE[9607]                    mov si, msg_int_timer1
  1262 000005B9 E852FE                      call puts
  1263 000005BC EB28                        jmp .eoi_exit
  1264                                  
  1265                                  .handle_usart_rx:
  1266                                      ; INTP3: USART受信準備完了割り込み
  1267 000005BE BE[AF07]                    mov si, msg_int_usart_rx
  1268 000005C1 E84AFE                      call puts
  1269 000005C4 EB20                        jmp .eoi_exit
  1270                                  
  1271                                  .handle_usart_tx:
  1272                                      ; INTP4: USART送信完了割り込み
  1273 000005C6 BE[CA07]                    mov si, msg_int_usart_tx
  1274 000005C9 E842FE                      call puts
  1275 000005CC EB18                        jmp .eoi_exit
  1276                                  
  1277                                  .handle_scu_rx:
  1278                                      ; INTP5: SCU受信準備完了割り込み
  1279 000005CE BE[E507]                    mov si, msg_int_scu_rx
  1280 000005D1 E83AFE                      call puts
  1281 000005D4 EB10                        jmp .eoi_exit
  1282                                  
  1283                                  .handle_scu_tx:
  1284                                      ; INTP6: SCU送信完了割り込み
  1285 000005D6 BE[FE07]                    mov si, msg_int_scu_tx
  1286 000005D9 E832FE                      call puts
  1287 000005DC EB08                        jmp .eoi_exit
  1288                                  
  1289                                  .handle_ppi:
  1290                                      ; INTP7: PPI割り込み
  1291 000005DE BE[1708]                    mov si, msg_int_ppi
  1292 000005E1 E82AFE                      call puts
  1293 000005E4 EB00                        jmp .eoi_exit
  1294                                  
  1295                                  ; --- 終了処理 ---
  1296                                  .eoi_exit:
  1297                                      ; --- EOI (End of Interrupt) to PIC ---
  1298 000005E6 B020                        mov al, 20h     ; Non-specific EOI
  1299                                  
  1300                                      ; 外部PIC (Slave) の割り込み完了
  1301 000005E8 E6C8                        out PIC_REG0, al
  1302                                  
  1303                                      ; V53内蔵ICU (Master) の割り込み完了
  1304 000005EA BA8012                      mov dx, ICU_REG0 
  1305 000005ED EE                          out dx, al
  1306                                  
  1307 000005EE 07                          pop es
  1308 000005EF 1F                          pop ds
  1309 000005F0 61                          popa
  1310 000005F1 CF                          iret
  1311                                  
  1312                                  ;--------------------------------------
  1313                                  ; 未定義割り込みベクタ用の簡易トラップ
  1314                                  ;--------------------------------------
  1315                                  _default_int_unknown_handler:
  1316                                      ; 想定外の割り込みが発生したため、
  1317                                      ; 画面に "UNKNOWN INT" と出して停止する
  1318                                      
  1319 000005F2 FA                          cli                 ; 多重割り込み禁止
  1320 000005F3 60                          pusha
  1321 000005F4 1E                          push ds
  1322 000005F5 0E                          push cs
  1323 000005F6 1F                          pop ds              ; DS = CS
  1324                                  
  1325 000005F7 BE[2D08]                    mov si, msg_unknown_int
  1326 000005FA E811FE                      call puts
  1327                                      
  1328                                      ; 停止（暴走を防ぐ）
  1329                                  .halt:
  1330 000005FD F4                          hlt
  1331 000005FE EBFD                        jmp .halt
  1332                                  
