   535 0000024A 3C3A                        cmp al, ':'
   536 0000024C 75F9                        jne .wait_record
   537                                  
   538 0000024E E84902                      call get_hex_byte   ; データ長を読み込み
   539 00000251 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   540 00000253 B500                        mov ch, 0
   541                                      
   542 00000255 E84202                      call get_hex_byte   ; 上位アドレスを読み込み
   543 00000258 88C7                        mov bh, al
   544 0000025A E83D02                      call get_hex_byte   ; 下位アドレスを読み込み
   545 0000025D 88C3                        mov bl, al
   546                                      
   547 0000025F E83802                      call get_hex_byte   ; レコードタイプを読み込み
   548 00000262 3C01                        cmp al, 01          ; End of File?
   549 00000264 7419                        je .handle_eof      ; EOFの処理へ
   550 00000266 3C00                        cmp al, 00          ; Data Record?
   551 00000268 751A                        jne .skip_line      ; その他はスキップ
   552                                      
   553 0000026A E309                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   554                                      
   555                                  .data_loop:
   556 0000026C E82B02                      call get_hex_byte   ; 1バイト読み取り
   557 0000026F 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   558 00000272 43                          inc bx              ; 次のアドレスにする
   559 00000273 E2F7                        loop .data_loop     ; データ長分繰り返す
   560                                      
