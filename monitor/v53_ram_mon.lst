     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.13 2026-04-23
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; objcopy -I binary -O ihex --change-addresses=0x0000 v53_ram_mon.bin v53_ram_mon.hex
    10                                  ; -----------------
    11                                  
    12                                  ; ==========================================
    13                                  ; V53 System Register
    14                                  ; ==========================================
    15                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    16                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    17                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    18                                  %define DULA    0x0FFFB ; 
    19                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    20                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    21                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    22                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    23                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    24                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    25                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    26                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    27                                  %define SBCR    0x0FFF1 ; 
    28                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    29                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    30                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    31                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    32                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    33                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    34                                  %define BADR    0x0FFE1 ; 
    35                                  %define BSEL    0x0FFE0 ; 
    36                                  %define XAM     0x0FF80 ; 
    37                                  %define PGR     0x0FF00 ; 
    38                                  
    39                                  
    40                                  
    41                                  %ifdef SIM
    42                                      ; --- Simulation Mode ---
    43                                      org 0x100
    44                                      cpu 186
    45                                  
    46                                      %define SCU_DATA   0x3F8
    47                                      %define SCU_SST    0x3FD
    48                                      %define TX_READY    0x20                                 
    49                                      %define RX_READY    0x01
    50                                  %else
    51                                      ; --- Real Hardware Mode ---
    52                                      org 0
    53                                      cpu 186
    54                                  
    55                                      ; V53 SCU (F060Hに配置）
    56                                      %define SCU_DATA    0x0F060 ; 送受データ・レジスタ(R:SRB/W:STB)
    57                                      %define SCU_SST     0x0F061 ; ステータス・レジスタ(R:SST)
    58                                      %define SCU_SCM     0x0F061 ; コマンドレジスタ(W:SCM)
    59                                      %define SCU_SMD     0x0F062 ; シリアルモード設定(W:SMD)
    60                                      %define SCU_SIMK    0x0F063 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    61                                      %define TX_READY    00000001b   ; TBRDY                                 
    62                                      %define RX_READY    00000010b   ; RBRDY
    63                                  
    64                                      ; V53 TCU (F070Hに配置)
    65                                      %define TM0_CNT     0x0F070 ; Timer 0 Counter
    66                                      %define TM1_CNT     0x0F071 ; Timer 1 Counter
    67                                      %define TM2_CNT     0x0F072 ; Timer 2 Counter
    68                                      %define TM_CTL      0x0F073 ; Timer Control
    69                                  
    70                                      ; V53 ICU (F080Hに配置)
    71                                      %define ICU_REG0    0x0F080
    72                                      %define ICU_REG1    0x0F081
    73                                  
    74                                      ;-----------------------------------------
    75                                      ; V53 VME Board ペリフェラル
    76                                      ;-----------------------------------------
    77                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    78                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    79                                  
    80                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
    81                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
    82                                  
    83                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
    84                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
    85                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
    86                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
    87                                  %endif
    88                                  
    89                                  section .text
    90                                  
    91                                  start:
    92                                  %ifdef SIM
    93                                      xor ax, ax
    94                                      mov es, ax
    95                                  %else
    96 00000000 FA                          cli             ; 初期化中は割り込み禁止
    97                                  
    98                                      ; ---------------------------------------------
    99                                      ; 1. セグメントレジスタ初期化
   100                                      ; CS=DS=ES を想定
   101                                      ; ---------------------------------------------
   102 00000001 0E                          push cs
   103 00000002 1F                          pop ds
   104 00000003 0E                          push cs
   105 00000004 07                          pop es
   106                                      ; --- 【重要】スタックの初期化 ---
   107                                      ; 現在のCSセグメントの末尾 (FFFEh) にスタックを移動させます。
   108                                      ; これでコード領域との衝突を回避します。
   109 00000005 8CC8                        mov ax, cs
   110 00000007 8ED0                        mov ss, ax
   111 00000009 BCFEFF                      mov sp, 0xFFFE
   112                                      ; ------------------------------
   113                                  
   114                                      ;==============================================
   115                                      ; Interrupt Vector Setup 
   116                                      ;==============================================
   117                                  Init_Interrupt_Vectors:
   118                                      ; ----------------------------------------------------
   119                                      ; 1. 全ベクタ (00h-FFh) をデフォルトハンドラで埋める
   120                                      ;    (予期せぬ割り込みによる暴走を防ぐ安全策)
   121                                      ; ----------------------------------------------------
   122 0000000C 31C0                        xor ax, ax
   123 0000000E 8EC0                        mov es, ax          ; ES = 0000h (Vector Table)
   124 00000010 BF0000                      mov di, 0           ; Offset 0
   125                                  
   126 00000013 B90001                      mov cx, 256         ; 256個のベクタ全てを設定
   127                                  .init_loop:
   128 00000016 B8[6D06]                    mov ax, _default_int_unknown_handler ; 共通トラップハンドラ
   129 00000019 AB                          stosw               ; Offset書き込み
   130 0000001A 8CC8                        mov ax, cs
   131 0000001C AB                          stosw               ; Segment書き込み
   132 0000001D E2F7                        loop .init_loop
   133                                  
   134                                      ; 専用割り込みベクタを上書き登録 (0x00 - 0x05)
   135 0000001F 31C0                        xor  ax, ax
   136 00000021 8EC0                        mov  es, ax         ; ES = 0000h
   137                                  
   138 00000023 26C7060000[3905]            mov word [es:0x00], _isr_stub_0    ; オフセットを書き込み　0x00 * 4 = 0x00
   139 0000002A 268C0E0200                  mov word [es:0x02], cs             ; 現在のコードセグメントを書き込み
   140                                  
   141 0000002F 26C7060400[3D05]            mov word [es:0x04], _isr_stub_1    ; オフセットを書き込み　0x01 * 4 = 0x04
   142 00000036 268C0E0600                  mov word [es:0x06], cs             ; 現在のコードセグメントを書き込み
   143                                  
   144 0000003B 26C7060800[4105]            mov word [es:0x08], _isr_stub_2    ; オフセットを書き込み　0x02 * 4 = 0x08
   145 00000042 268C0E0A00                  mov word [es:0x0A], cs             ; 現在のコードセグメントを書き込み
   146                                  
   147 00000047 26C7060C00[4505]            mov word [es:0x0C], _isr_stub_3    ; オフセットを書き込み　0x03 * 4 = 0x0C
   148 0000004E 268C0E0E00                  mov word [es:0x0E], cs             ; 現在のコードセグメントを書き込み
   149                                  
   150 00000053 26C7061000[4905]            mov word [es:0x10], _isr_stub_4    ; オフセットを書き込み　0x04 * 4 = 0x10
   151 0000005A 268C0E1200                  mov word [es:0x12], cs             ; 現在のコードセグメントを書き込み
   152                                      
   153 0000005F 26C7061400[4D05]            mov word [es:0x14], _isr_stub_5    ; オフセットを書き込み　0x05 * 4 = 0x14
   154 00000066 268C0E1600                  mov word [es:0x16], cs             ; 現在のコードセグメントを書き込み
   155                                  
   156                                      ; ICU割り込みベクタを上書き登録 (0x20 - 0x27)    
   157                                      ; Vector 20h (ICU INTP0) 登録
   158 0000006B 26C7068000[5105]            mov word [es:0x80], _isr_stub_20    ; オフセットを書き込み　0x20 * 4 = 0x80
   159 00000072 268C0E8200                  mov word [es:0x82], cs              ; 現在のコードセグメントを書き込み
   160                                  
   161                                      ; Vector 21h (ICU INTP1) 登録
   162 00000077 26C7068400[5505]            mov word [es:0x84], _isr_stub_21
   163 0000007E 268C0E8600                  mov word [es:0x86], cs
   164                                  
   165                                      ; Vector 22h (ICU INTP2) 登録
   166 00000083 26C7068800[5905]            mov word [es:0x88], _isr_stub_22
   167 0000008A 268C0E8A00                  mov word [es:0x8A], cs
   168                                  
   169                                      ; Vector 23h (ICU INTP3) 登録
   170 0000008F 26C7068C00[5D05]            mov word [es:0x8C], _isr_stub_23
   171 00000096 268C0E8E00                  mov word [es:0x8E], cs
   172                                  
   173                                      ; Vector 24h (ICU INTP4) 登録
   174 0000009B 26C7069000[6105]            mov word [es:0x90], _isr_stub_24
   175 000000A2 268C0E9200                  mov word [es:0x92], cs
   176                                  
   177                                      ; Vector 25h (ICU INTP5) 登録
   178 000000A7 26C7069400[6505]            mov word [es:0x94], _isr_stub_25
   179 000000AE 268C0E9600                  mov word [es:0x96], cs
   180                                  
   181                                      ; Vector 26h (ICU INTP6) 登録
   182 000000B3 26C7069800[6905]            mov word [es:0x98], _isr_stub_26
   183 000000BA 268C0E9A00                  mov word [es:0x9A], cs
   184                                  
   185                                      ; Vector 27h (ICU INTP7) 登録
   186 000000BF 26C7069C00[EE05]            mov word [es:0x9C], _pic_dispatch_handler
   187 000000C6 268C0E9E00                  mov word [es:0x9E], cs
   188                                  
   189                                      ; ---------------------------------------------
   190                                      ; 1.2 メモリウェイト値の設定
   191                                      ; オンボードRAMは35nsなので0Waitで良さそう
   192                                      ; 拡張RAMボードは70nsなので途中1waitの領域も設定
   193                                      ; ROMは70nsなので2waitに、外部I/Oは不明のためとりあえず3waitで
   194                                      ; ---------------------------------------------
   195                                      ; リセット時の値
   196                                      ; WMB0  -111-111  16MBのメモリ空間の上位、下位で8MB
   197                                      ; WMB1  -111-111　1MBメモリ空間の上位、下位で512KB
   198                                      ; WCY0-WCY3 すべて7wait
   199                                      ;
   200 000000CB BAF3FF                      mov dx, WMB1
   201 000000CE B073                        mov al, 01110011b	; L=512KB(Onboard RAM) M=384KB(VME RAM) H=128KB(Onboard ROM)
   202 000000D0 EE                          out dx, al
   203                                  
   204 000000D1 BAF4FF                      mov dx, WCY2
   205 000000D4 B000                        mov al, 00000000b	; M=0wait L=0wait
   206 000000D6 EE                          out dx, al
   207                                  
   208 000000D7 BAF5FF                      mov dx, WCY3
   209 000000DA B032                        mov al, 00110010b	; IO=1wait H=1wait
   210 000000DC EE                          out dx, al
   211                                  
   212                                      ;------------------------------------------
   213                                      ; V53 内蔵ペリフェラルのIOアドレスを設定 (OPHA)
   214                                      ;------------------------------------------
   215 000000DD BAFCFF                      mov  dx, OPHA ; 内蔵ペリフェラル・リロケーション・レジスタ
   216 000000E0 B0F0                        mov  al, 0xF0 ; 0xF0xxに配置
   217 000000E2 EE                          out  dx, al
   218                                      ;------------------------------------------
   219                                      ; ICU レジスタ配置アドレスの設定 (IULA) 0xF080
   220                                      ;------------------------------------------
   221 000000E3 BAFAFF                      mov dx, IULA
   222 000000E6 B080                        mov al, 0x80    ; 下位アドレス
   223 000000E8 EE                          out dx, al
   224                                      ;------------------------------------------
   225                                      ; TCU レジスタ配置アドレスの設定 (TULA) 0xF070
   226                                      ;------------------------------------------
   227 000000E9 BAF9FF                      mov dx, TULA
   228 000000EC B070                        mov al, 0x70    ; 下位アドレス
   229 000000EE EE                          out dx, al
   230                                      ;------------------------------------------
   231                                      ; SCU レジスタ配置アドレスの設定 (SULA) 0xF060
   232                                      ;------------------------------------------
   233 000000EF BAF8FF                      mov dx, SULA
   234 000000F2 B060                        mov al, 0x60    ; 下位アドレス
   235 000000F4 EE                          out dx, al
   236                                      
   237                                      ;------------------------------------------
   238                                      ; V53 内蔵ペリフェラルの有効化 (OPSEL)
   239                                      ; 有効化する前にOPHA,DULA,IULA,TULA,SULAの設定が必要
   240                                      ;------------------------------------------
   241 000000F5 BAFDFF                      mov  dx, OPSEL
   242 000000F8 EC                          in   al, dx
   243 000000F9 0C0E                        or   al, 00001110b   ; Bit 1(ICU),Bit 2(TCU),Bit 3(SCU)をセット
   244 000000FB EE                          out  dx, al
   245                                  
   246                                      ;------------------------------------------
   247                                      ; TCUの設定
   248                                      ;------------------------------------------
   249                                      ; 3. TCKS: タイマクロック入力選択
   250                                      ;------------------------------------------
   251 000000FC BAF0FF                      mov  dx, TCKS
   252 000000FF B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   253 00000101 EE                          out  dx, al
   254                                  
   255                                      ;------------------------------------------
   256                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   257                                      ;------------------------------------------
   258 00000102 BA73F0                      mov  dx, TM_CTL
   259                                  
   260                                      ; --- Timer 0 Setup ---
   261 00000105 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   262 00000107 EE                          out  dx, al
   263                                      
   264                                      ; --- Timer 1 Setup ---
   265 00000108 B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   266 0000010A EE                          out  dx, al
   267                                  
   268                                      ; --- Timer 2 Setup ---
   269 0000010B B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   270 0000010D EE                          out  dx, al
   271                                  
   272                                      ;------------------------------------------
   273                                      ; 4. カウンタ値 (分周比) のロード
   274                                      ;------------------------------------------
   275                                      ; Timer 0 (INTP0)
   276                                      ; 1.2288MHz / 12288 = 100Hz
   277 0000010E BA70F0                      mov  dx, TM0_CNT
   278 00000111 B000                        mov  al, 0x00
   279 00000113 EE                          out  dx, al
   280 00000114 B030                        mov  al, 0x30
   281 00000116 EE                          out  dx, al
   282                                  
   283                                      ; Timer 1 (INTP2)
   284                                      ; 1.2288MHz / 61440 = 20Hz
   285 00000117 BA71F0                      mov  dx, TM1_CNT
   286 0000011A B000                        mov  al, 0x00
   287 0000011C EE                          out  dx, al
   288 0000011D B0F0                        mov  al, 0xF0
   289 0000011F EE                          out  dx, al
   290                                  
   291                                      ; Timer 2 (USART Tx/RxCLK)
   292                                      ; 1.2288MHz / 4 = 307.20KHz
   293                                      ; USART CLOCK 19200bps
   294 00000120 BA72F0                      mov  dx, TM2_CNT
   295 00000123 B004                        mov  al, 4
   296 00000125 EE                          out  dx, al
   297 00000126 B000                        mov  al, 0
   298 00000128 EE                          out  dx, al
   299                                  
   300                                      ;------------------------------------------
   301                                      ; μPD71051 (USART) 初期化
   302                                      ;------------------------------------------
   303 00000129 B000                        mov al, 0
   304 0000012B E6DA                        out USART_CMD, al
   305                                   
   306 0000012D F7E1                        mul cx              ; wait
   307 0000012F F7E1                        mul cx              ; wait
   308 00000131 E6DA                        out USART_CMD, al
   309                                   
   310 00000133 F7E1                        mul cx              ; wait
   311 00000135 F7E1                        mul cx              ; wait
   312 00000137 E6DA                        out USART_CMD, al
   313                                   
   314 00000139 F7E1                        mul cx              ; wait
   315 0000013B F7E1                        mul cx              ; wait
   316 0000013D B040                        mov al, 0x40        ; reset
   317 0000013F E6DA                        out USART_CMD, al
   318                                   
   319 00000141 F7E1                        mul cx              ; wait
   320 00000143 F7E1                        mul cx              ; wait
   321 00000145 B04E                        mov al, 0x4e        ; set mode
   322 00000147 E6DA                        out USART_CMD, al
   323                                   
   324 00000149 F7E1                        mul cx              ; wait
   325 0000014B F7E1                        mul cx              ; wait
   326 0000014D B037                        mov al, 0x37        ; rx,tx ready
   327 0000014F E6DA                        out USART_CMD, al
   328                                  
   329                                      ;------------------------------------------
   330                                      ; μPD71059 (PIC) 初期化
   331                                      ;------------------------------------------
   332 00000151 B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   333 00000153 E6C8                        out PIC_REG0, al
   334                                  
   335 00000155 B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   336 00000157 E6CA                        out PIC_REG1, al
   337                                                          ; ICW3 is skipped in Single Mode
   338 00000159 B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   339 0000015B E6CA                        out PIC_REG1, al
   340                                  
   341 0000015D B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   342 0000015F E6CA                        out PIC_REG1, al
   343                                  
   344                                      ;------------------------------------------
   345                                      ; ICUの追加設定
   346                                      ;------------------------------------------
   347                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   348                                      ;------------------------------------------
   349 00000161 BA80F0                      mov dx, ICU_REG0
   350 00000164 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   351 00000166 EE                          out dx, al
   352                                  
   353 00000167 BA81F0                      mov dx, ICU_REG1
   354 0000016A B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   355 0000016C EE                          out dx, al
   356                                                      ; ICW3 is skipped in Single Mode
   357 0000016D B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   358 0000016F EE                          out dx, al
   359                                  
   360                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   361                                      ;mov al, 7Fh     ; 0111 1111
   362 00000170 B000                        mov al, 00h     ; 0000 0000 全マスク解除
   363 00000172 EE                          out dx, al
   364                                  
   365                                      ;-------------------------------------------
   366                                      ; 割り込み許可
   367                                      ;-------------------------------------------
   368 00000173 FB                          sti
   369                                  
   370                                   %endif
   371                                  
   372                                      ; 変数初期化 (RAMエリアをクリア)
   373 00000174 C706[0409]0000              mov word [dump_seg], 0x0000
   374 0000017A C706[0609]0000              mov word [dump_off], 0x0000
   375 00000180 C706[0809]0020              mov word [load_seg], 0x2000
   376                                  
   377                                      ; スタートメッセージの表示
   378 00000186 BE[CF06]                    mov si, msg_boot
   379 00000189 E8F302                      call puts
   380                                  
   381                                  ; =================================================================
   382                                  ; Main Loop
   383                                  ; =================================================================
   384                                  monitor_loop:
   385 0000018C B03E                        mov al, '>'
   386 0000018E E8FC02                      call putc
   387 00000191 B020                        mov al, ' '
   388 00000193 E8F702                      call putc
   389                                  
   390 00000196 E81603                      call getc_echo  ; コマンド受信（エコーあり）
   391 00000199 88C3                        mov bl, al
   392                                      
   393 0000019B 80FB64                      cmp bl, 'd'     ; dump command
   394 0000019E 747A                        je do_dump
   395 000001A0 80FB44                      cmp bl, 'D'
   396 000001A3 7475                        je do_dump
   397                                      
   398 000001A5 80FB6C                      cmp bl, 'l'     ; load command
   399 000001A8 7503E9D000                  je do_load
   400 000001AD 80FB4C                      cmp bl, 'L'
   401 000001B0 7503E9C800                  je do_load
   402                                      
   403 000001B5 80FB67                      cmp bl, 'g'     ; go command
   404 000001B8 7503E94401                  je do_go
   405 000001BD 80FB47                      cmp bl, 'G'
   406 000001C0 7503E93C01                  je do_go
   407                                  
   408 000001C5 80FB77                      cmp bl, 'w'     ; Write command
   409 000001C8 7503E96001                  je do_write
   410 000001CD 80FB57                      cmp bl, 'W'
   411 000001D0 7503E95801                  je do_write
   412                                  
   413 000001D5 3C69                        cmp al, 'i'     ; Input Port command
   414 000001D7 7503E99401                  je do_in
   415 000001DC 3C49                        cmp al, 'I'
   416 000001DE 7503E98D01                  je do_in
   417                                  
   418 000001E3 3C6F                        cmp al, 'o'     ; Output Port command
   419 000001E5 7503E9AA01                  je do_out
   420 000001EA 3C4F                        cmp al, 'O'
   421 000001EC 7503E9A301                  je do_out
   422                                  
   423 000001F1 3C73                        cmp al, 's'     ; Scan I/O command
   424 000001F3 7503E9C601                  je do_scan
   425 000001F8 3C53                        cmp al, 'S'
   426 000001FA 7503E9BF01                  je do_scan
   427                                  
   428 000001FF 3C74                        cmp al, 't'     ; Scan Timer wait command
   429 00000201 7503E92A02                  je do_timer
   430 00000206 3C54                        cmp al, 'T'
