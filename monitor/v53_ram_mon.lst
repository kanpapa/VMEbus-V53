   674 000002DD E89B01                      call get_hex_word   ; AX = Offset
   675 000002E0 50                          push ax             ; ターゲットオフセットを保存
   676                                  
   677 000002E1 E86001                      call getc_echo      ; Space?
   678 000002E4 3C20                        cmp al, ' '
