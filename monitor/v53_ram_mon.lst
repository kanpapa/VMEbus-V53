   831                                  ; ==============================================================
   832                                  ; Command: Timer
   833                                  ;   T          -> Show current tick counter (32-bit HEX)
   834                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   835                                  ; ==============================================================
   836                                  do_timer:
   837 00000430 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   838 00000433 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   839 00000435 7421                        je .show_counter
   840 00000437 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   841 00000439 7403E9F200                  jne error           ; それ以外はエラー
   842                                  
   843                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   844 0000043E E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   845                                  
   846                                      ; 開始時刻を保存 (Start Time)
   847 00000441 8B1E[0A09]                  mov bx, [tick_counter_lo]
   848                                  
   849                                  .wait_loop:
   850                                      ; 1. 現在時刻を取得
   851 00000445 8B0E[0A09]                  mov cx, [tick_counter_lo]
   852                                      
   853                                      ; 2. 経過時間を計算 (Current - Start)
   854                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   855 00000449 29D9                        sub cx, bx          
   856                                      
   857                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   858 0000044B 39C1                        cmp cx, ax
   859 0000044D 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   860                                  
   861                                      ; 指定時間経過した
   862 0000044F BE[2E07]                    mov si, msg_done
   863 00000452 E82A00                      call puts
   864 00000455 E934FD                      jmp monitor_loop
   865                                  
   866                                  .show_counter:
   867                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   868 00000458 E85D00                      call putc_crlf
   869                                      
   870 0000045B BE[F607]                    mov si, msg_tick    ; "Tick: "
   871 0000045E E81E00                      call puts
   872                                  
   873                                      ; 32bitカウンタを [High][Low] の順で表示
   874 00000461 A1[0C09]                    mov ax, [tick_counter_hi]
   875 00000464 E85A00                      call print_hex_word
   876 00000467 A1[0A09]                    mov ax, [tick_counter_lo]
   877 0000046A E85400                      call print_hex_word
   878                                      
   879 0000046D E84800                      call putc_crlf
   880 00000470 E919FD                      jmp monitor_loop
   881                                  
   882                                  ; ==============================================================
   883                                  ; Command: Help
   884                                  ; ==============================================================
   885                                  cmd_help:
   886 00000473 E84200                      call putc_crlf
   887 00000476 BE[3A07]                    mov si, msg_help
   888 00000479 E80300                      call puts
   889 0000047C E90DFD                      jmp monitor_loop
   890                                  
   891                                  ; =================================================================
   892                                  ; Utilities
   893                                  ; =================================================================
   894                                  
   895                                  ; 文字列出力
   896                                  puts:
   897 0000047F 2E8A04                      mov al, [cs:si]
   898 00000482 08C0                        or al, al
   899 00000484 7406                        jz .ret
   900 00000486 E80400                      call putc
   901 00000489 46                          inc si
   902 0000048A EBF3                        jmp puts
   903 0000048C C3                      .ret: ret
   904                                  
   905                                  ; 1文字出力
   906                                  putc:
   907 0000048D 52                          push dx
   908 0000048E 50                          push ax
   909 0000048F BA61F0                      mov dx, SCU_SST
   910 00000492 EC                      .w: in al, dx
   911 00000493 A801                        test al, TX_READY  ; TX Ready?
   912 00000495 74FB                        jz .w
   913 00000497 BA60F0                      mov dx, SCU_DATA
   914 0000049A 58                          pop ax
   915 0000049B 50                          push ax
   916 0000049C EE                          out dx, al
   917 0000049D 58                          pop ax
   918 0000049E 5A                          pop dx
   919 0000049F C3                          ret
   920                                  
   921                                  ; 1文字入力
   922                                  getc:
   923 000004A0 52                          push dx
   924 000004A1 BA61F0                      mov dx, SCU_SST
   925 000004A4 EC                      .w: in al, dx
   926 000004A5 A802                        test al, RX_READY  ; RX Ready?
   927 000004A7 74FB                        jz .w
   928 000004A9 BA60F0                      mov dx, SCU_DATA
   929 000004AC EC                          in al, dx
   930 000004AD 5A                          pop dx
   931 000004AE C3                          ret
   932                                  
   933                                  ; 1文字入力　エコーバックあり
   934                                  getc_echo:
   935 000004AF E8EEFF                      call getc
   936 000004B2 50                          push ax
   937 000004B3 E8D7FF                      call putc
   938 000004B6 58                          pop ax
   939 000004B7 C3                          ret
   940                                  
   941                                  ; 改行出力
   942                                  putc_crlf:
   943 000004B8 B00D                        mov al, 0x0D
   944 000004BA E8D0FF                      call putc
   945 000004BD B00A                        mov al, 0x0A
   946 000004BF EBCC                        jmp putc
   947                                  
   948                                  ; -----------------------------------------------------------------
   949                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   950                                  ; Input: AX
   951                                  ; -----------------------------------------------------------------
   952                                  print_hex_word:
   953 000004C1 50                          push ax
   954 000004C2 88E0                        mov al, ah
   955 000004C4 E80100                      call print_hex_byte
   956 000004C7 58                          pop ax
   957                                  
   958                                  ; -----------------------------------------------------------------
   959                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   960                                  ; Input: AL
   961                                  ; -----------------------------------------------------------------
   962                                  print_hex_byte:
   963 000004C8 50                          push ax
   964 000004C9 51                          push cx
   965                                  
   966                                      ; 上位バイトの表示
   967 000004CA 50                          push ax
   968 000004CB C0E804                      shr al, 4
   969 000004CE E80900                      call .digit
   970                                  
   971                                      ; 下位バイトの表示
   972 000004D1 58                          pop ax
   973 000004D2 240F                        and al, 0x0F
   974 000004D4 E80300                      call .digit
   975                                  
   976 000004D7 59                          pop cx
   977 000004D8 58                          pop ax
   978 000004D9 C3                          ret
   979                                  
   980                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   981                                  .digit:
   982 000004DA 0430                        add al, '0'
   983 000004DC 3C39                        cmp al, '9'
   984 000004DE 7602                        jbe .p
   985 000004E0 0407                        add al, 7
   986 000004E2 E8A8FF                  .p: call putc
   987 000004E5 C3                          ret
   988                                  
   989                                  ; -----------------------------------------------------------------
   990                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   991                                  ; Input:  Serial (例: "1", "0", "0", "0")
   992                                  ; Output: AX = 0x1000
   993                                  ; -----------------------------------------------------------------
   994                                  get_hex_word:
   995 000004E6 53                          push bx
   996 000004E7 E80B00                      call get_hex_byte_echo
   997 000004EA 88C7                        mov bh, al
   998 000004EC E80600                      call get_hex_byte_echo
   999 000004EF 88C3                        mov bl, al
  1000 000004F1 89D8                        mov ax, bx
  1001 000004F3 5B                          pop bx
  1002 000004F4 C3                          ret
  1003                                  
  1004                                  ; 16進数2桁入力　エコーバック有り
  1005                                  get_hex_byte_echo:
  1006 000004F5 53                          push bx
  1007 000004F6 E8B6FF                      call getc_echo
  1008 000004F9 E82500                      call hex_char_to_bin
  1009 000004FC C0E004                      shl al, 4
  1010 000004FF 88C3                        mov bl, al
  1011 00000501 E8ABFF                      call getc_echo
  1012 00000504 E81A00                      call hex_char_to_bin
  1013 00000507 08D8                        or al, bl
  1014 00000509 5B                          pop bx
  1015 0000050A C3                          ret
  1016                                  
  1017                                  ; -----------------------------------------------------------------
  1018                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1019                                  ; Input:  Serial (例: "3", "F")
  1020                                  ; Output: AL = 0x3F
  1021                                  ; -----------------------------------------------------------------
  1022                                  get_hex_byte:
  1023 0000050B 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1024                                  
  1025                                      ; 上位4bit
  1026 0000050C E891FF                      call getc
  1027 0000050F E80F00                      call hex_char_to_bin
  1028 00000512 C0E004                      shl al, 4
  1029 00000515 88C3                        mov bl, al          ; 一時保存
  1030                                      
  1031                                      ; 下位4bit
  1032 00000517 E886FF                      call getc
  1033 0000051A E80400                      call hex_char_to_bin
  1034 0000051D 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1035 0000051F 5B                          pop bx
  1036 00000520 C3                          ret
  1037                                  
  1038                                  ; -----------------------------------------------------------------
  1039                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1040                                  ; Input: AL (ASCII)
  1041                                  ; Output: AL (Binary)
  1042                                  ; -----------------------------------------------------------------
  1043                                  hex_char_to_bin:
  1044 00000521 2C30                        sub al, '0'
  1045 00000523 3C09                        cmp al, 9
  1046 00000525 7604                        jbe .done
  1047 00000527 2C07                        sub al, 7           ; 'A'-'F'対応
  1048 00000529 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1049                                  .done:
  1050 0000052B C3                          ret
  1051                                  
  1052                                  ; -----------------------------------------------------------------
  1053                                  ; Helper: スペースなどを読み飛ばす
  1054                                  ; -----------------------------------------------------------------
  1055                                  skip_space:
  1056 0000052C E880FF                      call getc_echo
  1057 0000052F C3                          ret
  1058                                  
  1059                                  ; -----------------------------------------------------------------
  1060                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1061                                  ; -----------------------------------------------------------------
  1062                                  error:
  1063 00000530 BE[1207]                    mov si, msg_error
  1064 00000533 E849FF                      call puts
  1065 00000536 E953FC                      jmp monitor_loop
