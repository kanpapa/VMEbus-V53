   666                                      
   667                                      ; 2. オフセット (OOOO) を取得
   668 000002F5 E8CF01                      call get_hex_word   ; AX = Offset
   669 000002F8 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   670                                      
   671 000002F9 E89D01                      call putc_crlf      ; 実行前に改行
   672 000002FC BE[4E07]                    mov si, msg_go
   673 000002FF E85E01                      call puts
   674 00000302 E89401                      call putc_crlf
   675                                      
   676                                      ; 3. 実行環境のセットアップ
   677                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
