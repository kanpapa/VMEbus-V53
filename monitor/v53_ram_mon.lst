     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.6  2026-01-29
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; 
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; SCUレジスタ (SCUは1260Hに配置）
    55                                      %define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    56                                      %define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    57                                      %define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    58                                      %define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    59                                      %define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    60                                      %define TX_READY    00000001b   ; TBRDY                                 
    61                                      %define RX_READY    00000010b   ; RBRDY
    62                                  
    63                                      ; --- タイマーレジスタ (TCUは1270Hに配置) ---
    64                                      %define TM0_CNT     0x01270 ; Timer 0 Counter
    65                                      %define TM1_CNT     0x01271 ; Timer 1 Counter
    66                                      %define TM2_CNT     0x01272 ; Timer 2 Counter
    67                                      %define TM_CTL      0x01273 ; Timer Control
    68                                  
    69                                      %define DIV_LOW     0x04 ; 分周比 4 (1.2288MHz -> 307.2kHz)
    70                                      %define DIV_HIGH    0x00
    71                                  
    72                                      ;-----------------------------------------
    73                                      ; V53 VME Board ペリフェラル
    74                                      ;-----------------------------------------
    75                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    76                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    77                                  %endif
    78                                  
    79                                  section .text
    80                                  
    81                                  start:
    82                                  %ifdef SIM
    83                                      xor ax, ax
    84                                      mov es, ax
    85                                  %else
    86 00000000 FA                          cli
    87                                  
    88                                      ;==============================================
    89                                      ; ABORT (NMI) Handler Setup 
    90                                      ;==============================================
    91                                  Init_NMI:
    92                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
    93 00000001 31C0                        xor  ax, ax
    94 00000003 8EC0                        mov  es, ax          ; ES = 0000h
    95                                      
    96 00000005 BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
    97 00000008 B8[DC03]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
    98 0000000B AB                          stosw                ; [0000:0008] = AX
    99 0000000C 8CC8                        mov  ax, cs          ; 現在のCS
   100 0000000E AB                          stosw                ; [0000:000A] = CS
   101                                  
   102                                      ; ---------------------------------------------
   103                                      ; 1. セグメントレジスタ初期化
   104                                      ; CS=DS=ES を想定
   105                                      ; ---------------------------------------------
   106 0000000F 0E                          push cs
   107 00000010 1F                          pop ds
   108 00000011 0E                          push cs
   109 00000012 07                          pop es
   110                                      ; スタックは簡易モニタのものをそのまま使う
   111                                  
   112                                      ;------------------------------------------
   113                                      ; TCUの追加設定
   114                                      ;------------------------------------------
   115                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   116                                      ;------------------------------------------
   117 00000013 BAFDFF                      mov  dx, OPSEL
   118 00000016 EC                          in   al, dx
   119 00000017 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   120 00000019 EE                          out  dx, al
   121                                  
   122                                      ;------------------------------------------
   123                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   124                                      ;------------------------------------------
   125 0000001A BAF9FF                      mov dx, TULA
   126 0000001D B070                        mov al, 0x70    ; 下位アドレス
   127 0000001F EE                          out dx, al
   128                                  
   129                                      ;------------------------------------------
   130                                      ; 3. TCKS: タイマクロック入力選択
   131                                      ;------------------------------------------
   132 00000020 BAF0FF                      mov  dx, TCKS
   133 00000023 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   134 00000025 EE                          out  dx, al
   135                                  
   136                                      ;------------------------------------------
   137                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   138                                      ;------------------------------------------
   139 00000026 BA7312                      mov  dx, TM_CTL
   140                                  
   141                                      ; --- Timer 0 Setup ---
   142 00000029 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   143 0000002B EE                          out  dx, al
   144                                      
   145                                      ; --- Timer 1 Setup ---
   146 0000002C B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   147 0000002E EE                          out  dx, al
   148                                  
   149                                      ; --- Timer 2 Setup ---
   150 0000002F B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   151 00000031 EE                          out  dx, al
   152                                  
   153                                      ;------------------------------------------
   154                                      ; 4. カウンタ値 (分周比) のロード
   155                                      ;------------------------------------------
   156                                      ; Timer 0
   157 00000032 BA7012                      mov  dx, TM0_CNT
   158 00000035 B004                        mov  al, DIV_LOW
   159 00000037 EE                          out  dx, al
   160 00000038 B000                        mov  al, DIV_HIGH
   161 0000003A EE                          out  dx, al
   162                                  
   163                                      ; Timer 1
   164 0000003B BA7112                      mov  dx, TM1_CNT
   165 0000003E B004                        mov  al, DIV_LOW
   166 00000040 EE                          out  dx, al
   167 00000041 B000                        mov  al, DIV_HIGH
   168 00000043 EE                          out  dx, al
   169                                  
   170                                      ; Timer 2
   171 00000044 BA7212                      mov  dx, TM2_CNT
   172 00000047 B004                        mov  al, DIV_LOW
   173 00000049 EE                          out  dx, al
   174 0000004A B000                        mov  al, DIV_HIGH
   175 0000004C EE                          out  dx, al
   176                                  
   177                                      ;------------------------------------------
   178                                      ; μPD71051 (USART) 初期化
   179                                      ;------------------------------------------
   180 0000004D B000                        mov al, 0
   181 0000004F E6DA                        out USART_CMD, al
   182                                   
   183 00000051 F7E1                        mul cx              ; wait
   184 00000053 F7E1                        mul cx              ; wait
   185 00000055 E6DA                        out USART_CMD, al
   186                                   
   187 00000057 F7E1                        mul cx              ; wait
   188 00000059 F7E1                        mul cx              ; wait
   189 0000005B E6DA                        out USART_CMD, al
   190                                   
   191 0000005D F7E1                        mul cx              ; wait
   192 0000005F F7E1                        mul cx              ; wait
   193 00000061 B040                        mov al, 0x40        ; reset
   194 00000063 E6DA                        out USART_CMD, al
   195                                   
   196 00000065 F7E1                        mul cx              ; wait
   197 00000067 F7E1                        mul cx              ; wait
   198 00000069 B04E                        mov al, 0x4e        ; set mode
   199 0000006B E6DA                        out USART_CMD, al
   200                                   
   201 0000006D F7E1                        mul cx              ; wait
   202 0000006F F7E1                        mul cx              ; wait
   203 00000071 B037                        mov al, 0x37        ; rx,tx ready
   204 00000073 E6DA                        out USART_CMD, al
   205                                   %endif
   206                                  
   207                                      ; 変数初期化 (RAMエリアをクリア)
   208 00000075 C706[9805]0000              mov word [dump_seg], 0x0000
   209 0000007B C706[9A05]0000              mov word [dump_off], 0x0000
   210 00000081 C706[9C05]0020              mov word [load_seg], 0x2000
   211                                  
   212                                      ; スタートメッセージの表示
   213 00000087 BE[3D04]                    mov si, msg_boot
   214 0000008A E89502                      call puts
   215                                  
   216                                  ; =================================================================
   217                                  ; Main Loop
   218                                  ; =================================================================
   219                                  monitor_loop:
   220 0000008D B03E                        mov al, '>'
   221 0000008F E89E02                      call putc
   222 00000092 B020                        mov al, ' '
   223 00000094 E89902                      call putc
   224                                  
   225 00000097 E8B802                      call getc_echo  ; コマンド受信（エコーあり）
   226 0000009A 88C3                        mov bl, al
   227                                      
   228 0000009C 80FB64                      cmp bl, 'd'     ; dump command
   229 0000009F 746B                        je do_dump
   230 000000A1 80FB44                      cmp bl, 'D'
   231 000000A4 7466                        je do_dump
   232                                      
   233 000000A6 80FB6C                      cmp bl, 'l'     ; load command
   234 000000A9 7503E9C100                  je do_load
   235 000000AE 80FB4C                      cmp bl, 'L'
   236 000000B1 7503E9B900                  je do_load
   237                                      
   238 000000B6 80FB67                      cmp bl, 'g'     ; go command
   239 000000B9 7503E92C01                  je do_go
   240 000000BE 80FB47                      cmp bl, 'G'
   241 000000C1 7503E92401                  je do_go
   242                                  
   243 000000C6 80FB77                      cmp bl, 'w'     ; Write command
   244 000000C9 7503E94801                  je do_write
   245 000000CE 80FB57                      cmp bl, 'W'
   246 000000D1 7503E94001                  je do_write
   247                                  
   248 000000D6 3C69                        cmp al, 'i'     ; Input Port command
   249 000000D8 7503E97C01                  je do_in
   250 000000DD 3C49                        cmp al, 'I'
   251 000000DF 7503E97501                  je do_in
   252                                  
   253 000000E4 3C6F                        cmp al, 'o'     ; Output Port command
   254 000000E6 7503E99201                  je do_out
   255 000000EB 3C4F                        cmp al, 'O'
   256 000000ED 7503E98B01                  je do_out
   257                                  
   258 000000F2 3C73                        cmp al, 's'     ; Scan I/O command
   259 000000F4 7503E9AB01                  je do_scan
   260 000000F9 3C53                        cmp al, 'S'
   261 000000FB 7503E9A401                  je do_scan
   262                                      
   263 00000100 3C3F                        cmp al, '?'     ; Help
   264 00000102 7503E90F02                  je cmd_help
   265                                  
   266                                      ; 知らないコマンドなら改行して戻る
   267 00000107 E85102                      call putc_crlf
   268 0000010A EB81                        jmp monitor_loop
   269                                  
   270                                  ; =================================================================
   271                                  ; Command: Dump Memory
   272                                  ; Usage:
   273                                  ;   D               -> Dump next 64 bytes
   274                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   275                                  ; =================================================================
   276                                  do_dump:
   277 0000010C E84302                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   278 0000010F 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   279 00000111 7418                        je .dump_run
   280 00000113 3C20                        cmp al, ' '         ; Spaceなら引数解析
   281 00000115 7405                        je .parse_args
   282                                      
   283                                      ; それ以外なら無視して実行へ（またはエラー処理）
   284 00000117 E84102                      call putc_crlf
   285 0000011A EB12                        jmp .dump_run_start
   286                                  
   287                                  .parse_args:
   288 0000011C E86A02                      call get_hex_word
   289 0000011F A3[9805]                    mov [dump_seg], ax
   290 00000122 E8AA02                      call skip_space
   291 00000125 E86102                      call get_hex_word
   292 00000128 A3[9A05]                    mov [dump_off], ax
   293                                      ; ここでEnter待ちをするか、そのまま実行するか
   294                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   295                                      
   296                                  .dump_run:
   297 0000012B E82D02                      call putc_crlf              ; 実行直前に改行
   298                                  
   299                                  .dump_run_start:
   300 0000012E B90400                      mov cx, 4                   ; 4行表示する
   301                                      
   302                                  .line_loop:
   303 00000131 51                          push cx
   304                                      
   305 00000132 A1[9805]                    mov ax, [dump_seg]          ; セグメントの表示
   306 00000135 E82C02                      call print_hex_word
   307 00000138 B03A                        mov al, ':'                 ; 区切り文字の:を表示
   308 0000013A E8F301                      call putc
   309 0000013D A1[9A05]                    mov ax, [dump_off]          ; オフセットの表示
   310 00000140 E82102                      call print_hex_word
   311 00000143 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   312 00000145 E8E801                      call putc
   313                                  
   314 00000148 8B36[9A05]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   315                                  
   316 0000014C 1E                          push ds                     ; モニタのDSを保存
   317 0000014D 8E1E[9805]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   318                                      
   319 00000151 B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   320                                  .hex_loop:
   321 00000154 8A04                        mov al, [si]
   322 00000156 E81202                      call print_hex_byte         ; メモリ内容の表示
   323 00000159 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   324 0000015B E8D201                      call putc
   325 0000015E 46                          inc si                      ; 次のアドレスにする
   326 0000015F E2F3                        loop .hex_loop              ; 16回繰り返し    
   327                                  
   328 00000161 1F                          pop ds                      ; DSをモニタ用に戻す
   329                                  
   330 00000162 8936[9A05]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   331                                  
   332 00000166 E8F201                      call putc_crlf              ; 改行する
   333 00000169 59                          pop cx
   334 0000016A E2C5                        loop .line_loop             ; 4回繰り返す
   335                                      
   336 0000016C E91EFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   337                                  
   338                                  ; =================================================================
   339                                  ; Command: Load Intel HEX
   340                                  ; Usage:
   341                                  ;   L           -> Load to default segment (load_seg)
   342                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   343                                  ; =================================================================
   344                                  do_load:
   345                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   346 0000016F A1[9C05]                    mov ax, [load_seg]
   347 00000172 06                          push es             ; RAM用ESを保存
   348 00000173 50                          push ax             ; デフォルトセグメントを保存
   349                                      
   350 00000174 E8DB01                      call getc_echo
   351 00000177 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   352 00000179 7402                        je .parse_seg
   353 0000017B EB05                        jmp .start_load
   354                                  
   355                                  .parse_seg:
   356 0000017D 58                          pop ax              ; 不要になったデフォルトを捨てる
   357 0000017E E80802                      call get_hex_word   ; 新しいセグメント取得
   358 00000181 50                          push ax             ; 保存
   359                                  
   360                                  .start_load:
   361 00000182 E8D601                      call putc_crlf      ; メッセージ表示前に改行
   362 00000185 BE[6904]                    mov si, msg_load    ; ロード開始メッセージを表示
   363 00000188 E89701                      call puts
   364                                      
   365 0000018B 58                          pop ax
   366 0000018C 8EC0                        mov es, ax          ; ロード先をESに設定
   367                                      
   368                                      ; ターゲット表示
   369 0000018E E8D301                      call print_hex_word ; ESの値を表示
   370 00000191 B03A                        mov al, ':'         ; 区切り文字を表示
   371 00000193 E89A01                      call putc
   372 00000196 B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   373 00000198 E89501                      call putc
   374 0000019B E8BD01                      call putc_crlf
   375                                  
   376                                  .wait_record:
   377 0000019E E8A201                      call getc           ; 開始文字を待つ
   378 000001A1 3C3A                        cmp al, ':'
   379 000001A3 75F9                        jne .wait_record
   380                                  
   381 000001A5 E80602                      call get_hex_byte   ; データ長を読み込み
   382 000001A8 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   383 000001AA B500                        mov ch, 0
   384                                      
   385 000001AC E8FF01                      call get_hex_byte   ; 上位アドレスを読み込み
   386 000001AF 88C7                        mov bh, al
   387 000001B1 E8FA01                      call get_hex_byte   ; 下位アドレスを読み込み
   388 000001B4 88C3                        mov bl, al
   389                                      
   390 000001B6 E8F501                      call get_hex_byte   ; レコードタイプを読み込み
   391 000001B9 3C01                        cmp al, 01          ; End of File?
   392 000001BB 7419                        je .handle_eof      ; EOFの処理へ
   393 000001BD 3C00                        cmp al, 00          ; Data Record?
   394 000001BF 751A                        jne .skip_line      ; その他はスキップ
   395                                      
   396 000001C1 E309                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   397                                      
   398                                  .data_loop:
   399 000001C3 E8E801                      call get_hex_byte   ; 1バイト読み取り
   400 000001C6 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   401 000001C9 43                          inc bx              ; 次のアドレスにする
   402 000001CA E2F7                        loop .data_loop     ; データ長分繰り返す
   403                                      
   404                                  .read_chk:
   405 000001CC E8DF01                      call get_hex_byte   ; チェックサム読み取り（読み飛ばし）
   406 000001CF B02E                        mov al, '.'         ; 1行読んだことを示す"."を出力
   407 000001D1 E85C01                      call putc
   408 000001D4 EBC8                        jmp .wait_record    ; 次のレコード読み取りへ
   409                                  
   410                                  .handle_eof:            ; EOFの場合
   411 000001D6 E8D501                      call get_hex_byte   ; チェックサムを読み飛ばす
   412 000001D9 EB02                        jmp .finish         ; 読み込み終了処理へ
   413                                  
   414                                  .skip_line:
   415 000001DB EBC1                        jmp .wait_record    ; 次のレコード読み込みへ
   416                                  
   417                                  .finish:
   418 000001DD 07                          pop es              ; RAM用ESを復帰
   419 000001DE E87A01                      call putc_crlf
   420 000001E1 BE[7504]                    mov si, msg_ok      ; "OK"を表示
   421 000001E4 E83B01                      call puts
   422 000001E7 E9A3FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   423                                  
   424                                  ; =================================================================
   425                                  ; Command: Execute
   426                                  ; Usage:
   427                                  ;   G <Seg> <Off>
   428                                  ; Example: G 1000 0000
   429                                  ; =================================================================
   430                                  do_go:
   431                                      ; Gコマンドは入力後に改行
   432                                      
   433 000001EA E86501                      call getc_echo      ; Space?
   434 000001ED 3C20                        cmp al, ' '
   435 000001EF 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   436                                      
   437                                      ; 1. セグメント (SSSS) を取得
   438 000001F1 E89501                      call get_hex_word   ; AX = Segment
   439 000001F4 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   440 000001F5 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   441                                      
   442                                      ; スペース読み飛ばし (もしあれば)
   443 000001F7 E8D501                      call skip_space
   444                                      
   445                                      ; 2. オフセット (OOOO) を取得
   446 000001FA E88C01                      call get_hex_word   ; AX = Offset
   447 000001FD 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   448                                      
   449 000001FE E85A01                      call putc_crlf      ; 実行前に改行
   450 00000201 BE[7804]                    mov si, msg_go
   451 00000204 E81B01                      call puts
   452 00000207 E85101                      call putc_crlf
   453                                      
   454                                      ; 3. 実行環境のセットアップ
   455                                      ; ジャンプ先のプログラムのために、DS, ES もセグメントに合わせておくのが親切
   456 0000020A 8EDB                        mov ds, bx
   457 0000020C 8EC3                        mov es, bx
   458                                  
   459                                      ; 必要なら割り込み禁止 (OSが自分でセットアップするまで黙らせる)
   460 0000020E FA                          cli
   461                                  
   462                                      ; 4. ジャンプ！ (Far Return)
   463                                      ; スタック上の [IP, CS] をポップして、そこへ飛ぶ
   464 0000020F CB                          retf                ; Jump!
   465                                  
   466                                  .go_default:
   467 00000210 E84801                      call putc_crlf      ; 改行して
   468 00000213 E977FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   469                                  
   470                                  ; ==============================================================
   471                                  ; Command: Write Memory
   472                                  ; Usage:
   473                                  ;   W <Seg> <Off> <Val>
   474                                  ; ==============================================================
   475                                  do_write:    
   476 00000216 E83901                      call getc_echo      ; Space?
   477 00000219 3C20                        cmp al, ' '
   478 0000021B 7403E9B301                  jne error           ; 引数なしならリターン(またはエラー)
   479                                  
   480                                      ; 1. セグメント (SSSS) を取得
   481 00000220 E86601                      call get_hex_word   ; AX = Segment
   482 00000223 50                          push ax             ; ターゲットセグメントを保存
   483                                      
   484 00000224 E82B01                      call getc_echo      ; Space?
   485 00000227 3C20                        cmp al, ' '
   486 00000229 7403E9A501                  jne error           ; 引数なしならリターン(またはエラー)
   487                                      
   488                                      ; 2. オフセット (OOOO) を取得
   489 0000022E E85801                      call get_hex_word   ; AX = Offset
   490 00000231 50                          push ax             ; ターゲットオフセットを保存
   491                                  
   492 00000232 E81D01                      call getc_echo      ; Space?
   493 00000235 3C20                        cmp al, ' '
   494 00000237 7403E99701                  jne error           ; 引数なしならリターン(またはエラー)
   495                                  
   496                                      ; 3. 設定データ (VV) を取得
   497 0000023C E85901                      call get_hex_byte_echo   ; AL = Value
   498                                  
   499 0000023F 5B                          pop bx              ; bx = Offset
   500 00000240 5A                          pop dx              ; dx = Target Segment
   501                                  
   502                                      ; 次回のDコマンドのためにダンプ位置変数を更新する
   503 00000241 8916[9805]                  mov [dump_seg], dx
   504 00000245 891E[9A05]                  mov [dump_off], bx
   505                                      
   506 00000249 8EDA                        mov ds, dx          ; DS再設定
   507 0000024B 3E8807                      mov [ds:bx], al     ; 書き込み！
   508                                      
   509 0000024E 0E                          push cs             ; DSを復帰 (CS=DS前提のモニタなので)
   510 0000024F 1F                          pop ds
   511                                  
   512 00000250 BE[9B04]                    mov si, msg_done
   513 00000253 E8CC00                      call puts
   514 00000256 E934FE                      jmp monitor_loop
   515                                  
   516                                  ; ==============================================================
   517                                  ; Command: Input from Port
   518                                  ; Usage:
   519                                  ;   I <Port>
   520                                  ; ==============================================================
   521                                  do_in:
   522 00000259 E8F600                      call getc_echo
   523 0000025C 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   524 0000025E 7403E97001                  jne error           ; パラメタが無い場合はエラー処理へ
   525                                  
   526 00000263 E82301                      call get_hex_word   ; ポートアドレスを取得
   527 00000266 89C2                        mov dx, ax          ; 保存
   528 00000268 EC                          in al, dx           ; I/O Read
   529                                      
   530 00000269 50                          push ax
   531 0000026A E8EE00                      call putc_crlf      ; メッセージ表示前に改行
   532 0000026D BE[9504]                    mov si, msg_in_res
   533 00000270 E8AF00                      call puts
   534 00000273 58                          pop ax
   535                                  
   536 00000274 E8F400                      call print_hex_byte ; 値を表示
   537                                  
   538 00000277 E8E100                      call putc_crlf      ; 改行して
   539 0000027A E910FE                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   540                                  
   541                                  ; ==============================================================
   542                                  ; Command: Output to Port
   543                                  ; Usage
   544                                  ;   O <Port> <Val>
   545                                  ; ==============================================================
   546                                  do_out:
   547 0000027D E8D200                      call getc_echo
   548 00000280 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   549 00000282 7403E94C01                  jne error           ; パラメタが無い場合はエラー処理へ
   550                                  
   551 00000287 E8FF00                      call get_hex_word   ; ポートアドレスを取得
   552 0000028A 50                          push ax             ; スタックに積む
   553                                  
   554 0000028B E8C400                      call getc_echo
   555 0000028E 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   556 00000290 750E                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   557                                      
   558 00000292 E80301                      call get_hex_byte_echo   ; 出力値を取得
   559 00000295 5A                          pop dx              ; スタックからDXにセット
   560                                      
   561 00000296 EE                          out dx, al          ; I/O Write
   562                                      
   563 00000297 BE[9B04]                    mov si, msg_done    ; DONEを表示。改行付き。
   564 0000029A E88500                      call puts
   565 0000029D E9EDFD                      jmp monitor_loop    ; モニタのメインルーチンに飛ぶ
   566                                  
   567                                  error_pop:
   568 000002A0 58                          pop ax              ; 使わなかったスタックを捨てる
   569 000002A1 E92F01                      jmp error
   570                                  
   571                                  ; ==============================================================
   572                                  ; Command: Scan I/O Ports
   573                                  ; Usage:
   574                                  ;   S <Start_port> <End_port>
   575                                  ; Description: Reads ports and prints if value is NOT 0xFF
   576                                  ; ==============================================================
   577                                  do_scan:
   578 000002A4 E8AB00                      call getc_echo
   579 000002A7 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   580 000002A9 7403E92501                  jne error           ; パラメタが無い場合はエラー処理へ
   581                                  
   582 000002AE E8D800                      call get_hex_word   ; スタートポートアドレスを取得
   583 000002B1 89C3                        mov bx, ax          ; BX = Start Address
   584                                      
   585 000002B3 E89C00                      call getc_echo
   586 000002B6 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   587 000002B8 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   588                                  
   589 000002BA E8CC00                      call get_hex_word   ; エンドポートアドレスを取得
   590 000002BD 89C1                        mov cx, ax          ; CX = End Address
   591                                  
   592 000002BF 39CB                        cmp bx, cx          ; 開始 > 終了 ならエラー終了
   593 000002C1 7603E90D01                  ja error
   594                                  
   595 000002C6 E89200                      call putc_crlf
   596 000002C9 BE[2105]                    mov si, msg_scan_start
   597 000002CC E85300                      call puts
   598                                  
   599                                  .scan_loop:
   600 000002CF 89DA                        mov dx, bx          ; DXにポートアドレス設定
   601 000002D1 EC                          in al, dx           ; I/O Read
   602                                  
   603 000002D2 3CFF                        cmp al, 0xFF        ; 0xFF (Empty Bus) なら表示しない
   604 000002D4 741D                        je .next_port
   605                                  
   606 000002D6 50                          push ax             ; Readした値をスタックに保存
   607                                  
   608                                      ; --- 有効な値が見つかった場合の表示 ---
   609                                      ; [Port]: Value
   610 000002D7 89D8                        mov ax, bx
   611 000002D9 E88800                      call print_hex_word ; ポートアドレスの表示
   612 000002DC B03A                        mov al, ':'
   613 000002DE E84F00                      call putc
   614 000002E1 B020                        mov al, ' '
   615 000002E3 E84A00                      call putc
   616                                      
   617 000002E6 58                          pop ax
   618 000002E7 E88100                      call print_hex_byte ; Readした値の表示
   619                                      
   620 000002EA BE[4C05]                    mov si, msg_space   ; "  "
   621 000002ED E83200                      call puts
   622                                  
   623                                      ; 1行に見やすく並べるため、適当な間隔で改行を入れる等の工夫も可能ですが
   624                                      ; ここでは単純にリスト形式で改行します
   625 000002F0 E86800                      call putc_crlf
   626                                  
   627                                  .next_port:
   628 000002F3 43                          inc bx              ; 次のアドレスへ
   629                                      
   630                                      ; キー入力チェック（長いスキャンを中断できるようにする）
   631 000002F4 BA6112                      mov dx, SCU_SST
   632 000002F7 EC                          in al, dx
   633 000002F8 A802                        test al, RX_READY   ; RxRDY?
   634 000002FA 750D                        jnz .abort          ; 何かキーが押されたら中断
   635                                  
   636 000002FC 39CB                        cmp bx, cx
   637 000002FE 76CF                        jbe .scan_loop      ; BX <= CX ならループ
   638                                  
   639 00000300 BE[9B04]                    mov si, msg_done
   640 00000303 E81C00                      call puts
   641 00000306 E984FD                      jmp monitor_loop
   642                                  
   643                                  .abort:
   644                                      ; 入力バッファを空読みしておく
   645 00000309 BA6012                      mov dx, SCU_DATA
   646 0000030C EC                          in al, dx
   647 0000030D BE[4F05]                    mov si, msg_abort
   648 00000310 E80F00                      call puts
   649 00000313 E977FD                      jmp monitor_loop
   650                                  
   651                                  ; ==============================================================
   652                                  ; Command: Help
   653                                  ; ==============================================================
   654                                  cmd_help:
   655 00000316 E84200                      call putc_crlf
   656 00000319 BE[A604]                    mov si, msg_help
   657 0000031C E80300                      call puts
   658 0000031F E96BFD                      jmp monitor_loop
   659                                  
   660                                  ; =================================================================
   661                                  ; Utilities
   662                                  ; =================================================================
   663                                  
   664                                  ; 文字列出力
   665                                  puts:
   666 00000322 2E8A04                      mov al, [cs:si]
   667 00000325 08C0                        or al, al
   668 00000327 7406                        jz .ret
   669 00000329 E80400                      call putc
   670 0000032C 46                          inc si
   671 0000032D EBF3                        jmp puts
   672 0000032F C3                      .ret: ret
   673                                  
   674                                  ; 1文字出力
   675                                  putc:
   676 00000330 52                          push dx
   677 00000331 50                          push ax
   678 00000332 BA6112                      mov dx, SCU_SST
   679 00000335 EC                      .w: in al, dx
   680 00000336 A801                        test al, TX_READY  ; TX Ready?
   681 00000338 74FB                        jz .w
   682 0000033A BA6012                      mov dx, SCU_DATA
   683 0000033D 58                          pop ax
   684 0000033E 50                          push ax
   685 0000033F EE                          out dx, al
   686 00000340 58                          pop ax
   687 00000341 5A                          pop dx
   688 00000342 C3                          ret
   689                                  
   690                                  ; 1文字入力
   691                                  getc:
   692 00000343 52                          push dx
   693 00000344 BA6112                      mov dx, SCU_SST
   694 00000347 EC                      .w: in al, dx
   695 00000348 A802                        test al, RX_READY  ; RX Ready?
   696 0000034A 74FB                        jz .w
   697 0000034C BA6012                      mov dx, SCU_DATA
   698 0000034F EC                          in al, dx
   699 00000350 5A                          pop dx
   700 00000351 C3                          ret
   701                                  
   702                                  ; 1文字入力　エコーバックあり
   703                                  getc_echo:
   704 00000352 E8EEFF                      call getc
   705 00000355 50                          push ax
   706 00000356 E8D7FF                      call putc
   707 00000359 58                          pop ax
   708 0000035A C3                          ret
   709                                  
   710                                  ; 改行出力
   711                                  putc_crlf:
   712 0000035B B00D                        mov al, 0x0D
   713 0000035D E8D0FF                      call putc
   714 00000360 B00A                        mov al, 0x0A
   715 00000362 EBCC                        jmp putc
   716                                  
   717                                  ; -----------------------------------------------------------------
   718                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   719                                  ; Input: AX
   720                                  ; -----------------------------------------------------------------
   721                                  print_hex_word:
   722 00000364 50                          push ax
   723 00000365 88E0                        mov al, ah
   724 00000367 E80100                      call print_hex_byte
   725 0000036A 58                          pop ax
   726                                  
   727                                  ; -----------------------------------------------------------------
   728                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   729                                  ; Input: AL
   730                                  ; -----------------------------------------------------------------
   731                                  print_hex_byte:
   732 0000036B 50                          push ax
   733 0000036C 51                          push cx
   734                                  
   735                                      ; 上位バイトの表示
   736 0000036D 50                          push ax
   737 0000036E C0E804                      shr al, 4
   738 00000371 E80900                      call .digit
   739                                  
   740                                      ; 下位バイトの表示
   741 00000374 58                          pop ax
   742 00000375 240F                        and al, 0x0F
   743 00000377 E80300                      call .digit
   744                                  
   745 0000037A 59                          pop cx
   746 0000037B 58                          pop ax
   747 0000037C C3                          ret
   748                                  
   749                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   750                                  .digit:
   751 0000037D 0430                        add al, '0'
   752 0000037F 3C39                        cmp al, '9'
   753 00000381 7602                        jbe .p
   754 00000383 0407                        add al, 7
   755 00000385 E8A8FF                  .p: call putc
   756 00000388 C3                          ret
   757                                  
   758                                  ; -----------------------------------------------------------------
   759                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   760                                  ; Input:  Serial (例: "1", "0", "0", "0")
   761                                  ; Output: AX = 0x1000
   762                                  ; -----------------------------------------------------------------
   763                                  get_hex_word:
   764 00000389 53                          push bx
   765 0000038A E80B00                      call get_hex_byte_echo
   766 0000038D 88C7                        mov bh, al
   767 0000038F E80600                      call get_hex_byte_echo
   768 00000392 88C3                        mov bl, al
   769 00000394 89D8                        mov ax, bx
   770 00000396 5B                          pop bx
   771 00000397 C3                          ret
   772                                  
   773                                  ; 16進数2桁入力　エコーバック有り
   774                                  get_hex_byte_echo:
   775 00000398 53                          push bx
   776 00000399 E8B6FF                      call getc_echo
   777 0000039C E82500                      call hex_char_to_bin
   778 0000039F C0E004                      shl al, 4
   779 000003A2 88C3                        mov bl, al
   780 000003A4 E8ABFF                      call getc_echo
   781 000003A7 E81A00                      call hex_char_to_bin
   782 000003AA 08D8                        or al, bl
   783 000003AC 5B                          pop bx
   784 000003AD C3                          ret
   785                                  
   786                                  ; -----------------------------------------------------------------
   787                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   788                                  ; Input:  Serial (例: "3", "F")
   789                                  ; Output: AL = 0x3F
   790                                  ; -----------------------------------------------------------------
   791                                  get_hex_byte:
   792 000003AE 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   793                                  
   794                                      ; 上位4bit
   795 000003AF E891FF                      call getc
   796 000003B2 E80F00                      call hex_char_to_bin
   797 000003B5 C0E004                      shl al, 4
   798 000003B8 88C3                        mov bl, al          ; 一時保存
   799                                      
   800                                      ; 下位4bit
   801 000003BA E886FF                      call getc
   802 000003BD E80400                      call hex_char_to_bin
   803 000003C0 08D8                        or al, bl           ; 上位を合成して結果はALへ
   804 000003C2 5B                          pop bx
   805 000003C3 C3                          ret
   806                                  
   807                                  ; -----------------------------------------------------------------
   808                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   809                                  ; Input: AL (ASCII)
   810                                  ; Output: AL (Binary)
   811                                  ; -----------------------------------------------------------------
   812                                  hex_char_to_bin:
   813 000003C4 2C30                        sub al, '0'
   814 000003C6 3C09                        cmp al, 9
   815 000003C8 7604                        jbe .done
   816 000003CA 2C07                        sub al, 7           ; 'A'-'F'対応
   817 000003CC 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   818                                  .done:
   819 000003CE C3                          ret
   820                                  
   821                                  ; -----------------------------------------------------------------
   822                                  ; Helper: スペースなどを読み飛ばす
   823                                  ; -----------------------------------------------------------------
   824                                  skip_space:
   825 000003CF E880FF                      call getc_echo
   826 000003D2 C3                          ret
   827                                  
   828                                  ; -----------------------------------------------------------------
   829                                  ; Helper: エラーメッセージ出力後モニタに戻る
   830                                  ; -----------------------------------------------------------------
   831                                  error:
   832 000003D3 BE[7F04]                    mov si, msg_error
   833 000003D6 E849FF                      call puts
   834 000003D9 E9B1FC                      jmp monitor_loop
   835                                  
   836                                  ;==========================================================
   837                                  ; NMI (ABORT) Handler
   838                                  ;==========================================================
   839                                  
   840                                  NMI_Handler:
   841                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
   842 000003DC 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
   843 000003DD 1E                          push ds
   844 000003DE 06                          push es
   845                                  
   846                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
   847 000003DF 8CC8                        mov  ax, cs
   848 000003E1 8ED8                        mov  ds, ax
   849 000003E3 8EC0                        mov  es, ax
   850                                  
   851                                      ; 3. スタックフレームへのポインタ設定
   852 000003E5 89E5                        mov  bp, sp
   853                                  
   854                                      ; --- 画面表示 ---
   855 000003E7 BE[5A05]                    mov  si, msg_nmi
   856 000003EA E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
   857                                  
   858                                      ; 3. レジスタ表示 (スタックから読み出して表示)
   859                                      ; Stack Layout after pushes:
   860                                      ; BP+0: ES
   861                                      ; BP+2: DS
   862                                      ; BP+4: DI
   863                                      ; BP+6: SI
   864                                      ; BP+8: BP (Old)
   865                                      ; BP+10: SP (Original)
   866                                      ; BP+12: BX
   867                                      ; BP+14: DX
   868                                      ; BP+16: CX
   869                                      ; BP+18: AX
   870                                      ; BP+20: IP (Return Addr)
   871                                      ; BP+22: CS (Return Addr)
   872                                      ; BP+24: Flags
   873                                      
   874                                      ; AX
   875 000003ED BE[7205]                    mov  si, msg_ax
   876 000003F0 E82FFF                      call puts
   877 000003F3 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
   878 000003F6 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
   879                                  
   880                                      ; BX
   881 000003F9 BE[7705]                    mov  si, msg_bx
   882 000003FC E823FF                      call puts
   883 000003FF 8B460C                      mov  ax, [bp+12]
   884 00000402 E85FFF                      call print_hex_word
   885                                  
   886                                      ; CX
   887 00000405 BE[7C05]                    mov  si, msg_cx
   888 00000408 E817FF                      call puts
   889 0000040B 8B4610                      mov  ax, [bp+16]
   890 0000040E E853FF                      call print_hex_word
   891                                  
   892                                      ; DX
   893 00000411 BE[8105]                    mov  si, msg_dx
   894 00000414 E80BFF                      call puts
   895 00000417 8B460E                      mov  ax, [bp+14]
   896 0000041A E847FF                      call print_hex_word
   897                                  
   898 0000041D E83BFF                      call putc_crlf
   899                                  
   900                                      ; --- 中断地点 (CS:IP) の表示 ---
   901                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
   902                                      ; その上が割り込み発生時の IP, CS, Flags です
   903                                      
   904 00000420 BE[8605]                    mov  si, msg_addr
   905 00000423 E8FCFE                      call puts           ; " Stop at "
   906 00000426 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
   907 00000429 E838FF                      call print_hex_word
   908 0000042C B03A                        mov  al, ':'
   909 0000042E E8FFFE                      call putc
   910 00000431 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
   911 00000434 E82DFF                      call print_hex_word
   912                                  
   913 00000437 E821FF                      call putc_crlf
   914                                  
   915                                      ; 4. 復帰処理
   916                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
   917                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
   918 0000043A E9C3FB                      jmp  start  ; モニタの開始ラベルへ
   919                                  
