   622                                      
   623                                      ; 2. オフセット (OOOO) を取得
   624 00000311 E8CF01                      call get_hex_word   ; AX = Offset
   625 00000314 50                          push ax             ; スタックに積む (あとでRETFでIPになる)
   626                                      
   627 00000315 E89D01                      call putc_crlf      ; 実行前に改行
   628 00000318 BE[0807]                    mov si, msg_go
