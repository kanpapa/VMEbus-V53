   829                                  ; ==============================================================
   830                                  ; Command: Timer
   831                                  ;   T          -> Show current tick counter (32-bit HEX)
   832                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   833                                  ; ==============================================================
   834                                  do_timer:
   835 0000042D E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   836 00000430 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   837 00000432 7421                        je .show_counter
   838 00000434 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   839 00000436 7403E9F200                  jne error           ; それ以外はエラー
   840                                  
   841                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   842 0000043B E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   843                                  
   844                                      ; 開始時刻を保存 (Start Time)
   845 0000043E 8B1E[0709]                  mov bx, [tick_counter_lo]
   846                                  
   847                                  .wait_loop:
   848                                      ; 1. 現在時刻を取得
   849 00000442 8B0E[0709]                  mov cx, [tick_counter_lo]
   850                                      
   851                                      ; 2. 経過時間を計算 (Current - Start)
   852                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   853 00000446 29D9                        sub cx, bx          
   854                                      
   855                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   856 00000448 39C1                        cmp cx, ax
   857 0000044A 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   858                                  
   859                                      ; 指定時間経過した
   860 0000044C BE[2B07]                    mov si, msg_done
   861 0000044F E82A00                      call puts
   862 00000452 E937FD                      jmp monitor_loop
   863                                  
   864                                  .show_counter:
   865                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   866 00000455 E85D00                      call putc_crlf
   867                                      
   868 00000458 BE[F307]                    mov si, msg_tick    ; "Tick: "
   869 0000045B E81E00                      call puts
   870                                  
   871                                      ; 32bitカウンタを [High][Low] の順で表示
   872 0000045E A1[0909]                    mov ax, [tick_counter_hi]
   873 00000461 E85A00                      call print_hex_word
   874 00000464 A1[0709]                    mov ax, [tick_counter_lo]
   875 00000467 E85400                      call print_hex_word
   876                                      
   877 0000046A E84800                      call putc_crlf
   878 0000046D E91CFD                      jmp monitor_loop
   879                                  
   880                                  ; ==============================================================
   881                                  ; Command: Help
   882                                  ; ==============================================================
   883                                  cmd_help:
   884 00000470 E84200                      call putc_crlf
   885 00000473 BE[3707]                    mov si, msg_help
   886 00000476 E80300                      call puts
   887 00000479 E910FD                      jmp monitor_loop
   888                                  
   889                                  ; =================================================================
   890                                  ; Utilities
   891                                  ; =================================================================
   892                                  
   893                                  ; 文字列出力
   894                                  puts:
   895 0000047C 2E8A04                      mov al, [cs:si]
   896 0000047F 08C0                        or al, al
   897 00000481 7406                        jz .ret
   898 00000483 E80400                      call putc
   899 00000486 46                          inc si
   900 00000487 EBF3                        jmp puts
   901 00000489 C3                      .ret: ret
   902                                  
   903                                  ; 1文字出力
   904                                  putc:
   905 0000048A 52                          push dx
   906 0000048B 50                          push ax
   907 0000048C BA61F0                      mov dx, SCU_SST
   908 0000048F EC                      .w: in al, dx
   909 00000490 A801                        test al, TX_READY  ; TX Ready?
   910 00000492 74FB                        jz .w
   911 00000494 BA60F0                      mov dx, SCU_DATA
   912 00000497 58                          pop ax
   913 00000498 50                          push ax
   914 00000499 EE                          out dx, al
   915 0000049A 58                          pop ax
   916 0000049B 5A                          pop dx
   917 0000049C C3                          ret
   918                                  
   919                                  ; 1文字入力
   920                                  getc:
   921 0000049D 52                          push dx
   922 0000049E BA61F0                      mov dx, SCU_SST
   923 000004A1 EC                      .w: in al, dx
   924 000004A2 A802                        test al, RX_READY  ; RX Ready?
   925 000004A4 74FB                        jz .w
   926 000004A6 BA60F0                      mov dx, SCU_DATA
   927 000004A9 EC                          in al, dx
   928 000004AA 5A                          pop dx
   929 000004AB C3                          ret
   930                                  
   931                                  ; 1文字入力　エコーバックあり
   932                                  getc_echo:
   933 000004AC E8EEFF                      call getc
   934 000004AF 50                          push ax
   935 000004B0 E8D7FF                      call putc
   936 000004B3 58                          pop ax
   937 000004B4 C3                          ret
   938                                  
   939                                  ; 改行出力
   940                                  putc_crlf:
   941 000004B5 B00D                        mov al, 0x0D
   942 000004B7 E8D0FF                      call putc
   943 000004BA B00A                        mov al, 0x0A
   944 000004BC EBCC                        jmp putc
   945                                  
   946                                  ; -----------------------------------------------------------------
   947                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   948                                  ; Input: AX
   949                                  ; -----------------------------------------------------------------
   950                                  print_hex_word:
   951 000004BE 50                          push ax
   952 000004BF 88E0                        mov al, ah
   953 000004C1 E80100                      call print_hex_byte
   954 000004C4 58                          pop ax
   955                                  
   956                                  ; -----------------------------------------------------------------
   957                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   958                                  ; Input: AL
   959                                  ; -----------------------------------------------------------------
   960                                  print_hex_byte:
   961 000004C5 50                          push ax
   962 000004C6 51                          push cx
   963                                  
   964                                      ; 上位バイトの表示
   965 000004C7 50                          push ax
   966 000004C8 C0E804                      shr al, 4
   967 000004CB E80900                      call .digit
   968                                  
   969                                      ; 下位バイトの表示
   970 000004CE 58                          pop ax
   971 000004CF 240F                        and al, 0x0F
   972 000004D1 E80300                      call .digit
   973                                  
   974 000004D4 59                          pop cx
   975 000004D5 58                          pop ax
   976 000004D6 C3                          ret
   977                                  
   978                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   979                                  .digit:
   980 000004D7 0430                        add al, '0'
   981 000004D9 3C39                        cmp al, '9'
   982 000004DB 7602                        jbe .p
   983 000004DD 0407                        add al, 7
   984 000004DF E8A8FF                  .p: call putc
   985 000004E2 C3                          ret
   986                                  
   987                                  ; -----------------------------------------------------------------
   988                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   989                                  ; Input:  Serial (例: "1", "0", "0", "0")
   990                                  ; Output: AX = 0x1000
   991                                  ; -----------------------------------------------------------------
   992                                  get_hex_word:
   993 000004E3 53                          push bx
   994 000004E4 E80B00                      call get_hex_byte_echo
   995 000004E7 88C7                        mov bh, al
   996 000004E9 E80600                      call get_hex_byte_echo
   997 000004EC 88C3                        mov bl, al
   998 000004EE 89D8                        mov ax, bx
   999 000004F0 5B                          pop bx
  1000 000004F1 C3                          ret
  1001                                  
  1002                                  ; 16進数2桁入力　エコーバック有り
  1003                                  get_hex_byte_echo:
  1004 000004F2 53                          push bx
  1005 000004F3 E8B6FF                      call getc_echo
  1006 000004F6 E82500                      call hex_char_to_bin
  1007 000004F9 C0E004                      shl al, 4
  1008 000004FC 88C3                        mov bl, al
  1009 000004FE E8ABFF                      call getc_echo
  1010 00000501 E81A00                      call hex_char_to_bin
  1011 00000504 08D8                        or al, bl
  1012 00000506 5B                          pop bx
  1013 00000507 C3                          ret
  1014                                  
  1015                                  ; -----------------------------------------------------------------
  1016                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1017                                  ; Input:  Serial (例: "3", "F")
  1018                                  ; Output: AL = 0x3F
  1019                                  ; -----------------------------------------------------------------
  1020                                  get_hex_byte:
  1021 00000508 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1022                                  
  1023                                      ; 上位4bit
  1024 00000509 E891FF                      call getc
  1025 0000050C E80F00                      call hex_char_to_bin
  1026 0000050F C0E004                      shl al, 4
  1027 00000512 88C3                        mov bl, al          ; 一時保存
  1028                                      
  1029                                      ; 下位4bit
  1030 00000514 E886FF                      call getc
  1031 00000517 E80400                      call hex_char_to_bin
  1032 0000051A 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1033 0000051C 5B                          pop bx
  1034 0000051D C3                          ret
  1035                                  
  1036                                  ; -----------------------------------------------------------------
  1037                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1038                                  ; Input: AL (ASCII)
  1039                                  ; Output: AL (Binary)
  1040                                  ; -----------------------------------------------------------------
  1041                                  hex_char_to_bin:
  1042 0000051E 2C30                        sub al, '0'
  1043 00000520 3C09                        cmp al, 9
  1044 00000522 7604                        jbe .done
  1045 00000524 2C07                        sub al, 7           ; 'A'-'F'対応
  1046 00000526 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1047                                  .done:
  1048 00000528 C3                          ret
  1049                                  
  1050                                  ; -----------------------------------------------------------------
  1051                                  ; Helper: スペースなどを読み飛ばす
  1052                                  ; -----------------------------------------------------------------
  1053                                  skip_space:
  1054 00000529 E880FF                      call getc_echo
  1055 0000052C C3                          ret
  1056                                  
  1057                                  ; -----------------------------------------------------------------
  1058                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1059                                  ; -----------------------------------------------------------------
  1060                                  error:
  1061 0000052D BE[0F07]                    mov si, msg_error
  1062 00000530 E849FF                      call puts
  1063 00000533 E956FC                      jmp monitor_loop
  1064                                  
  1065                                  ;==========================================================
  1066                                  ; Interrupt Handler
  1067                                  ;==========================================================
  1068                                  
  1069                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1070                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1071                                  
  1072 00000536 6A00                    _isr_stub_0:  push 0x0          ; 0: Division by zero
  1073 00000538 EB30                                  jmp _default_int_handler
  1074 0000053A 6A01                    _isr_stub_1:  push 0x1          ; 1: Break flag
  1075 0000053C EB2C                                  jmp _default_int_handler
  1076 0000053E 6A02                    _isr_stub_2:  push 0x2          ; 2: NMI
  1077 00000540 EB28                                  jmp _default_int_handler
  1078 00000542 6A03                    _isr_stub_3:  push 0x3          ; 3: BRK3
  1079 00000544 EB24                                  jmp _default_int_handler
  1080 00000546 6A04                    _isr_stub_4:  push 0x4          ; 4: BRKV
  1081 00000548 EB20                                  jmp _default_int_handler
  1082 0000054A 6A05                    _isr_stub_5:  push 0x5          ; 5: CHKIND
  1083 0000054C EB1C                                  jmp _default_int_handler
  1084                                  
  1085 0000054E 6A20                    _isr_stub_20: push 0x0020       ; 32: ICU INTP0
  1086 00000550 EB18                                  jmp _default_int_handler
  1087 00000552 6A21                    _isr_stub_21: push 0x0021       ; 33: ICU INTP1
  1088 00000554 EB14                                  jmp _default_int_handler
  1089 00000556 6A22                    _isr_stub_22: push 0x0022       ; 34: ICU INTP2
  1090 00000558 EB10                                  jmp _default_int_handler
  1091 0000055A 6A23                    _isr_stub_23: push 0x0023       ; 35: ICU INTP3
  1092 0000055C EB0C                                  jmp _default_int_handler
  1093 0000055E 6A24                    _isr_stub_24: push 0x0024       ; 36: ICU INTP4
  1094 00000560 EB08                                  jmp _default_int_handler
  1095 00000562 6A25                    _isr_stub_25: push 0x0025       ; 37: ICU INTP5
  1096 00000564 EB04                                  jmp _default_int_handler
  1097 00000566 6A26                    _isr_stub_26: push 0x0026       ; 38: ICU INTP6
  1098 00000568 EB00                                  jmp _default_int_handler
  1099                                  
  1100                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1101                                  
  1102                                  ; ==========================================================
  1103                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1104                                  ; ==========================================================
  1105                                  
  1106                                  ; --- 共通処理部 (Common Handler) ---
  1107                                  _default_int_handler:
  1108                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1109 0000056A 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX (16 bytes)
  1110 0000056B 1E                          push ds
  1111 0000056C 06                          push es
  1112                                  
  1113                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1114 0000056D 8CC8                        mov  ax, cs
  1115 0000056F 8ED8                        mov  ds, ax
  1116 00000571 8EC0                        mov  es, ax
  1117 00000573 89E5                        mov  bp, sp
  1118                                  
  1119                                      ; --- メッセージ表示 ---
  1120 00000575 BE[FA07]                    mov  si, msg_int_trap
  1121 00000578 E801FF                      call puts           ; "** INT "
  1122                                  
  1123                                      ; --- ベクタ番号の表示 ---
  1124 0000057B 8B4614                      mov  ax, [bp+20]    ; ベクタ番号を取得
  1125 0000057E E844FF                      call print_hex_byte ; 表示 (例: 25)
  1126                                  
  1127 00000581 BE[0208]                    mov  si, msg_detected
  1128 00000584 E8F5FE                      call puts           ; " detected **" (改行含む)
  1129                                  
  1130                                      ; 4. レジスタ表示 (スタックから読み出して表示)
  1131                                      ; Stack Layout after pushes:
  1132                                      ; BP+0: ES　最後にpushしたもの
  1133                                      ; BP+2: DS
  1134                                      ; BP+4: DI　pushaの開始
  1135                                      ; BP+6: SI
  1136                                      ; BP+8: BP (Old)
  1137                                      ; BP+10: SP (Original)
  1138                                      ; BP+12: BX
  1139                                      ; BP+14: DX
  1140                                      ; BP+16: CX
  1141                                      ; BP+18: AX pushaの終了
  1142                                      ; BP+20: Vector Number スタブでpushした値
  1143                                      ; BP+22: IP 割り込み発生時の戻り先
  1144                                      ; BP+24: CS (Return Addr)
  1145                                      ; BP+26: Flags
  1146                                      
  1147                                      ; AX
  1148 00000587 BE[0F08]                    mov  si, msg_ax
  1149 0000058A E8EFFE                      call puts
  1150 0000058D 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1151 00000590 E82BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1152                                  
  1153                                      ; BX
  1154 00000593 BE[1408]                    mov  si, msg_bx
  1155 00000596 E8E3FE                      call puts
  1156 00000599 8B460C                      mov  ax, [bp+12]
  1157 0000059C E81FFF                      call print_hex_word
  1158                                  
  1159                                      ; CX
  1160 0000059F BE[1908]                    mov  si, msg_cx
  1161 000005A2 E8D7FE                      call puts
  1162 000005A5 8B4610                      mov  ax, [bp+16]
  1163 000005A8 E813FF                      call print_hex_word
  1164                                  
  1165                                      ; DX
  1166 000005AB BE[1E08]                    mov  si, msg_dx
  1167 000005AE E8CBFE                      call puts
  1168 000005B1 8B460E                      mov  ax, [bp+14]
  1169 000005B4 E807FF                      call print_hex_word
  1170                                  
  1171 000005B7 E8FBFE                      call putc_crlf
  1172                                  
  1173                                      ; --- 中断地点 (CS:IP) の表示 ---
  1174 000005BA BE[2308]                    mov  si, msg_addr
  1175 000005BD E8BCFE                      call puts           ; " Stop at "
  1176 000005C0 8B4618                      mov  ax, [bp+24]    ; Stack上の CS
  1177 000005C3 E8F8FE                      call print_hex_word
  1178 000005C6 B03A                        mov  al, ':'
  1179 000005C8 E8BFFE                      call putc
  1180 000005CB 8B4616                      mov  ax, [bp+22]    ; Stack上の IP
  1181 000005CE E8EDFE                      call print_hex_word
  1182                                  
  1183 000005D1 E8E1FE                      call putc_crlf
  1184                                  
  1185 000005D4 8B4614                      mov  ax, [bp+20]    ; Stack上の ベクタ番号
  1186 000005D7 83F820                      cmp  ax, 0x20
  1187 000005DA 7208                        jb   .no_eoi         ; ベクタ番号 < 20h (PIC/ICU以外) ならEOI不要
  1188                                  
  1189                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1190 000005DC B020                        mov al, 20h         ; Non-specific EOI
  1191 000005DE E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1192 000005E0 BA80F0                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1193 000005E3 EE                          out dx, al
  1194                                  .no_eoi:
  1195                                  
  1196 000005E4 07                          pop  es
  1197 000005E5 1F                          pop  ds
  1198 000005E6 61                          popa
  1199 000005E7 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1200 000005EA CF                          iret
  1201                                  
  1202                                  ; ==========================================================
  1203                                  ; PIC Dispatch Handler (Vector 27h)
  1204                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1205                                  ; ==========================================================
  1206                                  _pic_dispatch_handler:
  1207 000005EB 60                          pusha
  1208 000005EC 1E                          push ds
  1209 000005ED 06                          push es
  1210                                  
  1211                                      ; DS設定 (Tiny Model)
  1212 000005EE 8CC8                        mov ax, cs
  1213 000005F0 8ED8                        mov ds, ax
  1214                                  
  1215                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1216                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1217 000005F2 B00B                        mov al, 0x0B
  1218 000005F4 E6C8                        out PIC_REG0, al
  1219 000005F6 E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1220                                  
  1221                                      ; --- 2. 要因判定と分岐 ---
  1222                                      
  1223 000005F8 A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1224 000005FA 751E                        jnz .handle_timer0
  1225                                  
  1226 000005FC A802                        test al, 02h        ; Bit 1: SCSI
  1227 000005FE 7526                        jnz .handle_scsi
  1228                                  
  1229 00000600 A804                        test al, 04h        ; Bit 2: Timer 1
  1230 00000602 752A                        jnz .handle_timer1
  1231                                  
  1232 00000604 A808                        test al, 08h        ; Bit 3: USART Rx
  1233 00000606 752E                        jnz .handle_usart_rx
  1234                                  
  1235 00000608 A810                        test al, 10h        ; Bit 4: USART Tx
  1236 0000060A 7532                        jnz .handle_usart_tx
  1237                                  
  1238 0000060C A820                        test al, 20h        ; Bit 5: SCU Rx
  1239 0000060E 7536                        jnz .handle_scu_rx
  1240                                  
  1241 00000610 A840                        test al, 40h        ; Bit 6: SCU Tx
  1242 00000612 753A                        jnz .handle_scu_tx
  1243                                  
  1244 00000614 A880                        test al, 80h        ; Bit 7: PPI
  1245 00000616 753E                        jnz .handle_ppi
  1246                                  
  1247                                      ; 該当なしの場合は無視
  1248 00000618 EB44                        jmp .eoi_exit
  1249                                  
  1250                                  ; --- 各ハンドラ処理 ---
  1251                                  
  1252                                  .handle_timer0:
  1253                                      ; INTP0: Timer 0 (Tick)
  1254                                      ; --- 32bit カウンタのインクリメント ---
  1255 0000061A FF06[0709]                  inc word [tick_counter_lo]
  1256 0000061E 7504                        jnz .skip_carry
  1257 00000620 FF06[0909]                  inc word [tick_counter_hi]
  1258                                  .skip_carry:
  1259 00000624 EB38                        jmp .eoi_exit
  1260                                  
  1261                                  .handle_scsi:
  1262                                      ; INTP1: SCSIC
  1263 00000626 BE[3508]                    mov si, msg_int_scsi
  1264 00000629 E850FE                      call puts
  1265 0000062C EB30                        jmp .eoi_exit
  1266                                  
  1267                                  .handle_timer1:
  1268                                      ; INTP2: ユーザ用タイマー
  1269 0000062E BE[4C08]                    mov si, msg_int_timer1
  1270 00000631 E848FE                      call puts
  1271 00000634 EB28                        jmp .eoi_exit
  1272                                  
  1273                                  .handle_usart_rx:
  1274                                      ; INTP3: USART受信準備完了割り込み
  1275 00000636 BE[6508]                    mov si, msg_int_usart_rx
  1276 00000639 E840FE                      call puts
  1277 0000063C EB20                        jmp .eoi_exit
  1278                                  
  1279                                  .handle_usart_tx:
  1280                                      ; INTP4: USART送信完了割り込み
  1281 0000063E BE[8008]                    mov si, msg_int_usart_tx
  1282 00000641 E838FE                      call puts
  1283 00000644 EB18                        jmp .eoi_exit
  1284                                  
  1285                                  .handle_scu_rx:
  1286                                      ; INTP5: SCU受信準備完了割り込み
  1287 00000646 BE[9B08]                    mov si, msg_int_scu_rx
  1288 00000649 E830FE                      call puts
  1289 0000064C EB10                        jmp .eoi_exit
  1290                                  
  1291                                  .handle_scu_tx:
  1292                                      ; INTP6: SCU送信完了割り込み
  1293 0000064E BE[B408]                    mov si, msg_int_scu_tx
  1294 00000651 E828FE                      call puts
  1295 00000654 EB08                        jmp .eoi_exit
  1296                                  
  1297                                  .handle_ppi:
  1298                                      ; INTP7: PPI割り込み
  1299 00000656 BE[CD08]                    mov si, msg_int_ppi
  1300 00000659 E820FE                      call puts
  1301 0000065C EB00                        jmp .eoi_exit
  1302                                  
  1303                                  ; --- 終了処理 ---
  1304                                  .eoi_exit:
  1305                                      ; --- EOI (End of Interrupt) to PIC ---
  1306 0000065E B020                        mov al, 20h     ; Non-specific EOI
  1307                                  
  1308                                      ; 外部PIC (Slave) の割り込み完了
  1309 00000660 E6C8                        out PIC_REG0, al
  1310                                  
  1311                                      ; V53内蔵ICU (Master) の割り込み完了
  1312 00000662 BA80F0                      mov dx, ICU_REG0 
  1313 00000665 EE                          out dx, al
  1314                                  
  1315 00000666 07                          pop es
  1316 00000667 1F                          pop ds
  1317 00000668 61                          popa
  1318 00000669 CF                          iret
  1319                                  
  1320                                  ;--------------------------------------
  1321                                  ; 未定義割り込みベクタ用の簡易トラップ
  1322                                  ;--------------------------------------
  1323                                  _default_int_unknown_handler:
  1324                                      ; 想定外の割り込みが発生したため、
  1325                                      ; 画面に "UNKNOWN INT" と出して停止する
  1326 0000066A FA                          cli                 ; 多重割り込み禁止
  1327                                  
  1328                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1329 0000066B 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1330 0000066C 1E                          push ds
  1331 0000066D 06                          push es
  1332                                  
  1333                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1334 0000066E 8CC8                        mov  ax, cs
  1335 00000670 8ED8                        mov  ds, ax
  1336 00000672 8EC0                        mov  es, ax
  1337                                  
  1338                                      ; 3. スタックフレームへのポインタ設定
  1339 00000674 89E5                        mov  bp, sp
  1340                                  
  1341 00000676 BE[E308]                    mov si, msg_unknown_int
  1342 00000679 E800FE                      call puts
  1343                                  
  1344                                      ; 4. レジスタ表示 (スタックから読み出して表示)
  1345                                      ; Stack Layout after pushes:
  1346                                      ; BP+0: ES
  1347                                      ; BP+2: DS
  1348                                      ; BP+4: DI
  1349                                      ; BP+6: SI
  1350                                      ; BP+8: BP (Old)
  1351                                      ; BP+10: SP (Original)
  1352                                      ; BP+12: BX
  1353                                      ; BP+14: DX
  1354                                      ; BP+16: CX
  1355                                      ; BP+18: AX
  1356                                      ; BP+20: IP (Return Addr)
  1357                                      ; BP+22: CS (Return Addr)
  1358                                      ; BP+24: Flags
  1359                                      
  1360                                      ; AX
  1361 0000067C BE[0F08]                    mov  si, msg_ax
  1362 0000067F E8FAFD                      call puts
  1363 00000682 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1364 00000685 E836FE                      call print_hex_word     ; 4桁HEX表示ルーチン
  1365                                  
  1366                                      ; BX
  1367 00000688 BE[1408]                    mov  si, msg_bx
  1368 0000068B E8EEFD                      call puts
  1369 0000068E 8B460C                      mov  ax, [bp+12]
  1370 00000691 E82AFE                      call print_hex_word
  1371                                  
  1372                                      ; CX
  1373 00000694 BE[1908]                    mov  si, msg_cx
  1374 00000697 E8E2FD                      call puts
  1375 0000069A 8B4610                      mov  ax, [bp+16]
  1376 0000069D E81EFE                      call print_hex_word
  1377                                  
  1378                                      ; DX
  1379 000006A0 BE[1E08]                    mov  si, msg_dx
  1380 000006A3 E8D6FD                      call puts
  1381 000006A6 8B460E                      mov  ax, [bp+14]
  1382 000006A9 E812FE                      call print_hex_word
  1383                                  
  1384 000006AC E806FE                      call putc_crlf
  1385                                  
  1386                                      ; --- 中断地点 (CS:IP) の表示 ---
  1387                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1388                                      ; その上が割り込み発生時の IP, CS, Flags です
  1389                                      
  1390 000006AF BE[2308]                    mov  si, msg_addr
  1391 000006B2 E8C7FD                      call puts           ; " Stop at "
  1392 000006B5 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1393 000006B8 E803FE                      call print_hex_word
  1394 000006BB B03A                        mov  al, ':'
  1395 000006BD E8CAFD                      call putc
  1396 000006C0 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1397 000006C3 E8F8FD                      call print_hex_word
  1398                                  
  1399 000006C6 E8ECFD                      call putc_crlf
  1400                                  
  1401                                      ; 5. 復帰処理
  1402                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1403                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1404 000006C9 E934F9                      jmp  start  ; モニタの開始ラベルへ
  1405                                  
  1406                                      ; 停止（暴走を防ぐ）
  1407                                  ;.halt:
  1408                                  ;    hlt
  1409                                  ;    jmp .halt
