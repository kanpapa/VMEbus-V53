   823 000003A4 7403E96801                  jne error           ; パラメタが無い場合はエラー処理へ
   824                                  
   825 000003A9 E81B01                      call get_hex_word   ; スタートポートアドレスを取得
   826 000003AC 89C3                        mov bx, ax          ; BX = Start Address
   827                                      
   828 000003AE E8DF00                      call getc_echo
   829 000003B1 3C20                        cmp al, ' '         ; スペースがあれば第2パラメタがあると判断
   830 000003B3 75E6                        jne error_pop       ; 第2パラメタが無い場合はエラー処理へ
   831                                  
   832 000003B5 E80F01                      call get_hex_word   ; エンドポートアドレスを取得
   833 000003B8 89C1                        mov cx, ax          ; CX = End Address
   834                                  
