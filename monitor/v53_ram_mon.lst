   712 0000032C 50                          push ax             ; ターゲットオフセットを保存
   713                                  
   714 0000032D E86001                      call getc_echo      ; Space?
   715 00000330 3C20                        cmp al, ' '
   716 00000332 7403E9DA01                  jne error           ; 引数なしならリターン(またはエラー)
