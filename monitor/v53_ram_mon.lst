   825 00000423 BA60F0                      mov dx, SCU_DATA
   826 00000426 EC                          in al, dx
   827 00000427 BE[EB07]                    mov si, msg_abort
   828 0000042A E85200                      call puts
   829 0000042D E95CFD                      jmp monitor_loop
