     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.7 2026-01-31
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; V53 SCU (1260Hに配置）
    55                                      %define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    56                                      %define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    57                                      %define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    58                                      %define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    59                                      %define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    60                                      %define TX_READY    00000001b   ; TBRDY                                 
    61                                      %define RX_READY    00000010b   ; RBRDY
    62                                  
    63                                      ; V53 TCU (1270Hに配置)
    64                                      %define TM0_CNT     0x01270 ; Timer 0 Counter
    65                                      %define TM1_CNT     0x01271 ; Timer 1 Counter
    66                                      %define TM2_CNT     0x01272 ; Timer 2 Counter
    67                                      %define TM_CTL      0x01273 ; Timer Control
    68                                  
    69                                      ; V53 ICU (1280Hに配置)
    70                                      %define ICU_REG0    0x01280
    71                                      %define ICU_REG1    0x01281
    72                                      
    73                                      ;-----------------------------------------
    74                                      ; V53 VME Board ペリフェラル
    75                                      ;-----------------------------------------
    76                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    77                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    78                                  
    79                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
    80                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
    81                                  
    82                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
    83                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
    84                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
    85                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
    86                                  %endif
    87                                  
    88                                  section .text
    89                                  
    90                                  start:
    91                                  %ifdef SIM
    92                                      xor ax, ax
    93                                      mov es, ax
    94                                  %else
    95 00000000 FA                          cli             ; 初期化中は割り込み禁止
    96                                  
    97                                      ; --- 【重要】スタックの初期化 ---
    98                                      ; 現在のセグメント (CS=2000h) の末尾 (FFFEh) にスタックを移動させます。
    99                                      ; これでコード領域との衝突を回避します。
   100 00000001 8CC8                        mov ax, cs
   101 00000003 8ED0                        mov ss, ax
   102 00000005 BCFEFF                      mov sp, 0xFFFE
   103                                      ; ------------------------------
   104                                  
   105                                      ;==============================================
   106                                      ; ABORT (NMI) Handler Setup 
   107                                      ;==============================================
   108                                  Init_NMI:
   109                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   110 00000008 31C0                        xor  ax, ax
   111 0000000A 8EC0                        mov  es, ax          ; ES = 0000h
   112                                      
   113 0000000C BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   114 0000000F B8[B504]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   115 00000012 AB                          stosw                ; [0000:0008] = AX
   116 00000013 8CC8                        mov  ax, cs          ; 現在のCS
   117 00000015 AB                          stosw                ; [0000:000A] = CS
   118                                  
   119                                      ; ICU割り込みベクタの登録 (0x20 - 0x27)
   120                                      
   121                                      ; Vector 20h (ICU INTP0)
   122 00000016 BF8000                      mov  di, 0x0080      ; 0x20 * 4 = 80h
   123 00000019 B8[4405]                    mov  ax, _isr_stub_20
   124 0000001C AB                          stosw
   125 0000001D 8CC8                        mov  ax, cs
   126 0000001F AB                          stosw
   127                                  
   128                                      ; Vector 21h (ICU INTP1)
   129 00000020 BF8400                      mov  di, 0x0084
   130 00000023 B8[4805]                    mov  ax, _isr_stub_21
   131 00000026 AB                          stosw
   132 00000027 8CC8                        mov  ax, cs
   133 00000029 AB                          stosw
   134                                  
   135                                      ; Vector 22h (ICU INTP2)
   136 0000002A BF8800                      mov  di, 0x0088
   137 0000002D B8[4C05]                    mov  ax, _isr_stub_22
   138 00000030 AB                          stosw
   139 00000031 8CC8                        mov  ax, cs
   140 00000033 AB                          stosw
   141                                  
   142                                      ; Vector 23h (ICU INTP3)
   143 00000034 BF8C00                      mov  di, 0x008C
   144 00000037 B8[5005]                    mov  ax, _isr_stub_23
   145 0000003A AB                          stosw
   146 0000003B 8CC8                        mov  ax, cs
   147 0000003D AB                          stosw
   148                                  
   149                                      ; Vector 24h (ICU INTP4)
   150 0000003E BF9000                      mov  di, 0x0090
   151 00000041 B8[5405]                    mov  ax, _isr_stub_24
   152 00000044 AB                          stosw
   153 00000045 8CC8                        mov  ax, cs
   154 00000047 AB                          stosw
   155                                  
   156                                      ; Vector 25h (ICU INTP5)
   157 00000048 BF9400                      mov  di, 0x0094
   158 0000004B B8[5805]                    mov  ax, _isr_stub_25
   159 0000004E AB                          stosw
   160 0000004F 8CC8                        mov  ax, cs
   161 00000051 AB                          stosw
   162                                  
   163                                      ; Vector 26h (ICU INTP6)
   164 00000052 BF9800                      mov  di, 0x0098
   165 00000055 B8[5C05]                    mov  ax, _isr_stub_26
   166 00000058 AB                          stosw
   167 00000059 8CC8                        mov  ax, cs
   168 0000005B AB                          stosw
   169                                  
   170                                      ; Vector 27h (ICU INTP7 <-- PIC)
   171                                      ; PIC用割り込みベクタテーブル
   172 0000005C BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   173 0000005F B8[6005]                    mov  ax, _tick_handler ; Tick割り込みハンドラのアドレス (IP)
   174 00000062 AB                          stosw                ; [0000:009c] = AX
   175 00000063 8CC8                        mov  ax, cs          ; 現在のCS
   176 00000065 AB                          stosw                ; [0000:009e] = CS
   177                                  
   178                                      ; ---------------------------------------------
   179                                      ; 1. セグメントレジスタ初期化
   180                                      ; CS=DS=ES を想定
   181                                      ; ---------------------------------------------
   182 00000066 0E                          push cs
   183 00000067 1F                          pop ds
   184 00000068 0E                          push cs
   185 00000069 07                          pop es
   186                                      ; スタックは簡易モニタのものをそのまま使う
   187                                  
   188                                      ;------------------------------------------
   189                                      ; TCUの追加設定
   190                                      ;------------------------------------------
   191                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   192                                      ;------------------------------------------
   193 0000006A BAFDFF                      mov  dx, OPSEL
   194 0000006D EC                          in   al, dx
   195 0000006E 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   196 00000070 EE                          out  dx, al
   197                                  
   198                                      ;------------------------------------------
   199                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   200                                      ;------------------------------------------
   201 00000071 BAF9FF                      mov dx, TULA
   202 00000074 B070                        mov al, 0x70    ; 下位アドレス
   203 00000076 EE                          out dx, al
   204                                  
   205                                      ;------------------------------------------
   206                                      ; 3. TCKS: タイマクロック入力選択
   207                                      ;------------------------------------------
   208 00000077 BAF0FF                      mov  dx, TCKS
   209 0000007A B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   210 0000007C EE                          out  dx, al
   211                                  
   212                                      ;------------------------------------------
   213                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   214                                      ;------------------------------------------
   215 0000007D BA7312                      mov  dx, TM_CTL
   216                                  
   217                                      ; --- Timer 0 Setup ---
   218 00000080 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   219 00000082 EE                          out  dx, al
   220                                      
   221                                      ; --- Timer 1 Setup ---
   222 00000083 B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   223 00000085 EE                          out  dx, al
   224                                  
   225                                      ; --- Timer 2 Setup ---
   226 00000086 B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   227 00000088 EE                          out  dx, al
   228                                  
   229                                      ;------------------------------------------
   230                                      ; 4. カウンタ値 (分周比) のロード
   231                                      ;------------------------------------------
   232                                      ; Timer 0 (INTP0)
   233                                      ; 1.2288MHz / 12288 = 100Hz
   234 00000089 BA7012                      mov  dx, TM0_CNT
   235 0000008C B000                        mov  al, 0x00
   236 0000008E EE                          out  dx, al
   237 0000008F B030                        mov  al, 0x30
   238 00000091 EE                          out  dx, al
   239                                  
   240                                      ; Timer 1 (INTP2)
   241                                      ; 1.2288MHz / 61440 = 20Hz
   242 00000092 BA7112                      mov  dx, TM1_CNT
   243 00000095 B000                        mov  al, 0x00
   244 00000097 EE                          out  dx, al
   245 00000098 B0F0                        mov  al, 0xF0
   246 0000009A EE                          out  dx, al
   247                                  
   248                                      ; Timer 2 (USART Tx/RxCLK)
   249                                      ; 1.2288MHz / 4 = 307.20KHz
   250                                      ; USART CLOCK 19200bps
   251 0000009B BA7212                      mov  dx, TM2_CNT
   252 0000009E B004                        mov  al, 4
   253 000000A0 EE                          out  dx, al
   254 000000A1 B000                        mov  al, 0
   255 000000A3 EE                          out  dx, al
   256                                  
   257                                      ;------------------------------------------
   258                                      ; μPD71051 (USART) 初期化
   259                                      ;------------------------------------------
   260 000000A4 B000                        mov al, 0
   261 000000A6 E6DA                        out USART_CMD, al
   262                                   
   263 000000A8 F7E1                        mul cx              ; wait
   264 000000AA F7E1                        mul cx              ; wait
   265 000000AC E6DA                        out USART_CMD, al
   266                                   
   267 000000AE F7E1                        mul cx              ; wait
   268 000000B0 F7E1                        mul cx              ; wait
   269 000000B2 E6DA                        out USART_CMD, al
   270                                   
   271 000000B4 F7E1                        mul cx              ; wait
   272 000000B6 F7E1                        mul cx              ; wait
   273 000000B8 B040                        mov al, 0x40        ; reset
   274 000000BA E6DA                        out USART_CMD, al
   275                                   
   276 000000BC F7E1                        mul cx              ; wait
   277 000000BE F7E1                        mul cx              ; wait
   278 000000C0 B04E                        mov al, 0x4e        ; set mode
   279 000000C2 E6DA                        out USART_CMD, al
   280                                   
   281 000000C4 F7E1                        mul cx              ; wait
   282 000000C6 F7E1                        mul cx              ; wait
   283 000000C8 B037                        mov al, 0x37        ; rx,tx ready
   284 000000CA E6DA                        out USART_CMD, al
   285                                  
   286                                      ;------------------------------------------
   287                                      ; μPD71059 (PIC) 初期化
   288                                      ;------------------------------------------
   289 000000CC B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   290 000000CE E6C8                        out PIC_REG0, al
   291                                  
   292 000000D0 B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   293 000000D2 E6CA                        out PIC_REG1, al
   294                                                          ; ICW3 is skipped in Single Mode
   295 000000D4 B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   296 000000D6 E6CA                        out PIC_REG1, al
   297                                  
   298 000000D8 B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   299 000000DA E6CA                        out PIC_REG1, al
   300                                  
   301                                      ;------------------------------------------
   302                                      ; ICUの追加設定
   303                                      ;------------------------------------------
   304                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   305                                      ;------------------------------------------
   306 000000DC BAFDFF                      mov  dx, OPSEL
   307 000000DF EC                          in   al, dx
   308 000000E0 0C02                        or   al, 00000010b   ; Bit 1 (ICU) をセット
   309 000000E2 EE                          out  dx, al
   310                                  
   311                                      ;------------------------------------------
   312                                      ; 2. レジスタ配置アドレスの設定 (IULA)
   313                                      ;------------------------------------------
   314 000000E3 BAFAFF                      mov dx, IULA
   315 000000E6 B080                        mov al, 0x80    ; 下位アドレス
   316 000000E8 EE                          out dx, al
   317                                  
   318                                      ;------------------------------------------
   319                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   320                                      ;------------------------------------------
   321 000000E9 BA8012                      mov dx, ICU_REG0
   322 000000EC B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   323 000000EE EE                          out dx, al
   324                                  
   325 000000EF BA8112                      mov dx, ICU_REG1
   326 000000F2 B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   327 000000F4 EE                          out dx, al
   328                                                      ; ICW3 is skipped in Single Mode
   329 000000F5 B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   330 000000F7 EE                          out dx, al
   331                                  
   332                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   333 000000F8 B07F                        mov al, 7Fh     ; 0111 1111
   334 000000FA EE                          out dx, al
   335                                  
   336                                      ;-------------------------------------------
   337                                      ; 割り込み許可
   338                                      ;-------------------------------------------
   339 000000FB FB                          sti
   340                                  
   341                                   %endif
   342                                  
   343                                      ; 変数初期化 (RAMエリアをクリア)
   344 000000FC C706[FA06]0000              mov word [dump_seg], 0x0000
   345 00000102 C706[FC06]0000              mov word [dump_off], 0x0000
   346 00000108 C706[FE06]0020              mov word [load_seg], 0x2000
   347                                  
   348                                      ; スタートメッセージの表示
   349 0000010E BE[7B05]                    mov si, msg_boot
   350 00000111 E8E702                      call puts
   351                                  
   352                                  ; =================================================================
   353                                  ; Main Loop
   354                                  ; =================================================================
   355                                  monitor_loop:
   356 00000114 B03E                        mov al, '>'
   357 00000116 E8F002                      call putc
   358 00000119 B020                        mov al, ' '
   359 0000011B E8EB02                      call putc
   360                                  
   361 0000011E E80A03                      call getc_echo  ; コマンド受信（エコーあり）
   362 00000121 88C3                        mov bl, al
   363                                      
   364 00000123 80FB64                      cmp bl, 'd'     ; dump command
   365 00000126 747A                        je do_dump
   366 00000128 80FB44                      cmp bl, 'D'
   367 0000012B 7475                        je do_dump
   368                                      
   369 0000012D 80FB6C                      cmp bl, 'l'     ; load command
   370 00000130 7503E9D000                  je do_load
   371 00000135 80FB4C                      cmp bl, 'L'
   372 00000138 7503E9C800                  je do_load
   373                                      
   374 0000013D 80FB67                      cmp bl, 'g'     ; go command
   375 00000140 7503E93B01                  je do_go
   376 00000145 80FB47                      cmp bl, 'G'
   377 00000148 7503E93301                  je do_go
   378                                  
   379 0000014D 80FB77                      cmp bl, 'w'     ; Write command
   380 00000150 7503E95701                  je do_write
   381 00000155 80FB57                      cmp bl, 'W'
   382 00000158 7503E94F01                  je do_write
   383                                  
   384 0000015D 3C69                        cmp al, 'i'     ; Input Port command
   385 0000015F 7503E98B01                  je do_in
   386 00000164 3C49                        cmp al, 'I'
   387 00000166 7503E98401                  je do_in
   388                                  
   389 0000016B 3C6F                        cmp al, 'o'     ; Output Port command
   390 0000016D 7503E9A101                  je do_out
   391 00000172 3C4F                        cmp al, 'O'
   392 00000174 7503E99A01                  je do_out
   393                                  
   394 00000179 3C73                        cmp al, 's'     ; Scan I/O command
   395 0000017B 7503E9BA01                  je do_scan
   396 00000180 3C53                        cmp al, 'S'
   397 00000182 7503E9B301                  je do_scan
   398                                  
   399 00000187 3C74                        cmp al, 't'     ; Scan Timer wait command
   400 00000189 7503E91E02                  je do_timer
   401 0000018E 3C54                        cmp al, 'T'
   402 00000190 7503E91702                  je do_timer
   403                                  
   404 00000195 3C3F                        cmp al, '?'     ; Help
   405 00000197 7503E95302                  je cmd_help
   406                                  
   407                                      ; 知らないコマンドなら改行して戻る
   408 0000019C E89502                      call putc_crlf
   409 0000019F E972FF                      jmp monitor_loop
   410                                  
   411                                  ; =================================================================
   412                                  ; Command: Dump Memory
   413                                  ; Usage:
   414                                  ;   D               -> Dump next 64 bytes
   415                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   416                                  ; =================================================================
   417                                  do_dump:
   418 000001A2 E88602                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   419 000001A5 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   420 000001A7 7418                        je .dump_run
   421 000001A9 3C20                        cmp al, ' '         ; Spaceなら引数解析
   422 000001AB 7405                        je .parse_args
   423                                      
   424                                      ; それ以外なら無視して実行へ（またはエラー処理）
   425 000001AD E88402                      call putc_crlf
   426 000001B0 EB12                        jmp .dump_run_start
   427                                  
   428                                  .parse_args:
   429 000001B2 E8AD02                      call get_hex_word
   430 000001B5 A3[FA06]                    mov [dump_seg], ax
   431 000001B8 E8ED02                      call skip_space
   432 000001BB E8A402                      call get_hex_word
   433 000001BE A3[FC06]                    mov [dump_off], ax
   434                                      ; ここでEnter待ちをするか、そのまま実行するか
   435                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   436                                      
   437                                  .dump_run:
   438 000001C1 E87002                      call putc_crlf              ; 実行直前に改行
   439                                  
   440                                  .dump_run_start:
   441 000001C4 B90400                      mov cx, 4                   ; 4行表示する
   442                                      
   443                                  .line_loop:
   444 000001C7 51                          push cx
   445                                      
   446 000001C8 A1[FA06]                    mov ax, [dump_seg]          ; セグメントの表示
   447 000001CB E86F02                      call print_hex_word
   448 000001CE B03A                        mov al, ':'                 ; 区切り文字の:を表示
   449 000001D0 E83602                      call putc
   450 000001D3 A1[FC06]                    mov ax, [dump_off]          ; オフセットの表示
   451 000001D6 E86402                      call print_hex_word
   452 000001D9 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   453 000001DB E82B02                      call putc
   454                                  
   455 000001DE 8B36[FC06]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   456                                  
   457 000001E2 1E                          push ds                     ; モニタのDSを保存
   458 000001E3 8E1E[FA06]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   459                                      
   460 000001E7 B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   461                                  .hex_loop:
   462 000001EA 8A04                        mov al, [si]
   463 000001EC E85502                      call print_hex_byte         ; メモリ内容の表示
   464 000001EF B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   465 000001F1 E81502                      call putc
   466 000001F4 46                          inc si                      ; 次のアドレスにする
   467 000001F5 E2F3                        loop .hex_loop              ; 16回繰り返し    
   468                                  
