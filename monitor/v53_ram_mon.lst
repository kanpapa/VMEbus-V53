     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.7 2026-01-31
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; V53 SCU (1260Hに配置）
    55                                      %define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    56                                      %define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    57                                      %define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    58                                      %define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    59                                      %define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    60                                      %define TX_READY    00000001b   ; TBRDY                                 
    61                                      %define RX_READY    00000010b   ; RBRDY
    62                                  
    63                                      ; V53 TCU (1270Hに配置)
    64                                      %define TM0_CNT     0x01270 ; Timer 0 Counter
    65                                      %define TM1_CNT     0x01271 ; Timer 1 Counter
    66                                      %define TM2_CNT     0x01272 ; Timer 2 Counter
    67                                      %define TM_CTL      0x01273 ; Timer Control
    68                                  
    69                                      ; V53 ICU (1280Hに配置)
    70                                      %define ICU_REG0    0x01280
    71                                      %define ICU_REG1    0x01281
    72                                      
    73                                      ;-----------------------------------------
    74                                      ; V53 VME Board ペリフェラル
    75                                      ;-----------------------------------------
    76                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    77                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    78                                  
    79                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
    80                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
    81                                  
    82                                      %define PPI_PORTA   0x00e0  ; μPD71055 (PPI)	Port A	
    83                                      %define PPI_PORTB   0x00e2  ; μPD71055 (PPI)	Port B	
    84                                      %define PPI_PORTC   0x00e4	; μPD71055 (PPI)	Port C	
    85                                      %define PPI_CTRL    0x00e6  ; μPD71055 (PPI)	Control
    86                                  %endif
    87                                  
    88                                  section .text
    89                                  
    90                                  start:
    91                                  %ifdef SIM
    92                                      xor ax, ax
    93                                      mov es, ax
    94                                  %else
    95 00000000 FA                          cli             ; 初期化中は割り込み禁止
    96                                  
    97                                      ; --- 【重要】スタックの初期化 ---
    98                                      ; 現在のセグメント (CS=2000h) の末尾 (FFFEh) にスタックを移動させます。
    99                                      ; これでコード領域との衝突を回避します。
   100 00000001 8CC8                        mov ax, cs
   101 00000003 8ED0                        mov ss, ax
   102 00000005 BCFEFF                      mov sp, 0xFFFE
   103                                      ; ------------------------------
   104                                  
   105                                      ;==============================================
   106                                      ; ABORT (NMI) Handler Setup 
   107                                      ;==============================================
   108                                  Init_NMI:
   109                                      ; ----------------------------------------------------
   110                                      ; 1. 全ベクタ (00h-FFh) をデフォルトハンドラで埋める
   111                                      ;    (予期せぬ割り込みによる暴走を防ぐ安全策)
   112                                      ; ----------------------------------------------------
   113 00000008 31C0                        xor ax, ax
   114 0000000A 8EC0                        mov es, ax          ; ES = 0000h (Vector Table)
   115 0000000C BF0000                      mov di, 0           ; Offset 0
   116                                  
   117 0000000F B90001                      mov cx, 256         ; 256個のベクタ全てを設定
   118                                  .init_loop:
   119 00000012 B8[F205]                    mov ax, _default_int_unknown_handler ; 共通トラップハンドラ
   120 00000015 AB                          stosw               ; Offset書き込み
   121 00000016 8CC8                        mov ax, cs
   122 00000018 AB                          stosw               ; Segment書き込み
   123 00000019 E2F7                        loop .init_loop
   124                                  
   125                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   126 0000001B 31C0                        xor  ax, ax
   127 0000001D 8EC0                        mov  es, ax          ; ES = 0000h
   128                                      
   129 0000001F BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   130 00000022 B8[C804]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   131 00000025 AB                          stosw                ; [0000:0008] = AX
   132 00000026 8CC8                        mov  ax, cs          ; 現在のCS
   133 00000028 AB                          stosw                ; [0000:000A] = CS
   134                                  
   135                                      ; ICU割り込みベクタを上書き登録 (0x20 - 0x27)
   136                                      
   137                                      ; Vector 20h (ICU INTP0)
   138 00000029 BF8000                      mov  di, 0x0080      ; 0x20 * 4 = 80h
   139 0000002C B8[5705]                    mov  ax, _isr_stub_20
   140 0000002F AB                          stosw
   141 00000030 8CC8                        mov  ax, cs
   142 00000032 AB                          stosw
   143                                  
   144                                      ; Vector 21h (ICU INTP1)
   145 00000033 BF8400                      mov  di, 0x0084
   146 00000036 B8[5B05]                    mov  ax, _isr_stub_21
   147 00000039 AB                          stosw
   148 0000003A 8CC8                        mov  ax, cs
   149 0000003C AB                          stosw
   150                                  
   151                                      ; Vector 22h (ICU INTP2)
   152 0000003D BF8800                      mov  di, 0x0088
   153 00000040 B8[5F05]                    mov  ax, _isr_stub_22
   154 00000043 AB                          stosw
   155 00000044 8CC8                        mov  ax, cs
   156 00000046 AB                          stosw
   157                                  
   158                                      ; Vector 23h (ICU INTP3)
   159 00000047 BF8C00                      mov  di, 0x008C
   160 0000004A B8[6305]                    mov  ax, _isr_stub_23
   161 0000004D AB                          stosw
   162 0000004E 8CC8                        mov  ax, cs
   163 00000050 AB                          stosw
   164                                  
   165                                      ; Vector 24h (ICU INTP4)
   166 00000051 BF9000                      mov  di, 0x0090
   167 00000054 B8[6705]                    mov  ax, _isr_stub_24
   168 00000057 AB                          stosw
   169 00000058 8CC8                        mov  ax, cs
   170 0000005A AB                          stosw
   171                                  
   172                                      ; Vector 25h (ICU INTP5)
   173 0000005B BF9400                      mov  di, 0x0094
   174 0000005E B8[6B05]                    mov  ax, _isr_stub_25
   175 00000061 AB                          stosw
   176 00000062 8CC8                        mov  ax, cs
   177 00000064 AB                          stosw
   178                                  
   179                                      ; Vector 26h (ICU INTP6)
   180 00000065 BF9800                      mov  di, 0x0098
   181 00000068 B8[6F05]                    mov  ax, _isr_stub_26
   182 0000006B AB                          stosw
   183 0000006C 8CC8                        mov  ax, cs
   184 0000006E AB                          stosw
   185                                  
   186                                      ; Vector 27h (ICU INTP7 <-- PIC)
   187                                      ; PIC Dispatcher
   188 0000006F BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   189 00000072 B8[7305]                    mov  ax, _pic_dispatch_handler
   190 00000075 AB                          stosw                ; [0000:009c] = AX
   191 00000076 8CC8                        mov  ax, cs          ; 現在のCS
   192 00000078 AB                          stosw                ; [0000:009e] = CS
   193                                  
   194                                      ; ---------------------------------------------
   195                                      ; 1. セグメントレジスタ初期化
   196                                      ; CS=DS=ES を想定
   197                                      ; ---------------------------------------------
   198 00000079 0E                          push cs
   199 0000007A 1F                          pop ds
   200 0000007B 0E                          push cs
   201 0000007C 07                          pop es
   202                                      ; スタックは簡易モニタのものをそのまま使う
   203                                  
   204                                      ;------------------------------------------
   205                                      ; TCUの追加設定
   206                                      ;------------------------------------------
   207                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   208                                      ;------------------------------------------
   209 0000007D BAFDFF                      mov  dx, OPSEL
   210 00000080 EC                          in   al, dx
   211 00000081 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   212 00000083 EE                          out  dx, al
   213                                  
   214                                      ;------------------------------------------
   215                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   216                                      ;------------------------------------------
   217 00000084 BAF9FF                      mov dx, TULA
   218 00000087 B070                        mov al, 0x70    ; 下位アドレス
   219 00000089 EE                          out dx, al
   220                                  
   221                                      ;------------------------------------------
   222                                      ; 3. TCKS: タイマクロック入力選択
   223                                      ;------------------------------------------
   224 0000008A BAF0FF                      mov  dx, TCKS
   225 0000008D B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   226 0000008F EE                          out  dx, al
   227                                  
   228                                      ;------------------------------------------
   229                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   230                                      ;------------------------------------------
   231 00000090 BA7312                      mov  dx, TM_CTL
   232                                  
   233                                      ; --- Timer 0 Setup ---
   234 00000093 B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   235 00000095 EE                          out  dx, al
   236                                      
   237                                      ; --- Timer 1 Setup ---
   238 00000096 B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   239 00000098 EE                          out  dx, al
   240                                  
   241                                      ; --- Timer 2 Setup ---
   242 00000099 B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   243 0000009B EE                          out  dx, al
   244                                  
   245                                      ;------------------------------------------
   246                                      ; 4. カウンタ値 (分周比) のロード
   247                                      ;------------------------------------------
   248                                      ; Timer 0 (INTP0)
   249                                      ; 1.2288MHz / 12288 = 100Hz
   250 0000009C BA7012                      mov  dx, TM0_CNT
   251 0000009F B000                        mov  al, 0x00
   252 000000A1 EE                          out  dx, al
   253 000000A2 B030                        mov  al, 0x30
   254 000000A4 EE                          out  dx, al
   255                                  
   256                                      ; Timer 1 (INTP2)
   257                                      ; 1.2288MHz / 61440 = 20Hz
   258 000000A5 BA7112                      mov  dx, TM1_CNT
   259 000000A8 B000                        mov  al, 0x00
   260 000000AA EE                          out  dx, al
   261 000000AB B0F0                        mov  al, 0xF0
   262 000000AD EE                          out  dx, al
   263                                  
   264                                      ; Timer 2 (USART Tx/RxCLK)
   265                                      ; 1.2288MHz / 4 = 307.20KHz
   266                                      ; USART CLOCK 19200bps
   267 000000AE BA7212                      mov  dx, TM2_CNT
   268 000000B1 B004                        mov  al, 4
   269 000000B3 EE                          out  dx, al
   270 000000B4 B000                        mov  al, 0
   271 000000B6 EE                          out  dx, al
   272                                  
   273                                      ;------------------------------------------
   274                                      ; μPD71051 (USART) 初期化
   275                                      ;------------------------------------------
   276 000000B7 B000                        mov al, 0
   277 000000B9 E6DA                        out USART_CMD, al
   278                                   
   279 000000BB F7E1                        mul cx              ; wait
   280 000000BD F7E1                        mul cx              ; wait
   281 000000BF E6DA                        out USART_CMD, al
   282                                   
   283 000000C1 F7E1                        mul cx              ; wait
   284 000000C3 F7E1                        mul cx              ; wait
   285 000000C5 E6DA                        out USART_CMD, al
   286                                   
   287 000000C7 F7E1                        mul cx              ; wait
   288 000000C9 F7E1                        mul cx              ; wait
   289 000000CB B040                        mov al, 0x40        ; reset
   290 000000CD E6DA                        out USART_CMD, al
   291                                   
   292 000000CF F7E1                        mul cx              ; wait
   293 000000D1 F7E1                        mul cx              ; wait
   294 000000D3 B04E                        mov al, 0x4e        ; set mode
   295 000000D5 E6DA                        out USART_CMD, al
   296                                   
   297 000000D7 F7E1                        mul cx              ; wait
   298 000000D9 F7E1                        mul cx              ; wait
   299 000000DB B037                        mov al, 0x37        ; rx,tx ready
   300 000000DD E6DA                        out USART_CMD, al
   301                                  
   302                                      ;------------------------------------------
   303                                      ; μPD71059 (PIC) 初期化
   304                                      ;------------------------------------------
   305 000000DF B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   306 000000E1 E6C8                        out PIC_REG0, al
   307                                  
   308 000000E3 B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   309 000000E5 E6CA                        out PIC_REG1, al
   310                                                          ; ICW3 is skipped in Single Mode
   311 000000E7 B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   312 000000E9 E6CA                        out PIC_REG1, al
   313                                  
   314 000000EB B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   315 000000ED E6CA                        out PIC_REG1, al
   316                                  
   317                                      ;------------------------------------------
   318                                      ; ICUの追加設定
   319                                      ;------------------------------------------
   320                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   321                                      ;------------------------------------------
   322 000000EF BAFDFF                      mov  dx, OPSEL
   323 000000F2 EC                          in   al, dx
   324 000000F3 0C02                        or   al, 00000010b   ; Bit 1 (ICU) をセット
   325 000000F5 EE                          out  dx, al
   326                                  
   327                                      ;------------------------------------------
   328                                      ; 2. レジスタ配置アドレスの設定 (IULA)
   329                                      ;------------------------------------------
   330 000000F6 BAFAFF                      mov dx, IULA
   331 000000F9 B080                        mov al, 0x80    ; 下位アドレス
   332 000000FB EE                          out dx, al
   333                                  
   334                                      ;------------------------------------------
   335                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   336                                      ;------------------------------------------
   337 000000FC BA8012                      mov dx, ICU_REG0
   338 000000FF B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   339 00000101 EE                          out dx, al
   340                                  
   341 00000102 BA8112                      mov dx, ICU_REG1
   342 00000105 B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   343 00000107 EE                          out dx, al
   344                                                      ; ICW3 is skipped in Single Mode
   345 00000108 B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   346 0000010A EE                          out dx, al
   347                                  
   348                                      ; Bit 7 (INTP7) を 0 (許可) にその他は禁止します。
   349 0000010B B07F                        mov al, 7Fh     ; 0111 1111
   350 0000010D EE                          out dx, al
   351                                  
   352                                      ;-------------------------------------------
   353                                      ; 割り込み許可
   354                                      ;-------------------------------------------
   355 0000010E FB                          sti
   356                                  
   357                                   %endif
   358                                  
   359                                      ; 変数初期化 (RAMエリアをクリア)
   360 0000010F C706[4B08]0000              mov word [dump_seg], 0x0000
   361 00000115 C706[4D08]0000              mov word [dump_off], 0x0000
   362 0000011B C706[4F08]0020              mov word [load_seg], 0x2000
   363                                  
   364                                      ; スタートメッセージの表示
   365 00000121 BE[0006]                    mov si, msg_boot
   366 00000124 E8E702                      call puts
   367                                  
   368                                  ; =================================================================
   369                                  ; Main Loop
   370                                  ; =================================================================
   371                                  monitor_loop:
   372 00000127 B03E                        mov al, '>'
   373 00000129 E8F002                      call putc
   374 0000012C B020                        mov al, ' '
   375 0000012E E8EB02                      call putc
   376                                  
   377 00000131 E80A03                      call getc_echo  ; コマンド受信（エコーあり）
   378 00000134 88C3                        mov bl, al
   379                                      
   380 00000136 80FB64                      cmp bl, 'd'     ; dump command
   381 00000139 747A                        je do_dump
   382 0000013B 80FB44                      cmp bl, 'D'
   383 0000013E 7475                        je do_dump
   384                                      
   385 00000140 80FB6C                      cmp bl, 'l'     ; load command
   386 00000143 7503E9D000                  je do_load
   387 00000148 80FB4C                      cmp bl, 'L'
   388 0000014B 7503E9C800                  je do_load
   389                                      
   390 00000150 80FB67                      cmp bl, 'g'     ; go command
   391 00000153 7503E93B01                  je do_go
   392 00000158 80FB47                      cmp bl, 'G'
   393 0000015B 7503E93301                  je do_go
   394                                  
   395 00000160 80FB77                      cmp bl, 'w'     ; Write command
   396 00000163 7503E95701                  je do_write
   397 00000168 80FB57                      cmp bl, 'W'
   398 0000016B 7503E94F01                  je do_write
   399                                  
   400 00000170 3C69                        cmp al, 'i'     ; Input Port command
   401 00000172 7503E98B01                  je do_in
   402 00000177 3C49                        cmp al, 'I'
   403 00000179 7503E98401                  je do_in
   404                                  
   405 0000017E 3C6F                        cmp al, 'o'     ; Output Port command
   406 00000180 7503E9A101                  je do_out
   407 00000185 3C4F                        cmp al, 'O'
   408 00000187 7503E99A01                  je do_out
   409                                  
   410 0000018C 3C73                        cmp al, 's'     ; Scan I/O command
   411 0000018E 7503E9BA01                  je do_scan
   412 00000193 3C53                        cmp al, 'S'
   413 00000195 7503E9B301                  je do_scan
   414                                  
   415 0000019A 3C74                        cmp al, 't'     ; Scan Timer wait command
   416 0000019C 7503E91E02                  je do_timer
   417 000001A1 3C54                        cmp al, 'T'
   418 000001A3 7503E91702                  je do_timer
   419                                  
   420 000001A8 3C3F                        cmp al, '?'     ; Help
   421 000001AA 7503E95302                  je cmd_help
   422                                  
   423                                      ; 知らないコマンドなら改行して戻る
   424 000001AF E89502                      call putc_crlf
   425 000001B2 E972FF                      jmp monitor_loop
   426                                  
   427                                  ; =================================================================
   428                                  ; Command: Dump Memory
   429                                  ; Usage:
   430                                  ;   D               -> Dump next 64 bytes
   431                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   432                                  ; =================================================================
   433                                  do_dump:
   434 000001B5 E88602                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   435 000001B8 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   436 000001BA 7418                        je .dump_run
   437 000001BC 3C20                        cmp al, ' '         ; Spaceなら引数解析
   438 000001BE 7405                        je .parse_args
   439                                      
   440                                      ; それ以外なら無視して実行へ（またはエラー処理）
   441 000001C0 E88402                      call putc_crlf
   442 000001C3 EB12                        jmp .dump_run_start
   443                                  
   444                                  .parse_args:
   445 000001C5 E8AD02                      call get_hex_word
   446 000001C8 A3[4B08]                    mov [dump_seg], ax
   447 000001CB E8ED02                      call skip_space
   448 000001CE E8A402                      call get_hex_word
   449 000001D1 A3[4D08]                    mov [dump_off], ax
   450                                      ; ここでEnter待ちをするか、そのまま実行するか
   451                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   452                                      
   453                                  .dump_run:
   454 000001D4 E87002                      call putc_crlf              ; 実行直前に改行
   455                                  
   456                                  .dump_run_start:
   457 000001D7 B90400                      mov cx, 4                   ; 4行表示する
   458                                      
   459                                  .line_loop:
   460 000001DA 51                          push cx
   461                                      
   462 000001DB A1[4B08]                    mov ax, [dump_seg]          ; セグメントの表示
   463 000001DE E86F02                      call print_hex_word
   464 000001E1 B03A                        mov al, ':'                 ; 区切り文字の:を表示
   465 000001E3 E83602                      call putc
   466 000001E6 A1[4D08]                    mov ax, [dump_off]          ; オフセットの表示
   467 000001E9 E86402                      call print_hex_word
   468 000001EC B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   469 000001EE E82B02                      call putc
   470                                  
