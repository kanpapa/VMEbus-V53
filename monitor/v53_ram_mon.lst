   702                                  ; Command: Input from Port
   703                                  ; Usage:
   704                                  ;   I <Port>
   705                                  ; ==============================================================
   706                                  do_in:
   707 00000308 E83901                      call getc_echo
   708 0000030B 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   709 0000030D 7403E9B301                  jne error           ; パラメタが無い場合はエラー処理へ
   710                                  
   711 00000312 E86601                      call get_hex_word   ; ポートアドレスを取得
   712 00000315 89C2                        mov dx, ax          ; 保存
   713 00000317 EC                          in al, dx           ; I/O Read
   714                                      
   715 00000318 50                          push ax
   716 00000319 E83101                      call putc_crlf      ; メッセージ表示前に改行
   717 0000031C BE[5E06]                    mov si, msg_in_res
   718 0000031F E8F200                      call puts
   719 00000322 58                          pop ax
   720                                  
   721 00000323 E83701                      call print_hex_byte ; 値を表示
   722                                  
