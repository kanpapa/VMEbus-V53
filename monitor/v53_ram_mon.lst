  1067                                  ;==========================================================
  1068                                  ; Interrupt Handler
  1069                                  ;==========================================================
  1070                                  
  1071                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1072                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1073                                  
  1074 00000539 6A00                    _isr_stub_0:  push 0x0          ; 0: Division by zero
  1075 0000053B EB30                                  jmp _default_int_handler
  1076 0000053D 6A01                    _isr_stub_1:  push 0x1          ; 1: Break flag
  1077 0000053F EB2C                                  jmp _default_int_handler
  1078 00000541 6A02                    _isr_stub_2:  push 0x2          ; 2: NMI
  1079 00000543 EB28                                  jmp _default_int_handler
  1080 00000545 6A03                    _isr_stub_3:  push 0x3          ; 3: BRK3
  1081 00000547 EB24                                  jmp _default_int_handler
  1082 00000549 6A04                    _isr_stub_4:  push 0x4          ; 4: BRKV
  1083 0000054B EB20                                  jmp _default_int_handler
  1084 0000054D 6A05                    _isr_stub_5:  push 0x5          ; 5: CHKIND
  1085 0000054F EB1C                                  jmp _default_int_handler
  1086                                  
  1087 00000551 6A20                    _isr_stub_20: push 0x0020       ; 32: ICU INTP0
  1088 00000553 EB18                                  jmp _default_int_handler
  1089 00000555 6A21                    _isr_stub_21: push 0x0021       ; 33: ICU INTP1
  1090 00000557 EB14                                  jmp _default_int_handler
  1091 00000559 6A22                    _isr_stub_22: push 0x0022       ; 34: ICU INTP2
  1092 0000055B EB10                                  jmp _default_int_handler
  1093 0000055D 6A23                    _isr_stub_23: push 0x0023       ; 35: ICU INTP3
  1094 0000055F EB0C                                  jmp _default_int_handler
  1095 00000561 6A24                    _isr_stub_24: push 0x0024       ; 36: ICU INTP4
  1096 00000563 EB08                                  jmp _default_int_handler
  1097 00000565 6A25                    _isr_stub_25: push 0x0025       ; 37: ICU INTP5
  1098 00000567 EB04                                  jmp _default_int_handler
  1099 00000569 6A26                    _isr_stub_26: push 0x0026       ; 38: ICU INTP6
  1100 0000056B EB00                                  jmp _default_int_handler
  1101                                  
  1102                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1103                                  
  1104                                  ; ==========================================================
  1105                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1106                                  ; ==========================================================
  1107                                  
  1108                                  ; --- 共通処理部 (Common Handler) ---
  1109                                  _default_int_handler:
  1110                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1111 0000056D 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX (16 bytes)
  1112 0000056E 1E                          push ds
  1113 0000056F 06                          push es
  1114                                  
  1115                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1116 00000570 8CC8                        mov  ax, cs
  1117 00000572 8ED8                        mov  ds, ax
  1118 00000574 8EC0                        mov  es, ax
  1119 00000576 89E5                        mov  bp, sp
  1120                                  
  1121                                      ; --- メッセージ表示 ---
  1122 00000578 BE[FD07]                    mov  si, msg_int_trap
  1123 0000057B E801FF                      call puts           ; "** INT "
  1124                                  
  1125                                      ; --- ベクタ番号の表示 ---
  1126 0000057E 8B4614                      mov  ax, [bp+20]    ; ベクタ番号を取得
  1127 00000581 E844FF                      call print_hex_byte ; 表示 (例: 25)
  1128                                  
  1129 00000584 BE[0508]                    mov  si, msg_detected
  1130 00000587 E8F5FE                      call puts           ; " detected **" (改行含む)
  1131                                  
  1132                                      ; 4. レジスタ表示 (スタックから読み出して表示)
  1133                                      ; Stack Layout after pushes:
  1134                                      ; BP+0: ES　最後にpushしたもの
  1135                                      ; BP+2: DS
  1136                                      ; BP+4: DI　pushaの開始
  1137                                      ; BP+6: SI
  1138                                      ; BP+8: BP (Old)
  1139                                      ; BP+10: SP (Original)
  1140                                      ; BP+12: BX
  1141                                      ; BP+14: DX
  1142                                      ; BP+16: CX
  1143                                      ; BP+18: AX pushaの終了
  1144                                      ; BP+20: Vector Number スタブでpushした値
  1145                                      ; BP+22: IP 割り込み発生時の戻り先
  1146                                      ; BP+24: CS (Return Addr)
  1147                                      ; BP+26: Flags
  1148                                      
  1149                                      ; AX
  1150 0000058A BE[1208]                    mov  si, msg_ax
  1151 0000058D E8EFFE                      call puts
  1152 00000590 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1153 00000593 E82BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1154                                  
  1155                                      ; BX
  1156 00000596 BE[1708]                    mov  si, msg_bx
  1157 00000599 E8E3FE                      call puts
  1158 0000059C 8B460C                      mov  ax, [bp+12]
  1159 0000059F E81FFF                      call print_hex_word
  1160                                  
  1161                                      ; CX
  1162 000005A2 BE[1C08]                    mov  si, msg_cx
  1163 000005A5 E8D7FE                      call puts
  1164 000005A8 8B4610                      mov  ax, [bp+16]
  1165 000005AB E813FF                      call print_hex_word
  1166                                  
  1167                                      ; DX
  1168 000005AE BE[2108]                    mov  si, msg_dx
  1169 000005B1 E8CBFE                      call puts
  1170 000005B4 8B460E                      mov  ax, [bp+14]
  1171 000005B7 E807FF                      call print_hex_word
  1172                                  
  1173 000005BA E8FBFE                      call putc_crlf
  1174                                  
  1175                                      ; --- 中断地点 (CS:IP) の表示 ---
  1176 000005BD BE[2608]                    mov  si, msg_addr
  1177 000005C0 E8BCFE                      call puts           ; " Stop at "
  1178 000005C3 8B4618                      mov  ax, [bp+24]    ; Stack上の CS
  1179 000005C6 E8F8FE                      call print_hex_word
  1180 000005C9 B03A                        mov  al, ':'
  1181 000005CB E8BFFE                      call putc
  1182 000005CE 8B4616                      mov  ax, [bp+22]    ; Stack上の IP
  1183 000005D1 E8EDFE                      call print_hex_word
  1184                                  
  1185 000005D4 E8E1FE                      call putc_crlf
  1186                                  
  1187 000005D7 8B4614                      mov  ax, [bp+20]    ; Stack上の ベクタ番号
  1188 000005DA 83F820                      cmp  ax, 0x20
  1189 000005DD 7208                        jb   .no_eoi         ; ベクタ番号 < 20h (PIC/ICU以外) ならEOI不要
  1190                                  
  1191                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1192 000005DF B020                        mov al, 20h         ; Non-specific EOI
  1193 000005E1 E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1194 000005E3 BA80F0                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1195 000005E6 EE                          out dx, al
  1196                                  .no_eoi:
  1197                                  
  1198 000005E7 07                          pop  es
  1199 000005E8 1F                          pop  ds
  1200 000005E9 61                          popa
  1201 000005EA 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1202 000005ED CF                          iret
  1203                                  
  1204                                  ; ==========================================================
  1205                                  ; PIC Dispatch Handler (Vector 27h)
  1206                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1207                                  ; ==========================================================
  1208                                  _pic_dispatch_handler:
  1209 000005EE 60                          pusha
  1210 000005EF 1E                          push ds
  1211 000005F0 06                          push es
  1212                                  
  1213                                      ; DS設定 (Tiny Model)
  1214 000005F1 8CC8                        mov ax, cs
  1215 000005F3 8ED8                        mov ds, ax
  1216                                  
  1217                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1218                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1219 000005F5 B00B                        mov al, 0x0B
  1220 000005F7 E6C8                        out PIC_REG0, al
  1221 000005F9 E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1222                                  
  1223                                      ; --- 2. 要因判定と分岐 ---
  1224                                      
  1225 000005FB A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1226 000005FD 751E                        jnz .handle_timer0
  1227                                  
  1228 000005FF A802                        test al, 02h        ; Bit 1: SCSI
  1229 00000601 7526                        jnz .handle_scsi
  1230                                  
  1231 00000603 A804                        test al, 04h        ; Bit 2: Timer 1
  1232 00000605 752A                        jnz .handle_timer1
  1233                                  
  1234 00000607 A808                        test al, 08h        ; Bit 3: USART Rx
  1235 00000609 752E                        jnz .handle_usart_rx
  1236                                  
  1237 0000060B A810                        test al, 10h        ; Bit 4: USART Tx
  1238 0000060D 7532                        jnz .handle_usart_tx
  1239                                  
  1240 0000060F A820                        test al, 20h        ; Bit 5: SCU Rx
  1241 00000611 7536                        jnz .handle_scu_rx
  1242                                  
  1243 00000613 A840                        test al, 40h        ; Bit 6: SCU Tx
  1244 00000615 753A                        jnz .handle_scu_tx
  1245                                  
  1246 00000617 A880                        test al, 80h        ; Bit 7: PPI
  1247 00000619 753E                        jnz .handle_ppi
  1248                                  
  1249                                      ; 該当なしの場合は無視
  1250 0000061B EB44                        jmp .eoi_exit
  1251                                  
  1252                                  ; --- 各ハンドラ処理 ---
  1253                                  
  1254                                  .handle_timer0:
  1255                                      ; INTP0: Timer 0 (Tick)
  1256                                      ; --- 32bit カウンタのインクリメント ---
  1257 0000061D FF06[0A09]                  inc word [tick_counter_lo]
  1258 00000621 7504                        jnz .skip_carry
  1259 00000623 FF06[0C09]                  inc word [tick_counter_hi]
  1260                                  .skip_carry:
  1261 00000627 EB38                        jmp .eoi_exit
  1262                                  
  1263                                  .handle_scsi:
  1264                                      ; INTP1: SCSIC
  1265 00000629 BE[3808]                    mov si, msg_int_scsi
  1266 0000062C E850FE                      call puts
  1267 0000062F EB30                        jmp .eoi_exit
  1268                                  
  1269                                  .handle_timer1:
  1270                                      ; INTP2: ユーザ用タイマー
  1271 00000631 BE[4F08]                    mov si, msg_int_timer1
  1272 00000634 E848FE                      call puts
  1273 00000637 EB28                        jmp .eoi_exit
  1274                                  
  1275                                  .handle_usart_rx:
  1276                                      ; INTP3: USART受信準備完了割り込み
  1277 00000639 BE[6808]                    mov si, msg_int_usart_rx
  1278 0000063C E840FE                      call puts
  1279 0000063F EB20                        jmp .eoi_exit
  1280                                  
  1281                                  .handle_usart_tx:
  1282                                      ; INTP4: USART送信完了割り込み
  1283 00000641 BE[8308]                    mov si, msg_int_usart_tx
  1284 00000644 E838FE                      call puts
  1285 00000647 EB18                        jmp .eoi_exit
  1286                                  
  1287                                  .handle_scu_rx:
  1288                                      ; INTP5: SCU受信準備完了割り込み
  1289 00000649 BE[9E08]                    mov si, msg_int_scu_rx
  1290 0000064C E830FE                      call puts
  1291 0000064F EB10                        jmp .eoi_exit
  1292                                  
  1293                                  .handle_scu_tx:
  1294                                      ; INTP6: SCU送信完了割り込み
  1295 00000651 BE[B708]                    mov si, msg_int_scu_tx
  1296 00000654 E828FE                      call puts
  1297 00000657 EB08                        jmp .eoi_exit
  1298                                  
  1299                                  .handle_ppi:
  1300                                      ; INTP7: PPI割り込み
  1301 00000659 BE[D008]                    mov si, msg_int_ppi
  1302 0000065C E820FE                      call puts
  1303 0000065F EB00                        jmp .eoi_exit
  1304                                  
  1305                                  ; --- 終了処理 ---
  1306                                  .eoi_exit:
  1307                                      ; --- EOI (End of Interrupt) to PIC ---
  1308 00000661 B020                        mov al, 20h     ; Non-specific EOI
  1309                                  
  1310                                      ; 外部PIC (Slave) の割り込み完了
  1311 00000663 E6C8                        out PIC_REG0, al
  1312                                  
  1313                                      ; V53内蔵ICU (Master) の割り込み完了
  1314 00000665 BA80F0                      mov dx, ICU_REG0 
  1315 00000668 EE                          out dx, al
  1316                                  
  1317 00000669 07                          pop es
  1318 0000066A 1F                          pop ds
  1319 0000066B 61                          popa
  1320 0000066C CF                          iret
  1321                                  
  1322                                  ;--------------------------------------
  1323                                  ; 未定義割り込みベクタ用の簡易トラップ
  1324                                  ;--------------------------------------
  1325                                  _default_int_unknown_handler:
  1326                                      ; 想定外の割り込みが発生したため、
  1327                                      ; 画面に "UNKNOWN INT" と出して停止する
  1328 0000066D FA                          cli                 ; 多重割り込み禁止
  1329                                  
  1330                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1331 0000066E 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1332 0000066F 1E                          push ds
  1333 00000670 06                          push es
  1334                                  
  1335                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1336 00000671 8CC8                        mov  ax, cs
  1337 00000673 8ED8                        mov  ds, ax
  1338 00000675 8EC0                        mov  es, ax
  1339                                  
  1340                                      ; 3. スタックフレームへのポインタ設定
  1341 00000677 89E5                        mov  bp, sp
  1342                                  
  1343 00000679 BE[E608]                    mov si, msg_unknown_int
  1344 0000067C E800FE                      call puts
  1345                                  
  1346                                      ; 4. レジスタ表示 (スタックから読み出して表示)
  1347                                      ; Stack Layout after pushes:
  1348                                      ; BP+0: ES
  1349                                      ; BP+2: DS
  1350                                      ; BP+4: DI
  1351                                      ; BP+6: SI
  1352                                      ; BP+8: BP (Old)
  1353                                      ; BP+10: SP (Original)
  1354                                      ; BP+12: BX
  1355                                      ; BP+14: DX
  1356                                      ; BP+16: CX
  1357                                      ; BP+18: AX
  1358                                      ; BP+20: IP (Return Addr)
  1359                                      ; BP+22: CS (Return Addr)
  1360                                      ; BP+24: Flags
  1361                                      
  1362                                      ; AX
  1363 0000067F BE[1208]                    mov  si, msg_ax
  1364 00000682 E8FAFD                      call puts
  1365 00000685 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1366 00000688 E836FE                      call print_hex_word     ; 4桁HEX表示ルーチン
  1367                                  
  1368                                      ; BX
  1369 0000068B BE[1708]                    mov  si, msg_bx
  1370 0000068E E8EEFD                      call puts
  1371 00000691 8B460C                      mov  ax, [bp+12]
  1372 00000694 E82AFE                      call print_hex_word
  1373                                  
  1374                                      ; CX
  1375 00000697 BE[1C08]                    mov  si, msg_cx
  1376 0000069A E8E2FD                      call puts
  1377 0000069D 8B4610                      mov  ax, [bp+16]
  1378 000006A0 E81EFE                      call print_hex_word
  1379                                  
  1380                                      ; DX
  1381 000006A3 BE[2108]                    mov  si, msg_dx
  1382 000006A6 E8D6FD                      call puts
  1383 000006A9 8B460E                      mov  ax, [bp+14]
  1384 000006AC E812FE                      call print_hex_word
  1385                                  
  1386 000006AF E806FE                      call putc_crlf
  1387                                  
  1388                                      ; --- 中断地点 (CS:IP) の表示 ---
  1389                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1390                                      ; その上が割り込み発生時の IP, CS, Flags です
  1391                                      
  1392 000006B2 BE[2608]                    mov  si, msg_addr
  1393 000006B5 E8C7FD                      call puts           ; " Stop at "
  1394 000006B8 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1395 000006BB E803FE                      call print_hex_word
  1396 000006BE B03A                        mov  al, ':'
  1397 000006C0 E8CAFD                      call putc
  1398 000006C3 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1399 000006C6 E8F8FD                      call print_hex_word
  1400                                  
  1401 000006C9 E8ECFD                      call putc_crlf
  1402                                  
  1403                                      ; 5. 復帰処理
  1404                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1405                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1406 000006CC E931F9                      jmp  start  ; モニタの開始ラベルへ
  1407                                  
  1408                                      ; 停止（暴走を防ぐ）
  1409                                  ;.halt:
  1410                                  ;    hlt
  1411                                  ;    jmp .halt
