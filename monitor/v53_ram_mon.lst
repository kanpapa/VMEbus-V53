   873                                  ; ==============================================================
   874                                  ; Command: Timer
   875                                  ;   T          -> Show current tick counter (32-bit HEX)
   876                                  ;   T <val>    -> Wait for <val> ticks (10ms unit)
   877                                  ; ==============================================================
   878                                  do_timer:
   879 00000411 E87C00                      call getc_echo      ; コマンド('T')の次の文字を取得
   880 00000414 3C0D                        cmp al, 0x0D        ; Enterキー(CR)なら表示モードへ
   881 00000416 7421                        je .show_counter
   882 00000418 3C20                        cmp al, ' '         ; スペースならWaitモードへ
   883 0000041A 7403E9F200                  jne error           ; それ以外はエラー
   884                                  
   885                                      ; --- Wait Mode (引数あり: T 0064 等) ---
   886 0000041F E8A500                      call get_hex_word   ; AX = 待ち時間 (0064h = 1秒)
   887                                  
   888                                      ; 開始時刻を保存 (Start Time)
   889 00000422 8B1E[6509]                  mov bx, [tick_counter_lo]
   890                                  
   891                                  .wait_loop:
   892                                      ; 1. 現在時刻を取得
   893 00000426 8B0E[6509]                  mov cx, [tick_counter_lo]
   894                                      
   895                                      ; 2. 経過時間を計算 (Current - Start)
   896                                      ; オーバーフローしても、この引き算の結果は正しい経過時間になる
   897 0000042A 29D9                        sub cx, bx          
   898                                      
   899                                      ; 3. 経過時間 < 待ち時間 ならループ継続
   900 0000042C 39C1                        cmp cx, ax
   901 0000042E 72F6                        jb .wait_loop       ; Jump if Below (unsigned compare)
   902                                  
   903                                      ; 指定時間経過した
   904 00000430 BE[7107]                    mov si, msg_done
   905 00000433 E82A00                      call puts
   906 00000436 E937FD                      jmp monitor_loop
   907                                  
   908                                  .show_counter:
   909                                      ; --- Show Counter Mode (引数なし: Tのみ) ---
   910 00000439 E85D00                      call putc_crlf
   911                                      
   912 0000043C BE[3908]                    mov si, msg_tick    ; "Tick: "
   913 0000043F E81E00                      call puts
   914                                  
   915                                      ; 32bitカウンタを [High][Low] の順で表示
   916 00000442 A1[6709]                    mov ax, [tick_counter_hi]
   917 00000445 E85A00                      call print_hex_word
   918 00000448 A1[6509]                    mov ax, [tick_counter_lo]
   919 0000044B E85400                      call print_hex_word
   920                                      
   921 0000044E E84800                      call putc_crlf
   922 00000451 E91CFD                      jmp monitor_loop
   923                                  
   924                                  ; ==============================================================
   925                                  ; Command: Help
   926                                  ; ==============================================================
   927                                  cmd_help:
   928 00000454 E84200                      call putc_crlf
   929 00000457 BE[7D07]                    mov si, msg_help
   930 0000045A E80300                      call puts
   931 0000045D E910FD                      jmp monitor_loop
   932                                  
   933                                  ; =================================================================
   934                                  ; Utilities
   935                                  ; =================================================================
   936                                  
   937                                  ; 文字列出力
   938                                  puts:
   939 00000460 2E8A04                      mov al, [cs:si]
   940 00000463 08C0                        or al, al
   941 00000465 7406                        jz .ret
   942 00000467 E80400                      call putc
   943 0000046A 46                          inc si
   944 0000046B EBF3                        jmp puts
   945 0000046D C3                      .ret: ret
   946                                  
   947                                  ; 1文字出力
   948                                  putc:
   949 0000046E 52                          push dx
   950 0000046F 50                          push ax
   951 00000470 BA61F0                      mov dx, SCU_SST
   952 00000473 EC                      .w: in al, dx
   953 00000474 A801                        test al, TX_READY  ; TX Ready?
   954 00000476 74FB                        jz .w
   955 00000478 BA60F0                      mov dx, SCU_DATA
   956 0000047B 58                          pop ax
   957 0000047C 50                          push ax
   958 0000047D EE                          out dx, al
   959 0000047E 58                          pop ax
   960 0000047F 5A                          pop dx
   961 00000480 C3                          ret
   962                                  
   963                                  ; 1文字入力
   964                                  getc:
   965 00000481 52                          push dx
   966 00000482 BA61F0                      mov dx, SCU_SST
   967 00000485 EC                      .w: in al, dx
   968 00000486 A802                        test al, RX_READY  ; RX Ready?
   969 00000488 74FB                        jz .w
   970 0000048A BA60F0                      mov dx, SCU_DATA
   971 0000048D EC                          in al, dx
   972 0000048E 5A                          pop dx
   973 0000048F C3                          ret
   974                                  
   975                                  ; 1文字入力　エコーバックあり
   976                                  getc_echo:
   977 00000490 E8EEFF                      call getc
   978 00000493 50                          push ax
   979 00000494 E8D7FF                      call putc
   980 00000497 58                          pop ax
   981 00000498 C3                          ret
   982                                  
   983                                  ; 改行出力
   984                                  putc_crlf:
   985 00000499 B00D                        mov al, 0x0D
   986 0000049B E8D0FF                      call putc
   987 0000049E B00A                        mov al, 0x0A
   988 000004A0 EBCC                        jmp putc
   989                                  
   990                                  ; -----------------------------------------------------------------
   991                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   992                                  ; Input: AX
   993                                  ; -----------------------------------------------------------------
   994                                  print_hex_word:
   995 000004A2 50                          push ax
   996 000004A3 88E0                        mov al, ah
   997 000004A5 E80100                      call print_hex_byte
   998 000004A8 58                          pop ax
   999                                  
  1000                                  ; -----------------------------------------------------------------
  1001                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
  1002                                  ; Input: AL
  1003                                  ; -----------------------------------------------------------------
  1004                                  print_hex_byte:
  1005 000004A9 50                          push ax
  1006 000004AA 51                          push cx
  1007                                  
  1008                                      ; 上位バイトの表示
  1009 000004AB 50                          push ax
  1010 000004AC C0E804                      shr al, 4
  1011 000004AF E80900                      call .digit
  1012                                  
  1013                                      ; 下位バイトの表示
  1014 000004B2 58                          pop ax
  1015 000004B3 240F                        and al, 0x0F
  1016 000004B5 E80300                      call .digit
  1017                                  
  1018 000004B8 59                          pop cx
  1019 000004B9 58                          pop ax
  1020 000004BA C3                          ret
  1021                                  
  1022                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
  1023                                  .digit:
  1024 000004BB 0430                        add al, '0'
  1025 000004BD 3C39                        cmp al, '9'
  1026 000004BF 7602                        jbe .p
  1027 000004C1 0407                        add al, 7
  1028 000004C3 E8A8FF                  .p: call putc
  1029 000004C6 C3                          ret
  1030                                  
  1031                                  ; -----------------------------------------------------------------
  1032                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
  1033                                  ; Input:  Serial (例: "1", "0", "0", "0")
  1034                                  ; Output: AX = 0x1000
  1035                                  ; -----------------------------------------------------------------
  1036                                  get_hex_word:
  1037 000004C7 53                          push bx
  1038 000004C8 E80B00                      call get_hex_byte_echo
  1039 000004CB 88C7                        mov bh, al
  1040 000004CD E80600                      call get_hex_byte_echo
  1041 000004D0 88C3                        mov bl, al
  1042 000004D2 89D8                        mov ax, bx
  1043 000004D4 5B                          pop bx
  1044 000004D5 C3                          ret
  1045                                  
  1046                                  ; 16進数2桁入力　エコーバック有り
  1047                                  get_hex_byte_echo:
  1048 000004D6 53                          push bx
  1049 000004D7 E8B6FF                      call getc_echo
  1050 000004DA E82500                      call hex_char_to_bin
  1051 000004DD C0E004                      shl al, 4
  1052 000004E0 88C3                        mov bl, al
  1053 000004E2 E8ABFF                      call getc_echo
  1054 000004E5 E81A00                      call hex_char_to_bin
  1055 000004E8 08D8                        or al, bl
  1056 000004EA 5B                          pop bx
  1057 000004EB C3                          ret
  1058                                  
  1059                                  ; -----------------------------------------------------------------
  1060                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1061                                  ; Input:  Serial (例: "3", "F")
  1062                                  ; Output: AL = 0x3F
  1063                                  ; -----------------------------------------------------------------
  1064                                  get_hex_byte:
  1065 000004EC 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1066                                  
  1067                                      ; 上位4bit
  1068 000004ED E891FF                      call getc
  1069 000004F0 E80F00                      call hex_char_to_bin
  1070 000004F3 C0E004                      shl al, 4
  1071 000004F6 88C3                        mov bl, al          ; 一時保存
  1072                                      
  1073                                      ; 下位4bit
  1074 000004F8 E886FF                      call getc
  1075 000004FB E80400                      call hex_char_to_bin
  1076 000004FE 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1077 00000500 5B                          pop bx
  1078 00000501 C3                          ret
  1079                                  
  1080                                  ; -----------------------------------------------------------------
  1081                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1082                                  ; Input: AL (ASCII)
  1083                                  ; Output: AL (Binary)
  1084                                  ; -----------------------------------------------------------------
  1085                                  hex_char_to_bin:
  1086 00000502 2C30                        sub al, '0'
  1087 00000504 3C09                        cmp al, 9
  1088 00000506 7604                        jbe .done
  1089 00000508 2C07                        sub al, 7           ; 'A'-'F'対応
  1090 0000050A 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1091                                  .done:
  1092 0000050C C3                          ret
  1093                                  
  1094                                  ; -----------------------------------------------------------------
  1095                                  ; Helper: スペースなどを読み飛ばす
  1096                                  ; -----------------------------------------------------------------
  1097                                  skip_space:
  1098 0000050D E880FF                      call getc_echo
  1099 00000510 C3                          ret
  1100                                  
  1101                                  ; -----------------------------------------------------------------
  1102                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1103                                  ; -----------------------------------------------------------------
  1104                                  error:
  1105 00000511 BE[5507]                    mov si, msg_error
  1106 00000514 E849FF                      call puts
  1107 00000517 E956FC                      jmp monitor_loop
  1108                                  
  1109                                  ;==========================================================
  1110                                  ; NMI (ABORT) Handler
  1111                                  ;==========================================================
  1112                                  
  1113                                  NMI_Handler:
  1114                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1115 0000051A 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1116 0000051B 1E                          push ds
  1117 0000051C 06                          push es
  1118                                  
  1119                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1120 0000051D 8CC8                        mov  ax, cs
  1121 0000051F 8ED8                        mov  ds, ax
  1122 00000521 8EC0                        mov  es, ax
  1123                                  
  1124                                      ; 3. スタックフレームへのポインタ設定
  1125 00000523 89E5                        mov  bp, sp
  1126                                  
  1127                                      ; --- 画面表示 ---
  1128 00000525 BE[4008]                    mov  si, msg_nmi
  1129 00000528 E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1130                                  
  1131                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1132                                      ; Stack Layout after pushes:
  1133                                      ; BP+0: ES
  1134                                      ; BP+2: DS
  1135                                      ; BP+4: DI
  1136                                      ; BP+6: SI
  1137                                      ; BP+8: BP (Old)
  1138                                      ; BP+10: SP (Original)
  1139                                      ; BP+12: BX
  1140                                      ; BP+14: DX
  1141                                      ; BP+16: CX
  1142                                      ; BP+18: AX
  1143                                      ; BP+20: IP (Return Addr)
  1144                                      ; BP+22: CS (Return Addr)
  1145                                      ; BP+24: Flags
  1146                                      
  1147                                      ; AX
  1148 0000052B BE[5808]                    mov  si, msg_ax
  1149 0000052E E82FFF                      call puts
  1150 00000531 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1151 00000534 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1152                                  
  1153                                      ; BX
  1154 00000537 BE[5D08]                    mov  si, msg_bx
  1155 0000053A E823FF                      call puts
  1156 0000053D 8B460C                      mov  ax, [bp+12]
  1157 00000540 E85FFF                      call print_hex_word
  1158                                  
  1159                                      ; CX
  1160 00000543 BE[6208]                    mov  si, msg_cx
  1161 00000546 E817FF                      call puts
  1162 00000549 8B4610                      mov  ax, [bp+16]
  1163 0000054C E853FF                      call print_hex_word
  1164                                  
  1165                                      ; DX
  1166 0000054F BE[6708]                    mov  si, msg_dx
  1167 00000552 E80BFF                      call puts
  1168 00000555 8B460E                      mov  ax, [bp+14]
  1169 00000558 E847FF                      call print_hex_word
  1170                                  
  1171 0000055B E83BFF                      call putc_crlf
  1172                                  
  1173                                      ; --- 中断地点 (CS:IP) の表示 ---
  1174                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1175                                      ; その上が割り込み発生時の IP, CS, Flags です
  1176                                      
  1177 0000055E BE[6C08]                    mov  si, msg_addr
  1178 00000561 E8FCFE                      call puts           ; " Stop at "
  1179 00000564 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1180 00000567 E838FF                      call print_hex_word
  1181 0000056A B03A                        mov  al, ':'
  1182 0000056C E8FFFE                      call putc
  1183 0000056F 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1184 00000572 E82DFF                      call print_hex_word
  1185                                  
  1186 00000575 E821FF                      call putc_crlf
  1187                                  
  1188                                      ; 4. 復帰処理
  1189                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1190                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1191 00000578 E985FA                      jmp  start  ; モニタの開始ラベルへ
  1192                                  
  1193                                  ; ==========================================================
  1194                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1195                                  ; ==========================================================
  1196                                  
  1197                                  ; --- 共通処理部 (Common Handler) ---
  1198                                  _default_int_handler:
  1199                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1200 0000057B 55                          push bp
  1201 0000057C 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1202 0000057D 1E                          push ds
  1203 0000057E 06                          push es
  1204                                  
  1205                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1206 0000057F 8CC8                        mov  ax, cs
  1207 00000581 8ED8                        mov  ds, ax
  1208 00000583 8EC0                        mov  es, ax
  1209                                  
  1210                                      ; 3. スタックフレームへのポインタ設定
  1211 00000585 89E5                        mov  bp, sp
  1212                                  
  1213                                      ; --- メッセージ表示 ---
  1214 00000587 BE[7E08]                    mov  si, msg_int_trap
  1215 0000058A E8D3FE                      call puts           ; "** INT "
  1216                                  
  1217                                      ; --- ベクタ番号の表示 ---
  1218                                      ; スタック構造:
  1219                                      ; [BP+0] Old BP
  1220                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1221                                      ; [BP+4] Return IP ...
  1222                                      
  1223 0000058D 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1224 00000590 E816FF                      call print_hex_byte ; 表示 (例: 25)
  1225                                  
  1226 00000593 BE[8608]                    mov  si, msg_detected
  1227 00000596 E8C7FE                      call puts           ; " detected **" (改行含む)
  1228                                  
  1229                                  ; 3. レジスタ表示 (スタックから読み出して表示)
  1230                                      ; Stack Layout after pushes:
  1231                                      ; BP+0: ES
  1232                                      ; BP+2: DS
  1233                                      ; BP+4: DI
  1234                                      ; BP+6: SI
  1235                                      ; BP+8: BP (Old)
  1236                                      ; BP+10: SP (Original)
  1237                                      ; BP+12: BX
  1238                                      ; BP+14: DX
  1239                                      ; BP+16: CX
  1240                                      ; BP+18: AX
  1241                                      ; BP+20: IP (Return Addr)
  1242                                      ; BP+22: CS (Return Addr)
  1243                                      ; BP+24: Flags
  1244                                      
  1245                                      ; AX
  1246 00000599 BE[5808]                    mov  si, msg_ax
  1247 0000059C E8C1FE                      call puts
  1248 0000059F 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1249 000005A2 E8FDFE                      call print_hex_word     ; 4桁HEX表示ルーチン
  1250                                  
  1251                                      ; BX
  1252 000005A5 BE[5D08]                    mov  si, msg_bx
  1253 000005A8 E8B5FE                      call puts
  1254 000005AB 8B460C                      mov  ax, [bp+12]
  1255 000005AE E8F1FE                      call print_hex_word
  1256                                  
  1257                                      ; CX
  1258 000005B1 BE[6208]                    mov  si, msg_cx
  1259 000005B4 E8A9FE                      call puts
  1260 000005B7 8B4610                      mov  ax, [bp+16]
  1261 000005BA E8E5FE                      call print_hex_word
  1262                                  
  1263                                      ; DX
  1264 000005BD BE[6708]                    mov  si, msg_dx
  1265 000005C0 E89DFE                      call puts
  1266 000005C3 8B460E                      mov  ax, [bp+14]
  1267 000005C6 E8D9FE                      call print_hex_word
  1268                                  
  1269 000005C9 E8CDFE                      call putc_crlf
  1270                                  
  1271                                      ; --- 中断地点 (CS:IP) の表示 ---
  1272                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1273                                      ; その上が割り込み発生時の IP, CS, Flags です
  1274                                      
  1275 000005CC BE[6C08]                    mov  si, msg_addr
  1276 000005CF E88EFE                      call puts           ; " Stop at "
  1277 000005D2 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1278 000005D5 E8CAFE                      call print_hex_word
  1279 000005D8 B03A                        mov  al, ':'
  1280 000005DA E891FE                      call putc
  1281 000005DD 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1282 000005E0 E8BFFE                      call print_hex_word
  1283                                  
  1284 000005E3 E8B3FE                      call putc_crlf
  1285                                  
  1286                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1287 000005E6 B020                        mov al, 20h         ; Non-specific EOI
  1288 000005E8 E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1289 000005EA BA80F0                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1290 000005ED EE                          out dx, al
  1291                                  
  1292 000005EE 07                          pop  es
  1293 000005EF 1F                          pop  ds
  1294 000005F0 61                          popa
  1295 000005F1 5D                          pop  bp
  1296 000005F2 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1297 000005F5 CF                          iret
  1298                                  
  1299                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1300                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1301                                  
  1302 000005F6 6A00                    _isr_stub_0:  push 0x0          ; 0: Division by zero
  1303 000005F8 EB81                                  jmp _default_int_handler
  1304 000005FA 6A01                    _isr_stub_1:  push 0x1          ; 1: Break flag
  1305 000005FC E97CFF                                jmp _default_int_handler
  1306                                                                  ; 2: NMI
  1307 000005FF 6A03                    _isr_stub_3:  push 0x3          ; 3: BRK3
  1308 00000601 E977FF                                jmp _default_int_handler
  1309 00000604 6A04                    _isr_stub_4:  push 0x4          ; 4: BRKV
  1310 00000606 E972FF                                jmp _default_int_handler
  1311 00000609 6A05                    _isr_stub_5:  push 0x5          ; 5: CHKIND
  1312 0000060B E96DFF                                jmp _default_int_handler
  1313                                  
  1314 0000060E 6A20                    _isr_stub_20: push 0x0020       ; 32: ICU INTP0
  1315 00000610 E968FF                                jmp _default_int_handler
  1316 00000613 6A21                    _isr_stub_21: push 0x0021       ; 33: ICU INTP1
  1317 00000615 E963FF                                jmp _default_int_handler
  1318 00000618 6A22                    _isr_stub_22: push 0x0022       ; 34: ICU INTP2
  1319 0000061A E95EFF                                jmp _default_int_handler
  1320 0000061D 6A23                    _isr_stub_23: push 0x0023       ; 35: ICU INTP3
  1321 0000061F E959FF                                jmp _default_int_handler
  1322 00000622 6A24                    _isr_stub_24: push 0x0024       ; 36: ICU INTP4
  1323 00000624 E954FF                                jmp _default_int_handler
  1324 00000627 6A25                    _isr_stub_25: push 0x0025       ; 37: ICU INTP5
  1325 00000629 E94FFF                                jmp _default_int_handler
  1326 0000062C 6A26                    _isr_stub_26: push 0x0026       ; 38: ICU INTP6
  1327 0000062E E94AFF                                jmp _default_int_handler
  1328                                  
  1329                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1330                                  
  1331                                  ; ==========================================================
  1332                                  ; PIC Dispatch Handler (Vector 27h)
  1333                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1334                                  ; ==========================================================
  1335                                  _pic_dispatch_handler:
  1336 00000631 60                          pusha
  1337 00000632 1E                          push ds
  1338 00000633 06                          push es
  1339                                  
  1340                                      ; DS設定 (Tiny Model)
  1341 00000634 8CC8                        mov ax, cs
  1342 00000636 8ED8                        mov ds, ax
  1343                                  
  1344                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1345                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1346 00000638 B00B                        mov al, 0x0B
  1347 0000063A E6C8                        out PIC_REG0, al
  1348 0000063C E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1349                                  
  1350                                      ; --- 2. 要因判定と分岐 ---
  1351                                      
  1352 0000063E A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1353 00000640 751E                        jnz .handle_timer0
  1354                                  
  1355 00000642 A802                        test al, 02h        ; Bit 1: SCSI
  1356 00000644 7526                        jnz .handle_scsi
  1357                                  
  1358 00000646 A804                        test al, 04h        ; Bit 2: Timer 1
  1359 00000648 752A                        jnz .handle_timer1
  1360                                  
  1361 0000064A A808                        test al, 08h        ; Bit 3: USART Rx
  1362 0000064C 752E                        jnz .handle_usart_rx
  1363                                  
  1364 0000064E A810                        test al, 10h        ; Bit 4: USART Tx
  1365 00000650 7532                        jnz .handle_usart_tx
  1366                                  
  1367 00000652 A820                        test al, 20h        ; Bit 5: SCU Rx
  1368 00000654 7536                        jnz .handle_scu_rx
  1369                                  
  1370 00000656 A840                        test al, 40h        ; Bit 6: SCU Tx
  1371 00000658 753A                        jnz .handle_scu_tx
  1372                                  
  1373 0000065A A880                        test al, 80h        ; Bit 7: PPI
  1374 0000065C 753E                        jnz .handle_ppi
  1375                                  
  1376                                      ; 該当なしの場合は無視
  1377 0000065E EB44                        jmp .eoi_exit
  1378                                  
  1379                                  ; --- 各ハンドラ処理 ---
  1380                                  
  1381                                  .handle_timer0:
  1382                                      ; INTP0: Timer 0 (Tick)
  1383                                      ; --- 32bit カウンタのインクリメント ---
  1384 00000660 FF06[6509]                  inc word [tick_counter_lo]
  1385 00000664 7504                        jnz .skip_carry
  1386 00000666 FF06[6709]                  inc word [tick_counter_hi]
  1387                                  .skip_carry:
  1388 0000066A EB38                        jmp .eoi_exit
  1389                                  
  1390                                  .handle_scsi:
  1391                                      ; INTP1: SCSIC
  1392 0000066C BE[9308]                    mov si, msg_int_scsi
  1393 0000066F E8EEFD                      call puts
  1394 00000672 EB30                        jmp .eoi_exit
  1395                                  
  1396                                  .handle_timer1:
  1397                                      ; INTP2: ユーザ用タイマー
  1398 00000674 BE[AA08]                    mov si, msg_int_timer1
  1399 00000677 E8E6FD                      call puts
  1400 0000067A EB28                        jmp .eoi_exit
  1401                                  
  1402                                  .handle_usart_rx:
  1403                                      ; INTP3: USART受信準備完了割り込み
  1404 0000067C BE[C308]                    mov si, msg_int_usart_rx
  1405 0000067F E8DEFD                      call puts
  1406 00000682 EB20                        jmp .eoi_exit
  1407                                  
  1408                                  .handle_usart_tx:
  1409                                      ; INTP4: USART送信完了割り込み
  1410 00000684 BE[DE08]                    mov si, msg_int_usart_tx
  1411 00000687 E8D6FD                      call puts
  1412 0000068A EB18                        jmp .eoi_exit
  1413                                  
  1414                                  .handle_scu_rx:
  1415                                      ; INTP5: SCU受信準備完了割り込み
  1416 0000068C BE[F908]                    mov si, msg_int_scu_rx
  1417 0000068F E8CEFD                      call puts
  1418 00000692 EB10                        jmp .eoi_exit
  1419                                  
  1420                                  .handle_scu_tx:
  1421                                      ; INTP6: SCU送信完了割り込み
  1422 00000694 BE[1209]                    mov si, msg_int_scu_tx
  1423 00000697 E8C6FD                      call puts
  1424 0000069A EB08                        jmp .eoi_exit
  1425                                  
  1426                                  .handle_ppi:
  1427                                      ; INTP7: PPI割り込み
  1428 0000069C BE[2B09]                    mov si, msg_int_ppi
  1429 0000069F E8BEFD                      call puts
  1430 000006A2 EB00                        jmp .eoi_exit
  1431                                  
  1432                                  ; --- 終了処理 ---
  1433                                  .eoi_exit:
  1434                                      ; --- EOI (End of Interrupt) to PIC ---
  1435 000006A4 B020                        mov al, 20h     ; Non-specific EOI
  1436                                  
  1437                                      ; 外部PIC (Slave) の割り込み完了
  1438 000006A6 E6C8                        out PIC_REG0, al
  1439                                  
  1440                                      ; V53内蔵ICU (Master) の割り込み完了
  1441 000006A8 BA80F0                      mov dx, ICU_REG0 
  1442 000006AB EE                          out dx, al
  1443                                  
  1444 000006AC 07                          pop es
  1445 000006AD 1F                          pop ds
  1446 000006AE 61                          popa
  1447 000006AF CF                          iret
  1448                                  
  1449                                  ;--------------------------------------
  1450                                  ; 未定義割り込みベクタ用の簡易トラップ
  1451                                  ;--------------------------------------
  1452                                  _default_int_unknown_handler:
  1453                                      ; 想定外の割り込みが発生したため、
  1454                                      ; 画面に "UNKNOWN INT" と出して停止する
  1455 000006B0 FA                          cli                 ; 多重割り込み禁止
  1456                                  
  1457                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1458 000006B1 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1459 000006B2 1E                          push ds
  1460 000006B3 06                          push es
  1461                                  
  1462                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1463 000006B4 8CC8                        mov  ax, cs
  1464 000006B6 8ED8                        mov  ds, ax
  1465 000006B8 8EC0                        mov  es, ax
  1466                                  
  1467                                      ; 3. スタックフレームへのポインタ設定
  1468 000006BA 89E5                        mov  bp, sp
  1469                                  
  1470 000006BC BE[4109]                    mov si, msg_unknown_int
  1471 000006BF E89EFD                      call puts
  1472                                  
  1473                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1474                                      ; Stack Layout after pushes:
  1475                                      ; BP+0: ES
  1476                                      ; BP+2: DS
  1477                                      ; BP+4: DI
  1478                                      ; BP+6: SI
  1479                                      ; BP+8: BP (Old)
  1480                                      ; BP+10: SP (Original)
  1481                                      ; BP+12: BX
  1482                                      ; BP+14: DX
  1483                                      ; BP+16: CX
  1484                                      ; BP+18: AX
  1485                                      ; BP+20: IP (Return Addr)
  1486                                      ; BP+22: CS (Return Addr)
  1487                                      ; BP+24: Flags
  1488                                      
  1489                                      ; AX
  1490 000006C2 BE[5808]                    mov  si, msg_ax
  1491 000006C5 E898FD                      call puts
  1492 000006C8 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1493 000006CB E8D4FD                      call print_hex_word     ; 4桁HEX表示ルーチン
  1494                                  
  1495                                      ; BX
  1496 000006CE BE[5D08]                    mov  si, msg_bx
  1497 000006D1 E88CFD                      call puts
  1498 000006D4 8B460C                      mov  ax, [bp+12]
  1499 000006D7 E8C8FD                      call print_hex_word
  1500                                  
  1501                                      ; CX
  1502 000006DA BE[6208]                    mov  si, msg_cx
  1503 000006DD E880FD                      call puts
  1504 000006E0 8B4610                      mov  ax, [bp+16]
  1505 000006E3 E8BCFD                      call print_hex_word
  1506                                  
  1507                                      ; DX
  1508 000006E6 BE[6708]                    mov  si, msg_dx
  1509 000006E9 E874FD                      call puts
  1510 000006EC 8B460E                      mov  ax, [bp+14]
  1511 000006EF E8B0FD                      call print_hex_word
  1512                                  
  1513 000006F2 E8A4FD                      call putc_crlf
  1514                                  
  1515                                      ; --- 中断地点 (CS:IP) の表示 ---
  1516                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1517                                      ; その上が割り込み発生時の IP, CS, Flags です
  1518                                      
  1519 000006F5 BE[6C08]                    mov  si, msg_addr
  1520 000006F8 E865FD                      call puts           ; " Stop at "
  1521 000006FB 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1522 000006FE E8A1FD                      call print_hex_word
  1523 00000701 B03A                        mov  al, ':'
  1524 00000703 E868FD                      call putc
  1525 00000706 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1526 00000709 E896FD                      call print_hex_word
  1527                                  
  1528 0000070C E88AFD                      call putc_crlf
  1529                                  
  1530                                      ; 4. 復帰処理
  1531                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1532                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1533 0000070F E9EEF8                      jmp  start  ; モニタの開始ラベルへ
  1534                                  
  1535                                      ; 停止（暴走を防ぐ）
  1536                                  ;.halt:
  1537                                  ;    hlt
  1538                                  ;    jmp .halt
  1539                                  
