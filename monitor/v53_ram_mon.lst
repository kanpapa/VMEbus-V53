   719                                  ; ==============================================================
   720                                  ; Command: Output to Port
   721                                  ; Usage
   722                                  ;   O <Port> <Val>
   723                                  ; ==============================================================
   724                                  do_out:
   725 00000394 E81801                      call getc_echo
   726 00000397 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   727 00000399 7403E99201                  jne error           ; パラメタが無い場合はエラー処理へ
   728                                  
