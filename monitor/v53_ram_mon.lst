     1                                  ; =================================================================
     2                                  ; V53 Monitor System v0.7 2026-01-31
     3                                  ; Target: V53 VME Board & DOSBox-X Simulation
     4                                  ; =================================================================
     5                                  
     6                                  ; --- ビルド方法 ---
     7                                  ; DOSBox: nasm -f bin -dSIM v53_ram_mon.asm -o v53_ram_mon.com -l v53_ram_mon.lst
     8                                  ; Real:   nasm -f bin v53_ram_mon.asm -o v53_ram_mon.bin -l v53_ram_mon.lst
     9                                  ; -----------------
    10                                  
    11                                  ; ==========================================
    12                                  ; V53 System Register
    13                                  ; ==========================================
    14                                  %define SCTL    0x0FFFE ; システム・コントロール・レジスタ
    15                                  %define OPSEL   0x0FFFD ; 内蔵ペリフェラル選択レジスタ
    16                                  %define OPHA    0x0FFFC ; 内蔵ペリフェラル・リロケーション・レジスタ
    17                                  %define DULA    0x0FFFB ; 
    18                                  %define IULA    0x0FFFA ; ICUリロケーション・レジスタ
    19                                  %define TULA    0x0FFF9 ; TCUリロケーション・レジスタ
    20                                  %define SULA    0x0FFF8 ; SCUリロケーション・レジスタ 
    21                                  %define WCY4    0x0FFF6 ; プログラマブル・ウェイト・サイクル数設定レジスタ4
    22                                  %define WCY3    0x0FFF5 ; プログラマブル・ウェイト・サイクル数設定レジスタ3
    23                                  %define WCY2    0x0FFF4 ; プログラマブル・ウェイト・サイクル数設定レジスタ2
    24                                  %define WMB1    0x0FFF3 ; プログラマブル・ウェイト・メモリ領域設定レジスタ1
    25                                  %define RFC     0x0FFF2 ; リフレッシュ・コントロール・レジスタ
    26                                  %define SBCR    0x0FFF1 ; 
    27                                  %define TCKS    0x0FFF0 ; タイマー・クロック選択レジスタ
    28                                  %define WAC     0x0FFED ; プログラマブル・ウェイト・メモリ・アドレス・コントロール・レジスタ
    29                                  %define WCY0    0x0FFEC ; プログラマブル・ウェイト・サイクル数設定レジスタ0
    30                                  %define WCY1    0x0FFEB ; プログラマブル・ウェイト・サイクル数設定レジスタ1
    31                                  %define WMB0    0x0FFEA ; プログラマブル・ウェイト・メモリ領域設定レジスタ0
    32                                  %define BRC     0x0FFE9 ; ボー・レート・カウンタ
    33                                  %define BADR    0x0FFE1 ; 
    34                                  %define BSEL    0x0FFE0 ; 
    35                                  %define XAM     0x0FF80 ; 
    36                                  %define PGR     0x0FF00 ; 
    37                                  
    38                                  
    39                                  
    40                                  %ifdef SIM
    41                                      ; --- Simulation Mode ---
    42                                      org 0x100
    43                                      cpu 186
    44                                  
    45                                      %define SCU_DATA   0x3F8
    46                                      %define SCU_SST    0x3FD
    47                                      %define TX_READY    0x20                                 
    48                                      %define RX_READY    0x01
    49                                  %else
    50                                      ; --- Real Hardware Mode ---
    51                                      org 0
    52                                      cpu 186
    53                                  
    54                                      ; SCUレジスタ (SCUは1260Hに配置）
    55                                      %define SCU_DATA    0x01260 ; 送受データ・レジスタ(R:SRB/W:STB)
    56                                      %define SCU_SST     0x01261 ; ステータス・レジスタ(R:SST)
    57                                      %define SCU_SCM     0x01261 ; コマンドレジスタ(W:SCM)
    58                                      %define SCU_SMD     0x01262 ; シリアルモード設定(W:SMD)
    59                                      %define SCU_SIMK    0x01263 ; シリアル割り込みマスクレジスタ(R/W:SIMK)
    60                                      %define TX_READY    00000001b   ; TBRDY                                 
    61                                      %define RX_READY    00000010b   ; RBRDY
    62                                  
    63                                      ; --- タイマーレジスタ (TCUは1270Hに配置) ---
    64                                      %define TM0_CNT     0x01270 ; Timer 0 Counter
    65                                      %define TM1_CNT     0x01271 ; Timer 1 Counter
    66                                      %define TM2_CNT     0x01272 ; Timer 2 Counter
    67                                      %define TM_CTL      0x01273 ; Timer Control
    68                                  
    69                                      %define DIV_LOW     0x04 ; 分周比 4 (1.2288MHz -> 307.2kHz)
    70                                      %define DIV_HIGH    0x00
    71                                  
    72                                      ; V53 ICU (1280Hに配置)
    73                                      %define ICU_REG0    0x01280
    74                                      %define ICU_REG1    0x01281
    75                                      
    76                                      ;-----------------------------------------
    77                                      ; V53 VME Board ペリフェラル
    78                                      ;-----------------------------------------
    79                                      %define USART_DATA  0x00d8  ; μPD71051 (USART)	Data Register
    80                                      %define USART_CMD   0x00da  ; μPD71051 (USART)	Cmd/Status
    81                                  
    82                                      %define PIC_REG0    0x00c8  ; μPD71059 (PIC)	IRR/ISR/IW1/PCFW/MCW	
    83                                      %define PIC_REG1    0x00cA  ; μPD71059 (PIC)	IMR/IW2/IW3/IW4
    84                                  %endif
    85                                  
    86                                  section .text
    87                                  
    88                                  start:
    89                                  %ifdef SIM
    90                                      xor ax, ax
    91                                      mov es, ax
    92                                  %else
    93 00000000 FA                          cli             ; 初期化中は割り込み禁止
    94                                  
    95                                      ; --- 【重要】スタックの初期化 ---
    96                                      ; 現在のセグメント (CS=2000h) の末尾 (FFFEh) にスタックを移動させます。
    97                                      ; これでコード領域との衝突を回避します。
    98 00000001 8CC8                        mov ax, cs
    99 00000003 8ED0                        mov ss, ax
   100 00000005 BCFEFF                      mov sp, 0xFFFE
   101                                      ; ------------------------------
   102                                  
   103                                      ;==============================================
   104                                      ; ABORT (NMI) Handler Setup 
   105                                      ;==============================================
   106                                  Init_NMI:
   107                                      ; 割り込みベクタテーブル (Vector 2 = NMI) の書き換え
   108 00000008 31C0                        xor  ax, ax
   109 0000000A 8EC0                        mov  es, ax          ; ES = 0000h
   110                                      
   111 0000000C BF0800                      mov  di, 0x0008      ; Vector 2 Address offset
   112 0000000F B8[7004]                    mov  ax, NMI_Handler ; ハンドラのアドレス (IP)
   113 00000012 AB                          stosw                ; [0000:0008] = AX
   114 00000013 8CC8                        mov  ax, cs          ; 現在のCS
   115 00000015 AB                          stosw                ; [0000:000A] = CS
   116                                  
   117                                      ; Tick用割り込みベクタテーブル (Vector 27h = V53 INTP7)
   118                                      ; 0x27 * 4 = 9Ch
   119 00000016 BF9C00                      mov  di, 0x009c      ; Vector 27h Address offset
   120 00000019 B8[D104]                    mov  ax, _tick_handler ; ハンドラのアドレス (IP)
   121 0000001C AB                          stosw                ; [0000:009c] = AX
   122 0000001D 8CC8                        mov  ax, cs          ; 現在のCS
   123 0000001F AB                          stosw                ; [0000:009e] = CS
   124                                  
   125                                      ; ---------------------------------------------
   126                                      ; 1. セグメントレジスタ初期化
   127                                      ; CS=DS=ES を想定
   128                                      ; ---------------------------------------------
   129 00000020 0E                          push cs
   130 00000021 1F                          pop ds
   131 00000022 0E                          push cs
   132 00000023 07                          pop es
   133                                      ; スタックは簡易モニタのものをそのまま使う
   134                                  
   135                                      ;------------------------------------------
   136                                      ; TCUの追加設定
   137                                      ;------------------------------------------
   138                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   139                                      ;------------------------------------------
   140 00000024 BAFDFF                      mov  dx, OPSEL
   141 00000027 EC                          in   al, dx
   142 00000028 0C04                        or   al, 00000100b   ; Bit 2 (TCU) をセット
   143 0000002A EE                          out  dx, al
   144                                  
   145                                      ;------------------------------------------
   146                                      ; 2. レジスタ配置アドレスの設定 (TULA)
   147                                      ;------------------------------------------
   148 0000002B BAF9FF                      mov dx, TULA
   149 0000002E B070                        mov al, 0x70    ; 下位アドレス
   150 00000030 EE                          out dx, al
   151                                  
   152                                      ;------------------------------------------
   153                                      ; 3. TCKS: タイマクロック入力選択
   154                                      ;------------------------------------------
   155 00000031 BAF0FF                      mov  dx, TCKS
   156 00000034 B01C                        mov  al, 00011100b   ; Timer1: TCLK端子入力使用
   157 00000036 EE                          out  dx, al
   158                                  
   159                                      ;------------------------------------------
   160                                      ; 3. タイマー初期化 (Mode 3 / Square Wave)
   161                                      ;------------------------------------------
   162 00000037 BA7312                      mov  dx, TM_CTL
   163                                  
   164                                      ; --- Timer 0 Setup ---
   165 0000003A B036                        mov  al, 0x36         ; Mode 3, Binary, LSB/MSB
   166 0000003C EE                          out  dx, al
   167                                      
   168                                      ; --- Timer 1 Setup ---
   169 0000003D B076                        mov  al, 0x76         ; Mode 3, Binary, LSB/MSB
   170 0000003F EE                          out  dx, al
   171                                  
   172                                      ; --- Timer 2 Setup ---
   173 00000040 B0B6                        mov  al, 0xb6         ; Mode 3, Binary, LSB/MSB
   174 00000042 EE                          out  dx, al
   175                                  
   176                                      ;------------------------------------------
   177                                      ; 4. カウンタ値 (分周比) のロード
   178                                      ;------------------------------------------
   179                                      ; Timer 0 (INTP0) 100Hz
   180 00000043 BA7012                      mov  dx, TM0_CNT
   181 00000046 B000                        mov  al, 0
   182 00000048 EE                          out  dx, al
   183 00000049 B030                        mov  al, 0x30
   184 0000004B EE                          out  dx, al
   185                                  
   186                                      ; Timer 1 (INTP2) 100Hz
   187 0000004C BA7112                      mov  dx, TM1_CNT
   188 0000004F B000                        mov  al, 0
   189 00000051 EE                          out  dx, al
   190 00000052 B030                        mov  al, 0x30
   191 00000054 EE                          out  dx, al
   192                                  
   193                                      ; Timer 2 (USART Tx/RxCLK)
   194 00000055 BA7212                      mov  dx, TM2_CNT
   195 00000058 B004                        mov  al, DIV_LOW
   196 0000005A EE                          out  dx, al
   197 0000005B B000                        mov  al, DIV_HIGH
   198 0000005D EE                          out  dx, al
   199                                  
   200                                      ;------------------------------------------
   201                                      ; μPD71051 (USART) 初期化
   202                                      ;------------------------------------------
   203 0000005E B000                        mov al, 0
   204 00000060 E6DA                        out USART_CMD, al
   205                                   
   206 00000062 F7E1                        mul cx              ; wait
   207 00000064 F7E1                        mul cx              ; wait
   208 00000066 E6DA                        out USART_CMD, al
   209                                   
   210 00000068 F7E1                        mul cx              ; wait
   211 0000006A F7E1                        mul cx              ; wait
   212 0000006C E6DA                        out USART_CMD, al
   213                                   
   214 0000006E F7E1                        mul cx              ; wait
   215 00000070 F7E1                        mul cx              ; wait
   216 00000072 B040                        mov al, 0x40        ; reset
   217 00000074 E6DA                        out USART_CMD, al
   218                                   
   219 00000076 F7E1                        mul cx              ; wait
   220 00000078 F7E1                        mul cx              ; wait
   221 0000007A B04E                        mov al, 0x4e        ; set mode
   222 0000007C E6DA                        out USART_CMD, al
   223                                   
   224 0000007E F7E1                        mul cx              ; wait
   225 00000080 F7E1                        mul cx              ; wait
   226 00000082 B037                        mov al, 0x37        ; rx,tx ready
   227 00000084 E6DA                        out USART_CMD, al
   228                                  
   229                                      ;------------------------------------------
   230                                      ; μPD71059 (PIC) 初期化
   231                                      ;------------------------------------------
   232 00000086 B013                        mov al, 13h         ; ICW1: Edge, Single, ICW4 needed
   233 00000088 E6C8                        out PIC_REG0, al
   234                                  
   235 0000008A B020                        mov al, 20h         ; ICW2: Vector Offset = 20h (INT 32)
   236 0000008C E6CA                        out PIC_REG1, al
   237                                                          ; ICW3 is skipped in Single Mode
   238 0000008E B001                        mov al, 01h         ; ICW4: 8086 Mode, Normal EOI
   239 00000090 E6CA                        out PIC_REG1, al
   240                                  
   241 00000092 B0FE                        mov al, 0FEh        ; OCW1: Unmask IR0 (Timer) only. (1111 1110)
   242 00000094 E6CA                        out PIC_REG1, al
   243                                  
   244                                      ;------------------------------------------
   245                                      ; ICUの追加設定
   246                                      ;------------------------------------------
   247                                      ; 1. 内蔵周辺機能の有効化 (OPSEL)
   248                                      ;------------------------------------------
   249 00000096 BAFDFF                      mov  dx, OPSEL
   250 00000099 EC                          in   al, dx
   251 0000009A 0C02                        or   al, 00000010b   ; Bit 1 (ICU) をセット
   252 0000009C EE                          out  dx, al
   253                                  
   254                                      ;------------------------------------------
   255                                      ; 2. レジスタ配置アドレスの設定 (IULA)
   256                                      ;------------------------------------------
   257 0000009D BAFAFF                      mov dx, IULA
   258 000000A0 B080                        mov al, 0x80    ; 下位アドレス
   259 000000A2 EE                          out dx, al
   260                                  
   261                                      ;------------------------------------------
   262                                      ; 3. 割り込みマスクの設定 (Enable INTP7)
   263                                      ;------------------------------------------
   264 000000A3 BA8012                      mov dx, ICU_REG0
   265 000000A6 B013                        mov al, 13h     ; ICW1: Edge, Single, ICW4 needed
   266 000000A8 EE                          out dx, al
   267                                  
   268 000000A9 BA8112                      mov dx, ICU_REG1
   269 000000AC B020                        mov al, 20h     ; ICW2: Vector Offset = 20h (INT 32)
   270 000000AE EE                          out dx, al
   271                                                      ; ICW3 is skipped in Single Mode
   272 000000AF B001                        mov al, 01h     ; ICW4: 8086 Mode, Normal EOI
   273 000000B1 EE                          out dx, al
   274                                  
   275                                      ; Bit 7 (INTP7) を 0 (許可) にします。
   276 000000B2 EC                          in  al, dx
   277 000000B3 247F                        and al, 7Fh     ; 0111 1111 (Bit 7をクリア)
   278 000000B5 EE                          out dx, al
   279                                  
   280                                      ;-------------------------------------------
   281                                      ; 割り込み許可
   282                                      ;-------------------------------------------
   283 000000B6 FB                          sti
   284                                  
   285                                   %endif
   286                                  
   287                                      ; 変数初期化 (RAMエリアをクリア)
   288 000000B7 C706[5606]0000              mov word [dump_seg], 0x0000
   289 000000BD C706[5806]0000              mov word [dump_off], 0x0000
   290 000000C3 C706[5A06]0020              mov word [load_seg], 0x2000
   291                                  
   292                                      ; スタートメッセージの表示
   293 000000C9 BE[EC04]                    mov si, msg_boot
   294 000000CC E8E702                      call puts
   295                                  
   296                                  ; =================================================================
   297                                  ; Main Loop
   298                                  ; =================================================================
   299                                  monitor_loop:
   300 000000CF B03E                        mov al, '>'
   301 000000D1 E8F002                      call putc
   302 000000D4 B020                        mov al, ' '
   303 000000D6 E8EB02                      call putc
   304                                  
   305 000000D9 E80A03                      call getc_echo  ; コマンド受信（エコーあり）
   306 000000DC 88C3                        mov bl, al
   307                                      
   308 000000DE 80FB64                      cmp bl, 'd'     ; dump command
   309 000000E1 747A                        je do_dump
   310 000000E3 80FB44                      cmp bl, 'D'
   311 000000E6 7475                        je do_dump
   312                                      
   313 000000E8 80FB6C                      cmp bl, 'l'     ; load command
   314 000000EB 7503E9D000                  je do_load
   315 000000F0 80FB4C                      cmp bl, 'L'
   316 000000F3 7503E9C800                  je do_load
   317                                      
   318 000000F8 80FB67                      cmp bl, 'g'     ; go command
   319 000000FB 7503E93B01                  je do_go
   320 00000100 80FB47                      cmp bl, 'G'
   321 00000103 7503E93301                  je do_go
   322                                  
   323 00000108 80FB77                      cmp bl, 'w'     ; Write command
   324 0000010B 7503E95701                  je do_write
   325 00000110 80FB57                      cmp bl, 'W'
   326 00000113 7503E94F01                  je do_write
   327                                  
   328 00000118 3C69                        cmp al, 'i'     ; Input Port command
   329 0000011A 7503E98B01                  je do_in
   330 0000011F 3C49                        cmp al, 'I'
   331 00000121 7503E98401                  je do_in
   332                                  
   333 00000126 3C6F                        cmp al, 'o'     ; Output Port command
   334 00000128 7503E9A101                  je do_out
   335 0000012D 3C4F                        cmp al, 'O'
   336 0000012F 7503E99A01                  je do_out
   337                                  
   338 00000134 3C73                        cmp al, 's'     ; Scan I/O command
   339 00000136 7503E9BA01                  je do_scan
   340 0000013B 3C53                        cmp al, 'S'
   341 0000013D 7503E9B301                  je do_scan
   342                                  
   343 00000142 3C74                        cmp al, 't'     ; Scan Timer wait command
   344 00000144 7503E91E02                  je do_timer
   345 00000149 3C54                        cmp al, 'T'
   346 0000014B 7503E91702                  je do_timer
   347                                  
   348 00000150 3C3F                        cmp al, '?'     ; Help
   349 00000152 7503E95302                  je cmd_help
   350                                  
   351                                      ; 知らないコマンドなら改行して戻る
   352 00000157 E89502                      call putc_crlf
   353 0000015A E972FF                      jmp monitor_loop
   354                                  
   355                                  ; =================================================================
   356                                  ; Command: Dump Memory
   357                                  ; Usage:
   358                                  ;   D               -> Dump next 64 bytes
   359                                  ;   D <Seg> <Off>   -> Set address and dump (e.g., D 0000 8000)
   360                                  ; =================================================================
   361                                  do_dump:
   362 0000015D E88602                      call getc_echo      ; 区切り文字受信 (Space or Enter)
   363 00000160 3C0D                        cmp al, 0x0D        ; Enterならすぐ実行
   364 00000162 7418                        je .dump_run
   365 00000164 3C20                        cmp al, ' '         ; Spaceなら引数解析
   366 00000166 7405                        je .parse_args
   367                                      
   368                                      ; それ以外なら無視して実行へ（またはエラー処理）
   369 00000168 E88402                      call putc_crlf
   370 0000016B EB12                        jmp .dump_run_start
   371                                  
   372                                  .parse_args:
   373 0000016D E8AD02                      call get_hex_word
   374 00000170 A3[5606]                    mov [dump_seg], ax
   375 00000173 E8ED02                      call skip_space
   376 00000176 E8A402                      call get_hex_word
   377 00000179 A3[5806]                    mov [dump_off], ax
   378                                      ; ここでEnter待ちをするか、そのまま実行するか
   379                                      ; 今回はパラメータ入力後にEnterを押したと仮定して改行
   380                                      
   381                                  .dump_run:
   382 0000017C E87002                      call putc_crlf              ; 実行直前に改行
   383                                  
   384                                  .dump_run_start:
   385 0000017F B90400                      mov cx, 4                   ; 4行表示する
   386                                      
   387                                  .line_loop:
   388 00000182 51                          push cx
   389                                      
   390 00000183 A1[5606]                    mov ax, [dump_seg]          ; セグメントの表示
   391 00000186 E86F02                      call print_hex_word
   392 00000189 B03A                        mov al, ':'                 ; 区切り文字の:を表示
   393 0000018B E83602                      call putc
   394 0000018E A1[5806]                    mov ax, [dump_off]          ; オフセットの表示
   395 00000191 E86402                      call print_hex_word
   396 00000194 B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   397 00000196 E82B02                      call putc
   398                                  
   399 00000199 8B36[5806]                  mov si, [dump_off]          ; DS変更前に、モニタ変数からオフセットをSIにロード
   400                                  
   401 0000019D 1E                          push ds                     ; モニタのDSを保存
   402 0000019E 8E1E[5606]                  mov ds, [dump_seg]          ; DSをターゲットセグメントに変更
   403                                      
   404 000001A2 B91000                      mov cx, 16                  ; 16回繰り返すカウンタ
   405                                  .hex_loop:
   406 000001A5 8A04                        mov al, [si]
   407 000001A7 E85502                      call print_hex_byte         ; メモリ内容の表示
   408 000001AA B020                        mov al, ' '                 ; 区切り文字のスペースを表示
   409 000001AC E81502                      call putc
   410 000001AF 46                          inc si                      ; 次のアドレスにする
   411 000001B0 E2F3                        loop .hex_loop              ; 16回繰り返し    
   412                                  
   413 000001B2 1F                          pop ds                      ; DSをモニタ用に戻す
   414                                  
   415 000001B3 8936[5806]                  mov [dump_off], si          ; DS復帰後に、SIの値をモニタ変数に保存
   416                                  
   417 000001B7 E83502                      call putc_crlf              ; 改行する
   418 000001BA 59                          pop cx
   419 000001BB E2C5                        loop .line_loop             ; 4回繰り返す
   420                                      
   421 000001BD E90FFF                      jmp monitor_loop            ; モニタのメインルーチンに飛ぶ
   422                                  
   423                                  ; =================================================================
   424                                  ; Command: Load Intel HEX
   425                                  ; Usage:
   426                                  ;   L           -> Load to default segment (load_seg)
   427                                  ;   L <Seg>     -> Set segment and Load (e.g., L 2000)
   428                                  ; =================================================================
   429                                  do_load:
   430                                      ; 一時的に ES をロード先にするため、デフォルト値をAXへ退避
   431 000001C0 A1[5A06]                    mov ax, [load_seg]
   432 000001C3 06                          push es             ; RAM用ESを保存
   433 000001C4 50                          push ax             ; デフォルトセグメントを保存
   434                                      
   435 000001C5 E81E02                      call getc_echo
   436 000001C8 3C20                        cmp al, ' '         ; スペースがあればパラメタ付きと判断
   437 000001CA 7402                        je .parse_seg
   438 000001CC EB05                        jmp .start_load
   439                                  
   440                                  .parse_seg:
   441 000001CE 58                          pop ax              ; 不要になったデフォルトを捨てる
   442 000001CF E84B02                      call get_hex_word   ; 新しいセグメント取得
   443 000001D2 50                          push ax             ; 保存
   444                                  
   445                                  .start_load:
   446 000001D3 E81902                      call putc_crlf      ; メッセージ表示前に改行
   447 000001D6 BE[1805]                    mov si, msg_load    ; ロード開始メッセージを表示
   448 000001D9 E8DA01                      call puts
   449                                      
   450 000001DC 58                          pop ax
   451 000001DD 8EC0                        mov es, ax          ; ロード先をESに設定
   452                                      
   453                                      ; ターゲット表示
   454 000001DF E81602                      call print_hex_word ; ESの値を表示
   455 000001E2 B03A                        mov al, ':'         ; 区切り文字を表示
   456 000001E4 E8DD01                      call putc
   457 000001E7 B030                        mov al, '0'         ; 本来は0000だが、0と簡易表示
   458 000001E9 E8D801                      call putc
   459 000001EC E80002                      call putc_crlf
   460                                  
   461                                  .wait_record:
   462 000001EF E8E501                      call getc           ; 開始文字を待つ
   463 000001F2 3C3A                        cmp al, ':'
   464 000001F4 75F9                        jne .wait_record
   465                                  
   466 000001F6 E84902                      call get_hex_byte   ; データ長を読み込み
   467 000001F9 88C1                        mov cl, al          ; データ長をcxレジスタに設定
   468 000001FB B500                        mov ch, 0
   469                                      
   470 000001FD E84202                      call get_hex_byte   ; 上位アドレスを読み込み
   471 00000200 88C7                        mov bh, al
   472 00000202 E83D02                      call get_hex_byte   ; 下位アドレスを読み込み
   473 00000205 88C3                        mov bl, al
   474                                      
   475 00000207 E83802                      call get_hex_byte   ; レコードタイプを読み込み
   476 0000020A 3C01                        cmp al, 01          ; End of File?
   477 0000020C 7419                        je .handle_eof      ; EOFの処理へ
   478 0000020E 3C00                        cmp al, 00          ; Data Record?
   479 00000210 751A                        jne .skip_line      ; その他はスキップ
   480                                      
   481 00000212 E309                        jcxz .read_chk      ; データ長がゼロならチェックサム読み込み処理
   482                                      
   483                                  .data_loop:
   484 00000214 E82B02                      call get_hex_byte   ; 1バイト読み取り
   485 00000217 268807                      mov [es:bx], al     ; ターゲット(ES)へ書き込み
   486 0000021A 43                          inc bx              ; 次のアドレスにする
   487 0000021B E2F7                        loop .data_loop     ; データ長分繰り返す
   488                                      
   489                                  .read_chk:
