   660 0000033A 50                          push ax             ; ターゲットセグメントを保存
   661                                      
   662 0000033B E87101                      call getc_echo      ; Space?
   663 0000033E 3C20                        cmp al, ' '
   664 00000340 7403E9EB01                  jne error           ; 引数なしならリターン(またはエラー)
