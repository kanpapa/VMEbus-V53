   896                                  ; =================================================================
   897                                  ; Utilities
   898                                  ; =================================================================
   899                                  
   900                                  ; 文字列出力
   901                                  puts:
   902 00000414 2E8A04                      mov al, [cs:si]
   903 00000417 08C0                        or al, al
   904 00000419 7406                        jz .ret
   905 0000041B E80400                      call putc
   906 0000041E 46                          inc si
   907 0000041F EBF3                        jmp puts
   908 00000421 C3                      .ret: ret
   909                                  
   910                                  ; 1文字出力
   911                                  putc:
   912 00000422 52                          push dx
   913 00000423 50                          push ax
   914 00000424 BA6120                      mov dx, SCU_SST
   915 00000427 EC                      .w: in al, dx
   916 00000428 A801                        test al, TX_READY  ; TX Ready?
   917 0000042A 74FB                        jz .w
   918 0000042C BA6020                      mov dx, SCU_DATA
   919 0000042F 58                          pop ax
   920 00000430 50                          push ax
   921 00000431 EE                          out dx, al
   922 00000432 58                          pop ax
   923 00000433 5A                          pop dx
   924 00000434 C3                          ret
   925                                  
   926                                  ; 1文字入力
   927                                  getc:
   928 00000435 52                          push dx
   929 00000436 BA6120                      mov dx, SCU_SST
   930 00000439 EC                      .w: in al, dx
   931 0000043A A802                        test al, RX_READY  ; RX Ready?
   932 0000043C 74FB                        jz .w
   933 0000043E BA6020                      mov dx, SCU_DATA
   934 00000441 EC                          in al, dx
   935 00000442 5A                          pop dx
   936 00000443 C3                          ret
   937                                  
   938                                  ; 1文字入力　エコーバックあり
   939                                  getc_echo:
   940 00000444 E8EEFF                      call getc
   941 00000447 50                          push ax
   942 00000448 E8D7FF                      call putc
   943 0000044B 58                          pop ax
   944 0000044C C3                          ret
   945                                  
   946                                  ; 改行出力
   947                                  putc_crlf:
   948 0000044D B00D                        mov al, 0x0D
   949 0000044F E8D0FF                      call putc
   950 00000452 B00A                        mov al, 0x0A
   951 00000454 EBCC                        jmp putc
   952                                  
   953                                  ; -----------------------------------------------------------------
   954                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   955                                  ; Input: AX
   956                                  ; -----------------------------------------------------------------
   957                                  print_hex_word:
   958 00000456 50                          push ax
   959 00000457 88E0                        mov al, ah
   960 00000459 E80100                      call print_hex_byte
   961 0000045C 58                          pop ax
   962                                  
   963                                  ; -----------------------------------------------------------------
   964                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   965                                  ; Input: AL
   966                                  ; -----------------------------------------------------------------
   967                                  print_hex_byte:
   968 0000045D 50                          push ax
   969 0000045E 51                          push cx
   970                                  
   971                                      ; 上位バイトの表示
   972 0000045F 50                          push ax
   973 00000460 C0E804                      shr al, 4
   974 00000463 E80900                      call .digit
   975                                  
   976                                      ; 下位バイトの表示
   977 00000466 58                          pop ax
   978 00000467 240F                        and al, 0x0F
   979 00000469 E80300                      call .digit
   980                                  
   981 0000046C 59                          pop cx
   982 0000046D 58                          pop ax
   983 0000046E C3                          ret
   984                                  
   985                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   986                                  .digit:
   987 0000046F 0430                        add al, '0'
   988 00000471 3C39                        cmp al, '9'
   989 00000473 7602                        jbe .p
   990 00000475 0407                        add al, 7
   991 00000477 E8A8FF                  .p: call putc
   992 0000047A C3                          ret
   993                                  
   994                                  ; -----------------------------------------------------------------
   995                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   996                                  ; Input:  Serial (例: "1", "0", "0", "0")
   997                                  ; Output: AX = 0x1000
   998                                  ; -----------------------------------------------------------------
   999                                  get_hex_word:
  1000 0000047B 53                          push bx
  1001 0000047C E80B00                      call get_hex_byte_echo
  1002 0000047F 88C7                        mov bh, al
  1003 00000481 E80600                      call get_hex_byte_echo
  1004 00000484 88C3                        mov bl, al
  1005 00000486 89D8                        mov ax, bx
  1006 00000488 5B                          pop bx
  1007 00000489 C3                          ret
  1008                                  
  1009                                  ; 16進数2桁入力　エコーバック有り
  1010                                  get_hex_byte_echo:
  1011 0000048A 53                          push bx
  1012 0000048B E8B6FF                      call getc_echo
  1013 0000048E E82500                      call hex_char_to_bin
  1014 00000491 C0E004                      shl al, 4
  1015 00000494 88C3                        mov bl, al
  1016 00000496 E8ABFF                      call getc_echo
  1017 00000499 E81A00                      call hex_char_to_bin
  1018 0000049C 08D8                        or al, bl
  1019 0000049E 5B                          pop bx
  1020 0000049F C3                          ret
  1021                                  
  1022                                  ; -----------------------------------------------------------------
  1023                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
  1024                                  ; Input:  Serial (例: "3", "F")
  1025                                  ; Output: AL = 0x3F
  1026                                  ; -----------------------------------------------------------------
  1027                                  get_hex_byte:
  1028 000004A0 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
  1029                                  
  1030                                      ; 上位4bit
  1031 000004A1 E891FF                      call getc
  1032 000004A4 E80F00                      call hex_char_to_bin
  1033 000004A7 C0E004                      shl al, 4
  1034 000004AA 88C3                        mov bl, al          ; 一時保存
  1035                                      
  1036                                      ; 下位4bit
  1037 000004AC E886FF                      call getc
  1038 000004AF E80400                      call hex_char_to_bin
  1039 000004B2 08D8                        or al, bl           ; 上位を合成して結果はALへ
  1040 000004B4 5B                          pop bx
  1041 000004B5 C3                          ret
  1042                                  
  1043                                  ; -----------------------------------------------------------------
  1044                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
  1045                                  ; Input: AL (ASCII)
  1046                                  ; Output: AL (Binary)
  1047                                  ; -----------------------------------------------------------------
  1048                                  hex_char_to_bin:
  1049 000004B6 2C30                        sub al, '0'
  1050 000004B8 3C09                        cmp al, 9
  1051 000004BA 7604                        jbe .done
  1052 000004BC 2C07                        sub al, 7           ; 'A'-'F'対応
  1053 000004BE 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
  1054                                  .done:
  1055 000004C0 C3                          ret
  1056                                  
  1057                                  ; -----------------------------------------------------------------
  1058                                  ; Helper: スペースなどを読み飛ばす
  1059                                  ; -----------------------------------------------------------------
  1060                                  skip_space:
  1061 000004C1 E880FF                      call getc_echo
  1062 000004C4 C3                          ret
  1063                                  
  1064                                  ; -----------------------------------------------------------------
  1065                                  ; Helper: エラーメッセージ出力後モニタに戻る
  1066                                  ; -----------------------------------------------------------------
  1067                                  error:
  1068 000004C5 BE[4806]                    mov si, msg_error
  1069 000004C8 E849FF                      call puts
  1070 000004CB E95FFC                      jmp monitor_loop
  1071                                  
  1072                                  ;==========================================================
  1073                                  ; NMI (ABORT) Handler
  1074                                  ;==========================================================
  1075                                  
  1076                                  NMI_Handler:
  1077                                      ; 1. 全レジスタを退避 (V53は80186互換なのでPUSHAが使えます)
  1078 000004CE 60                          pusha               ; DI, SI, BP, SP, BX, DX, CX, AX の順でPush
  1079 000004CF 1E                          push ds
  1080 000004D0 06                          push es
  1081                                  
  1082                                      ; 2. セグメントをモニタ用に設定 (表示ルーチンを使うため)
  1083 000004D1 8CC8                        mov  ax, cs
  1084 000004D3 8ED8                        mov  ds, ax
  1085 000004D5 8EC0                        mov  es, ax
  1086                                  
  1087                                      ; 3. スタックフレームへのポインタ設定
  1088 000004D7 89E5                        mov  bp, sp
  1089                                  
  1090                                      ; --- 画面表示 ---
  1091 000004D9 BE[3307]                    mov  si, msg_nmi
  1092 000004DC E835FF                      call puts           ; " *** ABORT INTERRUPT ***"
  1093                                  
  1094                                      ; 3. レジスタ表示 (スタックから読み出して表示)
  1095                                      ; Stack Layout after pushes:
  1096                                      ; BP+0: ES
  1097                                      ; BP+2: DS
  1098                                      ; BP+4: DI
  1099                                      ; BP+6: SI
  1100                                      ; BP+8: BP (Old)
  1101                                      ; BP+10: SP (Original)
  1102                                      ; BP+12: BX
  1103                                      ; BP+14: DX
  1104                                      ; BP+16: CX
  1105                                      ; BP+18: AX
  1106                                      ; BP+20: IP (Return Addr)
  1107                                      ; BP+22: CS (Return Addr)
  1108                                      ; BP+24: Flags
  1109                                      
  1110                                      ; AX
  1111 000004DF BE[4B07]                    mov  si, msg_ax
  1112 000004E2 E82FFF                      call puts
  1113 000004E5 8B4612                      mov  ax, [bp+18]        ; PUSHAで保存されたAX
  1114 000004E8 E86BFF                      call print_hex_word     ; 4桁HEX表示ルーチン
  1115                                  
  1116                                      ; BX
  1117 000004EB BE[5007]                    mov  si, msg_bx
  1118 000004EE E823FF                      call puts
  1119 000004F1 8B460C                      mov  ax, [bp+12]
  1120 000004F4 E85FFF                      call print_hex_word
  1121                                  
  1122                                      ; CX
  1123 000004F7 BE[5507]                    mov  si, msg_cx
  1124 000004FA E817FF                      call puts
  1125 000004FD 8B4610                      mov  ax, [bp+16]
  1126 00000500 E853FF                      call print_hex_word
  1127                                  
  1128                                      ; DX
  1129 00000503 BE[5A07]                    mov  si, msg_dx
  1130 00000506 E80BFF                      call puts
  1131 00000509 8B460E                      mov  ax, [bp+14]
  1132 0000050C E847FF                      call print_hex_word
  1133                                  
  1134 0000050F E83BFF                      call putc_crlf
  1135                                  
  1136                                      ; --- 中断地点 (CS:IP) の表示 ---
  1137                                      ; PUSHA(16byte) + DS(2) + ES(2) = 20byte
  1138                                      ; その上が割り込み発生時の IP, CS, Flags です
  1139                                      
  1140 00000512 BE[5F07]                    mov  si, msg_addr
  1141 00000515 E8FCFE                      call puts           ; " Stop at "
  1142 00000518 8B4616                      mov  ax, [bp+22]    ; Stack上の CS
  1143 0000051B E838FF                      call print_hex_word
  1144 0000051E B03A                        mov  al, ':'
  1145 00000520 E8FFFE                      call putc
  1146 00000523 8B4614                      mov  ax, [bp+20]    ; Stack上の IP
  1147 00000526 E82DFF                      call print_hex_word
  1148                                  
  1149 00000529 E821FF                      call putc_crlf
  1150                                  
  1151                                      ; 4. 復帰処理
  1152                                      ; ここでモニタのコマンド待ちへ強制ジャンプします
  1153                                      ; (レジスタはスタックに残ったままになりますが、モニタ再起動でリセットされる前提)
  1154 0000052C E9D1FA                      jmp  start  ; モニタの開始ラベルへ
  1155                                  
  1156                                  ; ==========================================================
  1157                                  ; Default Interrupt Handler (Trap for unused interrupts)
  1158                                  ; ==========================================================
  1159                                  
  1160                                  ; --- 共通処理部 (Common Handler) ---
  1161                                  _default_int_handler:
  1162 0000052F 55                          push bp
  1163 00000530 89E5                        mov  bp, sp
  1164 00000532 60                          pusha               ; 全レジスタ保存 (AX,CX,DX,BX,SP,BP,SI,DI)
  1165 00000533 1E                          push ds
  1166 00000534 06                          push es
  1167                                  
  1168                                      ; セグメント設定 (Tiny Model的な動作のためCSをDS/ESにコピー)
  1169 00000535 8CC8                        mov  ax, cs
  1170 00000537 8ED8                        mov  ds, ax
  1171 00000539 8EC0                        mov  es, ax
  1172                                  
  1173                                      ; --- メッセージ表示 ---
  1174 0000053B BE[7107]                    mov  si, msg_int_trap
  1175 0000053E E8D3FE                      call puts           ; "** INT "
  1176                                  
  1177                                      ; --- ベクタ番号の表示 ---
  1178                                      ; スタック構造:
  1179                                      ; [BP+0] Old BP
  1180                                      ; [BP+2] Vector Number (スタブでPUSHした値: 16bit)
  1181                                      ; [BP+4] Return IP ...
  1182                                      
  1183 00000541 8B4602                      mov  ax, [bp+2]     ; ベクタ番号を取得
  1184 00000544 E816FF                      call print_hex_byte ; 表示 (例: 25)
  1185                                  
  1186 00000547 BE[7907]                    mov  si, msg_detected
  1187 0000054A E8C7FE                      call puts           ; " detected **" (改行含む)
  1188                                  
  1189                                      ; --- EOI (End of Interrupt) to PIC, ICU ---
  1190 0000054D B020                        mov al, 20h         ; Non-specific EOI
  1191 0000054F E6C8                        out PIC_REG0, al    ; 外部PIC (Slave) の割り込み完了
  1192 00000551 BA8020                      mov dx, ICU_REG0    ; V53内蔵ICU (Master) の割り込み完了
  1193 00000554 EE                          out dx, al
  1194                                  
  1195 00000555 07                          pop  es
  1196 00000556 1F                          pop  ds
  1197 00000557 61                          popa
  1198 00000558 5D                          pop  bp
  1199 00000559 83C402                      add  sp, 2          ; スタブでPUSHしたベクタ番号分(2byte)をスタックから捨てる
  1200 0000055C CF                          iret
  1201                                  
  1202                                  ; --- 各ベクタ用スタブ (Entry Points) ---
  1203                                  ; ベクタ番号をスタックに積んで共通処理へジャンプします
  1204                                  
  1205 0000055D 6A20                    _isr_stub_20: push 0x0020       ; ICU INTP0
  1206 0000055F EBCE                                  jmp _default_int_handler
  1207 00000561 6A21                    _isr_stub_21: push 0x0021       ; ICU INTP1
  1208 00000563 EBCA                                  jmp _default_int_handler
  1209 00000565 6A22                    _isr_stub_22: push 0x0022       ; ICU INTP2
  1210 00000567 EBC6                                  jmp _default_int_handler
  1211 00000569 6A23                    _isr_stub_23: push 0x0023       ; ICU INTP3
  1212 0000056B EBC2                                  jmp _default_int_handler
  1213 0000056D 6A24                    _isr_stub_24: push 0x0024       ; ICU INTP4
  1214 0000056F EBBE                                  jmp _default_int_handler
  1215 00000571 6A25                    _isr_stub_25: push 0x0025       ; ICU INTP5
  1216 00000573 EBBA                                  jmp _default_int_handler
  1217 00000575 6A26                    _isr_stub_26: push 0x0026       ; ICU INTP6
  1218 00000577 EBB6                                  jmp _default_int_handler
  1219                                  
  1220                                  ; Note: Vector 27h (INTP7) は _pic_dispatch_handler で使用中なのでここには含めません
  1221                                  
  1222                                  ; ==========================================================
  1223                                  ; PIC Dispatch Handler (Vector 27h)
  1224                                  ; Handles: Timer, Serial, SCSI, PPI via PIC uPD71059
  1225                                  ; ==========================================================
  1226                                  _pic_dispatch_handler:
  1227 00000579 60                          pusha
  1228 0000057A 1E                          push ds
  1229 0000057B 06                          push es
  1230                                  
  1231                                      ; DS設定 (Tiny Model)
  1232 0000057C 8CC8                        mov ax, cs
  1233 0000057E 8ED8                        mov ds, ax
  1234                                  
  1235                                      ; --- 1. PICのISR (In-Service Register) を読む ---
  1236                                      ; OCW3: 0000_1011 (0x0B) -> RR=1, RIS=1 (Read ISR)
  1237 00000580 B00B                        mov al, 0x0B
  1238 00000582 E6C8                        out PIC_REG0, al
  1239 00000584 E4C8                        in  al, PIC_REG0    ; AL = 現在処理中の割り込みビット (ISR)
  1240                                  
  1241                                      ; --- 2. 要因判定と分岐 ---
  1242                                      
  1243 00000586 A801                        test al, 01h        ; Bit 0: Timer 0 (System Tick)
  1244 00000588 751E                        jnz .handle_timer0
  1245                                  
  1246 0000058A A802                        test al, 02h        ; Bit 1: SCSI
  1247 0000058C 7526                        jnz .handle_scsi
  1248                                  
  1249 0000058E A804                        test al, 04h        ; Bit 2: Timer 1
  1250 00000590 752A                        jnz .handle_timer1
  1251                                  
  1252 00000592 A808                        test al, 08h        ; Bit 3: USART Rx
  1253 00000594 752E                        jnz .handle_usart_rx
  1254                                  
  1255 00000596 A810                        test al, 10h        ; Bit 4: USART Tx
  1256 00000598 7532                        jnz .handle_usart_tx
  1257                                  
  1258 0000059A A820                        test al, 20h        ; Bit 5: SCU Rx
  1259 0000059C 7536                        jnz .handle_scu_rx
  1260                                  
  1261 0000059E A840                        test al, 40h        ; Bit 6: SCU Tx
  1262 000005A0 753A                        jnz .handle_scu_tx
  1263                                  
  1264 000005A2 A880                        test al, 80h        ; Bit 7: PPI
  1265 000005A4 753E                        jnz .handle_ppi
  1266                                  
  1267                                      ; 該当なしの場合は無視
  1268 000005A6 EB44                        jmp .eoi_exit
  1269                                  
  1270                                  ; --- 各ハンドラ処理 ---
  1271                                  
  1272                                  .handle_timer0:
  1273                                      ; INTP0: Timer 0 (Tick)
  1274                                      ; --- 32bit カウンタのインクリメント ---
  1275 000005A8 FF06[5808]                  inc word [tick_counter_lo]
  1276 000005AC 7504                        jnz .skip_carry
  1277 000005AE FF06[5A08]                  inc word [tick_counter_hi]
  1278                                  .skip_carry:
  1279 000005B2 EB38                        jmp .eoi_exit
  1280                                  
  1281                                  .handle_scsi:
  1282                                      ; INTP1: SCSIC
  1283 000005B4 BE[8607]                    mov si, msg_int_scsi
  1284 000005B7 E85AFE                      call puts
  1285 000005BA EB30                        jmp .eoi_exit
  1286                                  
  1287                                  .handle_timer1:
  1288                                      ; INTP2: ユーザ用タイマー
  1289 000005BC BE[9D07]                    mov si, msg_int_timer1
  1290 000005BF E852FE                      call puts
  1291 000005C2 EB28                        jmp .eoi_exit
  1292                                  
  1293                                  .handle_usart_rx:
  1294                                      ; INTP3: USART受信準備完了割り込み
  1295 000005C4 BE[B607]                    mov si, msg_int_usart_rx
  1296 000005C7 E84AFE                      call puts
  1297 000005CA EB20                        jmp .eoi_exit
  1298                                  
  1299                                  .handle_usart_tx:
  1300                                      ; INTP4: USART送信完了割り込み
  1301 000005CC BE[D107]                    mov si, msg_int_usart_tx
  1302 000005CF E842FE                      call puts
  1303 000005D2 EB18                        jmp .eoi_exit
  1304                                  
  1305                                  .handle_scu_rx:
  1306                                      ; INTP5: SCU受信準備完了割り込み
  1307 000005D4 BE[EC07]                    mov si, msg_int_scu_rx
  1308 000005D7 E83AFE                      call puts
  1309 000005DA EB10                        jmp .eoi_exit
  1310                                  
  1311                                  .handle_scu_tx:
  1312                                      ; INTP6: SCU送信完了割り込み
  1313 000005DC BE[0508]                    mov si, msg_int_scu_tx
  1314 000005DF E832FE                      call puts
  1315 000005E2 EB08                        jmp .eoi_exit
  1316                                  
  1317                                  .handle_ppi:
  1318                                      ; INTP7: PPI割り込み
  1319 000005E4 BE[1E08]                    mov si, msg_int_ppi
  1320 000005E7 E82AFE                      call puts
  1321 000005EA EB00                        jmp .eoi_exit
  1322                                  
  1323                                  ; --- 終了処理 ---
  1324                                  .eoi_exit:
  1325                                      ; --- EOI (End of Interrupt) to PIC ---
  1326 000005EC B020                        mov al, 20h     ; Non-specific EOI
  1327                                  
  1328                                      ; 外部PIC (Slave) の割り込み完了
  1329 000005EE E6C8                        out PIC_REG0, al
  1330                                  
  1331                                      ; V53内蔵ICU (Master) の割り込み完了
  1332 000005F0 BA8020                      mov dx, ICU_REG0 
  1333 000005F3 EE                          out dx, al
  1334                                  
  1335 000005F4 07                          pop es
  1336 000005F5 1F                          pop ds
  1337 000005F6 61                          popa
  1338 000005F7 CF                          iret
  1339                                  
  1340                                  ;--------------------------------------
  1341                                  ; 未定義割り込みベクタ用の簡易トラップ
  1342                                  ;--------------------------------------
  1343                                  _default_int_unknown_handler:
  1344                                      ; 想定外の割り込みが発生したため、
  1345                                      ; 画面に "UNKNOWN INT" と出して停止する
  1346                                      
  1347 000005F8 FA                          cli                 ; 多重割り込み禁止
  1348 000005F9 60                          pusha
  1349 000005FA 1E                          push ds
  1350 000005FB 0E                          push cs
  1351 000005FC 1F                          pop ds              ; DS = CS
  1352                                  
  1353 000005FD BE[3408]                    mov si, msg_unknown_int
  1354 00000600 E811FE                      call puts
  1355                                      
  1356                                      ; 停止（暴走を防ぐ）
  1357                                  .halt:
  1358 00000603 F4                          hlt
  1359 00000604 EBFD                        jmp .halt
  1360                                  
