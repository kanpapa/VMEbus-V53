   664                                  
   665                                      ; 1. セグメント (SSSS) を取得
   666 000002CF E8A901                      call get_hex_word   ; AX = Segment
   667 000002D2 50                          push ax             ; ターゲットセグメントを保存
   668                                      
   669 000002D3 E86E01                      call getc_echo      ; Space?
