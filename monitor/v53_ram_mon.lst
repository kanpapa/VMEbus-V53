   646                                  ; =================================================================
   647                                  ; Command: Execute
   648                                  ; Usage:
   649                                  ;   G <Seg> <Off>
   650                                  ; Example: G 1000 0000
   651                                  ; =================================================================
   652                                  do_go:
   653                                      ; Gコマンドは入力後に改行
   654                                      
   655 000002E5 E8A801                      call getc_echo      ; Space?
   656 000002E8 3C20                        cmp al, ' '
   657 000002EA 751F                        jne .go_default     ; 引数なしならリターン(またはエラー)
   658                                      
   659                                      ; 1. セグメント (SSSS) を取得
   660 000002EC E8D801                      call get_hex_word   ; AX = Segment
   661 000002EF 50                          push ax             ; スタックに積む (あとでRETFでCSになる)
   662 000002F0 89C3                        mov bx, ax          ; DS/ES用のために保存しておく
   663                                      
   664                                      ; スペース読み飛ばし (もしあれば)
