   433                                  ; =================================================================
   434                                  ; Utilities
   435                                  ; =================================================================
   436                                  
   437                                  ; 文字列出力
   438                                  puts:
   439 000001C6 2E8A04                      mov al, [cs:si]
   440 000001C9 08C0                        or al, al
   441 000001CB 7406                        jz .ret
   442 000001CD E80400                      call putc
   443 000001D0 46                          inc si
   444 000001D1 EBF3                        jmp puts
   445 000001D3 C3                      .ret: ret
   446                                  
   447                                  ; 1文字出力
   448                                  putc:
   449 000001D4 52                          push dx
   450 000001D5 50                          push ax
   451 000001D6 BA61F0                      mov dx, SCU_SST
   452 000001D9 EC                      .w: in al, dx
   453 000001DA A801                        test al, TX_READY  ; TX Ready?
   454 000001DC 74FB                        jz .w
   455 000001DE BA60F0                      mov dx, SCU_DATA
   456 000001E1 58                          pop ax
   457 000001E2 50                          push ax
   458 000001E3 EE                          out dx, al
   459 000001E4 58                          pop ax
   460 000001E5 5A                          pop dx
   461 000001E6 C3                          ret
   462                                  
   463                                  ; 1文字入力
   464                                  getc:
   465 000001E7 52                          push dx
   466 000001E8 BA61F0                      mov dx, SCU_SST
   467 000001EB EC                      .w: in al, dx
   468 000001EC A802                        test al, RX_READY  ; RX Ready?
   469 000001EE 74FB                        jz .w
   470 000001F0 BA60F0                      mov dx, SCU_DATA
   471 000001F3 EC                          in al, dx
   472 000001F4 5A                          pop dx
   473 000001F5 C3                          ret
   474                                  
   475                                  ; 1文字入力　エコーバックあり
   476                                  getc_echo:
   477 000001F6 E8EEFF                      call getc
   478 000001F9 50                          push ax
   479 000001FA E8D7FF                      call putc
   480 000001FD 58                          pop ax
   481 000001FE C3                          ret
   482                                  
   483                                  ; 改行出力
   484                                  putc_crlf:
   485 000001FF B00D                        mov al, 0x0D
   486 00000201 E8D0FF                      call putc
   487 00000204 B00A                        mov al, 0x0A
   488 00000206 EBCC                        jmp putc
   489                                  
   490                                  ; -----------------------------------------------------------------
   491                                  ; Helper: 1ワードを4文字のHEXで表示 (例: 0x2F3F -> "2", "F", "3", "F")
   492                                  ; Input: AX
   493                                  ; -----------------------------------------------------------------
   494                                  print_hex_word:
   495 00000208 50                          push ax
   496 00000209 88E0                        mov al, ah
   497 0000020B E80100                      call print_hex_byte
   498 0000020E 58                          pop ax
   499                                  
   500                                  ; -----------------------------------------------------------------
   501                                  ; Helper: 1バイトを2文字のHEXで表示 (例: 0x3F -> "3", "F")
   502                                  ; Input: AL
   503                                  ; -----------------------------------------------------------------
   504                                  print_hex_byte:
   505 0000020F 50                          push ax
   506 00000210 51                          push cx
   507                                  
   508                                      ; 上位バイトの表示
   509 00000211 50                          push ax
   510 00000212 C0E804                      shr al, 4
   511 00000215 E80900                      call .digit
   512                                  
   513                                      ; 下位バイトの表示
   514 00000218 58                          pop ax
   515 00000219 240F                        and al, 0x0F
   516 0000021B E80300                      call .digit
   517                                  
   518 0000021E 59                          pop cx
   519 0000021F 58                          pop ax
   520 00000220 C3                          ret
   521                                  
   522                                  ; 数値を16進数文字に変換して表示 (0-15 -> 0-9, A-F)
   523                                  .digit:
   524 00000221 0430                        add al, '0'
   525 00000223 3C39                        cmp al, '9'
   526 00000225 7602                        jbe .p
   527 00000227 0407                        add al, 7
   528 00000229 E8A8FF                  .p: call putc
   529 0000022C C3                          ret
   530                                  
   531                                  ; -----------------------------------------------------------------
   532                                  ; Helper: 4文字のHEXを受信して1ワード(16bit)の数値にする
   533                                  ; Input:  Serial (例: "1", "0", "0", "0")
   534                                  ; Output: AX = 0x1000
   535                                  ; -----------------------------------------------------------------
   536                                  get_hex_word:
   537 0000022D 53                          push bx
   538 0000022E E80B00                      call get_hex_byte_echo
   539 00000231 88C7                        mov bh, al
   540 00000233 E80600                      call get_hex_byte_echo
   541 00000236 88C3                        mov bl, al
   542 00000238 89D8                        mov ax, bx
   543 0000023A 5B                          pop bx
   544 0000023B C3                          ret
   545                                  
   546                                  ; 16進数2桁入力　エコーバック有り
   547                                  get_hex_byte_echo:
   548 0000023C 53                          push bx
   549 0000023D E8B6FF                      call getc_echo
   550 00000240 E82500                      call hex_char_to_bin
   551 00000243 C0E004                      shl al, 4
   552 00000246 88C3                        mov bl, al
   553 00000248 E8ABFF                      call getc_echo
   554 0000024B E81A00                      call hex_char_to_bin
   555 0000024E 08D8                        or al, bl
   556 00000250 5B                          pop bx
   557 00000251 C3                          ret
   558                                  
   559                                  ; -----------------------------------------------------------------
   560                                  ; Helper: 2文字のHEXを受信して1バイトの数値にする
   561                                  ; Input:  Serial (例: "3", "F")
   562                                  ; Output: AL = 0x3F
   563                                  ; -----------------------------------------------------------------
   564                                  get_hex_byte:
   565 00000252 53                          push bx             ; BH/BLを使うので退避（メインでアドレス用に使ってるため重要）
   566                                  
   567                                      ; 上位4bit
   568 00000253 E891FF                      call getc
   569 00000256 E80F00                      call hex_char_to_bin
   570 00000259 C0E004                      shl al, 4
   571 0000025C 88C3                        mov bl, al          ; 一時保存
   572                                      
   573                                      ; 下位4bit
   574 0000025E E886FF                      call getc
   575 00000261 E80400                      call hex_char_to_bin
   576 00000264 08D8                        or al, bl           ; 上位を合成して結果はALへ
   577 00000266 5B                          pop bx
   578 00000267 C3                          ret
   579                                  
   580                                  ; -----------------------------------------------------------------
   581                                  ; Helper: ASCII文字を数値へ (0-9, A-F -> 0-15)
   582                                  ; Input: AL (ASCII)
   583                                  ; Output: AL (Binary)
   584                                  ; -----------------------------------------------------------------
   585                                  hex_char_to_bin:
   586 00000268 2C30                        sub al, '0'
   587 0000026A 3C09                        cmp al, 9
   588 0000026C 7604                        jbe .done
   589 0000026E 2C07                        sub al, 7           ; 'A'-'F'対応
   590 00000270 240F                        and al, 0x0F        ; 小文字対応も含めてざっくりマスク
   591                                  .done:
   592 00000272 C3                          ret
   593                                  
   594                                  ; -----------------------------------------------------------------
   595                                  ; Helper: スペースなどを読み飛ばす
   596                                  ; -----------------------------------------------------------------
   597                                  skip_space:
   598 00000273 E880FF                      call getc_echo
   599 00000276 C3                          ret
